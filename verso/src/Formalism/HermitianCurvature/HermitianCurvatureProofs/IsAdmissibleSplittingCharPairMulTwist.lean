    refine mul_ne_zero ?_ (ih fun b hb => h b (List.mem_cons_of_mem _ hb))
    split_ifs
    · exact div_ne_zero (h a List.mem_cons_self).1 (h a List.mem_cons_self).2
    · exact one_ne_zero

