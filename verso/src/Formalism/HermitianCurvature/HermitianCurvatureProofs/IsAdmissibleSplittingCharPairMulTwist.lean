section S_Q_Q3

set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace Formalism.FourierDecayAlt.P.MAx3.Q

open Formalism.FourierDecayAlt Formalism.FourierDecayAlt.MA Formalism.FourierDecayAlt.R Formalism.FourierDecayAlt.R.LevelData Formalism.FourierDecayAlt.P.RuleGD Matrix Formalism.FourierDecayAlt.P.MAx3.H
open Formalism.FourierDecayAlt.P.MAx2.Jet (matSub matrix_two_mem_sub)

noncomputable section

section Abs
variable {A : Type} [Ring A] [Algebra ℂ A] {r : ℕ} (L : LevelData A r)

def siteC (l : Fin r) : Subalgebra ℂ A := Subalgebra.centralizer ℂ {L.pb l, L.cb l, L.cbi l}

/- English proof (translation)
Rewrite using `[siteC, Subalgebra.mem_centralizer_iff]`. Introduce `w hw`. Simplify using `only [Set.mem_insert_iff, Set.mem_singleton_iff] at hw`. Apply the tactic sequence `rcases hw with rfl | rfl | rfl <;> assumption`.
-/
theorem mem_siteC {l : Fin r} {z : A} (h1 : L.pb l * z = z * L.pb l) (h2 : L.cb l * z = z * L.cb l)
    (h3 : L.cbi l * z = z * L.cbi l) : z ∈ siteC L l := by
  rw [siteC, Subalgebra.mem_centralizer_iff]
  intro w hw
  simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hw
  rcases hw with rfl | rfl | rfl <;> assumption

/- English proof (translation)
The claim follows from `matrix_two_mem_sub _ _ _ _ _ (sub_mem (Subalgebra.algebraMap_mem _ _) hp) (neg_mem hc) hci (Subalgebra.zero_mem _)`.
-/
theorem cmem (S : Subalgebra ℂ A) {x : A} (hx : x ∈ S) (y : ℂ) (l : Fin r) (hp : L.pb l ∈ S) (hc : L.cb l ∈ S)
    (hci : L.cbi l ∈ S) : L.Tvl y l ∈ matSub S (Fin 2) :=
  matrix_two_mem_sub _ _ _ _ _ (sub_mem (Subalgebra.algebraMap_mem _ _) hp) (neg_mem hc) hci (Subalgebra.zero_mem _)

/- English proof (translation)
Establish `hm : L.Tvl y' m ∈ matSub (siteC L l) (Fin 2)`. Use `matrix_two_mem_sub _ _ _ _ _ (sub_mem (Subalgebra.algebraMap_mem _ _) ?_) (neg_mem ?_) ?_ (Subalgebra.zero_mem _)` and prove the remaining obligations. Conclude with `mem_siteC L (L.pb_pb l m) (by rw [L.pb_cb m l, if_neg (Ne.symm hlm), add_zero]) (by rw [L.pb_cbi m l, if_neg (Ne.symm hlm), sub_zero])`. Use `mem_siteC L ?_ (fc L (m_cb L l) (m_cb L m)) (fc L (m_cbi L l) (m_cb L m))` and prove the remaining obligations. Rewrite using `[L.pb_cb, if_neg hlm, add_zero]`.

Use `mem_siteC L ?_ (fc L (m_cb L l) (m_cbi L m)) (fc L (m_cbi L l) (m_cbi L m))` and prove the remaining obligations. Rewrite using `[L.pb_cbi, if_neg hlm, sub_zero]`. Establish `hz` using `hm k n`. Rewrite `hz` using `[siteC, Subalgebra.mem_centralizer_iff]`. Establish `hl : L.Tvl y l ∈ matSub (Subalgebra.centralizer ℂ {(L.Tvl y' m) k n}) (Fin 2)`.

Apply the tactic sequence `refine matrix_two_mem_sub _ _ _ _ _ (sub_mem (Subalgebra.algebraMap_mem _ _) ?_) (neg_mem ?_) ?_ (Subalgebra.zero_mem _) <;>`. Apply the tactic sequence `rw [Subalgebra.mem_centralizer_iff]; intro w hw; rw [Set.mem_singleton_iff.1 hw] first | exact (hz _ (by simp)).symm`. Use `(Subalgebra.mem_centralizer_iff _).1 (hl i j) _ rfl` as an intermediate fact. Conclude with `this.symm`.
-/
theorem site_entries (l m : Fin r) (hlm : l ≠ m) (y y' : ℂ) (i j k n : Fin 2) :
    (L.Tvl y l) i j * (L.Tvl y' m) k n = (L.Tvl y' m) k n * (L.Tvl y l) i j := by
  have hm : L.Tvl y' m ∈ matSub (siteC L l) (Fin 2) := by
    refine matrix_two_mem_sub _ _ _ _ _ (sub_mem (Subalgebra.algebraMap_mem _ _) ?_) (neg_mem ?_) ?_ (Subalgebra.zero_mem _)
    · exact mem_siteC L (L.pb_pb l m) (by rw [L.pb_cb m l, if_neg (Ne.symm hlm), add_zero])
        (by rw [L.pb_cbi m l, if_neg (Ne.symm hlm), sub_zero])
    · refine mem_siteC L ?_ (fc L (m_cb L l) (m_cb L m)) (fc L (m_cbi L l) (m_cb L m))
      rw [L.pb_cb, if_neg hlm, add_zero]
    · refine mem_siteC L ?_ (fc L (m_cb L l) (m_cbi L m)) (fc L (m_cbi L l) (m_cbi L m))
      rw [L.pb_cbi, if_neg hlm, sub_zero]
  have hz := hm k n
  rw [siteC, Subalgebra.mem_centralizer_iff] at hz
  have hl : L.Tvl y l ∈ matSub (Subalgebra.centralizer ℂ {(L.Tvl y' m) k n}) (Fin 2) := by
    refine matrix_two_mem_sub _ _ _ _ _ (sub_mem (Subalgebra.algebraMap_mem _ _) ?_) (neg_mem ?_) ?_ (Subalgebra.zero_mem _) <;>
    · rw [Subalgebra.mem_centralizer_iff]; intro w hw; rw [Set.mem_singleton_iff.1 hw]
      first | exact (hz _ (by simp)).symm
  have := (Subalgebra.mem_centralizer_iff _).1 (hl i j) _ rfl
  exact this.symm

/- English proof (translation)
Unfold `LevelData.Tvprod`. Rewrite using `[transpose_list_prod, List.map_reverse, List.reverse_reverse, List.map_ofFn]`. Both sides reduce to the same expression. Rewrite using `[List.pairwise_reverse, List.pairwise_ofFn]`. Introduce `l m hlm i j k n`.

Conclude with `site_entries L m l hlm.ne' y y i j k n`.
-/
theorem Tvprod_transpose (y : ℂ) : (L.Tvprod y)ᵀ = (List.ofFn fun l => (L.Tvl y l)ᵀ).prod := by
  unfold LevelData.Tvprod
  rw [transpose_list_prod, List.map_reverse, List.reverse_reverse, List.map_ofFn]
  · rfl
  · rw [List.pairwise_reverse, List.pairwise_ofFn]
    intro l m hlm i j k n
    exact site_entries L m l hlm.ne' y y i j k n

end Abs

end

end Formalism.FourierDecayAlt.P.MAx3.Q

end S_Q_Q3

section S_Q_Q4

set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace Formalism.FourierDecayAlt.P.MAx3.Q

open Formalism.FourierDecayAlt Formalism.FourierDecayAlt.MA Formalism.FourierDecayAlt.R Formalism.FourierDecayAlt.R.LevelData Formalism.FourierDecayAlt.P.RuleGD Matrix Formalism.FourierDecayAlt.P.MAx3.H
open Formalism.FourierDecayAlt.P.MAx2.Jet (matSub matrix_two_mem_sub)

noncomputable section

variable {P : M.Par} {L : LevelData (A P (DQ P)) P.r} (hL : IsModelLevel P (DQ P) L) (hLaw : (DQ P).Laws P.TT)
include hL hLaw

/- English proof (translation)
Establish `: Fact ((DQ P).Laws P.TT)` using `⟨hLaw⟩`. Establish `hs` using `Formalism.FourierDecayAlt.P.MAx1.starGens P (DQ P)`. Take `⟨hp, hpb, hc, hci, hcb, hcbi, hz, hzi, hzb, hzbi, hg, hgi, hn, hns, -⟩` from `hL`. Use `⟨fun l => ?_, fun l => ?_, fun l => ?_, fun l => ?_, fun l => ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩` and prove the remaining obligations. Rewrite using `[hp, hpb]`.

Conclude with `(hs.1 l).2.2`. Rewrite using `[hc, hcb]`. Conclude with `(hs.1 l).1`. Rewrite using `[hci, hcbi]`. Conclude with `(hs.1 l).2.1`.

Rewrite using `[hc, hcb, ← (hs.1 l).1, star_star]`. Rewrite using `[hci, hcbi, ← (hs.1 l).2.1, star_star]`. Rewrite using `[hz, hzb]`. Conclude with `hs.2.1`. Rewrite using `[hz, hzb, ← hs.2.1, star_star]`.

Rewrite using `[hg]`. Conclude with `hs.2.2.2.1`. Rewrite using `[hgi]`. Conclude with `hs.2.2.2.2.1`. Rewrite using `[hn, hns]`.

Conclude with `hs.2.2.2.2.2`. Rewrite using `[hn, hns, ← hs.2.2.2.2.2, star_star]`.
-/
theorem star_all : (∀ l, star (L.p l) = -L.pb l) ∧ (∀ l, star (L.c l) = L.cb l) ∧ (∀ l, star (L.ci l) = L.cbi l) ∧
    (∀ l, star (L.cb l) = L.c l) ∧ (∀ l, star (L.cbi l) = L.ci l) ∧ star L.ζ = L.ζb ∧ star L.ζb = L.ζ ∧
    star L.GG = L.GG ∧ star L.GGi = L.GGi ∧ star L.nab = L.nabs ∧ star L.nabs = L.nab := by
  have : Fact ((DQ P).Laws P.TT) := ⟨hLaw⟩
  have hs := Formalism.FourierDecayAlt.P.MAx1.starGens P (DQ P)
  obtain ⟨hp, hpb, hc, hci, hcb, hcbi, hz, hzi, hzb, hzbi, hg, hgi, hn, hns, -⟩ := hL
  refine ⟨fun l => ?_, fun l => ?_, fun l => ?_, fun l => ?_, fun l => ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · rw [hp, hpb]; exact (hs.1 l).2.2
  · rw [hc, hcb]; exact (hs.1 l).1
  · rw [hci, hcbi]; exact (hs.1 l).2.1
  · rw [hc, hcb, ← (hs.1 l).1, star_star]
  · rw [hci, hcbi, ← (hs.1 l).2.1, star_star]
  · rw [hz, hzb]; exact hs.2.1
  · rw [hz, hzb, ← hs.2.1, star_star]
  · rw [hg]; exact hs.2.2.2.1
  · rw [hgi]; exact hs.2.2.2.2.1
  · rw [hn, hns]; exact hs.2.2.2.2.2
  · rw [hn, hns, ← hs.2.2.2.2.2, star_star]

/- English proof (translation)
Rewrite using `[← algebraMap_star_comm]`. Both sides reduce to the same expression.
-/
theorem star_alg (z : ℂ) : star (algebraMap ℂ (A P (DQ P)) z) = algebraMap ℂ (A P (DQ P)) (starRingEnd ℂ z) := by
  rw [← algebraMap_star_comm]; rfl

/- English proof (translation)
Take `⟨hp, hc, hci, -⟩` from `star_all hL hLaw`. Use `Matrix.ext fun i j => ?_` and prove the remaining obligations. Apply the tactic sequence `fin_cases i <;> fin_cases j <;>`. Simplify using `[LevelData.Tl, LevelData.Tvl, conjTranspose_apply, star_add, star_neg, hp, hc, hci, star_alg hL hLaw, sub_eq_add_neg]`.
-/
theorem star_Tl (y : ℂ) (l : Fin P.r) : (L.Tl y l)ᴴ = (L.Tvl (starRingEnd ℂ y) l)ᵀ := by
  obtain ⟨hp, hc, hci, -⟩ := star_all hL hLaw
  refine Matrix.ext fun i j => ?_
  fin_cases i <;> fin_cases j <;>
    simp [LevelData.Tl, LevelData.Tvl, conjTranspose_apply, star_add, star_neg, hp, hc, hci, star_alg hL hLaw, sub_eq_add_neg]

/- English proof (translation)
Rewrite using `[Tvprod_transpose]`. Unfold `LevelData.Tprod`. Rewrite using `[conjTranspose_list_prod, List.map_reverse, List.reverse_reverse, List.map_ofFn]`. Use `congr 1`. Conclude with `congrArg List.ofFn (funext fun l => star_Tl hL hLaw y l)`.
-/
theorem star_Tprod (y : ℂ) : (L.Tprod y)ᴴ = (L.Tvprod (starRingEnd ℂ y))ᵀ := by
  rw [Tvprod_transpose]
  unfold LevelData.Tprod
  rw [conjTranspose_list_prod, List.map_reverse, List.reverse_reverse, List.map_ofFn]
  congr 1
  exact congrArg List.ofFn (funext fun l => star_Tl hL hLaw y l)

/- English proof (translation)
Establish `h` using `congrArg (fun M => M 0 0) (star_Tprod hL hLaw y)`. Simplify `h` using `[conjTranspose_apply, LevelData.Ar, LevelData.Avr]`.
-/
theorem star_Ar (y : ℂ) : star (L.Ar y) = L.Avr (starRingEnd ℂ y) := by
  have h := congrArg (fun M => M 0 0) (star_Tprod hL hLaw y)
  simpa [conjTranspose_apply, LevelData.Ar, LevelData.Avr] using h

/- English proof (translation)
Establish `h` using `congrArg (fun M => M 0 1) (star_Tprod hL hLaw y)`. Simplify `h` using `[conjTranspose_apply, LevelData.Br, LevelData.Bvr]`.
-/
theorem star_Br (y : ℂ) : star (L.Br y) = L.Bvr (starRingEnd ℂ y) := by
  have h := congrArg (fun M => M 0 1) (star_Tprod hL hLaw y)
  simpa [conjTranspose_apply, LevelData.Br, LevelData.Bvr] using h

/- English proof (translation)
Take `⟨-, hc, -⟩` from `star_all hL hLaw`. Unfold `LevelData.Dr LevelData.Drb`. Rewrite using `[star_list_prod', List.map_ofFn]`. Establish `: (star ∘ L.c) = L.cb` using `funext hc`. Rewrite using `[this, rev_prod L]`.

Introduce `x hx`. Take `⟨l, rfl⟩` from `List.mem_ofFn.1 hx`. Conclude with `memF L (m_cb L l)`.
-/
theorem star_Dr : star L.Dr = L.Drb := by
  obtain ⟨-, hc, -⟩ := star_all hL hLaw
  unfold LevelData.Dr LevelData.Drb
  rw [star_list_prod', List.map_ofFn]
  have : (star ∘ L.c) = L.cb := funext hc
  rw [this, rev_prod L]
  intro x hx; obtain ⟨l, rfl⟩ := List.mem_ofFn.1 hx; exact memF L (m_cb L l)

/- English proof (translation)
Unfold `LevelData.Ahat LevelData.Ahatv`. Rewrite using `[star_mul, star_Ar hL hLaw, star_Dr hL hLaw, Avr_Drb]`.
-/
theorem star_Ahat (y : ℂ) : star (L.Ahat y) = L.Ahatv (starRingEnd ℂ y - 1) := by
  unfold LevelData.Ahat LevelData.Ahatv
  rw [star_mul, star_Ar hL hLaw, star_Dr hL hLaw, Avr_Drb]

end

end Formalism.FourierDecayAlt.P.MAx3.Q

end S_Q_Q4

section S_Q_Q5

set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace Formalism.FourierDecayAlt.P.MAx3.Q

open Formalism.FourierDecayAlt Formalism.FourierDecayAlt.MA Formalism.FourierDecayAlt.R Formalism.FourierDecayAlt.R.LevelData Formalism.FourierDecayAlt.P.RuleGD Matrix Formalism.FourierDecayAlt.P.MAx3.H

noncomputable section

section Abs
variable {A : Type} [Ring A] [Algebra ℂ A] {r : ℕ} (L : LevelData A r)

/- English proof (translation)
Establish `hz : ∀ l, L.ζ * L.GGi * L.pb l = L.pb l * (L.ζ * L.GGi)` using `fun l => by`. Rewrite using `[mul_assoc, ← L.pb_GGi, ← mul_assoc, ← L.pb_ζ, mul_assoc]`. Use `⟨fun l => ?_, fun l => ?_, fun l => ?_⟩` and prove the remaining obligations. Unfold `LevelData.m0`. Rewrite using `[sub_mul, mul_sub, neg_mul, mul_neg, ← L.pb_nabs, mul_assoc, hz, ← mul_assoc, ← mul_assoc, Algebra.commutes]`.

Simplify using `only [mul_assoc]`. Unfold `LevelData.m0`. Establish `h1 : L.ζ * L.GGi * L.cb l = L.cb l * (L.ζ * L.GGi)` using `cl_comm L (Subring.mul_mem _ (memζ L) (memF L (m_GGi L))) (memF L (m_cb L l))`. Rewrite using `[sub_mul, mul_sub, neg_mul, mul_neg, L.nabs_cb, mul_assoc, h1, ← mul_assoc, ← mul_assoc, Algebra.commutes]`. Simplify using `only [mul_assoc]`.

Unfold `LevelData.m0`. Establish `h1 : L.ζ * L.GGi * L.cbi l = L.cbi l * (L.ζ * L.GGi)` using `cl_comm L (Subring.mul_mem _ (memζ L) (memF L (m_GGi L))) (memF L (m_cbi L l))`. Rewrite using `[sub_mul, mul_sub, neg_mul, mul_neg, L.nabs_cbi, mul_assoc, h1, ← mul_assoc, ← mul_assoc, Algebra.commutes]`. Simplify using `only [mul_assoc]`.
-/
theorem raising_constant_commute_sites (Y : ℂ) : (∀ l, L.m0 Y * L.pb l = L.pb l * L.m0 Y) ∧ (∀ l, L.m0 Y * L.cb l = L.cb l * L.m0 Y) ∧
    (∀ l, L.m0 Y * L.cbi l = L.cbi l * L.m0 Y) := by
  have hz : ∀ l, L.ζ * L.GGi * L.pb l = L.pb l * (L.ζ * L.GGi) := fun l => by
    rw [mul_assoc, ← L.pb_GGi, ← mul_assoc, ← L.pb_ζ, mul_assoc]
  refine ⟨fun l => ?_, fun l => ?_, fun l => ?_⟩
  · unfold LevelData.m0
    rw [sub_mul, mul_sub, neg_mul, mul_neg, ← L.pb_nabs, mul_assoc, hz, ← mul_assoc, ← mul_assoc,
      Algebra.commutes]
    simp only [mul_assoc]
  · unfold LevelData.m0
    have h1 : L.ζ * L.GGi * L.cb l = L.cb l * (L.ζ * L.GGi) :=
      cl_comm L (Subring.mul_mem _ (memζ L) (memF L (m_GGi L))) (memF L (m_cb L l))
    rw [sub_mul, mul_sub, neg_mul, mul_neg, L.nabs_cb, mul_assoc, h1, ← mul_assoc, ← mul_assoc, Algebra.commutes]
    simp only [mul_assoc]
  · unfold LevelData.m0
    have h1 : L.ζ * L.GGi * L.cbi l = L.cbi l * (L.ζ * L.GGi) :=
      cl_comm L (Subring.mul_mem _ (memζ L) (memF L (m_GGi L))) (memF L (m_cbi L l))
    rw [sub_mul, mul_sub, neg_mul, mul_neg, L.nabs_cbi, mul_assoc, h1, ← mul_assoc, ← mul_assoc, Algebra.commutes]
    simp only [mul_assoc]

/- English proof (translation)
Unfold `LevelData.m0`. Establish `hζ : L.ζ * L.GGi * L.GG = L.ζ` using `by rw [mul_assoc, L.GGi_GG, mul_one]`. Establish `hζ' : L.GG * (L.ζ * L.GGi) = L.ζ`. Rewrite using `[← mul_assoc, fc L (m_GG L) (m_ζ L), mul_assoc, L.GG_GGi, mul_one]`. Establish `e : algebraMap ℂ A (Y + 1 - 1 / 2) = algebraMap ℂ A (Y - 1 / 2) + 1`.

Rewrite using `[← map_one (algebraMap ℂ A), ← map_add]`. Use `congr 1`. Expand and normalize the polynomial expressions, which then agree. Rewrite using `[sub_mul, neg_mul, L.nabs_GG, mul_assoc (algebraMap ℂ A _), hζ, mul_sub, mul_neg, ← mul_assoc L.GG, ← Algebra.commutes, mul_assoc, hζ', e, add_mul, one_mul]`. Normalize the expressions using the abelian group laws.
-/
theorem raising_constant_gamma_shift (Y : ℂ) : L.m0 (Y + 1) * L.GG = L.GG * L.m0 Y := by
  unfold LevelData.m0
  have hζ : L.ζ * L.GGi * L.GG = L.ζ := by rw [mul_assoc, L.GGi_GG, mul_one]
  have hζ' : L.GG * (L.ζ * L.GGi) = L.ζ := by
    rw [← mul_assoc, fc L (m_GG L) (m_ζ L), mul_assoc, L.GG_GGi, mul_one]
  have e : algebraMap ℂ A (Y + 1 - 1 / 2) = algebraMap ℂ A (Y - 1 / 2) + 1 := by
    rw [← map_one (algebraMap ℂ A), ← map_add]; congr 1; ring
  rw [sub_mul, neg_mul, L.nabs_GG, mul_assoc (algebraMap ℂ A _), hζ, mul_sub, mul_neg, ← mul_assoc L.GG,
    ← Algebra.commutes, mul_assoc, hζ', e, add_mul, one_mul]
  abel

end Abs

variable {P : M.Par} {L : LevelData (A P (DQ P)) P.r} (hL : IsModelLevel P (DQ P) L) (hLaw : (DQ P).Laws P.TT)
include hL hLaw

/- English proof (translation)
Take `⟨-, -, -, -, -, hz, hzb, -, hgi, hn, -⟩` from `star_all hL hLaw`. Unfold `LevelData.l0 LevelData.m0`. Rewrite using `[star_sub, star_neg, hn, star_mul, star_mul, hzb, hgi, star_alg hL hLaw]`. Establish `hc : L.GGi * L.ζ = L.ζ * L.GGi` using `fc L (m_GGi L) (m_ζ L)`. Rewrite using `[hc, ← Algebra.commutes]`.

Use `congr 3`. Simplify using `only [map_add, map_div₀, map_one, map_ofNat]`. Expand and normalize the polynomial expressions, which then agree.
-/
theorem star_lowering_constant (y : ℂ) : star (L.l0 y) = L.m0 (starRingEnd ℂ y + 1) := by
  obtain ⟨-, -, -, -, -, hz, hzb, -, hgi, hn, -⟩ := star_all hL hLaw
  unfold LevelData.l0 LevelData.m0
  rw [star_sub, star_neg, hn, star_mul, star_mul, hzb, hgi, star_alg hL hLaw]
  have hc : L.GGi * L.ζ = L.ζ * L.GGi := fc L (m_GGi L) (m_ζ L)
  rw [hc, ← Algebra.commutes]
  congr 3
  simp only [map_add, map_div₀, map_one, map_ofNat]
  ring

/- English proof (translation)
Take `⟨-, -, -, -, -, -, -, hg, -, -, -⟩` from `star_all hL hLaw`. Use `set Y := starRingEnd ℂ y`. Unfold `LevelData.R0 LevelData.R0v`. Rewrite using `[star_mul, star_mul, star_add, star_mul, star_Ar hL hLaw, star_Br hL hLaw, star_lowering_constant hL hLaw, hg, star_Drb hL hLaw]`. Establish `ha : L.Avr Y * L.m0 (Y + 1) = L.m0 (Y + 1) * L.Avr Y`.

Take `⟨h1, h2, h3⟩` from `raising_constant_commute_sites L (Y + 1)`. Conclude with `((comm_Tvprod L (L.m0 (Y + 1)) h1 h2 h3 Y).1).symm`. Establish `hGA : L.GG * L.Avr Y = L.Avr Y * L.GG ∧ L.GG * L.Bvr Y = L.Bvr Y * L.GG` using `comm_Tvprod L L.GG (fun l => (L.pb_GG l).symm) (fun l => fc L (m_GG L) (m_cb L l)) (fun l => fc L (m_GG L) (m_cbi L l)) Y`. Establish `hDA : L.Dr * L.Avr Y = L.Avr Y * L.Dr ∧ L.Dr * L.Bvr Y = L.Bvr Y * L.Dr` using `comm_Tvprod L L.Dr (fun l => (comm_prod L.c (L.pb l) (fun m => L.pb_c l m)).symm) (fun l => cl_comm L (memDr L) (memF L (m_cb L l))) (fun l => cl_comm L (memDr L) (memF L (m_cbi L l))) Y`. Establish `hDm : L.Dr * L.m0 Y = L.m0 Y * L.Dr`.

Unfold `LevelData.m0`. Establish `h1 : L.nabs * L.Dr = L.Dr * L.nabs` using `comm_Dr L (fun l => L.nabs_c l)`. Establish `h2 : L.Dr * (L.ζ * L.GGi) = L.ζ * L.GGi * L.Dr` using `cl_comm L (memDr L) (Subring.mul_mem _ (memζ L) (memF L (m_GGi L)))`. Rewrite using `[mul_sub, sub_mul, mul_neg, neg_mul, h1, ← mul_assoc, ← Algebra.commutes, mul_assoc, h2]`. Simplify using `only [mul_assoc]`.

Establish `hD1 : L.Dr * (L.m0 Y * L.Avr Y + L.Bvr Y) = (L.m0 Y * L.Avr Y + L.Bvr Y) * L.Dr`. Rewrite using `[mul_add, add_mul, ← mul_assoc, hDm, mul_assoc, hDA.1, hDA.2, mul_assoc]`. Establish `hDG : L.Dr * L.GG = L.GG * L.Dr` using `cl_comm L (memDr L) (memGG L)`. Combine the equalities or inequalities in the displayed calculation. Rewrite using `[ha]`.

Simplify using `only [add_mul, mul_assoc]`. Use `_ = (L.m0 (Y + 1) * L.GG * L.Avr Y + L.GG * L.Bvr Y) * L.Dr := by`. Rewrite using `[← hGA.1, ← hGA.2, mul_assoc]`. Use `_ = L.GG * (L.m0 Y * L.Avr Y + L.Bvr Y) * L.Dr := by`. Rewrite using `[raising_constant_gamma_shift]`.

Simplify using `only [mul_add, mul_assoc]`. Use `_ = L.Dr * L.GG * (L.m0 Y * L.Avr Y + L.Bvr Y) := by`. Rewrite using `[mul_assoc, ← hD1, ← mul_assoc, ← hDG]`.
-/
theorem star_raising (y : ℂ) : star (L.R0 y) = L.R0v (starRingEnd ℂ y) := by
  obtain ⟨-, -, -, -, -, -, -, hg, -, -, -⟩ := star_all hL hLaw
  set Y := starRingEnd ℂ y
  unfold LevelData.R0 LevelData.R0v
  rw [star_mul, star_mul, star_add, star_mul, star_Ar hL hLaw, star_Br hL hLaw, star_lowering_constant hL hLaw, hg,
    star_Drb hL hLaw]

  have ha : L.Avr Y * L.m0 (Y + 1) = L.m0 (Y + 1) * L.Avr Y := by
    obtain ⟨h1, h2, h3⟩ := raising_constant_commute_sites L (Y + 1)
    exact ((comm_Tvprod L (L.m0 (Y + 1)) h1 h2 h3 Y).1).symm
  have hGA : L.GG * L.Avr Y = L.Avr Y * L.GG ∧ L.GG * L.Bvr Y = L.Bvr Y * L.GG :=
    comm_Tvprod L L.GG (fun l => (L.pb_GG l).symm) (fun l => fc L (m_GG L) (m_cb L l)) (fun l => fc L (m_GG L) (m_cbi L l)) Y
  have hDA : L.Dr * L.Avr Y = L.Avr Y * L.Dr ∧ L.Dr * L.Bvr Y = L.Bvr Y * L.Dr :=
    comm_Tvprod L L.Dr (fun l => (comm_prod L.c (L.pb l) (fun m => L.pb_c l m)).symm)
      (fun l => cl_comm L (memDr L) (memF L (m_cb L l))) (fun l => cl_comm L (memDr L) (memF L (m_cbi L l))) Y
  have hDm : L.Dr * L.m0 Y = L.m0 Y * L.Dr := by
    unfold LevelData.m0
    have h1 : L.nabs * L.Dr = L.Dr * L.nabs := comm_Dr L (fun l => L.nabs_c l)
    have h2 : L.Dr * (L.ζ * L.GGi) = L.ζ * L.GGi * L.Dr :=
      cl_comm L (memDr L) (Subring.mul_mem _ (memζ L) (memF L (m_GGi L)))
    rw [mul_sub, sub_mul, mul_neg, neg_mul, h1, ← mul_assoc, ← Algebra.commutes, mul_assoc, h2]
    simp only [mul_assoc]
  have hD1 : L.Dr * (L.m0 Y * L.Avr Y + L.Bvr Y) = (L.m0 Y * L.Avr Y + L.Bvr Y) * L.Dr := by
    rw [mul_add, add_mul, ← mul_assoc, hDm, mul_assoc, hDA.1, hDA.2, mul_assoc]
  have hDG : L.Dr * L.GG = L.GG * L.Dr := cl_comm L (memDr L) (memGG L)
  calc (L.Avr Y * L.m0 (Y + 1) + L.Bvr Y) * (L.GG * L.Dr)
      = (L.m0 (Y + 1) * (L.Avr Y * L.GG) + L.Bvr Y * L.GG) * L.Dr := by
        rw [ha]; simp only [add_mul, mul_assoc]
    _ = (L.m0 (Y + 1) * L.GG * L.Avr Y + L.GG * L.Bvr Y) * L.Dr := by
        rw [← hGA.1, ← hGA.2, mul_assoc]
    _ = L.GG * (L.m0 Y * L.Avr Y + L.Bvr Y) * L.Dr := by
        rw [raising_constant_gamma_shift]; simp only [mul_add, mul_assoc]
    _ = L.Dr * L.GG * (L.m0 Y * L.Avr Y + L.Bvr Y) := by
        rw [mul_assoc, ← hD1, ← mul_assoc, ← hDG]

end

end Formalism.FourierDecayAlt.P.MAx3.Q

