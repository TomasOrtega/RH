theorem rep_const {G : Set ℂ} {X : SlopeTestRemainingChoices S (A P (DQ P))} (hX : X ∈ UB L S) : Rep L G (fun _ => X) :=
  ⟨[(fun _ => 1, X)], by simp [hX, continuousAt_const], fun Y => by simp⟩

