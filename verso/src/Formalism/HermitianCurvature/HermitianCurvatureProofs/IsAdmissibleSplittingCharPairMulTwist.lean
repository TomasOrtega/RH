/- English proof (translation)
Combine the equalities or inequalities in the displayed calculation. Rewrite using `[Finset.sum_comm]`. Conclude with `Finset.sum_congr rfl fun e _ => Finset.sum_comm`. Use `_ = ∑ e, ∑ a, ∑ e', ∑ b, T a b e e' := Finset.sum_comm`. Use `_ = ∑ e, ∑ e', ∑ a, ∑ b, T a b e e' := Finset.sum_congr rfl fun e _ => Finset.sum_comm`.
-/
theorem sum4 {M : Type*} [AddCommMonoid M] {ι : Type*} [Fintype ι] (T : ι → ι → ι → ι → M) :
    ∑ a, ∑ b, ∑ e, ∑ e', T a b e e' = ∑ e, ∑ e', ∑ a, ∑ b, T a b e e' := by
  calc ∑ a, ∑ b, ∑ e, ∑ e', T a b e e' = ∑ a, ∑ e, ∑ e', ∑ b, T a b e e' :=
        Finset.sum_congr rfl fun a _ => by
          rw [Finset.sum_comm]; exact Finset.sum_congr rfl fun e _ => Finset.sum_comm
    _ = ∑ e, ∑ a, ∑ e', ∑ b, T a b e e' := Finset.sum_comm
    _ = ∑ e, ∑ e', ∑ a, ∑ b, T a b e e' := Finset.sum_congr rfl fun e _ => Finset.sum_comm

/- English proof (translation)
Establish `h1 : ∀ a b, star (u a) * (star F * d * F) a b * u b = ∑ e, ∑ e', star (u a) * (star (F e a) * (d e e' * (F e' b * u b)))`. Introduce `a b`. Simplify using `only [Matrix.mul_apply, Matrix.star_apply, Finset.sum_mul, Finset.mul_sum, mul_assoc]`. Rewrite using `[Finset.sum_comm]`. Establish `h2 : ∀ e e', star (∑ e'', F e e'' * u e'') * d e e' * ∑ e'', F e' e'' * u e'' = ∑ a, ∑ b, star (u a) * (star (F e a) * (d e e' * (F e' b * u b)))`.

Introduce `e e'`. Simplify using `only [star_sum, star_mul, Finset.sum_mul, Finset.mul_sum, mul_assoc]`. Rewrite using `[Finset.sum_comm]`. Rewrite using `[Finset.sum_congr rfl fun a _ => Finset.sum_congr rfl fun b _ => h1 a b, Finset.sum_congr rfl fun e _ => Finset.sum_congr rfl fun e' _ => h2 e e']`. Conclude with `sum4 _`.
-/
theorem sandwich {R : Type*} [Ring R] [StarRing R] {ι : Type*} [Fintype ι] [DecidableEq ι]
    (F d : Matrix ι ι R) (u : ι → R) :
    ∑ a, ∑ b, star (u a) * (star F * d * F) a b * u b =
      ∑ e, ∑ e', star (∑ e'', F e e'' * u e'') * d e e' * ∑ e'', F e' e'' * u e'' := by
  have h1 : ∀ a b, star (u a) * (star F * d * F) a b * u b =
      ∑ e, ∑ e', star (u a) * (star (F e a) * (d e e' * (F e' b * u b))) := by
    intro a b
    simp only [Matrix.mul_apply, Matrix.star_apply, Finset.sum_mul, Finset.mul_sum, mul_assoc]
    rw [Finset.sum_comm]
  have h2 : ∀ e e', star (∑ e'', F e e'' * u e'') * d e e' * ∑ e'', F e' e'' * u e'' =
      ∑ a, ∑ b, star (u a) * (star (F e a) * (d e e' * (F e' b * u b))) := by
    intro e e'
    simp only [star_sum, star_mul, Finset.sum_mul, Finset.mul_sum, mul_assoc]
    rw [Finset.sum_comm]
  rw [Finset.sum_congr rfl fun a _ => Finset.sum_congr rfl fun b _ => h1 a b,
    Finset.sum_congr rfl fun e _ => Finset.sum_congr rfl fun e' _ => h2 e e']
  exact sum4 _

/- English proof (translation)
Take `⟨⟨hOK, hl1, hlk, _, hu, hu', hαβ, hcut⟩, _, _, _, _, _, hL2, _, h6⟩` from `hH`. Establish `hBF` using `Formalism.FourierDecayAlt.P.boxes_fit (sysQ P l L j lam α β Lb c Ntot) hL2 h6`. Establish `hAdm` using `hBF.2.2 w hw hlen`. Establish `hYI : ∀ y ∈ w, y ∈ Set.Icc α β` using `fun y hy => hAdm.1 (true, y) (List.mem_map.2 ⟨y, hy, rfl⟩)`. Establish `hpw : w.Pairwise fun y y' => 2 < |y - y'|`.

Use `hAdm.2` as an intermediate fact. Unfold `LE.plus at this`. Rewrite `this` using `[List.pairwise_map]`. Conclude with `this`. Use `⟨plusWord_slots_nodup w, fun a ha => ?_, MAx2.pairwise_wordP hpw⟩` and prove the remaining obligations.

Take `⟨y, hy, e⟩` from `MAx2.mem_wordP ha`. Rewrite using `[e]`. Conclude with `⟨Complex.ofReal_im _, by rw [Complex.ofReal_re]; exact hcut _ (hYI y hy)⟩`.
-/
theorem cutWord_of {P : M.Par} {l : ℕ} {L : R.LevelData (A P (DQ P)) P.r} {j : M.Ty P → SmQ P.r P.TT}
    {lam : Fin (P.k + 2 * P.r + 1) → ℝ} {α β Lb : ℝ} {Ntot : ℕ} (hH : Hyps P l L j lam α β Lb Ntot) (c : LE.Cut)
    (w : List ℝ) (hw : (sysQ P l L j lam α β Lb c Ntot).OnBoxes w) (hlen : w.length ≤ Ntot) :
    M.CutWord P l (wordP w) := by
  obtain ⟨⟨hOK, hl1, hlk, _, hu, hu', hαβ, hcut⟩, _, _, _, _, _, hL2, _, h6⟩ := hH
  have hBF := Formalism.FourierDecayAlt.P.boxes_fit (sysQ P l L j lam α β Lb c Ntot) hL2 h6
  have hAdm := hBF.2.2 w hw hlen
  have hYI : ∀ y ∈ w, y ∈ Set.Icc α β := fun y hy => hAdm.1 (true, y) (List.mem_map.2 ⟨y, hy, rfl⟩)
  have hpw : w.Pairwise fun y y' => 2 < |y - y'| := by
    have := hAdm.2
    unfold LE.plus at this
    rw [List.pairwise_map] at this
    exact this
  refine ⟨plusWord_slots_nodup w, fun a ha => ?_, MAx2.pairwise_wordP hpw⟩
  obtain ⟨y, hy, e⟩ := MAx2.mem_wordP ha
  rw [e]
  exact ⟨Complex.ofReal_im _, by rw [Complex.ofReal_re]; exact hcut _ (hYI y hy)⟩

/- English proof (translation)
Take `⟨h1, h2, h3⟩` from `h`. Use `⟨h1, fun a ha => ?_, ?_⟩` and prove the remaining obligations. Conclude with `Complex.conj_eq_iff_im.2 (h2 a ha).1`. Use `h3.imp_of_mem fun {a b} ha hb hab => ?_` and prove the remaining obligations. Unfold `RegL`.

Rewrite using `[if_pos (plusWord_letters_plus w b hb)]`. Introduce `e`. Establish `: a.pt.re - b.pt.re = 1`. Use `congrArg Complex.re e` as an intermediate fact. Simplify using `using this`.

Rewrite `hab` using `[this]`. Evaluate the numerical expressions using `at hab`.
-/
theorem good_of_cut {P : M.Par} {l : ℕ} (w : List ℝ) (h : M.CutWord P l (wordP w)) : Good (wordP w) := by
  obtain ⟨h1, h2, h3⟩ := h
  refine ⟨h1, fun a ha => ?_, ?_⟩
  · exact Complex.conj_eq_iff_im.2 (h2 a ha).1
  · refine h3.imp_of_mem fun {a b} ha hb hab => ?_
    unfold RegL
    rw [if_pos (plusWord_letters_plus w b hb)]
    intro e
    have : a.pt.re - b.pt.re = 1 := by
      have := congrArg Complex.re e
      simpa using this
    rw [this] at hab
    norm_num at hab

/- English proof (translation)
Establish `e1 : (wordP w).reverse.map (fun a => f a.pt) = (w.map fun y => f ((y : ℝ) : ℂ)).reverse`. Rewrite using `[List.map_reverse]`. Use `congr 1`. Use `congrArg (List.map f) (MAx2.plusWord_points w)` as an intermediate fact. Simplify `this` using `[List.map_map, Function.comp_def]`.

Establish `e2 : (LE.plus w).reverse.map (fun x => f ((x.2 : ℝ) : ℂ)) = (w.map fun y => f ((y : ℝ) : ℂ)).reverse`. Rewrite using `[List.map_reverse]`. Simplify using `[LE.plus, List.map_map, Function.comp_def]`. Rewrite using `[e1, e2]`.
-/
theorem prod_eq {B : Type*} [Monoid B] (f : ℂ → B) (w : List ℝ) :
    ((wordP w).reverse.map fun a => f a.pt).prod = ((LE.plus w).reverse.map fun x => f ((x.2 : ℝ) : ℂ)).prod := by
  have e1 : (wordP w).reverse.map (fun a => f a.pt) = (w.map fun y => f ((y : ℝ) : ℂ)).reverse := by
    rw [List.map_reverse]
    congr 1
    have := congrArg (List.map f) (MAx2.plusWord_points w)
    simpa [List.map_map, Function.comp_def] using this
  have e2 : (LE.plus w).reverse.map (fun x => f ((x.2 : ℝ) : ℂ)) = (w.map fun y => f ((y : ℝ) : ℂ)).reverse := by
    rw [List.map_reverse]
    simp [LE.plus, List.map_map, Function.comp_def]
  rw [e1, e2]

end Formalism.FourierDecayAlt.P.MAx3.F

