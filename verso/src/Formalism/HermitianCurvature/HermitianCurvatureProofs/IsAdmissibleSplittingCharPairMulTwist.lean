Take `⟨-, -, -, -, -, hzs, hzbs, -⟩` from `Q.star_all hL hLaw`. Establish `c1` using `cl_comm L (memDri L) (memζi L)`. Establish `c2` using `cl_comm L (memDrbi L) (memζbi L)`. Establish `c3` using `cl_comm L (memζb L) (memDrb L)`. Establish `c4` using `cl_comm L (memζ L) (memDr L)`.

Use `⟨h1, h2, ?_, ?_, ?_, ?_⟩` and prove the remaining obligations. Unfold `LevelData.Di LevelData.Dbi`. Rewrite using `[star_mul, hDri, h1, c2]`. Unfold `LevelData.Di LevelData.Dbi`. Rewrite using `[star_mul, hDrbi, h2, c1]`.

Unfold `LevelData.D LevelData.Db`. Rewrite using `[star_mul, hzs, hDr, c3]`. Unfold `LevelData.D LevelData.Db`. Rewrite using `[star_mul, hzbs, hDrb, c4]`.
-/
theorem star_more : star L.ζi = L.ζbi ∧ star L.ζbi = L.ζi ∧ star L.Di = L.Dbi ∧ star L.Dbi = L.Di ∧
    star L.D = L.Db ∧ star L.Db = L.D := by
  have : Fact ((DQ P).Laws P.TT) := ⟨hLaw⟩
  have hs := Formalism.FourierDecayAlt.P.MAx1.starGens P (DQ P)
  have hL' := hL
  obtain ⟨-, -, -, -, -, -, hz, hzi, hzb, hzbi, -⟩ := hL'
  have h1 : star L.ζi = L.ζbi := by rw [hzi, hzbi]; exact hs.2.2.1
  have h2 : star L.ζbi = L.ζi := by rw [← h1, star_star]
  have hDr := Q.star_Dr hL hLaw
  have hDri := H.star_Dri hL hLaw
  have hDrb : star L.Drb = L.Dr := by rw [← hDr, star_star]
  have hDrbi : star L.Drbi = L.Dri := by rw [← hDri, star_star]
  obtain ⟨-, -, -, -, -, hzs, hzbs, -⟩ := Q.star_all hL hLaw
  have c1 := cl_comm L (memDri L) (memζi L)
  have c2 := cl_comm L (memDrbi L) (memζbi L)
  have c3 := cl_comm L (memζb L) (memDrb L)
  have c4 := cl_comm L (memζ L) (memDr L)
  refine ⟨h1, h2, ?_, ?_, ?_, ?_⟩
  · unfold LevelData.Di LevelData.Dbi; rw [star_mul, hDri, h1, c2]
  · unfold LevelData.Di LevelData.Dbi; rw [star_mul, hDrbi, h2, c1]
  · unfold LevelData.D LevelData.Db; rw [star_mul, hzs, hDr, c3]
  · unfold LevelData.D LevelData.Db; rw [star_mul, hzbs, hDrb, c4]

/- English proof (translation)
Take `⟨h1, h2, h3, h4, h5, h6⟩` from `star_more hL hLaw`. Establish `gen : ∀ {x}, x ∈ bddSet P L → x ∈ SB L` using `fun h => Submonoid.subset_closure h`. Proceed by induction on `hb using Submonoid.closure_induction with`. Consider the case `one => simp`. Consider the case `mul a c _ _ ha hc => rw [star_mul]`.

Conclude with `Submonoid.mul_mem _ hc ha`. Consider the case `mem a ha`. Break down `ha with (((ha | ⟨f, rfl⟩) | ⟨i, hi, rfl⟩) | ⟨i, hi, rfl⟩)` into its components or cases. Simplify using `only [Set.mem_insert_iff, Set.mem_singleton_iff] at ha`. Break down `ha with rfl | rfl | rfl | rfl` into its components or cases.

Rewrite using `[h1]; exact gen (Or.inl (Or.inl (Or.inl (by simp))))`. Rewrite using `[h2]; exact gen (Or.inl (Or.inl (Or.inl (by simp))))`. Rewrite using `[star_mul, h4, h5]`. Rewrite using `[show L.Di * L.Db = L.Db * L.Di from cl_comm L (memDi L) (memDb L)]`. Conclude with `gen (Or.inl (Or.inl (Or.inl (by simp))))`.

Rewrite using `[star_mul, h3, h6]`. Rewrite using `[show L.Dbi * L.D = L.D * L.Dbi from cl_comm L (memDbi L) (memD L)]`. Conclude with `gen (Or.inl (Or.inl (Or.inl (by simp))))`. Establish `: star (kap P (DQ P) f) = kap P (DQ P) (fun π => starRingEnd ℂ (f π))`. Establish `e : ∀ g : M.Ty P → ℂ, kap P (DQ P) g = Matrix.diagonal fun π => algebraMap ℂ (DQ P).Pr (g π)` using `fun g => rfl`.

Rewrite using `[e, e]`. Use extensionality with `π π'`. Rewrite using `[Matrix.star_apply, Matrix.diagonal_apply, Matrix.diagonal_apply]`. Distinguish the cases in `h : π = π'`. Substitute `h` using the available equality.

Simplify using `[← algebraMap_star_comm]`. Simplify using `[h, Ne.symm h]`. Rewrite using `[this]`. Conclude with `gen (Or.inl (Or.inl (Or.inr ⟨_, rfl⟩)))`. Conclude with `gen (Or.inr ⟨i, hi, rfl⟩)`.

Use `show star (star (L.Drb * L.Dri * SS P (DQ P) i)) ∈ SB L`. Rewrite using `[star_star]`. Conclude with `gen (Or.inl (Or.inr ⟨i, hi, rfl⟩))`.
-/
theorem star_SB {b : A P (DQ P)} (hb : b ∈ SB L) : star b ∈ SB L := by
  obtain ⟨h1, h2, h3, h4, h5, h6⟩ := star_more hL hLaw
  have gen : ∀ {x}, x ∈ bddSet P L → x ∈ SB L := fun h => Submonoid.subset_closure h
  induction hb using Submonoid.closure_induction with
  | one => simp
  | mul a c _ _ ha hc => rw [star_mul]; exact Submonoid.mul_mem _ hc ha
  | mem a ha =>
    rcases ha with (((ha | ⟨f, rfl⟩) | ⟨i, hi, rfl⟩) | ⟨i, hi, rfl⟩)
    · simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at ha
      rcases ha with rfl | rfl | rfl | rfl
      · rw [h1]; exact gen (Or.inl (Or.inl (Or.inl (by simp))))
      · rw [h2]; exact gen (Or.inl (Or.inl (Or.inl (by simp))))
      · rw [star_mul, h4, h5]
        rw [show L.Di * L.Db = L.Db * L.Di from cl_comm L (memDi L) (memDb L)]
        exact gen (Or.inl (Or.inl (Or.inl (by simp))))
      · rw [star_mul, h3, h6]
        rw [show L.Dbi * L.D = L.D * L.Dbi from cl_comm L (memDbi L) (memD L)]
        exact gen (Or.inl (Or.inl (Or.inl (by simp))))
    · have : star (kap P (DQ P) f) = kap P (DQ P) (fun π => starRingEnd ℂ (f π)) := by
        have e : ∀ g : M.Ty P → ℂ, kap P (DQ P) g = Matrix.diagonal fun π => algebraMap ℂ (DQ P).Pr (g π) :=
          fun g => rfl
        rw [e, e]
        ext π π'
        rw [Matrix.star_apply, Matrix.diagonal_apply, Matrix.diagonal_apply]
        by_cases h : π = π'
        · subst h; simp [← algebraMap_star_comm]
        · simp [h, Ne.symm h]
      rw [this]; exact gen (Or.inl (Or.inl (Or.inr ⟨_, rfl⟩)))
    · exact gen (Or.inr ⟨i, hi, rfl⟩)
    · show star (star (L.Drb * L.Dri * SS P (DQ P) i)) ∈ SB L
      rw [star_star]; exact gen (Or.inl (Or.inr ⟨i, hi, rfl⟩))

end

