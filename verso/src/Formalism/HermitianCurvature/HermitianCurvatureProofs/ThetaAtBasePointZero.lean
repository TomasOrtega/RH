theorem exp_base_point_eq (hTT : 0 ≤ TT) : Complex.exp (x0 TT) = ((TT + 1 : ℝ) : ℂ) := by
  rw [x0, ← Complex.ofReal_exp, Real.exp_log (by linarith)]

/- English proof (translation)
