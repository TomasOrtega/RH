theorem tele_right (T D : ℝ) (hD : 0 < D) (A B : ℕ → ℝ) : ∀ n : ℕ,
    (∀ j < n, B j ≤ A j) → (∀ j, j + 1 < n → A j ≤ B (j + 1)) → (∀ j < n, D ≤ B j - T) →
