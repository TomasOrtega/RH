/- English proof (translation)
Introduce `hO R₀ R₁ _ _ _ q hq A _ g hab hsm c h₁ h₂`. Take `⟨B, hB, pr, pr', habB, hsmB, hp, hp', -, -, -, hl, hr⟩` from `GlobalTheory.T.exists_abelianScheme_baseChange_and_square R₀ R₁ A g hab hsm`. Use `letI : GrpObj B := hB`. Take `⟨e, he⟩` from `GlobalTheory.T.h1_structure_base_change_extension R₀ R₁ q hq`. Use `set c₁ := (e _ _ _ _ _ hp').symm c with hc₁`.

Establish `hc : e _ _ _ _ _ hp' c₁ = c` using `by simp [hc₁]`. Establish `hl' : IsPullO (overW (lift (𝟙 B) 1)) c₁ 0`. Use `he _ _ _ _ _ hp' _ _ _ _ _ hp _ _ (overW (lift (𝟙 A) 1)) (overW (lift (𝟙 B) 1)) hl c₁ 0 ?_` and prove the remaining obligations. Rewrite using `[hc, map_zero]`. Conclude with `h₁`.

Establish `hr' : IsPullO (overW (lift 1 (𝟙 B))) c₁ 0`. Use `he _ _ _ _ _ hp' _ _ _ _ _ hp _ _ (overW (lift 1 (𝟙 A))) (overW (lift 1 (𝟙 B))) hr c₁ 0 ?_` and prove the remaining obligations. Rewrite using `[hc, map_zero]`. Conclude with `h₂`. Establish `h0 : c₁ = 0` using `hO R₁ B g habB hsmB c₁ hl' hr'`.

Rewrite using `[← hc, h0, map_zero]`.
-/
theorem axesE1_of_axesO1 : AxesVanishingStructureSheafDegOne → AxesVanishingExtendedDegOne := by
  intro hO R₀ R₁ _ _ _ q hq A _ g hab hsm c h₁ h₂
  obtain ⟨B, hB, pr, pr', habB, hsmB, hp, hp', -, -, -, hl, hr⟩ :=
    GlobalTheory.T.exists_abelianScheme_baseChange_and_square R₀ R₁ A g hab hsm
  letI : GrpObj B := hB
  obtain ⟨e, he⟩ := GlobalTheory.T.h1_structure_base_change_extension R₀ R₁ q hq
  set c₁ := (e _ _ _ _ _ hp').symm c with hc₁
  have hc : e _ _ _ _ _ hp' c₁ = c := by simp [hc₁]
  have hl' : IsPullO (overW (lift (𝟙 B) 1)) c₁ 0 := by
    refine he _ _ _ _ _ hp' _ _ _ _ _ hp _ _ (overW (lift (𝟙 A) 1)) (overW (lift (𝟙 B) 1)) hl c₁ 0 ?_
    rw [hc, map_zero]; exact h₁
  have hr' : IsPullO (overW (lift 1 (𝟙 B))) c₁ 0 := by
    refine he _ _ _ _ _ hp' _ _ _ _ _ hp _ _ (overW (lift 1 (𝟙 A))) (overW (lift 1 (𝟙 B))) hr c₁ 0 ?_
    rw [hc, map_zero]; exact h₂
  have h0 : c₁ = 0 := hO R₁ B g habB hsmB c₁ hl' hr'
  rw [← hc, h0, map_zero]

end GlobalTheory.Obs
