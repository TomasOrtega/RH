variable (P : M.Par)

/- English proof (translation)
Use function extensionality and compare the values at `π`. Use `show ∑ π', ((0 : Matrix (M.Ty P) (M.Ty P) (DQ P).Pr) π π').1 (j π') = 0`. Conclude with `Finset.sum_eq_zero fun π' _ => rfl`.
-/
theorem actA_zero (j : M.Ty P → SmQ P.r P.TT) : actA P (0 : A P (DQ P)) j = 0 := by
  funext π
  show ∑ π', ((0 : Matrix (M.Ty P) (M.Ty P) (DQ P).Pr) π π').1 (j π') = 0
  exact Finset.sum_eq_zero fun π' _ => rfl

/- English proof (translation)
Use function extensionality and compare the values at `π`. Use `show ∑ π', ((a + b : Matrix (M.Ty P) (M.Ty P) (DQ P).Pr) π π').1 (j π') = ∑ π', (a π π').1 (j π') + ∑ π', (b π π').1 (j π')`. Rewrite using `[← Finset.sum_add_distrib]`. Both sides reduce to the same expression.
-/
theorem actA_add (a b : A P (DQ P)) (j : M.Ty P → SmQ P.r P.TT) : actA P (a + b) j = actA P a j + actA P b j := by
  funext π
  show ∑ π', ((a + b : Matrix (M.Ty P) (M.Ty P) (DQ P).Pr) π π').1 (j π') =
    ∑ π', (a π π').1 (j π') + ∑ π', (b π π').1 (j π')
  rw [← Finset.sum_add_distrib]
  rfl

/- English proof (translation)
Proceed by induction on `s using Finset.induction_on with`. Consider the case `empty => simp [actA_zero]`. Consider the case `insert a s ha ih => rw [Finset.sum_insert ha, Finset.sum_insert ha, actA_add, ih]`.
-/
theorem actA_sum {ι : Type} (s : Finset ι) (f : ι → A P (DQ P)) (j : M.Ty P → SmQ P.r P.TT) :
    actA P (∑ i ∈ s, f i) j = ∑ i ∈ s, actA P (f i) j := by
  classical
  induction s using Finset.induction_on with
  | empty => simp [actA_zero]
  | insert a s ha ih => rw [Finset.sum_insert ha, Finset.sum_insert ha, actA_add, ih]

/- English proof (translation)
Establish `h1 : ∀ e' π', toSm P (fun q' => U q' (iotaOf P N e' π')) = actA P (g e') j π'`. Introduce `e' π'`. Establish `: (fun q' => U q' (iotaOf P N e' π')) = evQ P (actA P (g e') j π')` using `funext fun q' => by`. Rewrite using `[hU, ixOf_iotaOf]`. Rewrite using `[this]`.

Conclude with `MAx2.Jet.toSm_ev P _`. Unfold `wordModuleApply`. Simplify using `only [h1]`. Rewrite using `[actA_sum, Finset.sum_apply, MAx2.Jet.evQ_sum]`. Use `Finset.sum_congr rfl fun e' _ => ?_` and prove the remaining obligations.

Rewrite using `[actA_mul]`. Use `show _ = evQ P (∑ π', ((Mx (ixOf P N i).1 e') (ixOf P N i).2 π').1 (actA P (g e') j π')) q`. Conclude with `(MAx2.Jet.evQ_sum P _ _ q).symm`.
-/
theorem apply_matrix_vector {N : ℕ} (Mx : SlopeTestRemainingChoices (Fin N) (A P (DQ P))) (g : Ix (Fin N) → A P (DQ P)) (j : M.Ty P → SmQ P.r P.TT)
    (U : Qp P.r P.TT → Iota P N → ℂ)
    (hU : ∀ i q, U q i = evQ P (actA P (g (ixOf P N i).1) j (ixOf P N i).2) q) (q : Qp P.r P.TT) (i : Iota P N) :
    wordModuleApply P Mx U q i = evQ P (actA P (∑ e', Mx (ixOf P N i).1 e' * g e') j (ixOf P N i).2) q := by
  have h1 : ∀ e' π', toSm P (fun q' => U q' (iotaOf P N e' π')) = actA P (g e') j π' := by
    intro e' π'
    have : (fun q' => U q' (iotaOf P N e' π')) = evQ P (actA P (g e') j π') := funext fun q' => by
      rw [hU, ixOf_iotaOf]
    rw [this]
    exact MAx2.Jet.toSm_ev P _
  unfold wordModuleApply
  simp only [h1]
  rw [actA_sum, Finset.sum_apply, MAx2.Jet.evQ_sum]
  refine Finset.sum_congr rfl fun e' _ => ?_
  rw [actA_mul]
  show _ = evQ P (∑ π', ((Mx (ixOf P N i).1 e') (ixOf P N i).2 π').1 (actA P (g e') j π')) q
  exact (MAx2.Jet.evQ_sum P _ _ q).symm

end Act2

