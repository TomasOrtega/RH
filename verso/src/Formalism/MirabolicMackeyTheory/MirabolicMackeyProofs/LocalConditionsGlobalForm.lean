def OnExport2 : Prop :=
  ∀ (K : Type) [Field K] [NumberField K] [StarRing K] (D : ℕ), 0 < D →
  ∀ (Tup : Type) (μ : HeightOneSpectrum (𝓞 K) → Tup) (J : Type) [Fintype J] (d : J → ℕ),
    (∀ j, d j = D) →
  ∀ (M : ∀ j, Submodule (𝓞 K) (Fin (d j) → K))
    (T : ∀ j, Tup → Submodule (𝓞 K) (Fin (d j) → K))
    (θ : ∀ j, Tup → Matrix (Fin (d j)) (Fin (d j)) K)
    (S : Finset (HeightOneSpectrum (𝓞 K)))
    (e0 r0 ε0 F0 errl Jx : HeightOneSpectrum (𝓞 K) → J → ℝ)
    (vU0 gq : HeightOneSpectrum (𝓞 K) → ℝ) (dK EA Rb EJ : J → ℝ) (δq E3 : ℝ), 0 < δq →
    (∀ w ∈ S, ∀ j, (idx w (M j) (matLat (θ j (μ w)) (T j (μ w))) : ℝ) ≤
      (ramw w : ℝ) * ((e0 w j + vU0 w) * (d j : ℝ) + (r0 w j + dK j * vU0 w) / δq + ε0 w j)) →
    (∀ w ∈ S, ∀ j, (idx (conjPl w) (M j) (matLat (θ j (μ w)) (T j (μ w))) : ℝ) ≤
      (ramw (conjPl w) : ℝ) * ((e0 (conjPl w) j + vU0 (conjPl w)) * (d j : ℝ) +
        (r0 (conjPl w) j + dK j * vU0 (conjPl w)) / δq + ε0 (conjPl w) j)) →
    (∀ j, dK j / δq ≤ 3 * (D : ℝ)) →
    (∀ w ∈ S, 0 ≤ vU0 w ∧ vU0 (conjPl w) = vU0 w ∧ 4 * vU0 w ≤ gq w) →
    (∀ w ∈ S, ∀ j, e0 w j + e0 (conjPl w) j - 2 * F0 w j + 2 * gq w ≤ errl w j) →
    (∀ w ∈ S, ∑ j, (ε0 w j + ε0 (conjPl w) j) ≤ 2 / (plc w : ℝ) ^ 2) →
    (∀ j, ∑ w ∈ S, lw w * ((ramw w : ℝ) * errl w j) ≤ EA j) →
    (∀ j, ∀ S' : Finset (HeightOneSpectrum (𝓞 K)), ∑ w ∈ S', lw w * ((ramw w : ℝ) * r0 w j) ≤ Rb j) →
    (∀ j, ∑ w ∈ S, lw w * Jx w j ≤ EJ j) →
    ∑ w ∈ S, lw w * ((ramw w : ℝ) * (2 / (plc w : ℝ) ^ 2)) ≤ E3 →
      (∀ w ∈ S, ∑ j, ((idx w (M j) (matLat (θ j (μ w)) (T j (μ w))) : ℝ) +
          (idx (conjPl w) (M j) (matLat (θ j (μ w)) (T j (μ w))) : ℝ)) ≤
        (∑ j, (2 * ((ramw w : ℝ) * F0 w j) +
            (ramw w : ℝ) * (errl w j + (r0 w j + r0 (conjPl w) j) / (δq * (D : ℝ)))) +
          2 / ellw w ^ 2) * D) ∧
      (∀ j, ∑ w ∈ S, lw w * ((ramw w : ℝ) * (errl w j + (r0 w j + r0 (conjPl w) j) / (δq * (D : ℝ))) +
          Jx w j) ≤ EA j + 2 * Rb j / (δq * (D : ℝ)) + EJ j) ∧
      ∑ w ∈ S, lw w * (2 / ellw w ^ 2) ≤ E3

/- English proof (translation)
Introduce `K _ _ _ D hD Tup μ J _ d hd M T θ S e0 r0 ε0 F0 errl Jx vU0 gq dK EA Rb EJ δq E3 hδ h1 h2 hsh hv hdep htw hEA hRb hEJ hE3`. Establish `hDr : (0 : ℝ) < D` using `by exact_mod_cast hD`. Establish `hD1 : (1 : ℝ) ≤ D` using `by exact_mod_cast hD`. Use `⟨?_, ?_, ?_⟩` and prove the remaining obligations. Introduce `w hw`.

Take `⟨hp, hr1, hpc, hrc, hell⟩` from `hR K w`. Establish `hρ : (1 : ℝ) ≤ (ramw w : ℝ)` using `by exact_mod_cast hr1`. Take `⟨hv0, hvc, hvg⟩` from `hv w hw`. Establish `hl : (0 : ℝ) < (plc w : ℝ) ^ 2`. Establish `: (0 : ℝ) < (plc w : ℝ)` using `by exact_mod_cast hp.pos`.

Check the signs of the components of the expression. Establish `key : ∀ j, ((idx w (M j) (matLat (θ j (μ w)) (T j (μ w))) : ℝ) + (idx (conjPl w) (M j) (matLat (θ j (μ w)) (T j (μ w))) : ℝ)) ≤ (2 * ((ramw w : ℝ) * F0 w j) + (ramw w : ℝ) * (errl w j + (r0 w j + r0 (conjPl w) j) / (δq * (D : ℝ)))) * D + (ramw w : ℝ) * (ε0 w j + ε0 (conjPl w) j)`. Introduce `j`. Establish `a1` using `h1 w hw j`. Establish `a2` using `h2 w hw j`.

Rewrite `a2` using `[hrc, hvc]`. Establish `hdj : (d j : ℝ) = D` using `by exact_mod_cast hd j`. Rewrite `a1`, `a2` using `[hdj]`. Establish `a3` using `hdep w hw j`. Establish `a4` using `hsh j`.

Establish `e1 : (r0 w j + dK j * vU0 w) / δq = r0 w j / δq + dK j / δq * vU0 w`. Clear the denominators using the available nonvanishing facts. Establish `e2 : (r0 (conjPl w) j + dK j * vU0 w) / δq = r0 (conjPl w) j / δq + dK j / δq * vU0 w`. Clear the denominators using the available nonvanishing facts. Establish `e3 : (r0 w j + r0 (conjPl w) j) / (δq * (D : ℝ)) * D = r0 w j / δq + r0 (conjPl w) j / δq`.

Clear the denominators using the available nonvanishing facts. Rewrite `a1` using `[e1]`. Rewrite `a2` using `[e2]`. Establish `b1 : dK j / δq * vU0 w ≤ 3 * (D : ℝ) * vU0 w` using `mul_le_mul_of_nonneg_right a4 hv0`. Establish `b2 : (e0 w j + e0 (conjPl w) j + 8 * vU0 w) * (D : ℝ) ≤ (2 * F0 w j + errl w j) * D` using `mul_le_mul_of_nonneg_right (by linarith) hDr.le`.

Establish `b3 : ((e0 w j + vU0 w) * (D : ℝ) + (r0 w j / δq + dK j / δq * vU0 w) + ε0 w j) + ((e0 (conjPl w) j + vU0 w) * (D : ℝ) + (r0 (conjPl w) j / δq + dK j / δq * vU0 w) + ε0 (conjPl w) j) ≤ (2 * F0 w j + errl w j) * D + (r0 w j + r0 (conjPl w) j) / (δq * (D : ℝ)) * D + (ε0 w j + ε0 (co …`. Rewrite using `[e3]`. Use the polynomial consequences of the given equalities and inequalities. Establish `b4` using `mul_le_mul_of_nonneg_left b3 (by linarith : (0 : ℝ) ≤ (ramw w : ℝ))`. Combine the equalities or inequalities in the displayed calculation.

Combine the equalities or inequalities in the displayed calculation. Rewrite using `[Finset.sum_add_distrib, Finset.sum_mul, Finset.mul_sum]`. Use `_ ≤ _ := by`. Rewrite using `[hell, add_mul]`. Establish `c1` using `mul_le_mul_of_nonneg_left (htw w hw) (by linarith : (0 : ℝ) ≤ (ramw w : ℝ))`.

Establish `c2 : (ramw w : ℝ) * (2 / (plc w : ℝ) ^ 2) ≤ (ramw w : ℝ) * (2 / (plc w : ℝ) ^ 2) * D`. Establish `c3 : (0 : ℝ) ≤ (ramw w : ℝ) * (2 / (plc w : ℝ) ^ 2)` using `by positivity`. Use the polynomial consequences of the given equalities and inequalities. Combine the linear equalities and inequalities to obtain the conclusion. Introduce `j`.

Establish `hc : ∑ w ∈ S, lw w * ((ramw w : ℝ) * r0 (conjPl w) j) ≤ Rb j`. Establish `hinj : Set.InjOn (conjPl (K` using `K)) S := by`. Introduce `a _ b _ hab`. Use `congrArg conjPl hab` as an intermediate fact. Rewrite `this` using `[(valuation_basic_properties K a).2.2.2.1, (valuation_basic_properties K b).2.2.2.1]`. Then use the resulting hypothesis.

Use `hRb j (S.image conjPl)` as an intermediate fact. Rewrite `this` using `[Finset.sum_image hinj]`. Use `le_trans (le_of_eq ?_) this` and prove the remaining obligations. Use `Finset.sum_congr rfl (fun w _ => ?_)` and prove the remaining obligations. Rewrite using `[(valuation_basic_properties K w).2.2.1, (hR K w).2.2.2.1]`.

Establish `hpos : (0 : ℝ) < δq * D` using `mul_pos hδ hDr`. Establish `e : ∑ w ∈ S, lw w * ((ramw w : ℝ) * (errl w j + (r0 w j + r0 (conjPl w) j) / (δq * (D : ℝ))) + Jx w j) = ∑ w ∈ S, lw w * ((ramw w : ℝ) * errl w j) + (∑ w ∈ S, lw w * ((ramw w : ℝ) * r0 w j) + ∑ w ∈ S, lw w * ((ramw w : ℝ) * r0 (conjPl w) j)) / (δq * (D : ℝ)) + ∑ w ∈ S, lw w * Jx …`. Rewrite using `[← Finset.sum_add_distrib, Finset.sum_div, ← Finset.sum_add_distrib, ← Finset.sum_add_distrib]`. Use `Finset.sum_congr rfl (fun w _ => ?_)` and prove the remaining obligations. Expand and normalize the polynomial expressions, which then agree.

