  intro n h1 h2 h3
  have key : ∀ m, m ≤ n → 0 < m →
      ∑ j ∈ range m, (1 / (B j - T) - 1 / (A j - T)) ≤ 1 / (B 0 - T) - 1 / (A (m - 1) - T) ∧
