theorem bf_eq (A : Matrix ι ι ℝ) (x y : ι → ℝ) : bf A x y = x ⬝ᵥ A *ᵥ y := by
  simp only [bf, dotProduct, Matrix.mulVec, Finset.mul_sum]
  refine Finset.sum_congr rfl fun i _ => Finset.sum_congr rfl fun j _ => by ring

