theorem ldq_rpow (s : ℝ) (q : ℕ) (x : ℝ) (hx : 0 < x) : LE.ld q (fun x : ℝ => x ^ s) x = s ^ q * x ^ s := by
  unfold LE.ld
  have h : (fun u : ℝ => (fun x : ℝ => x ^ s) (Real.exp u)) = fun u => Real.exp (u * s) :=
