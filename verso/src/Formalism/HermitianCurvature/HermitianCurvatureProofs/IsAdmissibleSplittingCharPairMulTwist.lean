theorem phR_ne (v : List (Letter ℂ S)) (e : Ix S) (Y : ℝ) (h : ∀ a ∈ v, Y - a.pt.re ≠ 0 ∧ Y - a.pt.re - 1 ≠ 0) :
    MAx3.R.phR v e Y ≠ 0 := by
  induction v with
