/- English proof (translation)
Proceed by induction on `hy using Subring.closure_induction with`. Consider the case `mem x hx => exact hz x hx`. Consider the case `zero => simp`. Consider the case `one => simp`. Consider the case `add x y _ _ h1 h2 => rw [mul_add, add_mul, h1, h2]`.

Consider the case `neg x _ h => rw [mul_neg, neg_mul, h]`. Consider the case `mul x y _ _ h1 h2 => rw [← mul_assoc, h1, mul_assoc, h2, mul_assoc]`.
-/
theorem comm_cl {z : A} (hz : ∀ x ∈ FS L, z * x = x * z) {y : A} (hy : y ∈ Subring.closure (FS L)) :
    z * y = y * z := by
  induction hy using Subring.closure_induction with
  | mem x hx => exact hz x hx
  | zero => simp
  | one => simp
  | add x y _ _ h1 h2 => rw [mul_add, add_mul, h1, h2]
  | neg x _ h => rw [mul_neg, neg_mul, h]
  | mul x y _ _ h1 h2 => rw [← mul_assoc, h1, mul_assoc, h2, mul_assoc]

/- English proof (translation)
The claim follows from `comm_cl L (fun w hw => (comm_cl L (fun v hv => FS_comm L w hw v hv) hx).symm) hy`.
-/
theorem cl_comm {x y : A} (hx : x ∈ Subring.closure (FS L)) (hy : y ∈ Subring.closure (FS L)) : x * y = y * x :=
  comm_cl L (fun w hw => (comm_cl L (fun v hv => FS_comm L w hw v hv) hx).symm) hy

/- English proof (translation)
Unfold `LevelData.D LevelData.Di`. Rewrite using `[mul_assoc, ← mul_assoc L.ζ, L.ζ_ζi, one_mul, Dr_Dri]`.
-/
theorem D_Di : L.D * L.Di = 1 := by
  unfold LevelData.D LevelData.Di
  rw [mul_assoc, ← mul_assoc L.ζ, L.ζ_ζi, one_mul, Dr_Dri]
/- English proof (translation)
Unfold `LevelData.D LevelData.Di`. Rewrite using `[mul_assoc, ← mul_assoc L.Dri, Dri_Dr, one_mul, L.ζi_ζ]`.
-/
theorem Di_D : L.Di * L.D = 1 := by
  unfold LevelData.D LevelData.Di
  rw [mul_assoc, ← mul_assoc L.Dri, Dri_Dr, one_mul, L.ζi_ζ]
/- English proof (translation)
Unfold `LevelData.Dbi`. Rewrite using `[← mul_assoc, cl_comm L (memDrb L) (memF L (m_ζbi L)), mul_assoc, Drb_Drbi, mul_one]`.
-/
theorem Drb_Dbi : L.Drb * L.Dbi = L.ζbi := by
  unfold LevelData.Dbi
  rw [← mul_assoc, cl_comm L (memDrb L) (memF L (m_ζbi L)), mul_assoc, Drb_Drbi, mul_one]

def la (y : ℂ) : A := L.Di * L.Ahat y

def lb (y : ℂ) : A := L.Dbi * L.R0 y

/- English proof (translation)
Establish `hT : L.Tprod y ∈ matC Z` using `Subalgebra.list_prod_mem _ fun x hx => by`. Take `⟨m, rfl⟩` from `List.mem_ofFn.1 (List.mem_reverse.1 hx)`. Conclude with `m22C Z _ _ _ _ (add_mem (Z.algebraMap_mem _) (hp m)) (neg_mem (hfn _ (m_c L m))) (hfn _ (m_ci L m)) Z.zero_mem`. Establish `hA : L.Ar y ∈ Z` using `hT 0 0`. Establish `hB : L.Br y ∈ Z` using `hT 1 0`.

Establish `prodZ : ∀ f : Fin r → A, (∀ i, f i ∈ Z) → (List.ofFn f).prod ∈ Z` using `fun f hf => Subalgebra.list_prod_mem _ fun x hx => by obtain ⟨i, rfl⟩ := List.mem_ofFn.1 hx; exact hf i`. Establish `hDr : L.Dr ∈ Z` using `prodZ _ fun i => hfn _ (m_c L i)`. Establish `hDri : L.Dri ∈ Z` using `prodZ _ fun i => hfn _ (m_ci L i)`. Establish `hDrb : L.Drb ∈ Z` using `prodZ _ fun i => hfn _ (m_cb L i)`. Establish `hDrbi : L.Drbi ∈ Z` using `prodZ _ fun i => hfn _ (m_cbi L i)`.

Establish `hAh : L.Ahat y ∈ Z` using `mul_mem hDr hA`. Establish `hl0 : L.l0 y ∈ Z` using `sub_mem (neg_mem hn) (mul_mem (Z.algebraMap_mem _) (mul_mem (hfn _ (m_ζb L)) (hfn _ (m_GGi L))))`. Establish `hR : L.R0 y ∈ Z` using `mul_mem (mul_mem hDrb (hfn _ (m_GG L))) (add_mem (mul_mem hl0 hA) hB)`. Use `⟨hAh, hR, mul_mem (mul_mem (hfn _ (m_ζi L)) hDri) hAh, mul_mem (mul_mem (hfn _ (m_ζbi L)) hDrbi) hR⟩` and prove the remaining obligations.
-/
theorem letters_mem (Z : Subalgebra ℂ A) (hp : ∀ m, L.p m ∈ Z) (hfn : ∀ y ∈ L.fns, y ∈ Z) (hn : L.nab ∈ Z)
    (y : ℂ) : L.Ahat y ∈ Z ∧ L.R0 y ∈ Z ∧ la L y ∈ Z ∧ lb L y ∈ Z := by
  have hT : L.Tprod y ∈ matC Z := Subalgebra.list_prod_mem _ fun x hx => by
    obtain ⟨m, rfl⟩ := List.mem_ofFn.1 (List.mem_reverse.1 hx)
    exact m22C Z _ _ _ _ (add_mem (Z.algebraMap_mem _) (hp m)) (neg_mem (hfn _ (m_c L m)))
      (hfn _ (m_ci L m)) Z.zero_mem
  have hA : L.Ar y ∈ Z := hT 0 0
  have hB : L.Br y ∈ Z := hT 1 0
  have prodZ : ∀ f : Fin r → A, (∀ i, f i ∈ Z) → (List.ofFn f).prod ∈ Z := fun f hf =>
    Subalgebra.list_prod_mem _ fun x hx => by obtain ⟨i, rfl⟩ := List.mem_ofFn.1 hx; exact hf i
  have hDr : L.Dr ∈ Z := prodZ _ fun i => hfn _ (m_c L i)
  have hDri : L.Dri ∈ Z := prodZ _ fun i => hfn _ (m_ci L i)
  have hDrb : L.Drb ∈ Z := prodZ _ fun i => hfn _ (m_cb L i)
  have hDrbi : L.Drbi ∈ Z := prodZ _ fun i => hfn _ (m_cbi L i)
  have hAh : L.Ahat y ∈ Z := mul_mem hDr hA
  have hl0 : L.l0 y ∈ Z := sub_mem (neg_mem hn) (mul_mem (Z.algebraMap_mem _)
    (mul_mem (hfn _ (m_ζb L)) (hfn _ (m_GGi L))))
  have hR : L.R0 y ∈ Z := mul_mem (mul_mem hDrb (hfn _ (m_GG L))) (add_mem (mul_mem hl0 hA) hB)
  refine ⟨hAh, hR, mul_mem (mul_mem (hfn _ (m_ζi L)) hDri) hAh, mul_mem (mul_mem (hfn _ (m_ζbi L)) hDrbi) hR⟩

/- English proof (translation)
Establish `mZ : ∀ x : A, x * h = h * x → x ∈ Subalgebra.centralizer ℂ ({h} : Set A)` using `fun x hx => by`. Rewrite using `[Subalgebra.mem_centralizer_iff]`. Introduce `g hg`. Rewrite using `[Set.mem_singleton_iff.1 hg]`. Conclude with `hx.symm`.

Take `⟨-, -, h1, h2⟩` from `letters_mem L (Subalgebra.centralizer ℂ ({h} : Set A)) (fun m => mZ _ (hp m)) (fun x hx => mZ _ (hfn x hx)) (mZ _ hn) y`. Rewrite `h1`, `h2` using `[Subalgebra.mem_centralizer_iff]`. Conclude with `⟨(h1 h rfl).symm, (h2 h rfl).symm⟩`.
-/
theorem commH (h : A) (hp : ∀ m, L.p m * h = h * L.p m) (hfn : ∀ y ∈ L.fns, y * h = h * y)
    (hn : L.nab * h = h * L.nab) (y : ℂ) :
    la L y * h = h * la L y ∧ lb L y * h = h * lb L y := by
  have mZ : ∀ x : A, x * h = h * x → x ∈ Subalgebra.centralizer ℂ ({h} : Set A) := fun x hx => by
    rw [Subalgebra.mem_centralizer_iff]
    intro g hg
    rw [Set.mem_singleton_iff.1 hg]; exact hx.symm
  obtain ⟨-, -, h1, h2⟩ := letters_mem L (Subalgebra.centralizer ℂ ({h} : Set A)) (fun m => mZ _ (hp m))
    (fun x hx => mZ _ (hfn x hx)) (mZ _ hn) y
  rw [Subalgebra.mem_centralizer_iff] at h1 h2
  exact ⟨(h1 h rfl).symm, (h2 h rfl).symm⟩

end

end Formalism.FourierDecayAlt.P.MAx3.NF

end S_NF_NF1

section S_NF_NF2

set_option linter.unusedVariables false

namespace Formalism.FourierDecayAlt.P.MAx3.NF

open Formalism.FourierDecayAlt.R Formalism.FourierDecayAlt.R.LevelData Formalism.FourierDecayAlt.P.RuleGD

noncomputable section

variable {A : Type} [Ring A] [Algebra ℂ A] {r : ℕ} (L : LevelData A r)

open scoped IsMulCommutative in
instance instCF : CommRing (Subring.closure (FS L)) :=
  have := Subring.isMulCommutative_closure (FS_comm L); inferInstance

/- English proof (translation)
Establish `h` using `commA L L.Drbi L.Drb (Drbi_Drb L) (Drb_Drbi L) (fun m => (comm_prod L.cbi (L.p m) (fun i => L.p_cbi m i))) (fun y hy => cl_comm L (memF L hy) (memDrbi L)) (comm_prod L.cbi L.nab (fun i => L.nab_cbi i)) Y`. Establish `h2 : L.ζbi * L.Ahat Y = L.Ahat Y * L.ζbi ∧ L.ζbi * L.R0 Y = L.R0 Y * L.ζbi` using `commA L L.ζbi L.ζb L.ζbi_ζb L.ζb_ζbi (fun m => (L.p_ζbi m)) (fun y hy => fc L hy (m_ζbi L)) L.nab_ζbi Y`. Unfold `LevelData.Dbi`. Prove the components needed by the constructor for the conclusion. Rewrite using `[mul_assoc, h.1, ← mul_assoc, h2.1, mul_assoc]`.

Rewrite using `[mul_assoc, h.2, ← mul_assoc, h2.2, mul_assoc]`.
-/
theorem hat_Dbi (Y : ℂ) : L.Dbi * L.Ahat Y = L.Ahat Y * L.Dbi ∧ L.Dbi * L.R0 Y = L.R0 Y * L.Dbi := by
  have h := commA L L.Drbi L.Drb (Drbi_Drb L) (Drb_Drbi L)
    (fun m => (comm_prod L.cbi (L.p m) (fun i => L.p_cbi m i)))
    (fun y hy => cl_comm L (memF L hy) (memDrbi L))
    (comm_prod L.cbi L.nab (fun i => L.nab_cbi i)) Y
  have h2 : L.ζbi * L.Ahat Y = L.Ahat Y * L.ζbi ∧ L.ζbi * L.R0 Y = L.R0 Y * L.ζbi :=
    commA L L.ζbi L.ζb L.ζbi_ζb L.ζb_ζbi (fun m => (L.p_ζbi m)) (fun y hy => fc L hy (m_ζbi L))
      L.nab_ζbi Y
  unfold LevelData.Dbi
  constructor
  · rw [mul_assoc, h.1, ← mul_assoc, h2.1, mul_assoc]
  · rw [mul_assoc, h.2, ← mul_assoc, h2.2, mul_assoc]

/- English proof (translation)
Establish `h` using `(Formalism.FourierDecayAlt.P.shiftConjugation A r L Y).1`. Rewrite using `[← h, ← mul_assoc, ← mul_assoc, D_Di, one_mul]`.
-/
theorem Ahat_D (Y : ℂ) : L.Ahat Y * L.D = L.D * L.Ahat (Y + 1) := by
  have h := (Formalism.FourierDecayAlt.P.shiftConjugation A r L Y).1
  rw [← h, ← mul_assoc, ← mul_assoc, D_Di, one_mul]

/- English proof (translation)
Establish `h` using `(Formalism.FourierDecayAlt.P.shiftConjugation A r L Y).2.1`. Rewrite using `[← h, ← mul_assoc, ← mul_assoc, D_Di, one_mul]`.
-/
theorem raising_mul_D (Y : ℂ) : L.R0 Y * L.D =
    L.D * (L.R0 (Y + 1) + algebraMap ℂ A L.TT * (L.Drb * L.Di * L.Ahat (Y + 1))) := by
  have h := (Formalism.FourierDecayAlt.P.shiftConjugation A r L Y).2.1
  rw [← h, ← mul_assoc, ← mul_assoc, D_Di, one_mul]

def sn (SS : A) : A := L.Drb * L.Dri * SS

section S
variable (SS : A) (hf : ∀ x ∈ L.fns, x * SS = SS * x) (hp : ∀ l, L.p l * SS = SS * L.p l)
  (hpb : ∀ l, L.pb l * SS = SS * L.pb l) (hn : L.nab * SS = SS * L.nab - L.ζb * L.GGi * SS)
  (hns : L.nabs * SS = SS * L.nabs - L.ζ * L.GGi * SS)
include hf hp hpb hn hns

/- English proof (translation)
Use `(comm_cl L (z := SS) (fun y hy => ?_) hx).symm` and prove the remaining obligations. Break down `hy with hy | ⟨a, rfl⟩` into its components or cases. Conclude with `(hf y hy).symm`. Conclude with `(Algebra.commutes a SS).symm`.
-/
theorem SS_cl {x : A} (hx : x ∈ Subring.closure (FS L)) : x * SS = SS * x := by
  refine (comm_cl L (z := SS) (fun y hy => ?_) hx).symm
  rcases hy with hy | ⟨a, rfl⟩
  · exact (hf y hy).symm
  · exact (Algebra.commutes a SS).symm

/- English proof (translation)
Unfold `sn`. Rewrite using `[← mul_assoc, ← mul_assoc, cl_comm L hx (memDrb L), mul_assoc L.Drb, cl_comm L hx (memDri L), mul_assoc, mul_assoc, SS_cl L SS hf hp hpb hn hns hx, ← mul_assoc, ← mul_assoc]`.
-/
theorem SSn_cl {x : A} (hx : x ∈ Subring.closure (FS L)) :
    x * sn L SS = sn L SS * x := by
  unfold sn
  rw [← mul_assoc, ← mul_assoc, cl_comm L hx (memDrb L), mul_assoc L.Drb, cl_comm L hx (memDri L),
    mul_assoc, mul_assoc, SS_cl L SS hf hp hpb hn hns hx, ← mul_assoc, ← mul_assoc]

/- English proof (translation)
Establish `h` using `Formalism.FourierDecayAlt.P.intertwinerConjugation A r L SS 0 hf hp hpb hn hns (fun x _ => by simp) (fun l => by simp) (fun l => by simp) (by simp) (by simp) Y`. Conclude with `⟨h.1, h.2.1⟩`.
-/
theorem ruleSSn (Y : ℂ) : L.Ahat Y * sn L SS = sn L SS * L.Ahat (Y - 1) ∧
    L.R0 Y * sn L SS = sn L SS * L.R0 (Y - 1) := by
  have h := Formalism.FourierDecayAlt.P.intertwinerConjugation A r L SS 0 hf hp hpb hn hns (fun x _ => by simp) (fun l => by simp)
    (fun l => by simp) (by simp) (by simp) Y
  exact ⟨h.1, h.2.1⟩

/- English proof (translation)
The claim follows from `(Formalism.FourierDecayAlt.P.start_ee A r L SS).symm`.
-/
theorem S_eq : L.ζ * L.ζbi * SS = L.D * L.Dbi * sn L SS :=
  (Formalism.FourierDecayAlt.P.start_ee A r L SS).symm

omit hf hp hpb hn hns in
/- English proof (translation)
Rewrite using `[← mul_assoc, cl_comm L hu hv, mul_assoc]`.
-/
theorem sw {u v : A} (hu : u ∈ Subring.closure (FS L)) (hv : v ∈ Subring.closure (FS L)) (x : A) :
    u * (v * x) = v * (u * x) := by rw [← mul_assoc, cl_comm L hu hv, mul_assoc]

/- English proof (translation)
Rewrite using `[← mul_assoc, ← SSn_cl L SS hf hp hpb hn hns hu, mul_assoc]`.
-/
theorem shift_norm_commute_closure {u : A} (hu : u ∈ Subring.closure (FS L)) (x : A) :
    sn L SS * (u * x) = u * (sn L SS * x) := by
  rw [← mul_assoc, ← SSn_cl L SS hf hp hpb hn hns hu, mul_assoc]

omit hf hp hpb hn hns in
/- English proof (translation)
Rewrite using `[← mul_assoc, Ahat_D, mul_assoc]`.
-/
theorem hat_commute_D (y : ℂ) (x : A) : L.Ahat y * (L.D * x) = L.D * (L.Ahat (y + 1) * x) := by
  rw [← mul_assoc, Ahat_D, mul_assoc]

omit hf hp hpb hn hns in
/- English proof (translation)
Rewrite using `[← mul_assoc, raising_mul_D]`. Simplify using `only [mul_add, add_mul, mul_assoc]`.
-/
theorem raising_commute_D (y : ℂ) (x : A) : L.R0 y * (L.D * x) = L.D * (L.R0 (y + 1) * x) +
    L.D * (algebraMap ℂ A L.TT * (L.Drb * (L.Di * (L.Ahat (y + 1) * x)))) := by
  rw [← mul_assoc, raising_mul_D]; simp only [mul_add, add_mul, mul_assoc]

omit hf hp hpb hn hns in
/- English proof (translation)
Rewrite using `[← mul_assoc, Di_D, one_mul]`.
-/
theorem D_inv_mul_D (x : A) : L.Di * (L.D * x) = x := by rw [← mul_assoc, Di_D, one_mul]

omit hf hp hpb hn hns in
/- English proof (translation)
Rewrite using `[← mul_assoc, D_Di, one_mul]`.
-/
theorem D_mul_D_inv (x : A) : L.D * (L.Di * x) = x := by rw [← mul_assoc, D_Di, one_mul]

omit hf hp hpb hn hns in
/- English proof (translation)
Rewrite using `[← mul_assoc, ← (hat_Dbi L y).1, mul_assoc]`.
-/
theorem hat_commute_D_bar_inv (y : ℂ) (x : A) : L.Ahat y * (L.Dbi * x) = L.Dbi * (L.Ahat y * x) := by
  rw [← mul_assoc, ← (hat_Dbi L y).1, mul_assoc]

omit hf hp hpb hn hns in
/- English proof (translation)
Rewrite using `[← mul_assoc, ← (hat_Dbi L y).2, mul_assoc]`.
-/
theorem raising_commute_D_bar_inv (y : ℂ) (x : A) : L.R0 y * (L.Dbi * x) = L.Dbi * (L.R0 y * x) := by
  rw [← mul_assoc, ← (hat_Dbi L y).2, mul_assoc]

/- English proof (translation)
Rewrite using `[S_eq L SS hf hp hpb hn hns]`. Establish `e1` using `(ruleSSn L SS hf hp hpb hn hns (y + 1)).1`. Rewrite `e1` using `[add_sub_cancel_right]`. Unfold `la`. Simplify using `only [mul_assoc]`.

Rewrite using `[hat_commute_D, D_inv_mul_D, hat_commute_D_bar_inv, e1, shift_norm_commute_closure L SS hf hp hpb hn hns (memDi L), sw L (memDbi L) (memDi L), D_mul_D_inv]`.
-/
theorem S_la (y : ℂ) : la L y * (L.ζ * L.ζbi * SS) = (L.ζ * L.ζbi * SS) * la L y := by
  rw [S_eq L SS hf hp hpb hn hns]
  have e1 := (ruleSSn L SS hf hp hpb hn hns (y + 1)).1
  rw [add_sub_cancel_right] at e1
  unfold la
  simp only [mul_assoc]
  rw [hat_commute_D, D_inv_mul_D, hat_commute_D_bar_inv, e1, shift_norm_commute_closure L SS hf hp hpb hn hns (memDi L), sw L (memDbi L) (memDi L), D_mul_D_inv]

/- English proof (translation)
Rewrite using `[S_eq L SS hf hp hpb hn hns]`. Establish `e1` using `ruleSSn L SS hf hp hpb hn hns (y + 1)`. Rewrite `e1` using `[add_sub_cancel_right]`. Establish `fid : ∀ x : A, L.Dbi * (L.D * (algebraMap ℂ A L.TT * (L.Drb * (L.Di * (L.Dbi * x))))) = algebraMap ℂ A L.TT * (L.ζbi * (L.D * (L.Dbi * (L.Di * x))))`. Introduce `x`.

Establish `hz : (⟨L.Drb, memDrb L⟩ : Subring.closure (FS L)) * ⟨L.Dbi, memDbi L⟩ = ⟨L.ζbi, memF L (m_ζbi L)⟩` using `Subtype.ext (Drb_Dbi L)`. Establish `h` using `congrArg Subtype.val (show (⟨L.Dbi, memDbi L⟩ : Subring.closure (FS L)) * ⟨L.D, memD L⟩ * (⟨algebraMap ℂ A L.TT, memS L _⟩ * (⟨L.Drb, memDrb L⟩ * ⟨L.Di, memDi L⟩)) * ⟨L.Dbi, memDbi L⟩ = ⟨algebraMap ℂ A L.TT, memS L _⟩ * ⟨L.ζbi, memF L (m_ζbi L)⟩ * (⟨L.D, memD L⟩ * ⟨L.Dbi, memDbi …`. Rewrite using `[← hz]`. Use the proof step `ring)`. Simplify using `only [Subring.coe_mul] at h`.

Establish `h2` using `congrArg (· * x) h`. Simplify using `only [mul_assoc] at h2`. Conclude with `h2`. Unfold `la lb`. Simplify using `only [mul_assoc]`.

Rewrite using `[raising_commute_D, mul_add, raising_commute_D_bar_inv, e1.2, hat_commute_D_bar_inv, e1.1, fid, shift_norm_commute_closure L SS hf hp hpb hn hns (memDbi L), shift_norm_commute_closure L SS hf hp hpb hn hns (memDi L), sw L (memDbi L) (memD L)]`.
-/
theorem S_lb (y : ℂ) : lb L y * (L.ζ * L.ζbi * SS) = (L.ζ * L.ζbi * SS) * lb L y +
    (algebraMap ℂ A L.TT * (L.ζbi * (L.ζ * L.ζbi * SS))) * la L y := by
  rw [S_eq L SS hf hp hpb hn hns]
  have e1 := ruleSSn L SS hf hp hpb hn hns (y + 1)
  rw [add_sub_cancel_right] at e1
  have fid : ∀ x : A, L.Dbi * (L.D * (algebraMap ℂ A L.TT * (L.Drb * (L.Di * (L.Dbi * x))))) =
      algebraMap ℂ A L.TT * (L.ζbi * (L.D * (L.Dbi * (L.Di * x)))) := by
    intro x
    have hz : (⟨L.Drb, memDrb L⟩ : Subring.closure (FS L)) * ⟨L.Dbi, memDbi L⟩ = ⟨L.ζbi, memF L (m_ζbi L)⟩ :=
      Subtype.ext (Drb_Dbi L)
    have h := congrArg Subtype.val (show (⟨L.Dbi, memDbi L⟩ : Subring.closure (FS L)) * ⟨L.D, memD L⟩ *
        (⟨algebraMap ℂ A L.TT, memS L _⟩ * (⟨L.Drb, memDrb L⟩ * ⟨L.Di, memDi L⟩)) * ⟨L.Dbi, memDbi L⟩ =
        ⟨algebraMap ℂ A L.TT, memS L _⟩ * ⟨L.ζbi, memF L (m_ζbi L)⟩ * (⟨L.D, memD L⟩ * ⟨L.Dbi, memDbi L⟩) *
          ⟨L.Di, memDi L⟩ by
      rw [← hz]; ring)
    simp only [Subring.coe_mul] at h
    have h2 := congrArg (· * x) h
    simp only [mul_assoc] at h2
    exact h2
  unfold la lb
  simp only [mul_assoc]
  rw [raising_commute_D, mul_add, raising_commute_D_bar_inv, e1.2, hat_commute_D_bar_inv, e1.1, fid, shift_norm_commute_closure L SS hf hp hpb hn hns (memDbi L),
    shift_norm_commute_closure L SS hf hp hpb hn hns (memDi L), sw L (memDbi L) (memD L)]

end S

end

end Formalism.FourierDecayAlt.P.MAx3.NF

end S_NF_NF2

section S_NF_NF3

set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace Formalism.FourierDecayAlt.P.MAx3.NF

open Formalism.FourierDecayAlt Formalism.FourierDecayAlt.MA Formalism.FourierDecayAlt.R Formalism.FourierDecayAlt.Wd Formalism.FourierDecayAlt.Fr Formalism.FourierDecayAlt.P.MAx1.An Formalism.FourierDecayAlt.P.RuleGD

noncomputable section

variable (P : M.Par) (L : LevelData (A P (DQ P)) P.r)

def gensB : Set (A P (DQ P)) :=
  {L.ζbi} ∪ Set.range (kap P (DQ P)) ∪ (fun i => L.ζ * L.ζbi * SS P (DQ P) i) '' Set.Icc 1 (P.k - 1)

def BB : Subalgebra ℂ (A P (DQ P)) := Algebra.adjoin ℂ (gensB P L)

/- English proof (translation)
Both sides reduce to the same expression.
-/
theorem kap_diag (f : M.Ty P → ℂ) : kap P (DQ P) f = Matrix.diagonal fun π => algebraMap ℂ (DQ P).Pr (f π) := rfl

/- English proof (translation)
Rewrite using `[kap_diag, Matrix.diagonal_mul_diagonal, Matrix.diagonal_mul_diagonal]`. Use `congr 1`. Use function extensionality and compare the values at `π`. Conclude with `(Algebra.commutes _ _).symm`.
-/
theorem kap_comm_diag (f : M.Ty P → ℂ) (d : M.Ty P → (DQ P).Pr) :
    Matrix.diagonal d * kap P (DQ P) f = kap P (DQ P) f * Matrix.diagonal d := by
  rw [kap_diag, Matrix.diagonal_mul_diagonal, Matrix.diagonal_mul_diagonal]
  congr 1; funext π; exact (Algebra.commutes _ _).symm

section Model
variable {P L} (hTT : 0 ≤ P.TT) (hL : IsModelLevel P (DQ P) L)
include hL

/- English proof (translation)
Take `⟨hp, hpb, hc, hci, hcb, hcbi, hz, hzi, hzb, hzbi, hg, hgi, hn, hns, -⟩` from `hL`. Introduce `x hx`. Simplify using `only [LevelData.fns, Set.mem_union, Set.mem_range, Set.mem_insert_iff, Set.mem_singleton_iff] at hx`. Break down `hx with ((((⟨l, rfl⟩ | ⟨l, rfl⟩) | ⟨l, rfl⟩) | ⟨l, rfl⟩) | h)` into its components or cases. Conclude with `⟨(DQ P).cP l, by rw [hc]; rfl⟩`.

Conclude with `⟨(DQ P).ciP l, by rw [hci]; rfl⟩`. Conclude with `⟨(DQ P).cbP l, by rw [hcb]; rfl⟩`. Conclude with `⟨(DQ P).cbiP l, by rw [hcbi]; rfl⟩`. Break down `h with rfl | rfl | rfl | rfl | rfl | rfl` into its components or cases. Conclude with `⟨(DQ P).zP, by rw [hz]; rfl⟩`.

Conclude with `⟨(DQ P).ziP, by rw [hzi]; rfl⟩`. Conclude with `⟨(DQ P).zbP, by rw [hzb]; rfl⟩`. Conclude with `⟨(DQ P).zbiP, by rw [hzbi]; rfl⟩`. Conclude with `⟨(DQ P).ggP P.TT, by rw [hg]; rfl⟩`. Conclude with `⟨(DQ P).ggiP P.TT, by rw [hgi]; rfl⟩`.
-/
theorem fns_sc : ∀ x ∈ L.fns, ∃ w, x = sc P (DQ P) w := by
  obtain ⟨hp, hpb, hc, hci, hcb, hcbi, hz, hzi, hzb, hzbi, hg, hgi, hn, hns, -⟩ := hL
  intro x hx
  simp only [LevelData.fns, Set.mem_union, Set.mem_range, Set.mem_insert_iff, Set.mem_singleton_iff] at hx
  rcases hx with ((((⟨l, rfl⟩ | ⟨l, rfl⟩) | ⟨l, rfl⟩) | ⟨l, rfl⟩) | h)
  · exact ⟨(DQ P).cP l, by rw [hc]; rfl⟩
  · exact ⟨(DQ P).ciP l, by rw [hci]; rfl⟩
  · exact ⟨(DQ P).cbP l, by rw [hcb]; rfl⟩
  · exact ⟨(DQ P).cbiP l, by rw [hcbi]; rfl⟩
  · rcases h with rfl | rfl | rfl | rfl | rfl | rfl
    · exact ⟨(DQ P).zP, by rw [hz]; rfl⟩
    · exact ⟨(DQ P).ziP, by rw [hzi]; rfl⟩
    · exact ⟨(DQ P).zbP, by rw [hzb]; rfl⟩
    · exact ⟨(DQ P).zbiP, by rw [hzbi]; rfl⟩
    · exact ⟨(DQ P).ggP P.TT, by rw [hg]; rfl⟩
    · exact ⟨(DQ P).ggiP P.TT, by rw [hgi]; rfl⟩

/- English proof (translation)
Establish `hL'` using `hL`. Take `⟨hp, hpb, hc, hci, hcb, hcbi, hz, hzi, hzb, hzbi, hg, hgi, hn, hns, -⟩` from `hL'`. Use `commH L _ (fun m => ?_) (fun x hx => ?_) ?_ y` and prove the remaining obligations. Rewrite using `[hp]`. Use `show sc P (DQ P) _ * _ = _`.

Rewrite using `[G.sc_diag]`. Conclude with `kap_comm_diag P f _`. Take `⟨w, rfl⟩` from `fns_sc hL x hx`. Rewrite using `[G.sc_diag]`. Conclude with `kap_comm_diag P f _`.

Rewrite using `[hn]`. Conclude with `kap_comm_diag P f _`.
-/
theorem kap_letters (f : M.Ty P → ℂ) (y : ℂ) :
    la L y * kap P (DQ P) f = kap P (DQ P) f * la L y ∧ lb L y * kap P (DQ P) f = kap P (DQ P) f * lb L y := by
  have hL' := hL
  obtain ⟨hp, hpb, hc, hci, hcb, hcbi, hz, hzi, hzb, hzbi, hg, hgi, hn, hns, -⟩ := hL'
  refine commH L _ (fun m => ?_) (fun x hx => ?_) ?_ y
  · rw [hp]; show sc P (DQ P) _ * _ = _; rw [G.sc_diag]; exact kap_comm_diag P f _
  · obtain ⟨w, rfl⟩ := fns_sc hL x hx; rw [G.sc_diag]; exact kap_comm_diag P f _
  · rw [hn]; exact kap_comm_diag P f _

omit hL in
/- English proof (translation)
The claim follows from `commH L L.ζbi (fun m => L.p_ζbi m) (fun x hx => fc L hx (m_ζbi L)) L.nab_ζbi y`.
-/
theorem zbi_letters (y : ℂ) : la L y * L.ζbi = L.ζbi * la L y ∧ lb L y * L.ζbi = L.ζbi * lb L y :=
  commH L L.ζbi (fun m => L.p_ζbi m) (fun x hx => fc L hx (m_ζbi L)) L.nab_ζbi y

include hTT in
/- English proof (translation)
Establish `: Fact ((DQ P).Laws P.TT)` using `⟨Formalism.FourierDecayAlt.P.analytic_laws P.r P.TT hTT⟩`. Establish `hL'` using `hL`. Take `⟨hp, hpb, hc, hci, hcb, hcbi, hz, hzi, hzb, hzbi, hg, hgi, hn, hns, -⟩` from `hL'`. Establish `hsc : ∀ w, sc P (DQ P) w * SS P (DQ P) i = SS P (DQ P) i * sc P (DQ P) w` using `fun w => (Formalism.FourierDecayAlt.P.MAx1.sSScalar P (DQ P) i w).symm.eq`. Establish `hi' : i ∈ Finset.Icc 1 (P.k - 1)` using `by simpa using hi`.

Take `⟨h1, h2⟩` from `Formalism.FourierDecayAlt.P.MAx1.nabSS P (DQ P) i hi'`. Use `⟨fun x hx => ?_, fun m => ?_, fun m => ?_, ?_, ?_⟩` and prove the remaining obligations. Take `⟨w, rfl⟩` from `fns_sc hL x hx`. Conclude with `hsc w`. Rewrite using `[hp]`.

Conclude with `hsc _`. Rewrite using `[hpb]`. Conclude with `hsc _`. Rewrite using `[hn, hzb, hgi]`. Conclude with `h1`.

Rewrite using `[hns, hz, hgi]`. Conclude with `h2`.
-/
theorem SS_hyps (i : ℕ) (hi : i ∈ Set.Icc 1 (P.k - 1)) :
    (∀ x ∈ L.fns, x * SS P (DQ P) i = SS P (DQ P) i * x) ∧ (∀ m, L.p m * SS P (DQ P) i = SS P (DQ P) i * L.p m) ∧
    (∀ m, L.pb m * SS P (DQ P) i = SS P (DQ P) i * L.pb m) ∧
    L.nab * SS P (DQ P) i = SS P (DQ P) i * L.nab - L.ζb * L.GGi * SS P (DQ P) i ∧
    L.nabs * SS P (DQ P) i = SS P (DQ P) i * L.nabs - L.ζ * L.GGi * SS P (DQ P) i := by
  have : Fact ((DQ P).Laws P.TT) := ⟨Formalism.FourierDecayAlt.P.analytic_laws P.r P.TT hTT⟩
  have hL' := hL
  obtain ⟨hp, hpb, hc, hci, hcb, hcbi, hz, hzi, hzb, hzbi, hg, hgi, hn, hns, -⟩ := hL'
  have hsc : ∀ w, sc P (DQ P) w * SS P (DQ P) i = SS P (DQ P) i * sc P (DQ P) w := fun w =>
    (Formalism.FourierDecayAlt.P.MAx1.sSScalar P (DQ P) i w).symm.eq
  have hi' : i ∈ Finset.Icc 1 (P.k - 1) := by simpa using hi
  obtain ⟨h1, h2⟩ := Formalism.FourierDecayAlt.P.MAx1.nabSS P (DQ P) i hi'
  refine ⟨fun x hx => ?_, fun m => ?_, fun m => ?_, ?_, ?_⟩
  · obtain ⟨w, rfl⟩ := fns_sc hL x hx; exact hsc w
  · rw [hp]; exact hsc _
  · rw [hpb]; exact hsc _
  · rw [hn, hzb, hgi]; exact h1
  · rw [hns, hz, hgi]; exact h2

include hTT in

/- English proof (translation)
Establish `hle : BB P L ≤ Subalgebra.centralizer ℂ ({la L y} : Set (A P (DQ P)))`. Use `Algebra.adjoin_le fun g hg => ?_` and prove the remaining obligations. Rewrite using `[SetLike.mem_coe, Subalgebra.mem_centralizer_iff]`. Introduce `x hx`. Rewrite using `[Set.mem_singleton_iff.1 hx]`.

Break down `hg with (hg | ⟨f, rfl⟩) | ⟨i, hi, rfl⟩` into its components or cases. Rewrite using `[Set.mem_singleton_iff.1 hg]`. Conclude with `(zbi_letters y).1`. Conclude with `(kap_letters hL f y).1`. Take `⟨h1, h2, h3, h4, h5⟩` from `SS_hyps hTT hL i hi`.

Conclude with `S_la L _ h1 h2 h3 h4 h5 y`. Use `hle hβ` as an intermediate fact. Rewrite `this` using `[Subalgebra.mem_centralizer_iff]`. Conclude with `this _ rfl`.
-/
theorem BB_la {β : A P (DQ P)} (hβ : β ∈ BB P L) (y : ℂ) : la L y * β = β * la L y := by
  have hle : BB P L ≤ Subalgebra.centralizer ℂ ({la L y} : Set (A P (DQ P))) := by
    refine Algebra.adjoin_le fun g hg => ?_
    rw [SetLike.mem_coe, Subalgebra.mem_centralizer_iff]
    intro x hx
    rw [Set.mem_singleton_iff.1 hx]
    rcases hg with (hg | ⟨f, rfl⟩) | ⟨i, hi, rfl⟩
    · rw [Set.mem_singleton_iff.1 hg]; exact (zbi_letters y).1
    · exact (kap_letters hL f y).1
    · obtain ⟨h1, h2, h3, h4, h5⟩ := SS_hyps hTT hL i hi
      exact S_la L _ h1 h2 h3 h4 h5 y
  have := hle hβ
  rw [Subalgebra.mem_centralizer_iff] at this
  exact this _ rfl

include hTT in

/- English proof (translation)
Proceed by induction on `hβ using Algebra.adjoin_induction with`. Consider the case `mem g hg`. Break down `hg with (hg | ⟨f, rfl⟩) | ⟨i, hi, rfl⟩` into its components or cases. Rewrite using `[Set.mem_singleton_iff.1 hg]`. Conclude with `⟨0, Subalgebra.zero_mem _, fun y => by rw [zero_mul, add_zero]; exact (zbi_letters y).2⟩`.

Conclude with `⟨0, Subalgebra.zero_mem _, fun y => by rw [zero_mul, add_zero]; exact (kap_letters hL f y).2⟩`. Take `⟨h1, h2, h3, h4, h5⟩` from `SS_hyps hTT hL i hi`. Use `⟨algebraMap ℂ (A P (DQ P)) L.TT * (L.ζbi * (L.ζ * L.ζbi * SS P (DQ P) i)), ?_, fun y => S_lb L _ h1 h2 h3 h4 h5 y⟩` and prove the remaining obligations. Use `mul_mem (Subalgebra.algebraMap_mem _ _) (mul_mem (Algebra.subset_adjoin ?_) (Algebra.subset_adjoin ?_))` and prove the remaining obligations. Conclude with `Or.inl (Or.inl rfl)`.

Conclude with `Or.inr ⟨i, hi, rfl⟩`. Consider the case `algebraMap z`. Conclude with `⟨0, Subalgebra.zero_mem _, fun y => by rw [zero_mul, add_zero]; exact (Algebra.commutes z _).symm⟩`. Consider the case `add x y hx hy ihx ihy`. Take `⟨x', hx', ex⟩` from `ihx`.

Take `⟨y', hy', ey⟩` from `ihy`. Conclude with `⟨x' + y', add_mem hx' hy', fun t => by rw [mul_add, ex, ey, add_mul, add_mul]; abel⟩`. Consider the case `mul x y hx hy ihx ihy`. Take `⟨x', hx', ex⟩` from `ihx`. Take `⟨y', hy', ey⟩` from `ihy`.

Use `⟨x * y' + x' * y, add_mem (mul_mem hx hy') (mul_mem hx' hy), fun t => ?_⟩` and prove the remaining obligations. Rewrite using `[← mul_assoc, ex, add_mul, mul_assoc, ey, mul_assoc x', BB_la hTT hL hy t]`. Simplify using `only [mul_add, add_mul, mul_assoc]`. Normalize the expressions using the abelian group laws.
-/
theorem BB_lb {β : A P (DQ P)} (hβ : β ∈ BB P L) :
    ∃ β' ∈ BB P L, ∀ y : ℂ, lb L y * β = β * lb L y + β' * la L y := by
  induction hβ using Algebra.adjoin_induction with
  | mem g hg =>
    rcases hg with (hg | ⟨f, rfl⟩) | ⟨i, hi, rfl⟩
    · rw [Set.mem_singleton_iff.1 hg]
      exact ⟨0, Subalgebra.zero_mem _, fun y => by rw [zero_mul, add_zero]; exact (zbi_letters y).2⟩
    · exact ⟨0, Subalgebra.zero_mem _, fun y => by rw [zero_mul, add_zero]; exact (kap_letters hL f y).2⟩
    · obtain ⟨h1, h2, h3, h4, h5⟩ := SS_hyps hTT hL i hi
      refine ⟨algebraMap ℂ (A P (DQ P)) L.TT * (L.ζbi * (L.ζ * L.ζbi * SS P (DQ P) i)), ?_,
        fun y => S_lb L _ h1 h2 h3 h4 h5 y⟩
      refine mul_mem (Subalgebra.algebraMap_mem _ _) (mul_mem (Algebra.subset_adjoin ?_) (Algebra.subset_adjoin ?_))
      · exact Or.inl (Or.inl rfl)
      · exact Or.inr ⟨i, hi, rfl⟩
  | algebraMap z =>
    exact ⟨0, Subalgebra.zero_mem _, fun y => by rw [zero_mul, add_zero]; exact (Algebra.commutes z _).symm⟩
  | add x y hx hy ihx ihy =>
    obtain ⟨x', hx', ex⟩ := ihx
    obtain ⟨y', hy', ey⟩ := ihy
    exact ⟨x' + y', add_mem hx' hy', fun t => by rw [mul_add, ex, ey, add_mul, add_mul]; abel⟩
  | mul x y hx hy ihx ihy =>
    obtain ⟨x', hx', ex⟩ := ihx
    obtain ⟨y', hy', ey⟩ := ihy
    refine ⟨x * y' + x' * y, add_mem (mul_mem hx hy') (mul_mem hx' hy), fun t => ?_⟩
    rw [← mul_assoc, ex, add_mul, mul_assoc, ey, mul_assoc x', BB_la hTT hL hy t]
    simp only [mul_add, add_mul, mul_assoc]
    abel

end Model

