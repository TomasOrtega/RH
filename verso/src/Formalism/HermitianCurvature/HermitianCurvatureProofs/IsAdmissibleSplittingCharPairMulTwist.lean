theorem ζbi_BA : L.ζbi ∈ BA L := gen_BA hL hLaw (Or.inl (Or.inl (Or.inl (by simp))))

/- English proof (translation)
Establish `h1 : e L L.Dr (memDr L) * e L L.Dri (memDri L) = 1` using `Subtype.ext (RuleGD.Dr_Dri L)`. Establish `h2 : e L L.Drb (memDrb L) * e L L.Drbi (memDrbi L) = 1` using `Subtype.ext (RuleGD.Drb_Drbi L)`. Establish `key : e L L.ζ (memζ L) * e L L.ζbi (memζbi L) = e L L.Dr (memDr L) * e L L.ζ (memζ L) * (e L L.ζbi (memζbi L) * e L L.Drbi (memDrbi L)) * (e L L.Drb (memDrb L) * e L L.Dri (memDri L))`. Take the linear combination `(-(e L L.ζ (memζ L) * e L L.ζbi (memζbi L) * e L L.Drb (memDrb L) * e L L.Drbi (memDrbi L))) * h1 + (-(e L L.ζ (memζ L) * e L L.ζbi (memζbi L))) * h2`. Use `congrArg Subtype.val key` as an intermediate fact.

Simplify `this` using `[e, LevelData.D, LevelData.Dbi, mul_assoc]`.
-/
theorem ζζbi_eq : L.ζ * L.ζbi = L.D * L.Dbi * (L.Drb * L.Dri) := by
  have h1 : e L L.Dr (memDr L) * e L L.Dri (memDri L) = 1 := Subtype.ext (RuleGD.Dr_Dri L)
  have h2 : e L L.Drb (memDrb L) * e L L.Drbi (memDrbi L) = 1 := Subtype.ext (RuleGD.Drb_Drbi L)
  have key : e L L.ζ (memζ L) * e L L.ζbi (memζbi L) = e L L.Dr (memDr L) * e L L.ζ (memζ L) *
      (e L L.ζbi (memζbi L) * e L L.Drbi (memDrbi L)) * (e L L.Drb (memDrb L) * e L L.Dri (memDri L)) := by
    linear_combination (-(e L L.ζ (memζ L) * e L L.ζbi (memζbi L) * e L L.Drb (memDrb L) * e L L.Drbi (memDrbi L))) * h1 +
      (-(e L L.ζ (memζ L) * e L L.ζbi (memζbi L))) * h2
  have := congrArg Subtype.val key
  simpa [e, LevelData.D, LevelData.Dbi, mul_assoc] using this

/- English proof (translation)
Take `⟨-, -, -, -, -, -, hz, -, -, hzbi, -⟩` from `id hL`. Establish `hDrDG : L.Drb * L.Dri ∈ DG P`. Take `⟨-, d2, d3, -⟩` from `DrSC hL`. Take `⟨w, hw⟩` from `Subring.mul_mem _ d2 d3`. Rewrite using `[← hw]`.

Conclude with `sc_memDG P w`. Use `show zA P (DQ P) * zbiA P (DQ P) * _ ∈ BA L`. Rewrite using `[← hz, ← hzbi, Finset.mul_sum]`. Use `Subalgebra.sum_mem _ fun i hi => ?_` and prove the remaining obligations. Establish `hgen : L.Drb * L.Dri * SS P (DQ P) i ∈ bddSet P L` using `Or.inl (Or.inr ⟨i, Set.mem_Icc.2 (Finset.mem_Icc.1 hi), rfl⟩)`.

Establish `hDD : L.D * L.Dbi ∈ bddSet P L` using `Or.inl (Or.inl (Or.inl (by simp)))`. Establish `e1 : L.ζ * L.ζbi * (kap P (DQ P) (fun π => (Y + (M.rho P π i : ℂ))⁻¹) * SS P (DQ P) i) = L.D * L.Dbi * (kap P (DQ P) (fun π => (Y + (M.rho P π i : ℂ))⁻¹) * (L.Drb * L.Dri * SS P (DQ P) i))`. Rewrite using `[ζζbi_eq hL hLaw, mul_assoc (L.D * L.Dbi), ← mul_assoc (L.Drb * L.Dri), ← kap_comm_DG P _ hDrDG]`. Simplify using `only [mul_assoc]`. Rewrite using `[e1]`.

Conclude with `mul_mem (gen_BA hL hLaw hDD) (mul_mem (kap_BA hL hLaw _) (gen_BA hL hLaw hgen))`.
-/
theorem eeA_BA (Y : ℂ) : eeA P (DQ P) Y ∈ BA L := by
  obtain ⟨-, -, -, -, -, -, hz, -, -, hzbi, -⟩ := id hL
  have hDrDG : L.Drb * L.Dri ∈ DG P := by
    obtain ⟨-, d2, d3, -⟩ := DrSC hL
    obtain ⟨w, hw⟩ := Subring.mul_mem _ d2 d3
    rw [← hw]; exact sc_memDG P w
  show zA P (DQ P) * zbiA P (DQ P) * _ ∈ BA L
  rw [← hz, ← hzbi, Finset.mul_sum]
  refine Subalgebra.sum_mem _ fun i hi => ?_
  have hgen : L.Drb * L.Dri * SS P (DQ P) i ∈ bddSet P L :=
    Or.inl (Or.inr ⟨i, Set.mem_Icc.2 (Finset.mem_Icc.1 hi), rfl⟩)
  have hDD : L.D * L.Dbi ∈ bddSet P L := Or.inl (Or.inl (Or.inl (by simp)))
  have e1 : L.ζ * L.ζbi * (kap P (DQ P) (fun π => (Y + (M.rho P π i : ℂ))⁻¹) * SS P (DQ P) i) =
      L.D * L.Dbi * (kap P (DQ P) (fun π => (Y + (M.rho P π i : ℂ))⁻¹) * (L.Drb * L.Dri * SS P (DQ P) i)) := by
    rw [ζζbi_eq hL hLaw, mul_assoc (L.D * L.Dbi), ← mul_assoc (L.Drb * L.Dri),
      ← kap_comm_DG P _ hDrDG]
    simp only [mul_assoc]
  rw [e1]
  exact mul_mem (gen_BA hL hLaw hDD) (mul_mem (kap_BA hL hLaw _) (gen_BA hL hLaw hgen))

/- English proof (translation)
The claim follows from `MAx2.Jet.scalar_mem _ _ h`.
-/
theorem io_B {S : Type} [Fintype S] [DecidableEq S] {x : A P (DQ P)} (h : x ∈ BA L) : (io x : SlopeTestRemainingChoices S (A P (DQ P))) ∈ UB L S :=
  MAx2.Jet.scalar_mem _ _ h

/- English proof (translation)
Introduce `x y` and use `by simp only [eU, Matrix.of_apply] split_ifs · exact Subalgebra.one_mem _ · exact Subalgebra.zero_mem _`.
