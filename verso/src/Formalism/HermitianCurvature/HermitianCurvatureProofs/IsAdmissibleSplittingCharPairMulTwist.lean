/- English proof (translation)
Use function extensionality and compare the values at `i`. Apply `Fin.ext` to reduce the goal to its premises. Use `h1 i` as an intermediate fact. Use `h2 i` as an intermediate fact. Use linear arithmetic over natural numbers and integers.
-/
theorem up_tgt (P : M.Par) (m : ℕ) (π π₁ π₂ : M.Ty P) (h1 : M.Up P m π π₁) (h2 : M.Up P m π π₂) : π₁ = π₂ := by
  funext i; apply Fin.ext; have := h1 i; have := h2 i; omega

/- English proof (translation)
Unfold `dSS`. Distinguish the cases in `he : e = e'`. Rewrite using `[if_pos he, Fintype.sum_prod_type]`. Use `sum_congr rfl fun m _ => ?_` and prove the remaining obligations. Rewrite using `[sum_eq_single π]`.

Distinguish the cases in `hu : M.Up P ((m : ℕ) + 1) π' π`. Establish `h1 : (e = e' ∧ M.Up P ((m : ℕ) + 1) π' π)` using `⟨he, hu⟩`. Rewrite using `[if_pos h1]`. Simplify using `only [hu, if_true, mul_one]`. Establish `h1 : ¬ (e = e' ∧ M.Up P ((m : ℕ) + 1) π' π)` using `fun h => hu h.2`.

Rewrite using `[if_neg h1]`. Simplify using `only [hu, if_false, mul_zero]`. Introduce `b _ hb`. Rewrite using `[if_neg (Ne.symm hb)]`. Simplify using the standard rewrite rules.

Simplify using the standard rewrite rules. Rewrite using `[if_neg he]`. Conclude with `(sum_eq_zero fun m _ => if_neg fun h => he h.1).symm`.
-/
theorem dSS_sparse (P : M.Par) (w : List ℝ) (Y₁ Y₂ : ℝ) (q : Qp P.r P.TT) (e e' : Ix (Fin w.length))
    (π π' : M.Ty P) :
    dSS P w Y₁ Y₂ q e e' π π' = ∑ m : Fin (P.k - 1),
      if e = e' ∧ M.Up P ((m : ℕ) + 1) π' π then
        (((Y₁ : ℂ) - gJ P (m, π))⁻¹ - ((Y₂ : ℂ) - gJ P (m, π))⁻¹) * multS (wordP w) (gJ P (m, π)) e *
          (phase P q * ((Real.sqrt (M.Nrm P ((m : ℕ) + 1) π') : ℝ) : ℂ))
      else 0 := by
