    push_cast
    ring

/- English proof (translation)
The claim follows from `| [], e, Y, _ => by simp [phR] | a :: v, e, Y, h => by have ih := phR_bounds L hL v e Y (fun b hb => h b (List.mem_cons_of_mem _ hb)) have ha := h a List.mem_cons_self have hf : 1 ≤ (if e a.intersection_update_fsHerm_neg_one = 0 then (Y - a.pt.re) / (Y - a.pt.re - 1) else 1) ∧ (i …`.
-/
theorem phR_bounds (L : ℝ) (hL : 2 ≤ L) : ∀ (v : List (Letter ℂ S)) (e : Ix S) (Y : ℝ),
    (∀ a ∈ v, L ≤ Y - a.pt.re) → 1 ≤ phR v e Y ∧ phR v e Y ≤ (1 + 2 / L) ^ v.length
  | [], e, Y, _ => by simp [phR]
  | a :: v, e, Y, h => by
    have ih := phR_bounds L hL v e Y (fun b hb => h b (List.mem_cons_of_mem _ hb))
    have ha := h a List.mem_cons_self
    have hf : 1 ≤ (if e a.intersection_update_fsHerm_neg_one = 0 then (Y - a.pt.re) / (Y - a.pt.re - 1) else 1) ∧
