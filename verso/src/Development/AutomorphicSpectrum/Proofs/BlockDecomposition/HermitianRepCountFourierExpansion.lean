/- English proof (translation)
Unfold `cT`. Rewrite using `[Matrix.map_mul, Matrix.transpose_mul]`.
-/
theorem cT_mul (σ : R →+* R) {a b c : ℕ} (x : Matrix (Fin a) (Fin b) R) (y : Matrix (Fin b) (Fin c) R) :
    cT σ (x * y) = cT σ y * cT σ x := by
  unfold cT
  rw [Matrix.map_mul, Matrix.transpose_mul]

/- English proof (translation)
Use extensionality with `i j`. Conclude with `h (x i j)`.
-/
theorem cT_cT (σ : R →+* R) (h : ∀ a, σ (σ a) = a) {a b : ℕ} (x : Matrix (Fin a) (Fin b) R) :
    cT σ (cT σ x) = x := by
  ext i j
  exact h (x i j)

/- English proof (translation)
Use extensionality with `i j`. Conclude with `map_sub σ (x j i) (y j i)`.
-/
theorem cT_sub (σ : R →+* R) {a b : ℕ} (x y : Matrix (Fin a) (Fin b) R) :
    cT σ (x - y) = cT σ x - cT σ y := by
  ext i j
  exact map_sub σ (x j i) (y j i)

/- English proof (translation)
Unfold `red`. Conclude with `Matrix.map_mul`.
-/
theorem red_mul (ϖ : R) (k : ℕ) {a b c : ℕ} (x : Matrix (Fin a) (Fin b) R) (y : Matrix (Fin b) (Fin c) R) :
    red ϖ k (x * y) = red ϖ k x * red ϖ k y := by
  unfold red
  exact Matrix.map_mul

/- English proof (translation)
Use extensionality with `i j`. Conclude with `map_sub (Ideal.Quotient.mk (lev ϖ k)) (x i j) (y i j)`.
-/
theorem red_sub (ϖ : R) (k : ℕ) {a b : ℕ} (x y : Matrix (Fin a) (Fin b) R) :
    red ϖ k (x - y) = red ϖ k x - red ϖ k y := by
  ext i j
  exact map_sub (Ideal.Quotient.mk (lev ϖ k)) (x i j) (y i j)

/- English proof (translation)
Use extensionality with `i j`. Conclude with `map_neg (Ideal.Quotient.mk (lev ϖ k)) (x i j)`.
-/
theorem red_neg (ϖ : R) (k : ℕ) {a b : ℕ} (x : Matrix (Fin a) (Fin b) R) :
    red ϖ k (-x) = - red ϖ k x := by
  ext i j
  exact map_neg (Ideal.Quotient.mk (lev ϖ k)) (x i j)

/- English proof (translation)
Use extensionality with `i j`. Conclude with `(barσ_mk σ ϖ h k (x j i)).symm`.
-/
theorem red_cT (σ : R →+* R) (ϖ : R) (h : σ ϖ = ϖ) (k : ℕ) {a b : ℕ} (x : Matrix (Fin a) (Fin b) R) :
    red ϖ k (cT σ x) = cT (barσ σ ϖ h k) (red ϖ k x) := by
  ext i j
  exact (barσ_mk σ ϖ h k (x j i)).symm

/- English proof (translation)
Introduce `y`. Use `⟨Matrix.of fun i j => (Ideal.Quotient.mk_surjective (y i j)).choose, ?_⟩` and prove the remaining obligations. Use extensionality with `i j`. Conclude with `(Ideal.Quotient.mk_surjective (y i j)).choose_spec`.
-/
theorem red_surj (ϖ : R) (k : ℕ) {a b : ℕ} :
    Function.Surjective (red ϖ k : Matrix (Fin a) (Fin b) R → _) := by
  intro y
  refine ⟨Matrix.of fun i j => (Ideal.Quotient.mk_surjective (y i j)).choose, ?_⟩
  ext i j
  exact (Ideal.Quotient.mk_surjective (y i j)).choose_spec

/- English proof (translation)
Rewrite using `[red_mul, red_mul, red_cT σ ϖ h]`.
-/
theorem red_gram (σ : R →+* R) (ϖ : R) (h : σ ϖ = ϖ) (k : ℕ) {m n : ℕ}
    (S : Matrix (Fin m) (Fin m) R) (x : Matrix (Fin m) (Fin n) R) :
    red ϖ k (cT σ x * S * x) = cT (barσ σ ϖ h k) (red ϖ k x) * red ϖ k S * red ϖ k x := by
  rw [red_mul, red_mul, red_cT σ ϖ h]

/- English proof (translation)
Use extensionality with `y`. Prove the components needed by the constructor for the conclusion. Introduce and unpack `⟨x, hx, rfl⟩ show cT (barσ σ ϖ h k) (red ϖ k x) * red ϖ k S * red ϖ k x = red ϖ k T`. Rewrite using `[← red_gram σ ϖ h]`. Conclude with `hx`.

Introduce `hy`. Take `⟨x, rfl⟩` from `red_surj ϖ k y`. Use `⟨x, ?_, rfl⟩` and prove the remaining obligations. Use `show red ϖ k (cT σ x * S * x) = red ϖ k T`. Rewrite using `[red_gram σ ϖ h]`.

Conclude with `hy`.
-/
theorem image_sol (σ : R →+* R) (ϖ : R) (h : σ ϖ = ϖ) (k : ℕ) {m n : ℕ}
    (S : Matrix (Fin m) (Fin m) R) (T : Matrix (Fin n) (Fin n) R) :
    red ϖ k '' {x : Matrix (Fin m) (Fin n) R | red ϖ k (cT σ x * S * x) = red ϖ k T} =
      {y | cT (barσ σ ϖ h k) y * red ϖ k S * y = red ϖ k T} := by
  ext y
  constructor
  · rintro ⟨x, hx, rfl⟩
    show cT (barσ σ ϖ h k) (red ϖ k x) * red ϖ k S * red ϖ k x = red ϖ k T
    rw [← red_gram σ ϖ h]
    exact hx
  · intro hy
    obtain ⟨x, rfl⟩ := red_surj ϖ k y
    refine ⟨x, ?_, rfl⟩
    show red ϖ k (cT σ x * S * x) = red ϖ k T
    rw [red_gram σ ϖ h]
    exact hy

/- English proof (translation)
Take `⟨x, rfl⟩` from `red_surj ϖ k y`. Unfold `hermMod`. Use `⟨cT σ x * S * x - T, ?_, ?_⟩` and prove the remaining obligations. Use `show cT σ (cT σ x * S * x - T) = cT σ x * S * x - T`. Rewrite using `[cT_sub, cT_mul, cT_mul, cT_cT σ hinv, hS, hT, Matrix.mul_assoc]`.

Use `show red ϖ k (cT σ x * S * x - T) = _`. Rewrite using `[red_sub, red_gram σ ϖ h]`.
-/
theorem gram_sub_mem (σ : R →+* R) (ϖ : R) (hinv : ∀ a, σ (σ a) = a) (h : σ ϖ = ϖ) (k : ℕ) {m n : ℕ}
    (S : Matrix (Fin m) (Fin m) R) (T : Matrix (Fin n) (Fin n) R) (hS : cT σ S = S) (hT : cT σ T = T)
    (y : Matrix (Fin m) (Fin n) (R ⧸ lev ϖ k)) :
    cT (barσ σ ϖ h k) y * red ϖ k S * y - red ϖ k T ∈ hermMod σ ϖ n k := by
  obtain ⟨x, rfl⟩ := red_surj ϖ k y
  unfold hermMod
  refine ⟨cT σ x * S * x - T, ?_, ?_⟩
  · show cT σ (cT σ x * S * x - T) = cT σ x * S * x - T
    rw [cT_sub, cT_mul, cT_mul, cT_cT σ hinv, hS, hT, Matrix.mul_assoc]
  · show red ϖ k (cT σ x * S * x - T) = _
    rw [red_sub, red_gram σ ϖ h]

/- English proof (translation)
Unfold `hermMod at hB ⊢`. Take `⟨h0, hh, rfl⟩` from `hB`. Use `⟨-h0, ?_, red_neg ϖ k h0⟩` and prove the remaining obligations. Use `show cT σ (-h0) = -h0`. Establish `hh' : cT σ h0 = h0` using `hh`.

Use extensionality with `i j`. Establish `e : σ (h0 j i) = h0 i j` using `congrFun (congrFun hh' i) j`. Use `show σ (-(h0 j i)) = -(h0 i j)`. Rewrite using `[map_neg, e]`.
-/
theorem neg_mem_herm (σ : R →+* R) (ϖ : R) (n k : ℕ) {B : Matrix (Fin n) (Fin n) (R ⧸ lev ϖ k)}
    (hB : B ∈ hermMod σ ϖ n k) : -B ∈ hermMod σ ϖ n k := by
  unfold hermMod at hB ⊢
  obtain ⟨h0, hh, rfl⟩ := hB
  refine ⟨-h0, ?_, red_neg ϖ k h0⟩
  show cT σ (-h0) = -h0
  have hh' : cT σ h0 = h0 := hh
  ext i j
  have e : σ (h0 j i) = h0 i j := congrFun (congrFun hh' i) j
  show σ (-(h0 j i)) = -(h0 i j)
  rw [map_neg, e]

/- English proof (translation)
Unfold `nuAt`. Establish `hset : (Set.range fun x : Fin n → R ⧸ lev ϖ k => Matrix.vecMul x (-B)) = Set.range fun x : Fin n → R ⧸ lev ϖ k => Matrix.vecMul x B`. Use extensionality with `v`. Prove the components needed by the constructor for the conclusion. Introduce and unpack `⟨x, rfl⟩`.

Use `⟨-x, ?_⟩` and prove the remaining obligations. Use `show Matrix.vecMul (-x) B = Matrix.vecMul x (-B)`. Rewrite using `[Matrix.neg_vecMul, Matrix.vecMul_neg]`. Introduce and unpack `⟨x, rfl⟩`. Use `⟨-x, ?_⟩` and prove the remaining obligations.

Use `show Matrix.vecMul (-x) (-B) = Matrix.vecMul x B`. Rewrite using `[Matrix.neg_vecMul, Matrix.vecMul_neg, neg_neg]`. Rewrite using `[hset]`.
-/
theorem nuAt_neg (ϖ : R) {n k : ℕ} (B : Matrix (Fin n) (Fin n) (R ⧸ lev ϖ k)) :
    nuAt ϖ (-B) = nuAt ϖ B := by
  unfold nuAt
  have hset : (Set.range fun x : Fin n → R ⧸ lev ϖ k => Matrix.vecMul x (-B)) =
      Set.range fun x : Fin n → R ⧸ lev ϖ k => Matrix.vecMul x B := by
    ext v
    constructor
    · rintro ⟨x, rfl⟩
      refine ⟨-x, ?_⟩
      show Matrix.vecMul (-x) B = Matrix.vecMul x (-B)
      rw [Matrix.neg_vecMul, Matrix.vecMul_neg]
    · rintro ⟨x, rfl⟩
      refine ⟨-x, ?_⟩
      show Matrix.vecMul (-x) (-B) = Matrix.vecMul x B
      rw [Matrix.neg_vecMul, Matrix.vecMul_neg, neg_neg]
  rw [hset]

