section S_F_F9
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace Formalism.FourierDecayAlt.P.MAx3.F

open Formalism.FourierDecayAlt Formalism.FourierDecayAlt.Wd Formalism.FourierDecayAlt.Fr Formalism.FourierDecayAlt.R Formalism.FourierDecayAlt.MA Formalism.YangianSpanCharacter.T Matrix

noncomputable section

section abelian₂

variable {A : Type} [Ring A] [StarRing A] [Algebra ℂ A] {r : ℕ} (L : LevelData A r)

def abelian₂ {S : Type} [Fintype S] [DecidableEq S] (f : FrameData S A) (Y : ℂ) : M2 (SlopeTestRemainingChoices S A) :=
  !![io L.ζi, 0; 0, io L.ζbi] * !![1, 0; io L.GG * f.l L Y, io L.GG]

/- English proof (translation)
Unfold `abelian₂`. Rewrite using `[embM_mat_mul, matrix_two_map, matrix_two_map, rel_l L h]`. Simplify using `only [embM_io, embM_zero, embM_one, embM_mul]`.
-/
theorem lam_rel {N : ℕ} {f : FrameData (Fin N) A} {f' : FrameData (Fin (N + 1)) A} (h : Rel f f') (Y : ℂ) :
    abelian₂ L f' Y = (abelian₂ L f Y).map embM := by
  unfold abelian₂
  rw [embM_mat_mul, matrix_two_map, matrix_two_map, rel_l L h]
  simp only [embM_io, embM_zero, embM_one, embM_mul]

/- English proof (translation)
Establish `hR` using `rel_ofWord L st (wordP w) (plusWord_letters_plus w)`. Rewrite using `[plusWord_cons]`. Use `show ins (Fin.last w.length) (abelian₂ L (ofWord L st ((wordP w).map liftL)) ((Y : ℝ) : ℂ)) * (ofWord L st ((wordP w).map liftL)).F = _`. Rewrite using `[lam_rel L hR, hR.F]`.
-/
theorem F_cons (st : Start A) (Y : ℝ) (w : List ℝ) :
    (ofWord L st (wordP (Y :: w))).F =
      ins (Fin.last w.length) ((abelian₂ L (ofWord L st (wordP w)) ((Y : ℝ) : ℂ)).map embM) * embM (ofWord L st (wordP w)).F := by
  have hR := rel_ofWord L st (wordP w) (plusWord_letters_plus w)
  rw [plusWord_cons]
  show ins (Fin.last w.length) (abelian₂ L (ofWord L st ((wordP w).map liftL)) ((Y : ℝ) : ℂ)) *
    (ofWord L st ((wordP w).map liftL)).F = _
  rw [lam_rel L hR, hR.F]

end abelian₂

/- English proof (translation)
Simplify using `only [Finset.sum_mul, Finset.mul_sum, mul_assoc]`. Establish `hc2 : ∀ b e' e'', vv b * (F e' e'' * u e'') = F e' e'' * (vv b * u e'')` using `fun b e' e'' => by`. Rewrite using `[← mul_assoc, hc, mul_assoc]`. Simplify using `only [hc2]`. Rewrite using `[Finset.sum_comm]`.

Conclude with `Finset.sum_congr rfl fun _ _ => Finset.sum_comm`.
-/
theorem reorg {R : Type*} [Ring R] {ι κ : Type*} [Fintype ι] [Fintype κ] (X : κ → ι → R) (F : ι → ι → R) (u : ι → R)
    (vv : κ → R) (hc : ∀ b e' e'', vv b * F e' e'' = F e' e'' * vv b) :
    ∑ e', (∑ b, X b e' * vv b) * ∑ e'', F e' e'' * u e'' = ∑ e'', ∑ b, (∑ e', X b e' * F e' e'') * (vv b * u e'') := by
  simp only [Finset.sum_mul, Finset.mul_sum, mul_assoc]
  have hc2 : ∀ b e' e'', vv b * (F e' e'' * u e'') = F e' e'' * (vv b * u e'') := fun b e' e'' => by
    rw [← mul_assoc, hc, mul_assoc]
  simp only [hc2]
  rw [Finset.sum_comm]
  exact Finset.sum_congr rfl fun _ _ => Finset.sum_comm

section Gw

variable (P : M.Par) (D : DAlg P.r) (L : LevelData (A P D) P.r) (l : ℕ)

def gRw (w : List ℝ) (e : Ix (Fin w.length)) : A P D :=
  ∑ e'', (ofWord L (startM P D l) (wordP w)).F e e'' * uw (sites P D) (wordP w) e''

variable {P D L l}

/- English proof (translation)
Use `set f := ofWord L (startM P D l) (wordP w) with hf`. Use `set Λ := abelian₂ L f ((Y : ℝ) : ℂ) with hΛ`. Use `set vv : Fin 2 → A P D := ![L.Ar ((Y : ℝ) : ℂ), L.Br ((Y : ℝ) : ℂ)] with hvv`. Establish `hv : ∀ b, v0 (sites P D) ((Y : ℝ) : ℂ) b = vv b`. Introduce `b`.

Use `fin_cases b`. Conclude with `site_vector_first P D L hL _`. Conclude with `site_vector_second P D L hL _`. Establish `hvi : ∀ b, (![io (L.Ar ((Y : ℝ) : ℂ)), io (L.Br ((Y : ℝ) : ℂ))] : Fin 2 → SlopeTestRemainingChoices (Fin w.length) (A P D)) b = io (vv b)`. Apply the tactic sequence `intro b; fin_cases b <;> rfl`.

Establish `hvm : ∀ b, vv b ∈ Algebra.adjoin ℂ (sgen P D L)`. Introduce `b`. Use `fin_cases b`. Conclude with `Ar_mem _`. Conclude with `Br_mem _`.

Establish `hfok` using `fok_ofWord (L := L) (S := Fin w.length) hL l (wordP w) (plusWord_letters_plus w)`. Establish `hcomm : ∀ b e' e'', vv b * f.F e' e'' = f.F e' e'' * vv b` using `fun b e' e'' => (Algebra.commute_of_mem_adjoin_of_forall_mem_commute (hvm b) fun y hy => (((mem_Cz P D L).1 (hfok.F e' e'')) y hy).symm).eq.symm`. Establish `hL1 : ∀ e', ((Λ *ᵥ ![io (L.Ar ((Y : ℝ) : ℂ)), io (L.Br ((Y : ℝ) : ℂ))]) c) e e' = ∑ b, Λ c b e e' * vv b`. Introduce `e'`. Simplify using `only [Matrix.mulVec, dotProduct, hvi, Matrix.sum_apply, mul_io_apply]`.

Establish `hF : ∀ e'' b'', (ofWord L (startM P D l) (wordP (Y :: w))).F (Fin.snoc (α` using `fun _ => Fin 2) e c) (Fin.snoc (α := fun _ => Fin 2) e'' b'') = ∑ e', Λ c b'' e e' * f.F e' e'' := by`. Introduce `e'' b''`. Rewrite using `[F_cons L (startM P D l) Y w, Matrix.mul_apply, sum_snoc]`. Use `Finset.sum_congr rfl fun e' _ => ?_` and prove the remaining obligations. Simplify using `only [ins_last_apply, embM_snoc, mul_ite, mul_zero]`.

Rewrite using `[Finset.sum_ite_eq', if_pos (Finset.mem_univ _)]`. Unfold `gRw`. Use `Eq.trans ?_ (sum_snoc (N := w.length) (fun E => (ofWord L (startM P D l) (wordP (Y :: w))).F (Fin.snoc (α := fun _ => Fin 2) e c) E * uw (sites P D) (wordP (Y :: w)) E)).symm` and prove the remaining obligations. Establish `hR : ∀ e'' b'', (ofWord L (startM P D l) (wordP (Y :: w))).F (Fin.snoc (α` using `fun _ => Fin 2) e c) (Fin.snoc (α := fun _ => Fin 2) e'' b'') * uw (sites P D) (wordP (Y :: w)) (Fin.snoc (α := fun _ => Fin 2) e'' b'') = (∑ e', Λ c b'' e e' * f.F e' e'') * (vv b'' * uw (sites P D) (wordP w) e'') := by`. Introduce `e'' b''`.

Rewrite using `[hF, uw_cons P D l hS Y w hG hG', Fin.snoc_last, Fin.init_snoc, hv]`. Rewrite using `[Finset.sum_congr rfl fun e'' _ => Finset.sum_congr rfl fun b'' _ => hR e'' b'']`. Rewrite using `[Finset.sum_congr rfl fun e' _ => congrArg (· * _) (hL1 e')]`. Conclude with `reorg (fun b e' => Λ c b e e') f.F (uw (sites P D) (wordP w)) vv hcomm`.
-/
theorem key_alg (hL : IsModelLevel P D L) (hS : SitesOK (K := ℂ) (startM P D l).QQ (sites P D)) (Y : ℝ) (w : List ℝ)
    (hG : Good (wordP (Y :: w))) (hG' : Good (wordP w)) (c : Fin 2) (e : Ix (Fin w.length)) :
    ∑ e', ((abelian₂ L (ofWord L (startM P D l) (wordP w)) ((Y : ℝ) : ℂ) *ᵥ
        ![io (L.Ar ((Y : ℝ) : ℂ)), io (L.Br ((Y : ℝ) : ℂ))]) c) e e' * gRw P D L l w e' =
      gRw P D L l (Y :: w) (Fin.snoc (α := fun _ => Fin 2) e c) := by
  set f := ofWord L (startM P D l) (wordP w) with hf
  set Λ := abelian₂ L f ((Y : ℝ) : ℂ) with hΛ
  set vv : Fin 2 → A P D := ![L.Ar ((Y : ℝ) : ℂ), L.Br ((Y : ℝ) : ℂ)] with hvv
  have hv : ∀ b, v0 (sites P D) ((Y : ℝ) : ℂ) b = vv b := by
    intro b; fin_cases b
    · exact site_vector_first P D L hL _
    · exact site_vector_second P D L hL _
  have hvi : ∀ b, (![io (L.Ar ((Y : ℝ) : ℂ)), io (L.Br ((Y : ℝ) : ℂ))] : Fin 2 → SlopeTestRemainingChoices (Fin w.length) (A P D)) b = io (vv b) := by
    intro b; fin_cases b <;> rfl
