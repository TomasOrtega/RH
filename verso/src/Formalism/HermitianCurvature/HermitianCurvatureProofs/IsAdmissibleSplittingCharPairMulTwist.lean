            else L.Di * L.Ahat ((m : ℕ) : ℂ))) (Xw P l L (ju P j) w) q i‖ * Dabs q ^ (w.length + 1) := by
          rw [mul_assoc, Finset.sum_mul]
          congr 1
          refine Finset.sum_congr rfl fun m _ => ?_
          rw [hα]
