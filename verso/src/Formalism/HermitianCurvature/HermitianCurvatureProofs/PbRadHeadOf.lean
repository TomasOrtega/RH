section smul

variable {k r : ℕ} {z z' : Fin (2 * r + k + 1) → ℂ} {Wp Wq : Type} [NormedAddCommGroup Wp]
  [InnerProductSpace ℂ Wp] [NormedAddCommGroup Wq] [InnerProductSpace ℂ Wq] [FiniteDimensional ℂ Wq]
  {π : Mx k r → (Wp →L[ℂ] Wp)} {π' : Mx k r → (Wq →L[ℂ] Wq)} {S : Type} [Fintype S] [DecidableEq S]

/- English proof (translation)
Use function extensionality and compare the values at `e`. Simplify using `only [P5.act, map_smul, Finset.smul_sum]`.
-/
theorem act_smul' (M : Wd.SlopeTestRemainingChoices S (Pr (RadSp k r z z' π π'))) (x : Wd.Ix S → RadSp k r z z' π π') (a : ℂ) :
    P5.act M (fun e => a • x e) = fun e => a • P5.act M x e := by
  funext e
  simp only [P5.act, map_smul, Finset.smul_sum]

/- English proof (translation)
Unfold `P5.RRform`. Rewrite using `[act_smul']`. Unfold `P5.form`. Rewrite using `[← integral_const_mul]`. Use `congr 1`.

Use function extensionality and compare the values at `c'`. Simplify using `only [HerA.pairAt_smul_left, HerA.pairAt_smul_right, ← Finset.mul_sum]`. Expand and normalize the polynomial expressions, which then agree.
-/
theorem rrform_smul (L : R.LevelData (Pr (RadSp k r z z' π π')) r) (st : Fr.Start (Pr (RadSp k r z z' π π')))
    (μ : Measure (Mt k r)) (i : Fin (r + 1)) (w : List (Wd.Letter ℂ S)) (x y : Wd.Ix S → RadSp k r z z' π π')
    (c : Fin r → ℂ) (a : ℂ) :
    P5.RRform L st μ i w (fun e => a • x e) (fun e => a • y e) c = a * conj a * P5.RRform L st μ i w x y c := by
  unfold P5.RRform
  rw [act_smul']
  unfold P5.form
  rw [← integral_const_mul]
  congr 1
  funext c'
  simp only [HerA.pairAt_smul_left, HerA.pairAt_smul_right, ← Finset.mul_sum]
  ring

end smul

/- English proof (translation)
Take `⟨h1, h2⟩` from `hh`. Use `⟨fun b hb => ?_, ?_⟩` and prove the remaining obligations. Break down `List.mem_append.1 hb with hb | hb` into its components or cases. Conclude with `h1 b hb`. Rewrite `hb` using `[List.mem_singleton]`.

Substitute `hb` using the available equality. Conclude with `⟨le_rfl, ht⟩`. Unfold `D.ptSize at h2 ⊢`. Rewrite using `[List.map_append, List.sum_append, h2]`. Simplify using the standard rewrite rules.
-/
theorem isLocPt_snoc {h : C.LPt} {j : ℕ} (hh : D.IsLocPt h j) {t : ℂ} (ht : t ≠ 0) :
    D.IsLocPt (h ++ [(1, t)]) (j + 1) := by
  obtain ⟨h1, h2⟩ := hh
  refine ⟨fun b hb => ?_, ?_⟩
  · rcases List.mem_append.1 hb with hb | hb
    · exact h1 b hb
    · rw [List.mem_singleton] at hb
      subst hb
      exact ⟨le_rfl, ht⟩
  · unfold D.ptSize at h2 ⊢
    rw [List.map_append, List.sum_append, h2]
    simp

/- English proof (translation)
Establish `hj' : j + 1 ≠ P.r + 1` using `by omega`. Unfold `KB.levW`. Rewrite using `[if_neg hj']`. Establish `ht' : ‖t‖ ≠ 0` using `norm_ne_zero_iff.2 ht`. Rewrite using `[← pow_mul, ← zpow_natCast, ← zpow_add₀ ht']`.

Use `congr 1`. Unfold `C.Mlev`. Move the coercions through the operations in `[Nat.cast_sub (show j ≤ P.r by omega)]`. Expand and normalize the polynomial expressions, which then agree.
-/
theorem levW_below (P : M.Par) (j : ℕ) (hj : j + 1 ≤ P.r) {t : ℂ} (ht : t ≠ 0) :
    ‖t‖ ^ (-2 : ℤ) * (‖t‖ ^ (2 * (P.r - j) + P.k)) ^ 2 = KB.levW P (j + 1) t := by
  have hj' : j + 1 ≠ P.r + 1 := by omega
  unfold KB.levW
  rw [if_neg hj']
  have ht' : ‖t‖ ≠ 0 := norm_ne_zero_iff.2 ht
  rw [← pow_mul, ← zpow_natCast, ← zpow_add₀ ht']
  congr 1
  unfold C.Mlev
  push_cast [Nat.cast_sub (show j ≤ P.r by omega)]
  ring

end Formalism.FourierDecayAlt.P.PBP

