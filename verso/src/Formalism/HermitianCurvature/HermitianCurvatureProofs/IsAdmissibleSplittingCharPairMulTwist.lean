/- English proof (translation)
Establish `e1 : (T.map f).sum = ∑ i : Fin T.length, f (T.get i)`. Apply the tactic sequence `rw [← List.sum_ofFn]; congr 1; apply List.ext_get <;> simp`. Establish `e2 : (T.map fun t => f t ^ 2).sum = ∑ i : Fin T.length, f (T.get i) ^ 2`. Apply the tactic sequence `rw [← List.sum_ofFn]; congr 1; apply List.ext_get <;> simp`. Rewrite using `[e1, e2]`.

Use `sq_sum_le_card_mul_sum_sq (s := (Finset.univ : Finset (Fin T.length))) (f := fun i => f (T.get i))` as an intermediate fact. Simplify using `using this`.
-/
theorem list_sq_le {α : Type} (T : List α) (f : α → ℝ) :
    (T.map f).sum ^ 2 ≤ T.length * (T.map fun t => f t ^ 2).sum := by
  have e1 : (T.map f).sum = ∑ i : Fin T.length, f (T.get i) := by
    rw [← List.sum_ofFn]; congr 1; apply List.ext_get <;> simp
  have e2 : (T.map fun t => f t ^ 2).sum = ∑ i : Fin T.length, f (T.get i) ^ 2 := by
    rw [← List.sum_ofFn]; congr 1; apply List.ext_get <;> simp
  rw [e1, e2]
  have := sq_sum_le_card_mul_sum_sq (s := (Finset.univ : Finset (Fin T.length))) (f := fun i => f (T.get i))
  simpa using this

/- English proof (translation)
The claim follows from `List.sum_nonneg fun x hx => by obtain ⟨t, _, rfl⟩ := List.mem_map.1 hx; exact hf t`.
-/
theorem list_sum_nonneg {α : Type} (T : List α) (f : α → ℝ) (hf : ∀ t, 0 ≤ f t) : 0 ≤ (T.map f).sum :=
  List.sum_nonneg fun x hx => by obtain ⟨t, _, rfl⟩ := List.mem_map.1 hx; exact hf t

/- English proof (translation)
Proceed by induction on `l with`. Consider the case `nil => simp`. Consider the case `cons a l ih => simp [List.flatMap_cons, List.map_append, List.sum_append, ih]`.
-/
theorem flat_sum {α β : Type} (l : List α) (T : α → List β) (f : β → ℝ) :
    ((l.flatMap T).map f).sum = (l.map fun a => ((T a).map f).sum).sum := by
  induction l with
  | nil => simp
  | cons a l ih => simp [List.flatMap_cons, List.map_append, List.sum_append, ih]

/- English proof (translation)
Rewrite using `[flat_sum]`. Conclude with `List.single_le_sum (fun x hx => by`. Take `⟨b, _, rfl⟩` from `List.mem_map.1 hx`. Conclude with `list_sum_nonneg _ _ hf) _ (List.mem_map_of_mem ha)`.
-/
theorem flat_le {α β : Type} (l : List α) (T : α → List β) (f : β → ℝ) (hf : ∀ t, 0 ≤ f t) (a : α) (ha : a ∈ l) :
    ((T a).map f).sum ≤ ((l.flatMap T).map f).sum := by
  rw [flat_sum]
  exact List.single_le_sum (fun x hx => by
    obtain ⟨b, _, rfl⟩ := List.mem_map.1 hx; exact list_sum_nonneg _ _ hf) _ (List.mem_map_of_mem ha)

