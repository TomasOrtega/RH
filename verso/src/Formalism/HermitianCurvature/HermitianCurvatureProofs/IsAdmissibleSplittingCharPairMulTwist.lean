variable {A : Type} [Ring A] {N : ℕ}

local notation "sn" => Fin.snoc (α := fun _ => Fin 2)

/- English proof (translation)
Rewrite using `[Matrix.mul_apply, sum_snoc]`. Simplify using `only [eU_last_snoc, ite_mul, one_mul, zero_mul]`. Rewrite using `[Finset.sum_eq_single e (fun e1 _ he => Finset.sum_eq_zero fun c1 _ => if_neg fun h => he h.2.2.symm) (by simp)]`. Rewrite using `[Finset.sum_eq_single j (fun c1 _ hc => if_neg fun h => hc h.2.1) (by simp)]`. Distinguish the cases in `h : b = i`.

Rewrite using `[if_pos ⟨h, rfl, rfl⟩, if_pos h]`. Rewrite using `[if_neg (fun h' => h h'.1), if_neg h]`.
-/
theorem eU_mul_snoc (i j : Fin 2) (X : SlopeTestRemainingChoices (Fin (N + 1)) A) (e e' : Ix (Fin N)) (b b' : Fin 2) :
    ((eU (Fin.last N) i j : SlopeTestRemainingChoices (Fin (N + 1)) A) * X) (sn e b) (sn e' b') = if b = i then X (sn e j) (sn e' b') else 0 := by
  rw [Matrix.mul_apply, sum_snoc]
  simp only [eU_last_snoc, ite_mul, one_mul, zero_mul]
  rw [Finset.sum_eq_single e (fun e1 _ he => Finset.sum_eq_zero fun c1 _ => if_neg fun h => he h.2.2.symm) (by simp)]
  rw [Finset.sum_eq_single j (fun c1 _ hc => if_neg fun h => hc h.2.1) (by simp)]
  by_cases h : b = i
  · rw [if_pos ⟨h, rfl, rfl⟩, if_pos h]
  · rw [if_neg (fun h' => h h'.1), if_neg h]

/- English proof (translation)
Rewrite using `[Matrix.mul_apply, sum_snoc]`. Simplify using `only [eU_last_snoc, mul_ite, mul_one, mul_zero]`. Rewrite using `[Finset.sum_eq_single e' (fun e1 _ he => Finset.sum_eq_zero fun c1 _ => if_neg fun h => he h.2.2) (by simp)]`. Rewrite using `[Finset.sum_eq_single i (fun c1 _ hc => if_neg fun h => hc h.1) (by simp)]`. Distinguish the cases in `h : b' = j`.

Rewrite using `[if_pos ⟨rfl, h, rfl⟩, if_pos h]`. Rewrite using `[if_neg (fun h' => h h'.2.1), if_neg h]`.
-/
theorem mul_eU_snoc (i j : Fin 2) (X : SlopeTestRemainingChoices (Fin (N + 1)) A) (e e' : Ix (Fin N)) (b b' : Fin 2) :
    (X * (eU (Fin.last N) i j : SlopeTestRemainingChoices (Fin (N + 1)) A)) (sn e b) (sn e' b') = if b' = j then X (sn e b) (sn e' i) else 0 := by
  rw [Matrix.mul_apply, sum_snoc]
  simp only [eU_last_snoc, mul_ite, mul_one, mul_zero]
  rw [Finset.sum_eq_single e' (fun e1 _ he => Finset.sum_eq_zero fun c1 _ => if_neg fun h => he h.2.2) (by simp)]
  rw [Finset.sum_eq_single i (fun c1 _ hc => if_neg fun h => hc h.1) (by simp)]
  by_cases h : b' = j
  · rw [if_pos ⟨rfl, h, rfl⟩, if_pos h]
  · rw [if_neg (fun h' => h h'.2.1), if_neg h]

def resM (X : SlopeTestRemainingChoices (Fin (N + 1)) A) : SlopeTestRemainingChoices (Fin N) A := fun e e' => X (sn e 0) (sn e' 0)

/- English proof (translation)
Establish `key : ∀ e e' b b', X (sn e b) (sn e' b') = if b = b' then X (sn e 0) (sn e' 0) else 0`. Introduce `e e' b b'`. Distinguish the cases in `h : b = b'`. Substitute `h` using the available equality. Rewrite using `[if_pos rfl]`.

Use `congrFun (congrFun (hX b 0).eq (sn e b)) (sn e' 0)` as an intermediate fact. Rewrite `this` using `[eU_mul_snoc, mul_eU_snoc, if_pos rfl, if_pos rfl]`. Conclude with `this.symm`. Rewrite using `[if_neg h]`. Use `congrFun (congrFun (hX b b).eq (sn e b)) (sn e' b')` as an intermediate fact.

Rewrite `this` using `[eU_mul_snoc, mul_eU_snoc, if_pos rfl, if_neg (Ne.symm h)]`. Conclude with `this`. Use extensionality with `E E'`. Rewrite using `[← Fin.snoc_init_self (α := fun _ => Fin 2) E, ← Fin.snoc_init_self (α := fun _ => Fin 2) E', key, embM_snoc]`. Both sides reduce to the same expression.
-/
theorem free_embM {X : SlopeTestRemainingChoices (Fin (N + 1)) A} (hX : FreeOf (Fin.last N) X) : X = embM (resM X) := by
  have key : ∀ e e' b b', X (sn e b) (sn e' b') = if b = b' then X (sn e 0) (sn e' 0) else 0 := by
    intro e e' b b'
    by_cases h : b = b'
    · subst h
      rw [if_pos rfl]
      have := congrFun (congrFun (hX b 0).eq (sn e b)) (sn e' 0)
      rw [eU_mul_snoc, mul_eU_snoc, if_pos rfl, if_pos rfl] at this
      exact this.symm
    · rw [if_neg h]
      have := congrFun (congrFun (hX b b).eq (sn e b)) (sn e' b')
      rw [eU_mul_snoc, mul_eU_snoc, if_pos rfl, if_neg (Ne.symm h)] at this
      exact this
  ext E E'
  rw [← Fin.snoc_init_self (α := fun _ => Fin 2) E, ← Fin.snoc_init_self (α := fun _ => Fin 2) E', key, embM_snoc]
  rfl

/- English proof (translation)
Introduce `i j`. Use `show (eU (Fin.last N) i j : SlopeTestRemainingChoices (Fin (N + 1)) A) * embM X = embM X * eU (Fin.last N) i j`. Use extensionality with `E E'`. Rewrite using `[← Fin.snoc_init_self (α := fun _ => Fin 2) E, ← Fin.snoc_init_self (α := fun _ => Fin 2) E', eU_mul_snoc, mul_eU_snoc, embM_snoc, embM_snoc]`. Generalize the expression as in `Fin.init E = e`.

Generalize the expression as in `Fin.init E' = e'`. Generalize the expression as in `E (Fin.last N) = b`. Generalize the expression as in `E' (Fin.last N) = b'`. Apply the tactic sequence `by_cases h1 : b = i <;> by_cases h2 : b' = j <;> by_cases h3 : j = b' <;> by_cases h4 : b = i <;> simp_all`.
-/
theorem embM_free (X : SlopeTestRemainingChoices (Fin N) A) : FreeOf (Fin.last N) (embM X) := by
  intro i j
  show (eU (Fin.last N) i j : SlopeTestRemainingChoices (Fin (N + 1)) A) * embM X = embM X * eU (Fin.last N) i j
  ext E E'
  rw [← Fin.snoc_init_self (α := fun _ => Fin 2) E, ← Fin.snoc_init_self (α := fun _ => Fin 2) E', eU_mul_snoc,
    mul_eU_snoc, embM_snoc, embM_snoc]
  generalize Fin.init E = e; generalize Fin.init E' = e'
  generalize E (Fin.last N) = b; generalize E' (Fin.last N) = b'
  by_cases h1 : b = i <;> by_cases h2 : b' = j <;> by_cases h3 : j = b' <;> by_cases h4 : b = i <;> simp_all

/- English proof (translation)
Establish `e1 : M1 = (M1.map resM).map embM` using `Matrix.ext fun i j => free_embM (h1 i j)`. Establish `e2 : M2 = (M2.map resM).map embM` using `Matrix.ext fun i j => free_embM (h2 i j)`. Establish `key : M1.map resM = M2.map resM`. Use extensionality with `i j e e'`. Use `congrFun (congrFun h (sn e i)) (sn e' j)` as an intermediate fact.

Rewrite `this` using `[e1, e2, ins_last_apply, ins_last_apply]`. Conclude with `this`. Rewrite using `[e1, e2, key]`.
-/
theorem ins_inj_last {M1 M2 : M2 (SlopeTestRemainingChoices (Fin (N + 1)) A)} (h1 : FreeOf2 (Fin.last N) M1) (h2 : FreeOf2 (Fin.last N) M2)
    (h : ins (Fin.last N) M1 = ins (Fin.last N) M2) : M1 = M2 := by
  have e1 : M1 = (M1.map resM).map embM := Matrix.ext fun i j => free_embM (h1 i j)
  have e2 : M2 = (M2.map resM).map embM := Matrix.ext fun i j => free_embM (h2 i j)
  have key : M1.map resM = M2.map resM := by
    ext i j e e'
    have := congrFun (congrFun h (sn e i)) (sn e' j)
    rw [e1, e2, ins_last_apply, ins_last_apply] at this
    exact this
  rw [e1, e2, key]

end Free

