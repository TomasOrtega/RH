        constructor
        · exact le_refl _
        · have : 0 ≤ 2 / L := by positivity
          linarith
    have hpos : (0 : ℝ) ≤ 1 + 2 / L := by positivity
    simp only [phR, List.map_cons, List.prod_cons, List.length_cons] at ih ⊢
    constructor
    · nlinarith [ih.1, hf.1]
    · rw [pow_succ']
