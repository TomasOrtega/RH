theorem nuv_one (j : ℕ) (v : X.Pl) (s : Fin (X.G.P.n' v)) :
    X.nuv v (j + 1) s 1 = X.G.P.lam0 v s 0 + X.w v (j + 1) s := by
  unfold Sys.nuv nu
  rw [if_pos ⟨le_refl 1, by omega⟩]
  unfold lamI
  rw [dif_pos ⟨le_refl 1, by omega⟩]
  rfl

