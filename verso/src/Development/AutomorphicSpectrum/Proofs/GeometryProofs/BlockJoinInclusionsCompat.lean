/- English proof (translation)
Proceed by induction. Treat this case separately. Treat this case separately. Treat this case separately. Simplify using the standard rewrite rules.

Reduce the equality to equality of the corresponding arguments. Simplify using the standard rewrite rules.
-/
theorem mConeMap_rename {K : Type} {ι : K → Type} {K' : Type} {ι' : K' → Type}
    (κ : K → K') (v : (Σ k, ι k) → Σ k, ι' k) {Ω : Type} [Field Ω] (y : (Σ k, ι' k) → Ω)
    (hv : ∀ p, (v p).1 = κ p.1) (f : MvPolynomial (Σ k, ι k) ℤ) :
    mConeMap y (rename v f) = rename κ (mConeMap (y ∘ v) f) := by
  induction f using MvPolynomial.induction_on with
  | C a => simp [mConeMap]
  | add p q hp hq => simp only [map_add, hp, hq]
  | mul_X p i hp =>
    simp only [map_mul, hp, rename_X]
    congr 1
    simp [mConeMap, hv]

/- English proof (translation)
By extensionality, compare the relevant components. Simplify using the standard rewrite rules. Express the relevant assertion in an equivalent form by its definition. Rewrite the conclusion using the stated equalities. A detailed English derivation is pending.
-/
theorem imageZ_coord {K : Type} {ι : K → Type} {K' : Type} {ι' : K' → Type}
    (κ : K → K') (v : (Σ k, ι k) → Σ k, ι' k) {Ω : Type} [Field Ω] (y : (Σ k, ι' k) → Ω)
    (hκ : Function.Injective κ) (hv : ∀ p, (v p).1 = κ p.1) :
    imageZ v (mCoordIdeal y) = mCoordIdeal (y ∘ v) := by
  ext f
  simp only [imageZ, mCoordIdeal, Ideal.mem_comap, RingHom.mem_ker]
  change mConeMap y (rename v f) = 0 ↔ _
  rw [mConeMap_rename κ v y hv f]
  exact map_eq_zero_iff _ (rename_injective κ hκ)

/- English proof (translation)
Apply function extensionality and compare values at an arbitrary argument. Simplify using the standard rewrite rules. Consider separately whether the proposition holds or fails. Extract witnesses or component facts from the available result. Rewrite the conclusion using the stated equalities.

Consider separately whether the proposition holds or fails. Extract witnesses or component facts from the available result. Rewrite the conclusion using the stated equalities. Establish an intermediate fact. Rewrite the conclusion using the stated equalities.

Both sides reduce to the same expression. Establish an intermediate fact. Rewrite the conclusion using the stated equalities. A detailed English derivation is pending.
-/
theorem pullDeg_comp {K K' K'' : Type} (κ : K → K') (κ' : K' → K'')
    (hκ : Function.Injective κ) (hκ' : Function.Injective κ') (a : K → ℤ) :
    pullDeg (κ' ∘ κ) a = pullDeg κ' (pullDeg κ a) := by
  funext k''
  simp only [pullDeg]
  by_cases h' : ∃ k', κ' k' = k''
  · obtain ⟨k', rfl⟩ := h'
    rw [hκ'.extend_apply]
    by_cases h : ∃ k, κ k = k'
    · obtain ⟨k, rfl⟩ := h
      rw [hκ.extend_apply]
      exact (hκ'.comp hκ).extend_apply a 0 k
    · have h2 : ¬∃ k, (κ' ∘ κ) k = κ' k' := fun ⟨k, hk⟩ => h ⟨k, hκ' hk⟩
      rw [Function.extend_apply' _ _ _ h, Function.extend_apply' _ _ _ h2]
      rfl
  · have h2 : ¬∃ k, (κ' ∘ κ) k = k'' := fun ⟨k, hk⟩ => h' ⟨κ k, hk⟩
    rw [Function.extend_apply' _ _ _ h', Function.extend_apply' _ _ _ h2]

