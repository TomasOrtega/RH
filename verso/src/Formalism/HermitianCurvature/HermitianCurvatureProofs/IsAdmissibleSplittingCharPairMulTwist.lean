        ∑ e', G (ixOf P w.length i).1 e' * gRw P (DQ P) L l w e' =
          gRw P (DQ P) L l (Y :: w) (Fin.snoc (α := fun _ => Fin 2) (ixOf P w.length i).1 c) := by
