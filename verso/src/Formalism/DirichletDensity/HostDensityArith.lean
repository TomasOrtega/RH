import Formalism.DirichletDensity.DirichletDensityProofs.QuadDiscr
import Formalism.DirichletDensity.DirichletDensityProofs.MQDiscr
import Formalism.DirichletDensity.DirichletDensityProofs.APLogDensity
import Formalism.DirichletDensity.DirichletDensityProofs.LogToDir
import Formalism.DirichletDensity.DirichletDensityProofs.HostDensityArith
import Formalism.DirichletDensity.DirichletDensityProofs.HostDensity

namespace Formalism.HF.Final

/- English proof (authored)
Use the quadratic discriminant formula for a field generated by a square root of a squarefree integer congruent to one modulo four.
-/
theorem quadDiscr : Formalism.HF.QuadDiscr := Formalism.HF.quadDiscr
/- English proof (authored)
Apply the multiquadratic construction to the quadratic discriminant formula. The induction uses coprime discriminants to combine the quadratic factors and determines the sign from the complex places.
-/
theorem mqDiscr : Formalism.HF.MQDiscr := Formalism.HF.mqDiscr_of quadDiscr
/- English proof (authored)
Specialize the multiquadratic discriminant formula to the three distinct primes of the host field. Each prime has exponent four and the sign is positive.
-/
theorem hostDiscr : Formalism.HF.HostDiscr := Formalism.HF.hostDiscr_of mqDiscr
/- English proof (authored)
Apply the residue-class prime density theorem to the given reduced arithmetic progression. Its logarithmic density is the reciprocal of the totient of the modulus.
-/
theorem apLogDensity : Formalism.HF.APLogDensity := Formalism.HF.apLogDensity
/- English proof (authored)
Use the conversion theorem that integrates the logarithmically weighted prime sum to recover the Dirichlet density with the same value.
-/
theorem logToDir : Formalism.HF.LogToDir := Formalism.HF.logToDir
/- English proof (authored)
Apply the arithmetic sign-density theorem using the logarithmic densities of reduced residue classes and the conversion to Dirichlet density. Both densities for the prescribed three signs are one eighth.
-/
theorem hostDensityArith : Formalism.HF.HostDensityArith := Formalism.HF.hostDensityArith_of apLogDensity logToDir
/- English proof (authored)
Apply the host density theorem to the arithmetic sign-density result. The host Frobenius formula identifies the specified Frobenius class with those three signs at every allowed prime.
-/
theorem hostDensity : Formalism.HF.HostDensity := Formalism.HF.hostDensity_of hostDensityArith

end Formalism.HF.Final
