namespace Formalism.FourierDecayAlt.P.MAx3.L

open Formalism.FourierDecayAlt Formalism.FourierDecayAlt.MA Formalism.FourierDecayAlt.R Formalism.FourierDecayAlt.P.MAx1.An Formalism.FourierDecayAlt.P.MAx2.Jet Formalism.FourierDecayAlt.P.MAx3.G

noncomputable section

section Conj
variable {P : M.Par} (hTT : 0 ≤ P.TT) {L : LevelData (A P (DQ P)) P.r} (hL : IsModelLevel P (DQ P) L)
include hTT hL

/- English proof (translation)
Establish `hLaw` using `Formalism.FourierDecayAlt.P.analytic_laws P.r P.TT hTT`. Establish `hL'` using `hL`. Take `⟨hp, hpb, hc, hci, hcb, hcbi, hz, hzi, hzb, hzbi, hg, hgi, hn, hns, -⟩` from `hL'`. Establish `hpr : ∀ l, L.p l * Gs P s = Gs P s * L.p l + algebraMap ℂ (A P (DQ P)) (s : ℂ) * Gs P s`. Introduce `l`.

Rewrite using `[hp]`. Use `show sc P (DQ P) ((DQ P).pP l) * Gs P s = Gs P s * sc P (DQ P) ((DQ P).pP l) + _`. Rewrite using `[Gs, alg_sc, sc_mul, sc_mul, sc_mul, sc_add, pP_Gpow hLaw]`. Establish `hpbr : ∀ l, L.pb l * Gs P s = Gs P s * L.pb l + algebraMap ℂ (A P (DQ P)) (s : ℂ) * Gs P s`. Introduce `l`.

Rewrite using `[hpb]`. Use `show sc P (DQ P) ((DQ P).pbP l) * Gs P s = Gs P s * sc P (DQ P) ((DQ P).pbP l) + _`. Rewrite using `[Gs, alg_sc, sc_mul, sc_mul, sc_mul, sc_add, pbP_Gpow hLaw]`. Establish `hnr : L.nab * Gs P s = Gs P s * L.nab + algebraMap ℂ (A P (DQ P)) (s : ℂ) * (L.ζb * L.GGi * Gs P s)`. Rewrite using `[hn, hzb, hgi]`.

Simplify using `only [nabA, zbA, ggiA, Gs, sc_diag, alg_diag, Matrix.diagonal_mul_diagonal, Matrix.diagonal_add]`. Use `congr 1`. Use function extensionality and compare the values at `π`. Conclude with `nab_Gpow hLaw s (M.aC P π)`. Establish `hnsr : L.nabs * Gs P s = Gs P s * L.nabs - algebraMap ℂ (A P (DQ P)) (s : ℂ) * (L.ζ * L.GGi * Gs P s)`.

Rewrite using `[hns, hz, hgi]`. Simplify using `only [nabsA, zA, ggiA, Gs, sc_diag, alg_diag, Matrix.diagonal_mul_diagonal, Matrix.diagonal_sub]`. Use `congr 1`. Use function extensionality and compare the values at `π`. Conclude with `nabs_Gpow hLaw s (M.aC P π)`.

Establish `h` using `Formalism.FourierDecayAlt.P.gaugeConjugation (A P (DQ P)) P.r L (s : ℂ) (Gs P s) (Gs P (-s)) (Gs_mul_neg P s) (Gs_neg_mul P s) (fns_comm hTT hL s) hpr hpbr hnr hnsr Y`. Conclude with `⟨h.2.2.1, h.2.2.2⟩`.
-/
theorem conj_hatv (s : ℝ) (Y : ℂ) :
    Gs P (-s) * L.Ahatv Y * Gs P s = L.Ahatv (Y - s) ∧ Gs P (-s) * L.R0v Y * Gs P s = L.R0v (Y - s) := by
  have hLaw := Formalism.FourierDecayAlt.P.analytic_laws P.r P.TT hTT
  have hL' := hL
  obtain ⟨hp, hpb, hc, hci, hcb, hcbi, hz, hzi, hzb, hzbi, hg, hgi, hn, hns, -⟩ := hL'
  have hpr : ∀ l, L.p l * Gs P s = Gs P s * L.p l + algebraMap ℂ (A P (DQ P)) (s : ℂ) * Gs P s := by
    intro l
    rw [hp]
    show sc P (DQ P) ((DQ P).pP l) * Gs P s = Gs P s * sc P (DQ P) ((DQ P).pP l) + _
    rw [Gs, alg_sc, sc_mul, sc_mul, sc_mul, sc_add, pP_Gpow hLaw]
  have hpbr : ∀ l, L.pb l * Gs P s = Gs P s * L.pb l + algebraMap ℂ (A P (DQ P)) (s : ℂ) * Gs P s := by
    intro l
    rw [hpb]
    show sc P (DQ P) ((DQ P).pbP l) * Gs P s = Gs P s * sc P (DQ P) ((DQ P).pbP l) + _
    rw [Gs, alg_sc, sc_mul, sc_mul, sc_mul, sc_add, pbP_Gpow hLaw]
  have hnr : L.nab * Gs P s = Gs P s * L.nab + algebraMap ℂ (A P (DQ P)) (s : ℂ) * (L.ζb * L.GGi * Gs P s) := by
    rw [hn, hzb, hgi]
    simp only [nabA, zbA, ggiA, Gs, sc_diag, alg_diag, Matrix.diagonal_mul_diagonal, Matrix.diagonal_add]
    congr 1; funext π
    exact nab_Gpow hLaw s (M.aC P π)
  have hnsr : L.nabs * Gs P s = Gs P s * L.nabs - algebraMap ℂ (A P (DQ P)) (s : ℂ) * (L.ζ * L.GGi * Gs P s) := by
    rw [hns, hz, hgi]
    simp only [nabsA, zA, ggiA, Gs, sc_diag, alg_diag, Matrix.diagonal_mul_diagonal, Matrix.diagonal_sub]
    congr 1; funext π
    exact nabs_Gpow hLaw s (M.aC P π)
  have h := Formalism.FourierDecayAlt.P.gaugeConjugation (A P (DQ P)) P.r L (s : ℂ) (Gs P s) (Gs P (-s)) (Gs_mul_neg P s)
    (Gs_neg_mul P s) (fns_comm hTT hL s) hpr hpbr hnr hnsr Y
  exact ⟨h.2.2.1, h.2.2.2⟩

end Conj

section Poly
variable (P : M.Par) (L : LevelData (A P (DQ P)) P.r) (Y0 : ℂ)

/- English proof (translation)
Use `⟨!![1, 0; 0, 0], L.Tvl Y0 l, fun s => ?_⟩` and prove the remaining obligations. Use extensionality with `i j`. Apply the tactic sequence `fin_cases i <;> fin_cases j <;>`. Apply the tactic sequence `simp [LevelData.Tvl, map_add, Algebra.algebraMap_eq_smul_one] <;> abel`.
-/
theorem Tvl_affine (l : Fin P.r) : ∃ u v : Matrix (Fin 2) (Fin 2) (A P (DQ P)),
    ∀ s : ℂ, L.Tvl (Y0 + s) l = s • u + v := by
  refine ⟨!![1, 0; 0, 0], L.Tvl Y0 l, fun s => ?_⟩
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [LevelData.Tvl, map_add, Algebra.algebraMap_eq_smul_one] <;> abel

/- English proof (translation)
Establish `h` using `polyIn_list_prod ((List.ofFn fun l : Fin P.r => fun s : ℂ => L.Tvl (Y0 + s) l).reverse) (fun g hg => by`. Take `⟨l, rfl⟩` from `List.mem_ofFn.1 (List.mem_reverse.1 hg)`. Conclude with `Tvl_affine P L Y0 l)`. Rewrite `h` using `[List.length_reverse, List.length_ofFn]`. Use `(congrArg (fun F => PolyIn F P.r) (funext fun s => ?_)).mp h` and prove the remaining obligations.

Simplify using `only [LevelData.Tvprod, List.map_reverse, List.map_ofFn]`. Both sides reduce to the same expression.
-/
theorem Tvprod_poly : PolyIn (fun s : ℂ => L.Tvprod (Y0 + s)) P.r := by
  have h := polyIn_list_prod ((List.ofFn fun l : Fin P.r => fun s : ℂ => L.Tvl (Y0 + s) l).reverse)
    (fun g hg => by
      obtain ⟨l, rfl⟩ := List.mem_ofFn.1 (List.mem_reverse.1 hg)
      exact Tvl_affine P L Y0 l)
  rw [List.length_reverse, List.length_ofFn] at h
  refine (congrArg (fun F => PolyIn F P.r) (funext fun s => ?_)).mp h
  simp only [LevelData.Tvprod, List.map_reverse, List.map_ofFn]
  rfl

/- English proof (translation)
The claim follows from `polyIn_const_mul L.Drb (polyIn_entry (Tvprod_poly P L Y0) 0 0)`.
-/
theorem Ahatv_poly : PolyIn (fun s : ℂ => L.Ahatv (Y0 + s)) P.r :=
  polyIn_const_mul L.Drb (polyIn_entry (Tvprod_poly P L Y0) 0 0)

/- English proof (translation)
Use `⟨-(L.ζ * L.GGi), L.m0 Y0, fun s => ?_⟩` and prove the remaining obligations. Simplify using `only [LevelData.m0, map_add, map_sub, Algebra.algebraMap_eq_smul_one, add_mul, sub_mul, smul_mul_assoc, one_mul, smul_neg, add_smul, sub_smul]`. Normalize the expressions using the abelian group laws.
-/
theorem raising_constant_affine : ∃ u v : A P (DQ P), ∀ s : ℂ, L.m0 (Y0 + s) = s • u + v := by
  refine ⟨-(L.ζ * L.GGi), L.m0 Y0, fun s => ?_⟩
  simp only [LevelData.m0, map_add, map_sub, Algebra.algebraMap_eq_smul_one, add_mul, sub_mul, smul_mul_assoc,
    one_mul, smul_neg, add_smul, sub_smul]
  abel

/- English proof (translation)
Take `⟨u, v, huv⟩` from `raising_constant_affine P L Y0`. Apply the tactic sequence `have h1 := polyIn_affine_mul u v (polyIn_entry (Tvprod_poly P L Y0) 0 0)`. Apply the tactic sequence `have h2 := polyIn_mono (polyIn_entry (Tvprod_poly P L Y0) 1 0) (Nat.le_succ P.r)`. Establish `h3` using `polyIn_const_mul (L.Dr * L.GG) (polyIn_add h1 h2)`. Use `(congrArg (fun F => PolyIn F (P.r + 1)) (funext fun s => ?_)).mp h3` and prove the remaining obligations.

Simplify using `only [LevelData.R0v, LevelData.Avr, LevelData.Bvr, huv]`.
-/
theorem raising_variant_polynomial : PolyIn (fun s : ℂ => L.R0v (Y0 + s)) (P.r + 1) := by
  obtain ⟨u, v, huv⟩ := raising_constant_affine P L Y0
  have h1 := polyIn_affine_mul u v (polyIn_entry (Tvprod_poly P L Y0) 0 0)
  have h2 := polyIn_mono (polyIn_entry (Tvprod_poly P L Y0) 1 0) (Nat.le_succ P.r)
  have h3 := polyIn_const_mul (L.Dr * L.GG) (polyIn_add h1 h2)
  refine (congrArg (fun F => PolyIn F (P.r + 1)) (funext fun s => ?_)).mp h3
  simp only [LevelData.R0v, LevelData.Avr, LevelData.Bvr, huv]

end Poly

/- English proof (translation)
Take `⟨a, ha⟩` from `hpolyIn`. Use `set a' : ℕ → A P (DQ P) := fun k => if k < d + 1 then a k else 0`. Establish `ha' : ∀ t, X (y + t) = ∑ k ∈ Finset.range (d + 1), t ^ k • a' k` using `fun t => by`. Rewrite using `[show X (y + t) = (fun t => X (y + t)) t from rfl, ha t]`. Conclude with `Finset.sum_congr rfl fun k hk => by simp only [a']; rw [if_pos (Finset.mem_range.1 hk)]`.

Establish `hspan : ∀ k, a' k ∈ Submodule.span ℂ (Set.range fun n : Fin (d + 1) => X (y + n))`. Introduce `k`. Distinguish the cases in `hk : k < d + 1`. Use `polyIn_coeff_span (fun t => X (y + t)) d a' ha' k (Finset.mem_range.2 hk)` as an intermediate fact. Simplify using `using this`.

Establish `: a' k = 0` using `by simp only [a']; rw [if_neg hk]`. Rewrite using `[this]`. Conclude with `Submodule.zero_mem _`. Establish `hsub : Submodule.span ℂ (Set.range fun n : Fin (d + 1) => X (y + n)) ≤ Subalgebra.toSubmodule (JetMatrixAlgebra P)` using `Submodule.span_le.2 (by rintro _ ⟨n, rfl⟩; exact hmem _)`. Use `⟨a', hspan, mat_leibniz P X y σ d a' ha' hconj (fun π π' => ((hmem y) π π').1) (fun k π π' => ?_) φ hφ⟩` and prove the remaining obligations.

Conclude with `((hsub (hspan k)) π π').2`.
-/
theorem leib_gen (P : M.Par) (X : ℂ → A P (DQ P)) (y : ℂ) (σ : ℝ) (d : ℕ)
    (hpolyIn : PolyIn (fun t => X (y + t)) d)
    (hconj : ∀ s : ℝ, Gs P (-s) * X y * Gs P s = X (y + ((σ * s : ℝ) : ℂ)))
    (hmem : ∀ t, X t ∈ JetMatrixAlgebra P) (φ : ℝ → ℝ) (hφ : LE.SmoothLog φ) :
    ∃ a : ℕ → A P (DQ P), (∀ k, a k ∈ Submodule.span ℂ (Set.range fun n : Fin (d + 1) => X (y + n))) ∧
      X y * sc P (DQ P) (Fq P φ 0) = ∑ p ∈ Finset.range (d + 1), sc P (DQ P) (Fq P φ p) * (((σ : ℂ) ^ p) • a p) := by
  obtain ⟨a, ha⟩ := hpolyIn
  set a' : ℕ → A P (DQ P) := fun k => if k < d + 1 then a k else 0
  have ha' : ∀ t, X (y + t) = ∑ k ∈ Finset.range (d + 1), t ^ k • a' k := fun t => by
    rw [show X (y + t) = (fun t => X (y + t)) t from rfl, ha t]
    exact Finset.sum_congr rfl fun k hk => by simp only [a']; rw [if_pos (Finset.mem_range.1 hk)]
  have hspan : ∀ k, a' k ∈ Submodule.span ℂ (Set.range fun n : Fin (d + 1) => X (y + n)) := by
    intro k
    by_cases hk : k < d + 1
    · have := polyIn_coeff_span (fun t => X (y + t)) d a' ha' k (Finset.mem_range.2 hk)
      simpa using this
    · have : a' k = 0 := by simp only [a']; rw [if_neg hk]
      rw [this]; exact Submodule.zero_mem _
  have hsub : Submodule.span ℂ (Set.range fun n : Fin (d + 1) => X (y + n)) ≤ Subalgebra.toSubmodule (JetMatrixAlgebra P) :=
    Submodule.span_le.2 (by rintro _ ⟨n, rfl⟩; exact hmem _)
  refine ⟨a', hspan, mat_leibniz P X y σ d a' ha' hconj (fun π π' => ((hmem y) π π').1) (fun k π π' => ?_) φ hφ⟩
  exact ((hsub (hspan k)) π π').2

end

end Formalism.FourierDecayAlt.P.MAx3.L

