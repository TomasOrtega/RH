/- English proof (translation)
Rewrite using `[Formalism.FourierDecayAlt.P.word_product_formula ℂ (A P (DQ P)) (Fin (w.length + 1)) _ (sites P (DQ P)) _ hS hGl (sn e b)]`. Distinguish the cases in `hb : b = 0`. Substitute `hb` using the available equality. Rewrite using `[if_pos (fun c hc => ?_), if_pos rfl, uw_prod P (DQ P) l hS w hG e, List.map_map]`. Use `congr 1`.

Use `List.map_congr_left fun a ha => ?_` and prove the remaining obligations. Simplify using `only [Function.comp_apply, liftL, if_pos (plusWord_letters_plus w a ha), Fin.snoc_castSucc]`. Proceed by induction on `c using Fin.lastCases with`. Consider the case `last => simp`. Consider the case `cast k => exact absurd (mem_lift_positions w k) hc`.

Rewrite using `[if_neg (fun h => hb (by have := h _ (last_not_mem w); simpa using this)), if_neg hb]`.
-/
theorem uw_lift (hS : SitesOK (K := ℂ) (startM P (DQ P) l).QQ (sites P (DQ P))) (w : List ℝ)
    (hG : Good (wordP w)) (hGl : Good ((wordP w).map liftL)) (e : Ix (Fin w.length)) (b : Fin 2) :
    uw (sites P (DQ P)) ((wordP w).map liftL) (sn e b) = if b = 0 then uw (sites P (DQ P)) (wordP w) e else 0 := by
  rw [Formalism.FourierDecayAlt.P.word_product_formula ℂ (A P (DQ P)) (Fin (w.length + 1)) _ (sites P (DQ P)) _ hS hGl (sn e b)]
  by_cases hb : b = 0
  · subst hb
    rw [if_pos (fun c hc => ?_), if_pos rfl, uw_prod P (DQ P) l hS w hG e, List.map_map]
    · congr 1
      refine List.map_congr_left fun a ha => ?_
      simp only [Function.comp_apply, liftL, if_pos (plusWord_letters_plus w a ha), Fin.snoc_castSucc]
    · induction c using Fin.lastCases with
      | last => simp
      | cast k => exact absurd (mem_lift_positions w k) hc
  · rw [if_neg (fun h => hb (by have := h _ (last_not_mem w); simpa using this)), if_neg hb]

/- English proof (translation)
Establish `hTT : 0 ≤ P.TT` using `(mul_pos hOK.T_pos hOK.T'_pos).le`. Establish `hcwl` using `cut_lift_tail Y w hcw`. Establish `hGl : Good ((wordP w).map liftL)` using `good_of_cutW _ (liftL_plus w) hcwl`. Establish `hG : Good (wordP w)` using `good_of_cut w (cut_tail Y w hcw)`. Establish `hMW` using `(Formalism.FourierDecayAlt.P.model_words P hOK (DQ P) (Formalism.FourierDecayAlt.P.analytic_laws P.r P.TT hTT) l (Fin (w.length + 1)) ((wordP w).map liftL) hGl).2 ((Y : ℝ) : ℂ) (reg_new Y w hcw) (Complex.conj_ofReal _) (sn e 0)`.

Establish `hTTf` using `TT_free (P := P) (l := l) L Y w`. Establish `hCw : Cw (startM P (DQ P) l).QQ (sites P (DQ P)) ((wordP w).map liftL) ((Y : ℝ) : ℂ) = embM (CwR L l Y w)`. Unfold `Cw CwR`. Rewrite using `[embM_sum]`. Use `Finset.sum_congr rfl fun k _ => ?_` and prove the remaining obligations.

Rewrite using `[embM_sum]`. Use `Finset.sum_congr rfl fun k' _ => ?_` and prove the remaining obligations. Rewrite using `[embM_mul, embM_mul, embM_io, embM_io]`. Establish `hv : ∀ c, v0 (sites P (DQ P)) ((Y : ℝ) : ℂ) c = (![L.Ar ((Y : ℝ) : ℂ), L.Br ((Y : ℝ) : ℂ)] : Fin 2 → A P (DQ P)) c`. Introduce `c`.

Use `fin_cases c`. Conclude with `site_vector_first P (DQ P) L hL _`. Conclude with `site_vector_second P (DQ P) L hL _`. Conclude with `congr (congrArg (· * ·) (congrArg₂ (· * ·) (congrArg (fun x => (io (star x) : SlopeTestRemainingChoices (Fin (w.length + 1)) (A P (DQ P)))) (hv k)) (free_embM (hTTf k k')))) (congrArg (fun x => (io x : SlopeTestRemainingChoices (Fin (w.length + 1)) (A P (DQ P)))) (hv k'))`. Rewrite `hMW` using `[hCw, uw_lift hS w hG hGl e 0, if_pos rfl, sum_snoc]`.

Simplify using `only [embM_snoc, uw_lift hS w hG hGl, ite_mul, zero_mul] at hMW`. Rewrite using `[← hMW]`. Use `Finset.sum_congr rfl fun e' _ => ?_` and prove the remaining obligations. Rewrite using `[Finset.sum_eq_single 0 (fun b _ hb => by rw [if_neg (Ne.symm hb)]) (by simp), if_pos rfl, if_pos rfl]`.
-/
theorem core4 (hL : IsModelLevel P (DQ P) L) (hOK : P.OK) (hS : SitesOK (K := ℂ) (startM P (DQ P) l).QQ (sites P (DQ P)))
    (Y : ℝ) (w : List ℝ) (hcw : M.CutWord P l (wordP (Y :: w))) (e : Ix (Fin w.length)) :
    ∑ e', CwR L l Y w e e' * uw (sites P (DQ P)) (wordP w) e' =
      uw (sites P (DQ P)) (wordP w) e * C0 (startM P (DQ P) l).QQ (sites P (DQ P)) ((Y : ℝ) : ℂ) := by
  have hTT : 0 ≤ P.TT := (mul_pos hOK.T_pos hOK.T'_pos).le
  have hcwl := cut_lift_tail Y w hcw
  have hGl : Good ((wordP w).map liftL) := good_of_cutW _ (liftL_plus w) hcwl
  have hG : Good (wordP w) := good_of_cut w (cut_tail Y w hcw)
  have hMW := (Formalism.FourierDecayAlt.P.model_words P hOK (DQ P) (Formalism.FourierDecayAlt.P.analytic_laws P.r P.TT hTT) l
    (Fin (w.length + 1)) ((wordP w).map liftL) hGl).2 ((Y : ℝ) : ℂ) (reg_new Y w hcw) (Complex.conj_ofReal _) (sn e 0)

  have hTTf := TT_free (P := P) (l := l) L Y w
  have hCw : Cw (startM P (DQ P) l).QQ (sites P (DQ P)) ((wordP w).map liftL) ((Y : ℝ) : ℂ) = embM (CwR L l Y w) := by
    unfold Cw CwR
    rw [embM_sum]
    refine Finset.sum_congr rfl fun k _ => ?_
    rw [embM_sum]
    refine Finset.sum_congr rfl fun k' _ => ?_
    rw [embM_mul, embM_mul, embM_io, embM_io]
    have hv : ∀ c, v0 (sites P (DQ P)) ((Y : ℝ) : ℂ) c = (![L.Ar ((Y : ℝ) : ℂ), L.Br ((Y : ℝ) : ℂ)] : Fin 2 → A P (DQ P)) c := by
      intro c; fin_cases c
      · exact site_vector_first P (DQ P) L hL _
      · exact site_vector_second P (DQ P) L hL _
    exact congr (congrArg (· * ·) (congrArg₂ (· * ·)
      (congrArg (fun x => (io (star x) : SlopeTestRemainingChoices (Fin (w.length + 1)) (A P (DQ P)))) (hv k)) (free_embM (hTTf k k'))))
      (congrArg (fun x => (io x : SlopeTestRemainingChoices (Fin (w.length + 1)) (A P (DQ P)))) (hv k'))
  rw [hCw, uw_lift hS w hG hGl e 0, if_pos rfl, sum_snoc] at hMW
  simp only [embM_snoc, uw_lift hS w hG hGl, ite_mul, zero_mul] at hMW
  rw [← hMW]
  refine Finset.sum_congr rfl fun e' _ => ?_
  rw [Finset.sum_eq_single 0 (fun b _ hb => by rw [if_neg (Ne.symm hb)]) (by simp), if_pos rfl, if_pos rfl]

end Core4

