/- English proof (translation)
Take `⟨h1, M1, b1, e1⟩` from `hx`. Take `⟨h2, M2, b2, e2⟩` from `hy`. Use `⟨by positivity, fun q => M1 q + M2 q, fun q π π' => ?_, fun f q π => ?_⟩` and prove the remaining obligations. Conclude with `(norm_add_le _ _).trans (add_le_add (b1 q π π') (b2 q π π'))`. Rewrite using `[MAx2.R2.act_add, G.evQ_add, e1, e2, ← Finset.sum_add_distrib]`.

Conclude with `Finset.sum_congr rfl fun π' _ => by simp [add_mul]`.
-/
theorem PW_add {x y : A P (DQ P)} {C₁ C₂ : ℝ} (hx : PW x C₁) (hy : PW y C₂) : PW (x + y) (C₁ + C₂) := by
  obtain ⟨h1, M1, b1, e1⟩ := hx
  obtain ⟨h2, M2, b2, e2⟩ := hy
  refine ⟨by positivity, fun q => M1 q + M2 q, fun q π π' => ?_, fun f q π => ?_⟩
  · exact (norm_add_le _ _).trans (add_le_add (b1 q π π') (b2 q π π'))
  · rw [MAx2.R2.act_add, G.evQ_add, e1, e2, ← Finset.sum_add_distrib]
    exact Finset.sum_congr rfl fun π' _ => by simp [add_mul]

/- English proof (translation)
Use `⟨norm_nonneg _, fun _ π π' => if π = π' then c else 0, fun q π π' => ?_, fun f q π => ?_⟩` and prove the remaining obligations. Apply the tactic sequence `dsimp only; split_ifs <;> simp`. Rewrite using `[MAx2.R2.act_alg, Finset.sum_eq_single π (fun b _ hb => by dsimp only; rw [if_neg (Ne.symm hb), zero_mul]) (by simp)] dsimp only`. Rewrite using `[if_pos rfl]`. Both sides reduce to the same expression.
-/
theorem PW_alg (c : ℂ) : PW (algebraMap ℂ (A P (DQ P)) c) ‖c‖ := by
  classical
  refine ⟨norm_nonneg _, fun _ π π' => if π = π' then c else 0, fun q π π' => ?_, fun f q π => ?_⟩
  · dsimp only; split_ifs <;> simp
  · rw [MAx2.R2.act_alg, Finset.sum_eq_single π (fun b _ hb => by dsimp only; rw [if_neg (Ne.symm hb), zero_mul])
      (by simp)]
    dsimp only
    rw [if_pos rfl]
    rfl

/- English proof (translation)
Take `⟨h0, Mx, b, e⟩` from `hx`. Establish `key` using `e (fun π'' => if π'' = π' then 1 else 0) q π`. Establish `hl : actA P x (fun π'' => if π'' = π' then 1 else 0) π = (x π π').1 1`. Rewrite using `[MAx2.R2.actA_eq, Finset.sum_eq_single π' (fun b _ hb => by rw [if_neg hb, map_zero]) (by simp), if_pos rfl]`. Both sides reduce to the same expression.

Rewrite `key` using `[hl]`. Rewrite using `[key, Finset.sum_eq_single π' (fun b _ hb => by rw [if_neg hb, G.evQ_zero, mul_zero]) (by simp), if_pos rfl]`. Use `show ‖Mx q π π' * 1‖ ≤ C`. Rewrite using `[mul_one]`. Conclude with `b q π π'`.
-/
theorem PW_entry {x : A P (DQ P)} {C : ℝ} (hx : PW x C) (q : Qp P.r P.TT) (π π' : M.Ty P) :
    ‖evQ P ((x π π').1 1) q‖ ≤ C := by
  classical
  obtain ⟨h0, Mx, b, e⟩ := hx
  have key := e (fun π'' => if π'' = π' then 1 else 0) q π
  have hl : actA P x (fun π'' => if π'' = π' then 1 else 0) π = (x π π').1 1 := by
    rw [MAx2.R2.actA_eq, Finset.sum_eq_single π' (fun b _ hb => by rw [if_neg hb, map_zero]) (by simp), if_pos rfl]
    rfl
  rw [hl] at key
  rw [key, Finset.sum_eq_single π' (fun b _ hb => by rw [if_neg hb, G.evQ_zero, mul_zero]) (by simp), if_pos rfl]
  show ‖Mx q π π' * 1‖ ≤ C
  rw [mul_one]; exact b q π π'

/- English proof (translation)
Both sides reduce to the same expression.
-/
theorem ptMat_add {N : ℕ} (b c : SlopeTestRemainingChoices (Fin N) (A P (DQ P))) (q : Qp P.r P.TT) (i i' : Iota P N) :
    ptMat P (b + c) q i i' = ptMat P b q i i' + ptMat P c q i i' := rfl

/- English proof (translation)
Use `show evQ P (((z • b (ixOf P N i).1 (ixOf P N i').1) (ixOf P N i).2 (ixOf P N i').2).1 1) q = _`. Rewrite using `[show ((z • b (ixOf P N i).1 (ixOf P N i').1) (ixOf P N i).2 (ixOf P N i').2) = z • ((b (ixOf P N i).1 (ixOf P N i').1) (ixOf P N i).2 (ixOf P N i').2) from rfl, G.pfst_smul]`. Both sides reduce to the same expression.
-/
theorem ptMat_smul {N : ℕ} (z : ℂ) (b : SlopeTestRemainingChoices (Fin N) (A P (DQ P))) (q : Qp P.r P.TT) (i i' : Iota P N) :
    ptMat P (z • b) q i i' = z * ptMat P b q i i' := by
  show evQ P (((z • b (ixOf P N i).1 (ixOf P N i').1) (ixOf P N i).2 (ixOf P N i').2).1 1) q = _
  rw [show ((z • b (ixOf P N i).1 (ixOf P N i').1) (ixOf P N i).2 (ixOf P N i').2) =
    z • ((b (ixOf P N i).1 (ixOf P N i').1) (ixOf P N i).2 (ixOf P N i').2) from rfl, G.pfst_smul]
  rfl

/- English proof (translation)
Proceed by induction on `ts with`. Consider the case `nil => rfl`. Consider the case `cons a ts ih => rw [List.map_cons, List.sum_cons, ptMat_add, ptMat_smul, ih, List.map_cons, List.sum_cons]`.
-/
theorem ptMat_listsum {N : ℕ} (ts : List ((ℂ → ℂ) × SlopeTestRemainingChoices (Fin N) (A P (DQ P)))) (Y : ℂ) (q : Qp P.r P.TT)
    (i i' : Iota P N) :
    ptMat P ((ts.map fun t => t.1 Y • t.2).sum) q i i' = (ts.map fun t => t.1 Y * ptMat P t.2 q i i').sum := by
  induction ts with
  | nil => rfl
  | cons a ts ih => rw [List.map_cons, List.sum_cons, ptMat_add, ptMat_smul, ih, List.map_cons, List.sum_cons]

section PWBA
variable {L : LevelData (A P (DQ P)) P.r} (hTTp : 0 < P.TT) (hL : IsModelLevel P (DQ P) L)
  (hLaw : (DQ P).Laws P.TT)
include hTTp hL hLaw

/- English proof (translation)
Proceed by induction on `hx using Algebra.adjoin_induction with`. Consider the case `mem x hx => exact PW_gen hTTp hL hLaw hx`. Consider the case `algebraMap c => exact ⟨_, PW_alg c⟩`. Consider the case `add x y _ _ h1 h2 => obtain ⟨C1, h1⟩ := h1`. Take `⟨C2, h2⟩` from `h2`.

Conclude with `⟨_, PW_add h1 h2⟩`. Consider the case `mul x y _ _ h1 h2 => obtain ⟨C1, h1⟩ := h1`. Take `⟨C2, h2⟩` from `h2`. Conclude with `⟨_, PW_mul h1 h2⟩`.
-/
theorem PW_BA {x : A P (DQ P)} (hx : x ∈ BA L) : ∃ C, PW x C := by
  induction hx using Algebra.adjoin_induction with
  | mem x hx => exact PW_gen hTTp hL hLaw hx
  | algebraMap c => exact ⟨_, PW_alg c⟩
  | add x y _ _ h1 h2 => obtain ⟨C1, h1⟩ := h1; obtain ⟨C2, h2⟩ := h2; exact ⟨_, PW_add h1 h2⟩
  | mul x y _ _ h1 h2 => obtain ⟨C1, h1⟩ := h1; obtain ⟨C2, h2⟩ := h2; exact ⟨_, PW_mul h1 h2⟩

/- English proof (translation)
Establish `h : ∀ e e', ∃ C, PW (E e e') C` using `fun e e' => PW_BA hTTp hL hLaw (hE e e')`. Use `choose C hC using h`. Use `⟨∑ e, ∑ e', C e e', fun q i i' => ?_⟩` and prove the remaining obligations. Apply the tactic sequence `have h1 := PW_entry (hC (ixOf P N i).1 (ixOf P N i').1) q (ixOf P N i).2 (ixOf P N i').2`. Use `h1.trans ?_` and prove the remaining obligations.

Conclude with `(Finset.single_le_sum (f := fun e' => C (ixOf P N i).1 e') (fun e' _ => (hC _ e').1) (Finset.mem_univ _)).trans (Finset.single_le_sum (f := fun e => ∑ e', C e e') (fun e _ => Finset.sum_nonneg fun e' _ => (hC e e').1) (Finset.mem_univ _))`.
-/
theorem ptMat_bound {N : ℕ} {E : SlopeTestRemainingChoices (Fin N) (A P (DQ P))} (hE : E ∈ UB L (Fin N)) :
    ∃ C, ∀ q i i', ‖ptMat P E q i i'‖ ≤ C := by
  have h : ∀ e e', ∃ C, PW (E e e') C := fun e e' => PW_BA hTTp hL hLaw (hE e e')
  choose C hC using h
  refine ⟨∑ e, ∑ e', C e e', fun q i i' => ?_⟩
  have h1 := PW_entry (hC (ixOf P N i).1 (ixOf P N i').1) q (ixOf P N i).2 (ixOf P N i').2
  refine h1.trans ?_
  exact (Finset.single_le_sum (f := fun e' => C (ixOf P N i).1 e') (fun e' _ => (hC _ e').1) (Finset.mem_univ _)).trans
    (Finset.single_le_sum (f := fun e => ∑ e', C e e') (fun e _ => Finset.sum_nonneg fun e' _ => (hC e e').1)
      (Finset.mem_univ _))

end PWBA

/- English proof (translation)
Use `set f : ℂ[X] := ∑ k : Fin (d + 1), C (c k) * X ^ (k : ℕ)`. Establish `hinj : Set.InjOn (fun m : Fin (d + 1) => ((m : ℕ) : ℂ)) (Finset.univ : Finset (Fin (d + 1)))`. Introduce `a _ b _ h; simp only at h; exact Fin.ext (by exact_mod_cast h)`. Establish `hdeg : f.degree < (Finset.univ : Finset (Fin (d + 1))).card`. Rewrite using `[Finset.card_univ, Fintype.card_fin]`.

Conclude with `degree_sum_fin_lt c`. Establish `hf` using `Lagrange.eq_interpolate hinj hdeg`. Establish `hev : ∀ Z, f.eval Z = ∑ k : Fin (d + 1), Z ^ (k : ℕ) * c k` using `fun Z => by`. Simplify using `only [f, eval_finset_sum, eval_mul, eval_C, eval_pow, eval_X]`. Conclude with `Finset.sum_congr rfl fun k _ => mul_comm _ _`.

Use `congrArg (eval Y) hf` as an intermediate fact. Rewrite `this` using `[hev, Lagrange.interpolate_apply, eval_finset_sum]`. Rewrite using `[this]`. Use `Finset.sum_congr rfl fun m _ => ?_` and prove the remaining obligations. Rewrite using `[eval_mul, eval_C, hev]`.
-/
theorem lagrange (d : ℕ) (c : Fin (d + 1) → ℂ) (Y : ℂ) :
    ∑ k : Fin (d + 1), Y ^ (k : ℕ) * c k = ∑ m : Fin (d + 1), (∑ k : Fin (d + 1), ((m : ℕ) : ℂ) ^ (k : ℕ) * c k) *
      (Lagrange.basis Finset.univ (fun m : Fin (d + 1) => ((m : ℕ) : ℂ)) m).eval Y := by
  set f : ℂ[X] := ∑ k : Fin (d + 1), C (c k) * X ^ (k : ℕ)
  have hinj : Set.InjOn (fun m : Fin (d + 1) => ((m : ℕ) : ℂ)) (Finset.univ : Finset (Fin (d + 1))) := by
    intro a _ b _ h; simp only at h; exact Fin.ext (by exact_mod_cast h)
  have hdeg : f.degree < (Finset.univ : Finset (Fin (d + 1))).card := by
    rw [Finset.card_univ, Fintype.card_fin]; exact degree_sum_fin_lt c
  have hf := Lagrange.eq_interpolate hinj hdeg
  have hev : ∀ Z, f.eval Z = ∑ k : Fin (d + 1), Z ^ (k : ℕ) * c k := fun Z => by
    simp only [f, eval_finset_sum, eval_mul, eval_C, eval_pow, eval_X]
    exact Finset.sum_congr rfl fun k _ => mul_comm _ _
  have := congrArg (eval Y) hf
  rw [hev, Lagrange.interpolate_apply, eval_finset_sum] at this
  rw [this]
  refine Finset.sum_congr rfl fun m _ => ?_
  rw [eval_mul, eval_C, hev]

end

