section S_AB_AB1

set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace Formalism.FourierDecayAlt.P.MAx3.AB

open Formalism.FourierDecayAlt.R Formalism.FourierDecayAlt.R.LevelData Formalism.FourierDecayAlt.P.RuleGD Formalism.FourierDecayAlt.P.MAx3.H Formalism.FourierDecayAlt.P.MAx3.K

variable {A : Type} [Ring A] [Algebra ℂ A] {r : ℕ} (L : LevelData A r) (S : Submonoid A)

def MS (n k : ℕ) : Submodule ℂ A :=
  Submodule.span ℂ {x | ∃ β X, β ∈ S ∧ X ∈ minusHats L ∧ x = β * (L.D ^ n * L.Dbi ^ k) * X}

/- English proof (translation)
The claim follows from `(Commute.pow_right (Ahatv_D L Y) n).eq`.
-/
theorem Ahatv_Dpow (n : ℕ) (Y : ℂ) : L.Ahatv Y * L.D ^ n = L.D ^ n * L.Ahatv Y :=
  (Commute.pow_right (Ahatv_D L Y) n).eq
/- English proof (translation)
The claim follows from `(Commute.pow_right (raising_variant_commute_D L Y) n).eq`.
-/
theorem raising_variant_D_pow (n : ℕ) (Y : ℂ) : L.R0v Y * L.D ^ n = L.D ^ n * L.R0v Y :=
  (Commute.pow_right (raising_variant_commute_D L Y) n).eq

/- English proof (translation)
Rewrite using `[← mul_assoc, Ahatv_Dpow, mul_assoc, Ahatv_Dbipow, mul_assoc]`.
-/
theorem Ahatv_DD (n k : ℕ) (Y : ℂ) : L.Ahatv Y * (L.D ^ n * L.Dbi ^ k) = (L.D ^ n * L.Dbi ^ k) * L.Ahatv (Y + k) := by
  rw [← mul_assoc, Ahatv_Dpow, mul_assoc, Ahatv_Dbipow, mul_assoc]

variable {L S}

/- English proof (translation)
The claim follows from `Submodule.subset_span ⟨β, X, hβ, hX, rfl⟩`.
-/
theorem MS_gen {β X : A} (hβ : β ∈ S) (hX : X ∈ minusHats L) (n k : ℕ) : β * (L.D ^ n * L.Dbi ^ k) * X ∈ MS L S n k :=
  Submodule.subset_span ⟨β, X, hβ, hX, rfl⟩

/- English proof (translation)
Proceed by induction on `ts with`. Consider the case `nil => simp`. Consider the case `cons a ts ih`. Rewrite using `[List.map_cons, List.sum_cons]`. Conclude with `Submodule.add_mem _ (h a (by simp)) (ih fun x hx => h x (by simp [hx]))`.
-/
theorem MS_sum {n k : ℕ} {ι : Type} (ts : List ι) (f : ι → A) (h : ∀ x ∈ ts, f x ∈ MS L S n k) :
    (ts.map f).sum ∈ MS L S n k := by
  induction ts with
  | nil => simp
  | cons a ts ih =>
    rw [List.map_cons, List.sum_cons]
    exact Submodule.add_mem _ (h a (by simp)) (ih fun x hx => h x (by simp [hx]))

/- English proof (translation)
Establish `hc : ∀ z, z ∈ Subring.closure (FS L) → (L.D ^ n * L.Dbi ^ k) * z = z * (L.D ^ n * L.Dbi ^ k)` using `fun z hz => cl_comm L (Subring.mul_mem _ (memPow L (memD L) n) (memPow L (memDbi L) k)) hz`. Break down `hX with ⟨y, rfl⟩ | ⟨y, rfl⟩` into its components or cases. Take `⟨t, ht⟩` from `hV.ahatv β hβ`. Rewrite using `[← mul_assoc, ht, mul_assoc, Ahatv_DD, ← mul_assoc]`. Conclude with `MS_gen hβ (Or.inl ⟨_, rfl⟩) n k`.

Take `⟨t, ts, hts, e⟩` from `hV.r0v β hβ y`. Take `⟨cs, hcs⟩` from `raising_variant_D_bar_inv_pow L k (y + t)`. Rewrite using `[← mul_assoc, e, add_mul]`. Use `Submodule.add_mem _ ?_ ?_` and prove the remaining obligations. Establish `e2 : β * L.R0v (y + t) * (L.D ^ n * L.Dbi ^ k) = β * (L.D ^ n * L.Dbi ^ k) * L.R0v (y + t + k) + (cs.map fun x => x.1 • ((β * (L.Dr * L.Dbi)) * (L.D ^ n * L.Dbi ^ k) * L.Ahatv x.2)).sum`.

Rewrite using `[mul_assoc β, ← mul_assoc (L.R0v _), raising_variant_D_pow, mul_assoc, hcs, mul_add, mul_add, mul_add]`. Use `congr 1`. Simplify using `only [mul_assoc]`. Rewrite using `[← List.sum_map_mul_left, ← List.sum_map_mul_left, ← List.sum_map_mul_left]`. Use `congr 1`.

Use `List.map_congr_left fun x _ => ?_` and prove the remaining obligations. Simplify using `only [mul_smul_comm]`. Use `congr 1`. Establish `h1` using `hc (L.Dr * L.Dbi) (Subring.mul_mem _ (memDr L) (memDbi L))`. Combine the equalities or inequalities in the displayed calculation.

Rewrite using `[e2]`. Use `Submodule.add_mem _ (MS_gen hβ (Or.inr ⟨_, rfl⟩) n k) (MS_sum _ _ fun x _ => ?_)` and prove the remaining obligations. Conclude with `Submodule.smul_mem _ _ (MS_gen (S.mul_mem hβ hV.drv) (Or.inl ⟨_, rfl⟩) n k)`. Rewrite using `[← List.sum_map_mul_right]`. Use `MS_sum _ _ fun x hx => ?_` and prove the remaining obligations.

Simplify using `only [smul_mul_assoc]`. Use `Submodule.smul_mem _ _ ?_` and prove the remaining obligations. Rewrite using `[mul_assoc, Ahatv_DD, ← mul_assoc]`. Conclude with `MS_gen (hts x hx) (Or.inl ⟨_, rfl⟩) n k`.
-/
theorem hatv_past (hV : HypV L S) {X : A} (hX : X ∈ minusHats L) {β : A} (hβ : β ∈ S) (n k : ℕ) :
    X * (β * (L.D ^ n * L.Dbi ^ k)) ∈ MS L S n k := by
  have hc : ∀ z, z ∈ Subring.closure (FS L) → (L.D ^ n * L.Dbi ^ k) * z = z * (L.D ^ n * L.Dbi ^ k) := fun z hz =>
    cl_comm L (Subring.mul_mem _ (memPow L (memD L) n) (memPow L (memDbi L) k)) hz
  rcases hX with ⟨y, rfl⟩ | ⟨y, rfl⟩
  · obtain ⟨t, ht⟩ := hV.ahatv β hβ
    rw [← mul_assoc, ht, mul_assoc, Ahatv_DD, ← mul_assoc]
    exact MS_gen hβ (Or.inl ⟨_, rfl⟩) n k
  · obtain ⟨t, ts, hts, e⟩ := hV.r0v β hβ y
    obtain ⟨cs, hcs⟩ := raising_variant_D_bar_inv_pow L k (y + t)
    rw [← mul_assoc, e, add_mul]
    refine Submodule.add_mem _ ?_ ?_
    ·
      have e2 : β * L.R0v (y + t) * (L.D ^ n * L.Dbi ^ k) = β * (L.D ^ n * L.Dbi ^ k) * L.R0v (y + t + k) +
          (cs.map fun x => x.1 • ((β * (L.Dr * L.Dbi)) * (L.D ^ n * L.Dbi ^ k) * L.Ahatv x.2)).sum := by
        rw [mul_assoc β, ← mul_assoc (L.R0v _), raising_variant_D_pow, mul_assoc, hcs, mul_add, mul_add, mul_add]
        congr 1
        · simp only [mul_assoc]
        · rw [← List.sum_map_mul_left, ← List.sum_map_mul_left, ← List.sum_map_mul_left]
          congr 1
          refine List.map_congr_left fun x _ => ?_
          simp only [mul_smul_comm]
          congr 1
          have h1 := hc (L.Dr * L.Dbi) (Subring.mul_mem _ (memDr L) (memDbi L))
          calc β * (L.D ^ n * (L.Dbi ^ k * (L.Dr * L.Dbi * L.Ahatv x.2)))
              = β * ((L.D ^ n * L.Dbi ^ k) * (L.Dr * L.Dbi) * L.Ahatv x.2) := by simp only [mul_assoc]
            _ = β * ((L.Dr * L.Dbi) * (L.D ^ n * L.Dbi ^ k) * L.Ahatv x.2) := by rw [h1]
            _ = _ := by simp only [mul_assoc]
      rw [e2]
      refine Submodule.add_mem _ (MS_gen hβ (Or.inr ⟨_, rfl⟩) n k) (MS_sum _ _ fun x _ => ?_)
      exact Submodule.smul_mem _ _ (MS_gen (S.mul_mem hβ hV.drv) (Or.inl ⟨_, rfl⟩) n k)
    ·
      rw [← List.sum_map_mul_right]
      refine MS_sum _ _ fun x hx => ?_
      simp only [smul_mul_assoc]
      refine Submodule.smul_mem _ _ ?_
      rw [mul_assoc, Ahatv_DD, ← mul_assoc]
      exact MS_gen (hts x hx) (Or.inl ⟨_, rfl⟩) n k

