theorem comp_le (hTT : 0 ≤ P.TT) (ε σ : ℝ) (n : ℕ) (hε : 0 < ε) (hσ : (n : ℝ) ≤ σ) (c : ℝ) (z : ℂ)
    (q : Qp P.r P.TT) :
    LE.th ε σ (Gq P q) * (Wq P q ^ n * c) * ‖z‖ ^ 2 ≤ |c| * (ε⁻¹) ^ n * (‖z‖ * Dabs q ^ n) ^ 2 := by
  have hG := Gq_pos P q
  have hth0 : 0 ≤ LE.th ε σ (Gq P q) := by unfold LE.th; positivity
