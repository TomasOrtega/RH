  have hp1 : 0 < |ratF (Icc 1 k) (Icc 1 (k - 1)) a b Z₁| := abs_pos.2 (hne Z₁ h1)
  have hp2 : 0 < |ratF (Icc 1 k) (Icc 1 (k - 1)) a b Z₂| := abs_pos.2 (hne Z₂ h2)
