/- English proof (translation)
Take `⟨hp, hpb, hc, hci, hcb, hcbi, hz, hzi, hzb, hzbi, hg, hgi, hn, hns, -⟩` from `hL`. Use `⟨fun l => ?_, fun l => ?_, fun l => ?_, fun l => ?_, fun l => ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩` and prove the remaining obligations. Apply the tactic sequence `all_goals first`. Consider the case `(rw [hp]; exact sc_memDG P _) | (rw [hc]; exact sc_memDG P _) | (rw [hci]; exact sc_memDG P _)`. Consider the case `(rw [hcb]; exact sc_memDG P _) | (rw [hcbi]; exact sc_memDG P _) | (rw [hz]; exact sc_memDG P _)`.

Consider the case `(rw [hzi]; exact sc_memDG P _) | (rw [hzb]; exact sc_memDG P _) | (rw [hzbi]; exact sc_memDG P _)`. Consider the case `(rw [hg]; exact sc_memDG P _) | (rw [hgi]; exact sc_memDG P _) | (rw [hn]; exact diag_memDG P _)`.
-/
theorem levDG : (∀ l, L.p l ∈ DG P) ∧ (∀ l, L.c l ∈ DG P) ∧ (∀ l, L.ci l ∈ DG P) ∧ (∀ l, L.cb l ∈ DG P) ∧
    (∀ l, L.cbi l ∈ DG P) ∧ L.ζ ∈ DG P ∧ L.ζi ∈ DG P ∧ L.ζb ∈ DG P ∧ L.ζbi ∈ DG P ∧ L.GG ∈ DG P ∧
    L.GGi ∈ DG P ∧ L.nab ∈ DG P := by
  obtain ⟨hp, hpb, hc, hci, hcb, hcbi, hz, hzi, hzb, hzbi, hg, hgi, hn, hns, -⟩ := hL
  refine ⟨fun l => ?_, fun l => ?_, fun l => ?_, fun l => ?_, fun l => ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  all_goals first
    | (rw [hp]; exact sc_memDG P _) | (rw [hc]; exact sc_memDG P _) | (rw [hci]; exact sc_memDG P _)
    | (rw [hcb]; exact sc_memDG P _) | (rw [hcbi]; exact sc_memDG P _) | (rw [hz]; exact sc_memDG P _)
    | (rw [hzi]; exact sc_memDG P _) | (rw [hzb]; exact sc_memDG P _) | (rw [hzbi]; exact sc_memDG P _)
    | (rw [hg]; exact sc_memDG P _) | (rw [hgi]; exact sc_memDG P _) | (rw [hn]; exact diag_memDG P _)

/- English proof (translation)
Take `⟨hp, hpb, hc, hci, hcb, hcbi, hz, hzi, hzb, hzbi, hg, hgi, hn, hns, -⟩` from `hL`. Use `⟨fun l => ?_, fun l => ?_, fun l => ?_, fun l => ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩` and prove the remaining obligations. Apply the tactic sequence `all_goals first`. Consider the case `(rw [hc]; exact sc_memSC P _) | (rw [hci]; exact sc_memSC P _)`. Consider the case `(rw [hcb]; exact sc_memSC P _) | (rw [hcbi]; exact sc_memSC P _) | (rw [hz]; exact sc_memSC P _)`.

Consider the case `(rw [hzi]; exact sc_memSC P _) | (rw [hzb]; exact sc_memSC P _) | (rw [hzbi]; exact sc_memSC P _)`. Consider the case `(rw [hg]; exact sc_memSC P _) | (rw [hgi]; exact sc_memSC P _)`.
-/
theorem levSC : (∀ l, L.c l ∈ SC P) ∧ (∀ l, L.ci l ∈ SC P) ∧ (∀ l, L.cb l ∈ SC P) ∧ (∀ l, L.cbi l ∈ SC P) ∧
    L.ζ ∈ SC P ∧ L.ζi ∈ SC P ∧ L.ζb ∈ SC P ∧ L.ζbi ∈ SC P ∧ L.GG ∈ SC P ∧ L.GGi ∈ SC P := by
  obtain ⟨hp, hpb, hc, hci, hcb, hcbi, hz, hzi, hzb, hzbi, hg, hgi, hn, hns, -⟩ := hL
  refine ⟨fun l => ?_, fun l => ?_, fun l => ?_, fun l => ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  all_goals first
    | (rw [hc]; exact sc_memSC P _) | (rw [hci]; exact sc_memSC P _)
    | (rw [hcb]; exact sc_memSC P _) | (rw [hcbi]; exact sc_memSC P _) | (rw [hz]; exact sc_memSC P _)
    | (rw [hzi]; exact sc_memSC P _) | (rw [hzb]; exact sc_memSC P _) | (rw [hzbi]; exact sc_memSC P _)
    | (rw [hg]; exact sc_memSC P _) | (rw [hgi]; exact sc_memSC P _)

/- English proof (translation)
Take `⟨hc, hci, hcb, hcbi, -⟩` from `levSC hL`. Apply the tactic sequence `refine ⟨Subring.list_prod_mem _ fun x hx => ?_, Subring.list_prod_mem _ fun x hx => ?_, Subring.list_prod_mem _ fun x hx => ?_, Subring.list_prod_mem _ fun x hx => ?_⟩ <;>`. Apply the tactic sequence `obtain ⟨l, rfl⟩ := List.mem_ofFn.1 hx first | exact hc l | exact hcb l | exact hci l | exact hcbi l`.
-/
theorem DrSC : L.Dr ∈ SC P ∧ L.Drb ∈ SC P ∧ L.Dri ∈ SC P ∧ L.Drbi ∈ SC P := by
  obtain ⟨hc, hci, hcb, hcbi, -⟩ := levSC hL
  refine ⟨Subring.list_prod_mem _ fun x hx => ?_, Subring.list_prod_mem _ fun x hx => ?_,
    Subring.list_prod_mem _ fun x hx => ?_, Subring.list_prod_mem _ fun x hx => ?_⟩ <;>
  · obtain ⟨l, rfl⟩ := List.mem_ofFn.1 hx
    first | exact hc l | exact hcb l | exact hci l | exact hcbi l

/- English proof (translation)
Take `⟨-, -, -, -, hz, hzi, hzb, hzbi, -⟩` from `levSC hL`. Take `⟨d1, d2, d3, d4⟩` from `DrSC hL`. Conclude with `⟨Subring.mul_mem _ d1 hz, Subring.mul_mem _ hzi d3, Subring.mul_mem _ d2 hzb, Subring.mul_mem _ hzbi d4⟩`.
-/
theorem DSC : L.D ∈ SC P ∧ L.Di ∈ SC P ∧ L.Db ∈ SC P ∧ L.Dbi ∈ SC P := by
  obtain ⟨-, -, -, -, hz, hzi, hzb, hzbi, -⟩ := levSC hL
  obtain ⟨d1, d2, d3, d4⟩ := DrSC hL
  exact ⟨Subring.mul_mem _ d1 hz, Subring.mul_mem _ hzi d3, Subring.mul_mem _ d2 hzb, Subring.mul_mem _ hzbi d4⟩

/- English proof (translation)
Take `⟨hp, hc, hci, hcb, hcbi, hz, hzi, hzb, hzbi, hg, hgi, hn⟩` from `levDG hL`. Establish `hDr : L.Dr ∈ DG P` using `Subalgebra.list_prod_mem _ fun x hx => by`. Take `⟨l, rfl⟩` from `List.mem_ofFn.1 hx`. Conclude with `hc l`. Establish `hDrb : L.Drb ∈ DG P` using `Subalgebra.list_prod_mem _ fun x hx => by`.

Take `⟨l, rfl⟩` from `List.mem_ofFn.1 hx`. Conclude with `hcb l`. Establish `hT : L.Tprod Y ∈ matSub (DG P) (Fin 2)` using `Subalgebra.list_prod_mem _ fun x hx => by`. Take `⟨l, rfl⟩` from `List.mem_ofFn.1 (List.mem_reverse.1 hx)`. Conclude with `matrix_two_mem_sub _ _ _ _ _ (add_mem (Subalgebra.algebraMap_mem _ _) (hp l)) (neg_mem (hc l)) (hci l) (Subalgebra.zero_mem _)`.

Use `⟨mul_mem hDr (hT 0 0), mul_mem (mul_mem hDrb hg) (add_mem (mul_mem (sub_mem (neg_mem hn) (mul_mem (Subalgebra.algebraMap_mem _ _) (mul_mem hzb hgi))) (hT 0 0)) (hT 1 0))⟩` and prove the remaining obligations.
-/
theorem hatDG (Y : ℂ) : L.Ahat Y ∈ DG P ∧ L.R0 Y ∈ DG P := by
  obtain ⟨hp, hc, hci, hcb, hcbi, hz, hzi, hzb, hzbi, hg, hgi, hn⟩ := levDG hL
  have hDr : L.Dr ∈ DG P := Subalgebra.list_prod_mem _ fun x hx => by
    obtain ⟨l, rfl⟩ := List.mem_ofFn.1 hx; exact hc l
  have hDrb : L.Drb ∈ DG P := Subalgebra.list_prod_mem _ fun x hx => by
    obtain ⟨l, rfl⟩ := List.mem_ofFn.1 hx; exact hcb l
  have hT : L.Tprod Y ∈ matSub (DG P) (Fin 2) := Subalgebra.list_prod_mem _ fun x hx => by
    obtain ⟨l, rfl⟩ := List.mem_ofFn.1 (List.mem_reverse.1 hx)
    exact matrix_two_mem_sub _ _ _ _ _ (add_mem (Subalgebra.algebraMap_mem _ _) (hp l)) (neg_mem (hc l)) (hci l)
      (Subalgebra.zero_mem _)
  refine ⟨mul_mem hDr (hT 0 0), mul_mem (mul_mem hDrb hg) (add_mem (mul_mem (sub_mem (neg_mem hn)
    (mul_mem (Subalgebra.algebraMap_mem _ _) (mul_mem hzb hgi))) (hT 0 0)) (hT 1 0))⟩

end Lev

end

