/- English proof (translation)
Introduce `K B f T w P x N hG hP hw hA hM`. Establish `hG' : GrpTrue x.o.N f` using `x.fits.grp`. Take `⟨⟨plg, hplg⟩, hidem, hcen⟩` from `x.fits.grpAt`. Set `e` to `grpEquiv N.naut x.o.N.naut`. Establish `hco : ∀ g, x.o.N.ntypes.e0.coeff (e g) = N.ntypes.e0.coeff g` using `GrpTrue.typeIdempotent_coeff_across_layers hG hG'`.

Set `φ` to `MonoidAlgebra.domCongr ℂ ℂ e`. Establish `hφ : ∀ (a : MonoidAlgebra ℂ (G0g N.nd)) g, (φ a).coeff (e g) = a.coeff g`. Introduce `a g`. Simplify using `[φ]`. Establish `he0 : N.ntypes.e0 = φ.symm x.o.N.ntypes.e0`.

Apply `MonoidAlgebra.coeff_injective` to reduce the goal to its premises. Use `Finsupp.ext fun g => ?_` and prove the remaining obligations. Use `show _ = (MonoidAlgebra.domCongr ℂ ℂ e.symm x.o.N.ntypes.e0).coeff g`. Rewrite using `[MonoidAlgebra.coeff_domCongr, MulEquiv.symm_symm, hco]`. Establish `hpe : ∀ k v, plEquiv N.naut x.o.N.naut k v = cast (congrFun hP k) v`.

Introduce `k v`. Use `show (plF x.o.N.naut k).symm (plF N.naut k v) = _`. Rewrite using `[Equiv.symm_apply_eq]`. Apply `Subtype.ext` to reduce the goal to its premises. Rewrite using `[plF_apply, plF_apply, heq_apply_cast hP hw k v]`.

Establish `he : ∀ (g : G0g N.nd) k v, e g ⟨k, cast (congrFun hP k) v⟩ = g ⟨k, v⟩`. Introduce `g k v`. Rewrite using `[grpEquiv_apply, ← hpe, Equiv.symm_apply_apply]`. Use `⟨⟨⟨(Equiv.sigmaCongrRight fun k => plEquiv N.naut x.o.N.naut k).trans plg, fun kv => ?_⟩, ?_, ?_⟩, ?_⟩` and prove the remaining obligations. Take `⟨h1, h2⟩` from `hplg ⟨kv.1, plEquiv N.naut x.o.N.naut kv.1 kv.2⟩`.

Use `⟨?_, h2⟩` and prove the remaining obligations. Conclude with `h1.trans (TypesTrue.plGw_plEquiv hG hG' kv.1 kv.2)`. Use `show IsIdempotentElem N.ntypes.e0`. Rewrite using `[he0]`. Conclude with `hidem.map φ.symm`.

Use `show N.ntypes.e0 ∈ _`. Rewrite using `[he0]`. Conclude with `mem_center_map φ.symm hcen`. Introduce and unpack `eR ⟨plg1, iso1, hpl1, hact1⟩`. Establish `hstd : StdIso (w.st x.o.Z) w.px (eR.trans e)`.

Use `⟨(Equiv.sigmaCongrRight fun k => (plEquiv N.naut x.o.N.naut k).symm).trans plg1, fun kv => iso1 ⟨kv.1, (plEquiv N.naut x.o.N.naut kv.1).symm kv.2⟩, fun kv => ?_, fun g kv => ?_⟩` and prove the remaining obligations. Use `(hpl1 ⟨kv.1, (plEquiv N.naut x.o.N.naut kv.1).symm kv.2⟩).trans ?_` and prove the remaining obligations. Use `TypesTrue.plGw_plEquiv hG hG' kv.1 ((plEquiv N.naut x.o.N.naut kv.1).symm kv.2)` as an intermediate fact. Conclude with `((congrArg (x.o.N.naut.plGw kv.1) (Equiv.apply_symm_apply (plEquiv N.naut x.o.N.naut kv.1) kv.2)).symm.trans this).symm`. Conclude with `hact1 g _`.

Establish `hc` using `x.fits.cen _ hstd`. Establish `hz1 : ∀ (z : Subalgebra.center ℂ (MonoidAlgebra ℂ (G0g N.nd))), φ (z : MonoidAlgebra ℂ (G0g N.nd)) ∈ Subalgebra.center ℂ (MonoidAlgebra ℂ (G0g x.o.N.nd))` using `fun z => mem_center_map φ z.2`. Use `⟨fun μ z z' hz xx => ?_, fun μ j z z' hz xx => ?_⟩` and prove the remaining obligations. Establish `h1` using `hc.amb μ ⟨_, hz1 z⟩ z' (fun g => by show _ = (φ (z : MonoidAlgebra ℂ (G0g N.nd))).coeff (e (eR g))`. Conclude with `(hz g).trans (hφ _ _).symm) xx`.

Rewrite using `[cen_transport hP hA e he μ z ⟨_, hz1 z⟩ (fun g => hφ _ g)]`. Conclude with `h1`. Establish `h1` using `hc.mt μ j ⟨_, hz1 z⟩ z' (fun g => by show _ = (φ (z : MonoidAlgebra ℂ (G0g N.nd))).coeff (e (eR g))`. Conclude with `(hz g).trans (hφ _ _).symm) xx`. Rewrite using `[cen_transport₂ hP hM e he μ j z ⟨_, hz1 z⟩ (fun g => hφ _ g)]`.

Conclude with `h1`.
-/
theorem fits_swap : ∀ {K : Ctx} {B : Base} {f : Fr B.toPre} {T : TwDat B} {w : ColW B f T} {P : Pre2 K w} (x : St P) (N : NStage B w.C (P.q.W x.o.η x.o.hη)), GrpTrue N f → N.nd.PlG = x.o.N.nd.PlG → HEq N.naut.plGw x.o.N.naut.plGw → HEq N.ntypes.cenAmb x.o.N.ntypes.cenAmb → HEq N.ntypes.cenMt x.o.N.ntypes.cenMt → GrpAt (w.st (RowPk.Over.Z (⟨x.o.η, x.o.hη, x.o.V, x.o.S, N, x.o.G⟩ : P.q.Over))) w.I ∧ ∀ eR, StdIso (w.st (RowPk.Over.Z (⟨x.o.η, x.o.hη, x.o.V, x.o.S, N, x.o.G⟩ : P.q.Over))) w.px eR → CenIs P.q.p N eR := by
  intro K B f T w P x N hG hP hw hA hM
  have hG' : GrpTrue x.o.N f := x.fits.grp
  obtain ⟨⟨plg, hplg⟩, hidem, hcen⟩ := x.fits.grpAt
  let e := grpEquiv N.naut x.o.N.naut
  have hco : ∀ g, x.o.N.ntypes.e0.coeff (e g) = N.ntypes.e0.coeff g := GrpTrue.typeIdempotent_coeff_across_layers hG hG'
  let φ := MonoidAlgebra.domCongr ℂ ℂ e
  have hφ : ∀ (a : MonoidAlgebra ℂ (G0g N.nd)) g, (φ a).coeff (e g) = a.coeff g := by
    intro a g
    simp [φ]
  have he0 : N.ntypes.e0 = φ.symm x.o.N.ntypes.e0 := by
    apply MonoidAlgebra.coeff_injective
    refine Finsupp.ext fun g => ?_
    show _ = (MonoidAlgebra.domCongr ℂ ℂ e.symm x.o.N.ntypes.e0).coeff g
    rw [MonoidAlgebra.coeff_domCongr, MulEquiv.symm_symm, hco]
  have hpe : ∀ k v, plEquiv N.naut x.o.N.naut k v = cast (congrFun hP k) v := by
    intro k v
    show (plF x.o.N.naut k).symm (plF N.naut k v) = _
    rw [Equiv.symm_apply_eq]
    apply Subtype.ext
    rw [plF_apply, plF_apply, heq_apply_cast hP hw k v]
  have he : ∀ (g : G0g N.nd) k v, e g ⟨k, cast (congrFun hP k) v⟩ = g ⟨k, v⟩ := by
    intro g k v
    rw [grpEquiv_apply, ← hpe, Equiv.symm_apply_apply]
  refine ⟨⟨⟨(Equiv.sigmaCongrRight fun k => plEquiv N.naut x.o.N.naut k).trans plg, fun kv => ?_⟩, ?_, ?_⟩, ?_⟩
  · obtain ⟨h1, h2⟩ := hplg ⟨kv.1, plEquiv N.naut x.o.N.naut kv.1 kv.2⟩
    refine ⟨?_, h2⟩
    exact h1.trans (TypesTrue.plGw_plEquiv hG hG' kv.1 kv.2)
  · show IsIdempotentElem N.ntypes.e0
    rw [he0]
    exact hidem.map φ.symm
  · show N.ntypes.e0 ∈ _
    rw [he0]
    exact mem_center_map φ.symm hcen
  · rintro eR ⟨plg1, iso1, hpl1, hact1⟩
    have hstd : StdIso (w.st x.o.Z) w.px (eR.trans e) := by
      refine ⟨(Equiv.sigmaCongrRight fun k => (plEquiv N.naut x.o.N.naut k).symm).trans plg1,
        fun kv => iso1 ⟨kv.1, (plEquiv N.naut x.o.N.naut kv.1).symm kv.2⟩, fun kv => ?_, fun g kv => ?_⟩
      · refine (hpl1 ⟨kv.1, (plEquiv N.naut x.o.N.naut kv.1).symm kv.2⟩).trans ?_
        have := TypesTrue.plGw_plEquiv hG hG' kv.1 ((plEquiv N.naut x.o.N.naut kv.1).symm kv.2)
        exact ((congrArg (x.o.N.naut.plGw kv.1) (Equiv.apply_symm_apply (plEquiv N.naut x.o.N.naut kv.1) kv.2)).symm.trans
          this).symm
      · exact hact1 g _
    have hc := x.fits.cen _ hstd
    have hz1 : ∀ (z : Subalgebra.center ℂ (MonoidAlgebra ℂ (G0g N.nd))), φ (z : MonoidAlgebra ℂ (G0g N.nd)) ∈
        Subalgebra.center ℂ (MonoidAlgebra ℂ (G0g x.o.N.nd)) := fun z => mem_center_map φ z.2
    refine ⟨fun μ z z' hz xx => ?_, fun μ j z z' hz xx => ?_⟩
    · have h1 := hc.amb μ ⟨_, hz1 z⟩ z' (fun g => by
        show _ = (φ (z : MonoidAlgebra ℂ (G0g N.nd))).coeff (e (eR g))
        exact (hz g).trans (hφ _ _).symm) xx
      rw [cen_transport hP hA e he μ z ⟨_, hz1 z⟩ (fun g => hφ _ g)]
      exact h1
    · have h1 := hc.mt μ j ⟨_, hz1 z⟩ z' (fun g => by
        show _ = (φ (z : MonoidAlgebra ℂ (G0g N.nd))).coeff (e (eR g))
        exact (hz g).trans (hφ _ _).symm) xx
      rw [cen_transport₂ hP hM e he μ j z ⟨_, hz1 z⟩ (fun g => hφ _ g)]
      exact h1

end GlobalTheory.Mem.R3.Rw.SwapN
