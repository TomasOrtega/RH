section S_AD_AD2

set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace Formalism.FourierDecayAlt.P.MAx3.AD

open Formalism.FourierDecayAlt Formalism.FourierDecayAlt.MA Formalism.FourierDecayAlt.P.MAx1.An Formalism.FourierDecayAlt.P.MAx2.Jet Formalism.FourierDecayAlt.P.MAx3.L

noncomputable section

/- English proof (translation)
The claim follows from `(hf.of_le (by exact_mod_cast (le_top : (n : ℕ∞) ≤ ⊤))).contDiffAt`.
-/
theorem smooth_top_at {f : ℝ → ℝ} (hf : ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) f) (n : ℕ) (x : ℝ) :
    ContDiffAt ℝ n f x := (hf.of_le (by exact_mod_cast (le_top : (n : ℕ∞) ≤ ⊤))).contDiffAt

/- English proof (translation)
Unfold `LE.ld`. Establish `e : (fun u => (fun x => φ x * ψ x) (Real.exp u)) = (fun u => φ (Real.exp u)) * (fun u => ψ (Real.exp u))` using `rfl`. Rewrite using `[e, iteratedDeriv_mul (smooth_top_at hφ q _) (smooth_top_at hψ q _)]`.
-/
theorem ld_mul {φ ψ : ℝ → ℝ} (hφ : LE.SmoothLog φ) (hψ : LE.SmoothLog ψ) (q : ℕ) (x : ℝ) :
    LE.ld q (fun x => φ x * ψ x) x =
      ∑ i ∈ Finset.range (q + 1), (q.choose i : ℝ) * LE.ld i φ x * LE.ld (q - i) ψ x := by
  unfold LE.ld
  have e : (fun u => (fun x => φ x * ψ x) (Real.exp u)) = (fun u => φ (Real.exp u)) * (fun u => ψ (Real.exp u)) := rfl
  rw [e, iteratedDeriv_mul (smooth_top_at hφ q _) (smooth_top_at hψ q _)]

/- English proof (translation)
Take `⟨hs, ⟨ε, hε, h0⟩, hb⟩` from `hφ`. Take `⟨hs', -, hb'⟩` from `hψ`. Use `⟨?_, ⟨ε, hε, fun x hx => by simp [h0 x hx]⟩, fun q => ?_⟩` and prove the remaining obligations. Unfold `LE.SmoothLog`. Conclude with `hs.mul hs'`.

Use `choose C hC using hb choose C' hC' using hb'`. Use `⟨∑ i ∈ Finset.range (q + 1), (q.choose i : ℝ) * C i * C' (q - i), fun x hx => ?_⟩` and prove the remaining obligations. Rewrite using `[ld_mul hs hs']`. Use `(Finset.abs_sum_le_sum_abs _ _).trans (Finset.sum_le_sum fun i _ => ?_)` and prove the remaining obligations. Rewrite using `[abs_mul, abs_mul, abs_of_nonneg (Nat.cast_nonneg _)]`.

Establish `h1` using `hC i x hx`. Establish `h2` using `hC' (q - i) x hx`. Establish `hc0 : 0 ≤ C i` using `(abs_nonneg _).trans h1`. Conclude with `mul_le_mul (mul_le_mul_of_nonneg_left h1 (Nat.cast_nonneg _)) h2 (abs_nonneg _) (mul_nonneg (Nat.cast_nonneg _) hc0)`.
-/
theorem isAdmissibleSplittingCharPair_mul_twist {φ ψ : ℝ → ℝ} (hφ : admitted φ) (hψ : admitted ψ) : admitted (fun x => φ x * ψ x) := by
  obtain ⟨hs, ⟨ε, hε, h0⟩, hb⟩ := hφ
  obtain ⟨hs', -, hb'⟩ := hψ
  refine ⟨?_, ⟨ε, hε, fun x hx => by simp [h0 x hx]⟩, fun q => ?_⟩
  · unfold LE.SmoothLog; exact hs.mul hs'
  · choose C hC using hb
    choose C' hC' using hb'
    refine ⟨∑ i ∈ Finset.range (q + 1), (q.choose i : ℝ) * C i * C' (q - i), fun x hx => ?_⟩
    rw [ld_mul hs hs']
    refine (Finset.abs_sum_le_sum_abs _ _).trans (Finset.sum_le_sum fun i _ => ?_)
    rw [abs_mul, abs_mul, abs_of_nonneg (Nat.cast_nonneg _)]
    have h1 := hC i x hx
    have h2 := hC' (q - i) x hx
    have hc0 : 0 ≤ C i := (abs_nonneg _).trans h1
    exact mul_le_mul (mul_le_mul_of_nonneg_left h1 (Nat.cast_nonneg _)) h2 (abs_nonneg _)
      (mul_nonneg (Nat.cast_nonneg _) hc0)

/- English proof (translation)
The claim follows from `G.smoothLog_rpow t`.
-/
theorem smoothLog_rpow' (t : ℝ) : LE.SmoothLog (fun x : ℝ => x ^ t) := G.smoothLog_rpow t

/- English proof (translation)
Take `⟨hs, ⟨ε, hε, h0⟩, hb⟩` from `hφ`. Establish `hsm : LE.SmoothLog (fun x => φ x * x ^ t)`. Unfold `LE.SmoothLog`. Conclude with `hs.mul (smoothLog_rpow' t)`. Establish `hvan : ∀ x, x ≤ ε → φ x * x ^ t = 0` using `fun x hx => by rw [h0 x hx, zero_mul]`.

Use `⟨hsm, ⟨ε, hε, hvan⟩, fun q => ?_⟩` and prove the remaining obligations. Use `choose C hC using hb`. Use `⟨∑ i ∈ Finset.range (q + 1), (q.choose i : ℝ) * C i * (|t| ^ (q - i) * ε ^ t), fun x hx => ?_⟩` and prove the remaining obligations. Distinguish the cases in `hxe : x ≤ ε`. Rewrite using `[ld_vanish hsm hε hvan q hx hxe, abs_zero]`.

Use `Finset.sum_nonneg fun i _ => mul_nonneg (mul_nonneg (Nat.cast_nonneg _) ((abs_nonneg _).trans (hC i 1 one_pos))) (mul_nonneg (pow_nonneg (abs_nonneg _) _) (Real.rpow_nonneg hε.le _))` and prove the remaining obligations. Use `push Not at hxe`. Rewrite using `[ld_mul hs (smoothLog_rpow' t)]`. Use `(Finset.abs_sum_le_sum_abs _ _).trans (Finset.sum_le_sum fun i _ => ?_)` and prove the remaining obligations. Rewrite using `[ldq_rpow t (q - i) x hx, abs_mul, abs_mul, abs_mul, abs_of_nonneg (Nat.cast_nonneg _), abs_pow, abs_of_nonneg (Real.rpow_nonneg hx.le _)]`.

Establish `h1` using `hC i x hx`. Establish `hc0 : 0 ≤ C i` using `(abs_nonneg _).trans h1`. Establish `h3 : x ^ t ≤ ε ^ t` using `Real.rpow_le_rpow_of_nonpos hε hxe.le ht`. Conclude with `mul_le_mul (mul_le_mul_of_nonneg_left h1 (Nat.cast_nonneg _)) (mul_le_mul_of_nonneg_left h3 (pow_nonneg (abs_nonneg _) _)) (mul_nonneg (pow_nonneg (abs_nonneg _) _) (Real.rpow_nonneg hx.le _)) (mul_nonneg (Nat.cast_nonneg _) hc0)`.
-/
theorem admissible_mul_rpow {φ : ℝ → ℝ} (hφ : admitted φ) {t : ℝ} (ht : t ≤ 0) : admitted (fun x => φ x * x ^ t) := by
  obtain ⟨hs, ⟨ε, hε, h0⟩, hb⟩ := hφ
  have hsm : LE.SmoothLog (fun x => φ x * x ^ t) := by
    unfold LE.SmoothLog; exact hs.mul (smoothLog_rpow' t)
  have hvan : ∀ x, x ≤ ε → φ x * x ^ t = 0 := fun x hx => by rw [h0 x hx, zero_mul]
  refine ⟨hsm, ⟨ε, hε, hvan⟩, fun q => ?_⟩
  choose C hC using hb
  refine ⟨∑ i ∈ Finset.range (q + 1), (q.choose i : ℝ) * C i * (|t| ^ (q - i) * ε ^ t), fun x hx => ?_⟩
  by_cases hxe : x ≤ ε
  · rw [ld_vanish hsm hε hvan q hx hxe, abs_zero]
    refine Finset.sum_nonneg fun i _ => mul_nonneg (mul_nonneg (Nat.cast_nonneg _) ((abs_nonneg _).trans (hC i 1 one_pos)))
      (mul_nonneg (pow_nonneg (abs_nonneg _) _) (Real.rpow_nonneg hε.le _))
  · push Not at hxe
    rw [ld_mul hs (smoothLog_rpow' t)]
    refine (Finset.abs_sum_le_sum_abs _ _).trans (Finset.sum_le_sum fun i _ => ?_)
    rw [ldq_rpow t (q - i) x hx, abs_mul, abs_mul, abs_mul, abs_of_nonneg (Nat.cast_nonneg _), abs_pow,
      abs_of_nonneg (Real.rpow_nonneg hx.le _)]
    have h1 := hC i x hx
    have hc0 : 0 ≤ C i := (abs_nonneg _).trans h1
    have h3 : x ^ t ≤ ε ^ t := Real.rpow_le_rpow_of_nonpos hε hxe.le ht
    exact mul_le_mul (mul_le_mul_of_nonneg_left h1 (Nat.cast_nonneg _))
      (mul_le_mul_of_nonneg_left h3 (pow_nonneg (abs_nonneg _) _)) (mul_nonneg (pow_nonneg (abs_nonneg _) _)
        (Real.rpow_nonneg hx.le _)) (mul_nonneg (Nat.cast_nonneg _) hc0)

variable (P : M.Par)

/- English proof (translation)
Unfold `Phi`. Use `congr 1`. Use function extensionality and compare the values at `q`. Rewrite using `[ld_zero (Gq_pos P q)]`.
-/
theorem Phi0_eq {φ : ℝ → ℝ} (hφ : LE.SmoothLog φ) : Phi P φ 0 = toSm P (fun q => ((φ (Gq P q) : ℝ) : ℂ)) := by
  unfold Phi
  congr 1
  funext q
  rw [ld_zero (Gq_pos P q)]

/- English proof (translation)
Rewrite using `[ev_Phi P hφ, ld_zero (Gq_pos P q)]`.
-/
theorem eval_cutoff_operator_zero {φ : ℝ → ℝ} (hφ : LE.SmoothLog φ) (q : Qp P.r P.TT) : evQ P (Phi P φ 0) q = ((φ (Gq P q) : ℝ) : ℂ) := by
  rw [ev_Phi P hφ, ld_zero (Gq_pos P q)]

/- English proof (translation)
Establish `hs : LE.SmoothLog (fun x => φ x * ψ x)` using `by unfold LE.SmoothLog; exact hφ.mul hψ`. Apply `Subtype.ext` to reduce the goal to its premises. Use function extensionality and compare the values at `q`. Use `show evQ P (Phi P (fun x => φ x * ψ x) 0) q = evQ P (Phi P φ 0 * Phi P ψ 0) q`. Rewrite using `[MAx2.Jet.evQ_mul, eval_cutoff_operator_zero P hs, eval_cutoff_operator_zero P hφ, eval_cutoff_operator_zero P hψ]`.

Use `push_cast`. Expand and normalize the polynomial expressions, which then agree.
-/
theorem Phi0_mul {φ ψ : ℝ → ℝ} (hφ : LE.SmoothLog φ) (hψ : LE.SmoothLog ψ) :
    Phi P (fun x => φ x * ψ x) 0 = Phi P φ 0 * Phi P ψ 0 := by
  have hs : LE.SmoothLog (fun x => φ x * ψ x) := by unfold LE.SmoothLog; exact hφ.mul hψ
  apply Subtype.ext; funext q
  show evQ P (Phi P (fun x => φ x * ψ x) 0) q = evQ P (Phi P φ 0 * Phi P ψ 0) q
  rw [MAx2.Jet.evQ_mul, eval_cutoff_operator_zero P hs, eval_cutoff_operator_zero P hφ, eval_cutoff_operator_zero P hψ]
  push_cast; ring

def Ph (φ : ℝ → ℝ) : A P (DQ P) := sc P (DQ P) (Fq P φ 0)

/- English proof (translation)
Unfold `Ph Fq`. Rewrite using `[G.sc_mul]`. Use `congr 1`. Use `(Formalism.FourierDecayAlt.P.MAx1.multiplierPair_mul (DQ P) (Phi P φ 0) (Phi P φ 0) (Phi P ψ 0) (Phi P ψ 0)).trans ?_` and prove the remaining obligations. Apply the tactic sequence `congr 1 <;> exact (Phi0_mul P hφ hψ).symm`.
-/
theorem Ph_mul {φ ψ : ℝ → ℝ} (hφ : LE.SmoothLog φ) (hψ : LE.SmoothLog ψ) :
    Ph P φ * Ph P ψ = Ph P (fun x => φ x * ψ x) := by
  unfold Ph Fq
  rw [G.sc_mul]
  congr 1
  refine (Formalism.FourierDecayAlt.P.MAx1.multiplierPair_mul (DQ P) (Phi P φ 0) (Phi P φ 0) (Phi P ψ 0) (Phi P ψ 0)).trans ?_
  congr 1 <;> exact (Phi0_mul P hφ hψ).symm

/- English proof (translation)
Establish `: G.Gs P t = Ph P (fun x : ℝ => x ^ t)` using `rfl`. Rewrite using `[this, Ph_mul P hφ (smoothLog_rpow' t)]`.
-/
theorem Ph_Gs {φ : ℝ → ℝ} (hφ : LE.SmoothLog φ) (t : ℝ) :
    Ph P φ * G.Gs P t = Ph P (fun x => φ x * x ^ t) := by
  have : G.Gs P t = Ph P (fun x : ℝ => x ^ t) := rfl
  rw [this, Ph_mul P hφ (smoothLog_rpow' t)]

end

