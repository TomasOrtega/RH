section S_PG_PG3

set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace Formalism.FourierDecayAlt.P.MAx3.PG

open Formalism.FourierDecayAlt Formalism.FourierDecayAlt.MA Formalism.FourierDecayAlt.R Formalism.FourierDecayAlt.P.MAx1.An Formalism.FourierDecayAlt.P.MAx3.H Formalism.FourierDecayAlt.P.MAx3.G

noncomputable section

variable {P : M.Par} {L : LevelData (A P (DQ P)) P.r}

def CP (L : LevelData (A P (DQ P)) P.r) (d ℓ : ℕ) (x : A P (DQ P)) : Prop :=
  ∃ (K : ℕ) (c : ℕ → A P (DQ P)), (∀ k, c k ∈ NormalFormTwo L (I4.SB L) d ℓ) ∧
    ∀ s : ℝ, Gs P (-s) * x * Gs P s = ∑ k ∈ Finset.range (K + 1), ((s : ℂ) ^ k) • c k

/- English proof (translation)
Rewrite using `[← Finset.sum_range_add_sum_Ico _ (Nat.succ_le_succ hK)]`. Rewrite using `[Finset.sum_eq_zero (s := Finset.Ico (K + 1) (K' + 1)) (fun k hk => by`. Rewrite using `[if_neg (by simp [Finset.mem_Ico] at hk; omega), smul_zero]), add_zero]`. Conclude with `Finset.sum_congr rfl fun k hk => by rw [if_pos (by simp at hk; omega)]`.
-/
theorem pad {M : Type} [AddCommMonoid M] [Module ℂ M] (K K' : ℕ) (hK : K ≤ K') (c : ℕ → M) (t : ℂ) :
    ∑ k ∈ Finset.range (K + 1), t ^ k • c k =
      ∑ k ∈ Finset.range (K' + 1), t ^ k • (if k ≤ K then c k else 0) := by
  rw [← Finset.sum_range_add_sum_Ico _ (Nat.succ_le_succ hK)]
  rw [Finset.sum_eq_zero (s := Finset.Ico (K + 1) (K' + 1)) (fun k hk => by
    rw [if_neg (by simp [Finset.mem_Ico] at hk; omega), smul_zero]), add_zero]
  exact Finset.sum_congr rfl fun k hk => by rw [if_pos (by simp at hk; omega)]

/- English proof (translation)
Assemble the required witnesses or components as `⟨0, fun _ => 0, fun _ => Submodule.zero_mem _, fun s => by simp⟩`.
-/
theorem CP_zero (d ℓ : ℕ) : CP L d ℓ 0 :=
  ⟨0, fun _ => 0, fun _ => Submodule.zero_mem _, fun s => by simp⟩

/- English proof (translation)
Take `⟨K1, c1, h1, e1⟩` from `hx`. Take `⟨K2, c2, h2, e2⟩` from `hy`. Use `⟨K1 + K2, fun k => (if k ≤ K1 then c1 k else 0) + (if k ≤ K2 then c2 k else 0), fun k => ?_, fun s => ?_⟩` and prove the remaining obligations. Use `Submodule.add_mem _ ?_ ?_` and prove the remaining obligations. Use `split_ifs`.

Use `exacts [h1 k, Submodule.zero_mem _]`. Use `split_ifs`. Use `exacts [h2 k, Submodule.zero_mem _]`. Rewrite using `[mul_add, add_mul, e1, e2, pad K1 (K1 + K2) (by omega) c1, pad K2 (K1 + K2) (by omega) c2, ← Finset.sum_add_distrib]`. Simplify using `only [smul_add]`.
-/
theorem CP_add {d ℓ : ℕ} {x y : A P (DQ P)} (hx : CP L d ℓ x) (hy : CP L d ℓ y) : CP L d ℓ (x + y) := by
  obtain ⟨K1, c1, h1, e1⟩ := hx
  obtain ⟨K2, c2, h2, e2⟩ := hy
  refine ⟨K1 + K2, fun k => (if k ≤ K1 then c1 k else 0) + (if k ≤ K2 then c2 k else 0), fun k => ?_, fun s => ?_⟩
  · refine Submodule.add_mem _ ?_ ?_
    · split_ifs; exacts [h1 k, Submodule.zero_mem _]
    · split_ifs; exacts [h2 k, Submodule.zero_mem _]
  · rw [mul_add, add_mul, e1, e2, pad K1 (K1 + K2) (by omega) c1, pad K2 (K1 + K2) (by omega) c2,
      ← Finset.sum_add_distrib]
    simp only [smul_add]

/- English proof (translation)
Take `⟨K, c, h, e⟩` from `hx`. Use `⟨K, fun k => a • c k, fun k => Submodule.smul_mem _ _ (h k), fun s => ?_⟩` and prove the remaining obligations. Rewrite using `[mul_smul_comm, smul_mul_assoc, e s, Finset.smul_sum]`. Simplify using `only [smul_comm a]`.
-/
theorem CP_smul {d ℓ : ℕ} (a : ℂ) {x : A P (DQ P)} (hx : CP L d ℓ x) : CP L d ℓ (a • x) := by
  obtain ⟨K, c, h, e⟩ := hx
  refine ⟨K, fun k => a • c k, fun k => Submodule.smul_mem _ _ (h k), fun s => ?_⟩
  rw [mul_smul_comm, smul_mul_assoc, e s, Finset.smul_sum]
  simp only [smul_comm a]

variable (hTT : 0 ≤ P.TT) (hL : IsModelLevel P (DQ P) L) (hLaw : (DQ P).Laws P.TT)
include hTT hL hLaw

/- English proof (translation)
Take `⟨Hf, k1, k2, k3, k4⟩` from `conj_word hTT hL hLaw H h3`. Establish `hpoly` using `polyIn_const_mul (b * (L.Di ^ i * L.Dbi ^ i')) k4`. Take `⟨a, ha⟩` from `hpoly`. Take `⟨lam, hlam⟩` from `lagrange (fun t => b * (L.Di ^ i * L.Dbi ^ i') * (Hf t).prod) _ a ha`. Establish `hF : ∀ t, b * (L.Di ^ i * L.Dbi ^ i') * (Hf t).prod ∈ NormalFormTwo L (I4.SB L) d ℓ` using `fun t => mem2 hb h1 (by rw [k1, h2]) (k2 t)`.

Use `⟨H.length * (P.r + 1), fun k => if k ∈ Finset.range (H.length * (P.r + 1) + 1) then a k else 0, fun k => ?_, fun s => ?_⟩` and prove the remaining obligations. Simplify using `only split_ifs with hk`. Rewrite using `[hlam k hk]`. Conclude with `Submodule.sum_mem _ fun m _ => Submodule.smul_mem _ _ (hF _)`. Conclude with `Submodule.zero_mem _`.

Establish `hD : Gs P (-s) * (b * (L.Di ^ i * L.Dbi ^ i')) = b * (L.Di ^ i * L.Dbi ^ i') * Gs P (-s)`. Rewrite using `[← mul_assoc, Gs_comm_SB hTT hL hLaw (-s) hb, mul_assoc, mul_assoc, Gs_comm_cl hTT hL hLaw (-s) (Subring.mul_mem _ (memPow L (memDi L) i) (memPow L (memDbi L) i'))]`. Establish `e1 : Gs P (-s) * tm L b i i' H * Gs P s = b * (L.Di ^ i * L.Dbi ^ i') * (Gs P (-s) * H.prod * Gs P s)`. Unfold `tm`. Rewrite using `[← mul_assoc (Gs P (-s)), hD]`.

Simplify using `only [mul_assoc]`. Rewrite using `[e1, k3 s]`. Establish `hs` using `ha (s : ℂ)`. Simplify using `only at hs ⊢`. Rewrite using `[hs]`.

Conclude with `Finset.sum_congr rfl fun k hk => by rw [if_pos hk]`.
-/
theorem CP_term {d ℓ : ℕ} {b : A P (DQ P)} (hb : b ∈ I4.SB L) {i i' : ℕ} {H : List (A P (DQ P))}
    (h1 : i + i' = d) (h2 : H.length = ℓ) (h3 : ∀ h ∈ H, h ∈ plusHats L) : CP L d ℓ (tm L b i i' H) := by
  obtain ⟨Hf, k1, k2, k3, k4⟩ := conj_word hTT hL hLaw H h3
  have hpoly := polyIn_const_mul (b * (L.Di ^ i * L.Dbi ^ i')) k4
  obtain ⟨a, ha⟩ := hpoly
  obtain ⟨lam, hlam⟩ := lagrange (fun t => b * (L.Di ^ i * L.Dbi ^ i') * (Hf t).prod) _ a ha
  have hF : ∀ t, b * (L.Di ^ i * L.Dbi ^ i') * (Hf t).prod ∈ NormalFormTwo L (I4.SB L) d ℓ := fun t =>
    mem2 hb h1 (by rw [k1, h2]) (k2 t)
  refine ⟨H.length * (P.r + 1), fun k => if k ∈ Finset.range (H.length * (P.r + 1) + 1) then a k else 0,
    fun k => ?_, fun s => ?_⟩
  · dsimp only
    split_ifs with hk
    · rw [hlam k hk]
      exact Submodule.sum_mem _ fun m _ => Submodule.smul_mem _ _ (hF _)
    · exact Submodule.zero_mem _
  · have hD : Gs P (-s) * (b * (L.Di ^ i * L.Dbi ^ i')) = b * (L.Di ^ i * L.Dbi ^ i') * Gs P (-s) := by
      rw [← mul_assoc, Gs_comm_SB hTT hL hLaw (-s) hb, mul_assoc, mul_assoc,
        Gs_comm_cl hTT hL hLaw (-s) (Subring.mul_mem _ (memPow L (memDi L) i) (memPow L (memDbi L) i'))]
    have e1 : Gs P (-s) * tm L b i i' H * Gs P s = b * (L.Di ^ i * L.Dbi ^ i') * (Gs P (-s) * H.prod * Gs P s) := by
      unfold tm
      rw [← mul_assoc (Gs P (-s)), hD]; simp only [mul_assoc]
    rw [e1, k3 s]
    have hs := ha (s : ℂ)
    dsimp only at hs ⊢
    rw [hs]
    exact Finset.sum_congr rfl fun k hk => by rw [if_pos hk]

/- English proof (translation)
Proceed by induction on `hx using Submodule.span_induction with`. Consider the case `mem x hx`. Take `⟨b, hb, i, i', H, h1, h2, h3, rfl⟩` from `hx`. Conclude with `CP_term hTT hL hLaw hb h1 h2 h3`. Consider the case `zero => exact CP_zero d ℓ`.

Consider the case `add x y _ _ h1 h2 => exact CP_add h1 h2`. Consider the case `smul a x _ h => exact CP_smul a h`.
-/
theorem polynomial_control_of_normal_form {d ℓ : ℕ} {x : A P (DQ P)} (hx : x ∈ NormalFormTwo L (I4.SB L) d ℓ) : CP L d ℓ x := by
  induction hx using Submodule.span_induction with
  | mem x hx =>
    obtain ⟨b, hb, i, i', H, h1, h2, h3, rfl⟩ := hx
    exact CP_term hTT hL hLaw hb h1 h2 h3
  | zero => exact CP_zero d ℓ
  | add x y _ _ h1 h2 => exact CP_add h1 h2
  | smul a x _ h => exact CP_smul a h

end

end Formalism.FourierDecayAlt.P.MAx3.PG

end S_PG_PG3

section S_PG_PG4

set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace Formalism.FourierDecayAlt.P.MAx3.PG

open Formalism.FourierDecayAlt Formalism.FourierDecayAlt.MA Formalism.FourierDecayAlt.R Formalism.FourierDecayAlt.P.MAx1.An Formalism.FourierDecayAlt.P.MAx3.H Formalism.FourierDecayAlt.P.MAx3.G

noncomputable section

variable {P : M.Par}

def chi (c : LE.Cut) (ε : ℝ) : ℝ → ℝ := fun x => c.sc ε 1 x

/- English proof (translation)
Unfold `LE.SmoothLog chi LE.Cut.sc`. Establish `h1 : ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) (fun u : ℝ => Real.exp u / ε)` using `Real.contDiff_exp.div_const ε`. Conclude with `(c.smooth.comp h1).pow 1`.
-/
theorem smoothLog_chi (c : LE.Cut) (ε : ℝ) : LE.SmoothLog (chi c ε) := by
  unfold LE.SmoothLog chi LE.Cut.sc
  have h1 : ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) (fun u : ℝ => Real.exp u / ε) :=
    Real.contDiff_exp.div_const ε
  exact (c.smooth.comp h1).pow 1

/- English proof (translation)
Simplify using `[LE.ld, Real.exp_log hx]`.
-/
theorem log_derivative_zero (φ : ℝ → ℝ) (x : ℝ) (hx : 0 < x) : LE.ld 0 φ x = φ x := by
  simp [LE.ld, Real.exp_log hx]

/- English proof (translation)
Use function extensionality and compare the values at `π`. Establish `hm : (fun q : Qp P.r P.TT => (c.sc ε 1 (Gq P q) : ℂ) * (j π).1 q) ∈ smSub P.r P.TT`. Establish `h` using `(MAx2.Jet.Phi P (chi c ε) 0 * j π).2`. Establish `e : ((MAx2.Jet.Phi P (chi c ε) 0 * j π : SmQ P.r P.TT) : Qp P.r P.TT → ℂ) = fun q => (c.sc ε 1 (Gq P q) : ℂ) * (j π).1 q`. Use function extensionality and compare the values at `q`.

Use `show evQ P (MAx2.Jet.Phi P (chi c ε) 0 * j π) q = _`. Rewrite using `[MAx2.Jet.evQ_mul, MAx2.Jet.ev_Phi P (smoothLog_chi c ε), log_derivative_zero _ _ (Gq_pos P q)]`. Both sides reduce to the same expression. Rewrite using `[← e]`. Conclude with `h`.

Use `show toSm P _ = _`. Rewrite using `[G.toSm_of_mem P hm]`. Apply `Subtype.ext` to reduce the goal to its premises. Use function extensionality and compare the values at `q`. Use `show (c.sc ε 1 (Gq P q) : ℂ) * (j π).1 q = evQ P (MAx2.Jet.Phi P (chi c ε) 0 * j π) q`.

Rewrite using `[MAx2.Jet.evQ_mul, MAx2.Jet.ev_Phi P (smoothLog_chi c ε), log_derivative_zero _ _ (Gq_pos P q)]`. Both sides reduce to the same expression.
-/
theorem chiJ_eq (j : M.Ty P → SmQ P.r P.TT) (c : LE.Cut) (ε : ℝ) :
    chiJ P j c ε = fun π => MAx2.Jet.Phi P (chi c ε) 0 * j π := by
  funext π
  have hm : (fun q : Qp P.r P.TT => (c.sc ε 1 (Gq P q) : ℂ) * (j π).1 q) ∈ smSub P.r P.TT := by
    have h := (MAx2.Jet.Phi P (chi c ε) 0 * j π).2
    have e : ((MAx2.Jet.Phi P (chi c ε) 0 * j π : SmQ P.r P.TT) : Qp P.r P.TT → ℂ) =
        fun q => (c.sc ε 1 (Gq P q) : ℂ) * (j π).1 q := by
      funext q
      show evQ P (MAx2.Jet.Phi P (chi c ε) 0 * j π) q = _
      rw [MAx2.Jet.evQ_mul, MAx2.Jet.ev_Phi P (smoothLog_chi c ε), log_derivative_zero _ _ (Gq_pos P q)]
      rfl
    rw [← e]; exact h
  show toSm P _ = _
  rw [G.toSm_of_mem P hm]
  apply Subtype.ext
  funext q
  show (c.sc ε 1 (Gq P q) : ℂ) * (j π).1 q = evQ P (MAx2.Jet.Phi P (chi c ε) 0 * j π) q
  rw [MAx2.Jet.evQ_mul, MAx2.Jet.ev_Phi P (smoothLog_chi c ε), log_derivative_zero _ _ (Gq_pos P q)]
  rfl

variable {L : LevelData (A P (DQ P)) P.r} (hL : IsModelLevel P (DQ P) L) (hLaw : (DQ P).Laws P.TT)
include hL

/- English proof (translation)
Introduce `π π'` and use `by rw [Matrix.star_apply] simp only [SS, Matrix.of_apply] split_ifs · rw [← algebraMap_star_comm]; exact Subalgebra.algebraMap_mem _ _ · rw [star_zero]; exact Subalgebra.zero_mem _`.
-/
theorem starSS_mem (i : ℕ) : star (SS P (DQ P) i) ∈ MAx2.Jet.TS P := fun π π' => by
  rw [Matrix.star_apply]
  simp only [SS, Matrix.of_apply]
  split_ifs
  · rw [← algebraMap_star_comm]; exact Subalgebra.algebraMap_mem _ _
  · rw [star_zero]; exact Subalgebra.zero_mem _

/- English proof (translation)
Take `⟨-, -, -, -, -, -, -, -, hzb, -, hg, hgi, hn, -⟩` from `MAx2.Jet.lev_mem P hL`. Take `⟨d1, d2, d3, d4⟩` from `MAx2.Jet.Dr_mem P hL`. Break down `hh with ⟨y, rfl⟩ | ⟨y, rfl⟩` into its components or cases. Conclude with `mul_mem d1 ((MAx2.Jet.Tprod_mem P hL y).1 0 0)`. Establish `hT` using `(MAx2.Jet.Tprod_mem P hL y).1`.

Conclude with `mul_mem (mul_mem d2 hg) (add_mem (mul_mem (sub_mem (neg_mem hn) (mul_mem (Subalgebra.algebraMap_mem _ _) (mul_mem hzb hgi))) (hT 0 0)) (hT 1 0))`.
-/
theorem hatsTS {h : A P (DQ P)} (hh : h ∈ plusHats L) : h ∈ MAx2.Jet.TS P := by
  obtain ⟨-, -, -, -, -, -, -, -, hzb, -, hg, hgi, hn, -⟩ := MAx2.Jet.lev_mem P hL
  obtain ⟨d1, d2, d3, d4⟩ := MAx2.Jet.Dr_mem P hL
  rcases hh with ⟨y, rfl⟩ | ⟨y, rfl⟩
  · exact mul_mem d1 ((MAx2.Jet.Tprod_mem P hL y).1 0 0)
  · have hT := (MAx2.Jet.Tprod_mem P hL y).1
    exact mul_mem (mul_mem d2 hg) (add_mem (mul_mem (sub_mem (neg_mem hn)
      (mul_mem (Subalgebra.algebraMap_mem _ _) (mul_mem hzb hgi))) (hT 0 0)) (hT 1 0))

include hLaw

/- English proof (translation)
Take `⟨-, -, -, -, -, -, hz, hzi, hzb, hzbi, -⟩` from `MAx2.Jet.lev_mem P hL`. Take `⟨d1, d2, d3, d4⟩` from `MAx2.Jet.Dr_mem P hL`. Conclude with `⟨mul_mem d1 hz, mul_mem hzi d3, mul_mem d2 hzb, mul_mem hzbi d4⟩`.
-/
theorem DTS : L.D ∈ MAx2.Jet.TS P ∧ L.Di ∈ MAx2.Jet.TS P ∧ L.Db ∈ MAx2.Jet.TS P ∧ L.Dbi ∈ MAx2.Jet.TS P := by
  obtain ⟨-, -, -, -, -, -, hz, hzi, hzb, hzbi, -⟩ := MAx2.Jet.lev_mem P hL
  obtain ⟨d1, d2, d3, d4⟩ := MAx2.Jet.Dr_mem P hL
  exact ⟨mul_mem d1 hz, mul_mem hzi d3, mul_mem d2 hzb, mul_mem hzbi d4⟩

/- English proof (translation)
Take `⟨-, -, -, -, -, -, hz, hzi, hzb, hzbi, -⟩` from `MAx2.Jet.lev_mem P hL`. Take `⟨d1, d2, d3, d4⟩` from `MAx2.Jet.Dr_mem P hL`. Take `⟨D1, D2, D3, D4⟩` from `DTS hL hLaw`. Proceed by induction on `hb using Submonoid.closure_induction with`. Consider the case `mem x hx`.

Break down `hx with (((hx | ⟨f, rfl⟩) | ⟨i, hi, rfl⟩) | ⟨i, hi, rfl⟩)` into its components or cases. Simplify using `only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx`. Break down `hx with rfl | rfl | rfl | rfl` into its components or cases. Conclude with `hzi`. Conclude with `hzbi`.

Conclude with `mul_mem D1 D4`. Conclude with `mul_mem D3 D2`. Conclude with `MAx2.Jet.kap_mem P f`. Conclude with `mul_mem (mul_mem d2 d3) (MAx2.Jet.SS_mem P i)`. Simplify using `only`.

Rewrite using `[starSSn_eq hL hLaw]`. Conclude with `mul_mem (starSS_mem hL i) (mul_mem d1 d4)`. Consider the case `one => exact Subalgebra.one_mem _`. Consider the case `mul x y _ _ h1 h2 => exact mul_mem h1 h2`.
-/
theorem SB_TS {b : A P (DQ P)} (hb : b ∈ I4.SB L) : b ∈ MAx2.Jet.TS P := by
  obtain ⟨-, -, -, -, -, -, hz, hzi, hzb, hzbi, -⟩ := MAx2.Jet.lev_mem P hL
  obtain ⟨d1, d2, d3, d4⟩ := MAx2.Jet.Dr_mem P hL
  obtain ⟨D1, D2, D3, D4⟩ := DTS hL hLaw
  induction hb using Submonoid.closure_induction with
  | mem x hx =>
    rcases hx with (((hx | ⟨f, rfl⟩) | ⟨i, hi, rfl⟩) | ⟨i, hi, rfl⟩)
    · simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
      rcases hx with rfl | rfl | rfl | rfl
      · exact hzi
      · exact hzbi
      · exact mul_mem D1 D4
      · exact mul_mem D3 D2
    · exact MAx2.Jet.kap_mem P f
    · exact mul_mem (mul_mem d2 d3) (MAx2.Jet.SS_mem P i)
    · dsimp only
      rw [starSSn_eq hL hLaw]
      exact mul_mem (starSS_mem hL i) (mul_mem d1 d4)
  | one => exact Subalgebra.one_mem _
  | mul x y _ _ h1 h2 => exact mul_mem h1 h2

/- English proof (translation)
Take `⟨-, D2, -, D4⟩` from `DTS hL hLaw`. Proceed by induction on `hx using Submodule.span_induction with`. Consider the case `mem x hx`. Take `⟨b, hb, i, i', H, h1, h2, h3, rfl⟩` from `hx`. Conclude with `mul_mem (mul_mem (SB_TS hL hLaw hb) (mul_mem (pow_mem D2 i) (pow_mem D4 i'))) (Subalgebra.list_prod_mem _ fun h hh => hatsTS hL (h3 h hh))`.

Consider the case `zero => exact Subalgebra.zero_mem _`. Consider the case `add x y _ _ h1 h2 => exact add_mem h1 h2`. Consider the case `smul a x _ h => exact Subalgebra.smul_mem _ h a`.
-/
theorem normal_form_two_jet {d ℓ : ℕ} {x : A P (DQ P)} (hx : x ∈ NormalFormTwo L (I4.SB L) d ℓ) : x ∈ MAx2.Jet.TS P := by
  obtain ⟨-, D2, -, D4⟩ := DTS hL hLaw
  induction hx using Submodule.span_induction with
  | mem x hx =>
    obtain ⟨b, hb, i, i', H, h1, h2, h3, rfl⟩ := hx
    exact mul_mem (mul_mem (SB_TS hL hLaw hb) (mul_mem (pow_mem D2 i) (pow_mem D4 i')))
      (Subalgebra.list_prod_mem _ fun h hh => hatsTS hL (h3 h hh))
  | zero => exact Subalgebra.zero_mem _
  | add x y _ _ h1 h2 => exact add_mem h1 h2
  | smul a x _ h => exact Subalgebra.smul_mem _ h a

end

