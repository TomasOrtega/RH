/- English proof (translation)
Establish `h` using `commA L L.Drbi L.Drb (Drbi_Drb L) (Drb_Drbi L) (fun m => (comm_prod L.cbi (L.p m) (fun i => L.p_cbi m i))) (fun y hy => cl_comm L (memF L hy) (memDrbi L)) (comm_prod L.cbi L.nab (fun i => L.nab_cbi i)) Y`. Establish `h2` using `hat_ζbi L Y`. Unfold `LevelData.Dbi`. Prove the components needed by the constructor for the conclusion. Rewrite using `[mul_assoc, h.1, ← mul_assoc, h2.1, mul_assoc]`.

Rewrite using `[mul_assoc, h.2, ← mul_assoc, h2.2, mul_assoc]`.
-/
theorem hat_Dbi (Y : ℂ) : L.Dbi * L.Ahat Y = L.Ahat Y * L.Dbi ∧ L.Dbi * L.R0 Y = L.R0 Y * L.Dbi := by
  have h := commA L L.Drbi L.Drb (Drbi_Drb L) (Drb_Drbi L)
    (fun m => (comm_prod L.cbi (L.p m) (fun i => L.p_cbi m i)))
    (fun y hy => cl_comm L (memF L hy) (memDrbi L))
    (comm_prod L.cbi L.nab (fun i => L.nab_cbi i)) Y
  have h2 := hat_ζbi L Y
  unfold LevelData.Dbi
  constructor
  · rw [mul_assoc, h.1, ← mul_assoc, h2.1, mul_assoc]
  · rw [mul_assoc, h.2, ← mul_assoc, h2.2, mul_assoc]

/- English proof (translation)
Take `⟨h1, h2⟩` from `hat_Dbi L Y`. Prove the components needed by the constructor for the conclusion. Use `congrArg (fun x => L.Db * x * L.Db) h1` as an intermediate fact. Simplify using `only [← mul_assoc, Db_Dbi, one_mul] at this`. Rewrite `this` using `[mul_assoc, mul_assoc, Dbi_Db, mul_one]`.

Conclude with `this.symm`. Use `congrArg (fun x => L.Db * x * L.Db) h2` as an intermediate fact. Simplify using `only [← mul_assoc, Db_Dbi, one_mul] at this`. Rewrite `this` using `[mul_assoc, mul_assoc, Dbi_Db, mul_one]`. Conclude with `this.symm`.
-/
theorem hat_Db (Y : ℂ) : L.Db * L.Ahat Y = L.Ahat Y * L.Db ∧ L.Db * L.R0 Y = L.R0 Y * L.Db := by
  obtain ⟨h1, h2⟩ := hat_Dbi L Y
  constructor
  · have := congrArg (fun x => L.Db * x * L.Db) h1
    simp only [← mul_assoc, Db_Dbi, one_mul] at this
    rw [mul_assoc, mul_assoc, Dbi_Db, mul_one] at this
    exact this.symm
  · have := congrArg (fun x => L.Db * x * L.Db) h2
    simp only [← mul_assoc, Db_Dbi, one_mul] at this
    rw [mul_assoc, mul_assoc, Dbi_Db, mul_one] at this
    exact this.symm

/- English proof (translation)
Establish `h` using `(Formalism.FourierDecayAlt.P.shiftConjugation A r L (Y - 1)).1`. Rewrite `h` using `[sub_add_cancel]`. Rewrite using `[← h, mul_assoc, mul_assoc, D_Di, mul_one]`.
-/
theorem Ahat_Di (Y : ℂ) : L.Ahat Y * L.Di = L.Di * L.Ahat (Y - 1) := by
  have h := (Formalism.FourierDecayAlt.P.shiftConjugation A r L (Y - 1)).1
  rw [sub_add_cancel] at h
  rw [← h, mul_assoc, mul_assoc, D_Di, mul_one]

/- English proof (translation)
Establish `h` using `(Formalism.FourierDecayAlt.P.shiftConjugation A r L (Y - 1)).2.1`. Rewrite `h` using `[sub_add_cancel]`. Establish `h2 : L.Di * L.R0 (Y - 1) = (L.R0 Y + algebraMap ℂ A L.TT * (L.Drb * L.Di * L.Ahat Y)) * L.Di`. Rewrite using `[← h, mul_assoc, mul_assoc, D_Di, mul_one]`. Rewrite using `[mul_sub, h2, add_mul]`.

Establish `e1 : L.Di * algebraMap ℂ A L.TT = algebraMap ℂ A L.TT * L.Di` using `(Algebra.commutes _ _).symm`. Establish `e2 : L.Di * L.Drb = L.Drb * L.Di` using `cl_comm L (memDi L) (memDrb L)`. Establish `hc : L.Di * (algebraMap ℂ A L.TT * (L.Drb * L.Di * L.Ahat (Y - 1))) = algebraMap ℂ A L.TT * (L.Drb * L.Di * L.Ahat Y) * L.Di`. Combine the equalities or inequalities in the displayed calculation. Rewrite using `[← mul_assoc, e1, mul_assoc]`.

Use `congr 1`. Simplify using `only [← mul_assoc]`. Rewrite using `[e2]`. Use `_ = algebraMap ℂ A L.TT * (L.Drb * L.Di * L.Ahat Y) * L.Di := by`. Rewrite using `[← Ahat_Di]`.

Simplify using `only [mul_assoc]`. Rewrite using `[hc]`. Normalize the expressions using the abelian group laws.
-/
theorem raising_mul_D_inv (Y : ℂ) : L.R0 Y * L.Di =
    L.Di * (L.R0 (Y - 1) - algebraMap ℂ A L.TT * (L.Drb * L.Di * L.Ahat (Y - 1))) := by
  have h := (Formalism.FourierDecayAlt.P.shiftConjugation A r L (Y - 1)).2.1
  rw [sub_add_cancel] at h
  have h2 : L.Di * L.R0 (Y - 1) = (L.R0 Y + algebraMap ℂ A L.TT * (L.Drb * L.Di * L.Ahat Y)) * L.Di := by
    rw [← h, mul_assoc, mul_assoc, D_Di, mul_one]
  rw [mul_sub, h2, add_mul]
  have e1 : L.Di * algebraMap ℂ A L.TT = algebraMap ℂ A L.TT * L.Di := (Algebra.commutes _ _).symm
  have e2 : L.Di * L.Drb = L.Drb * L.Di := cl_comm L (memDi L) (memDrb L)
  have hc : L.Di * (algebraMap ℂ A L.TT * (L.Drb * L.Di * L.Ahat (Y - 1))) =
      algebraMap ℂ A L.TT * (L.Drb * L.Di * L.Ahat Y) * L.Di := by
    calc L.Di * (algebraMap ℂ A L.TT * (L.Drb * L.Di * L.Ahat (Y - 1)))
        = algebraMap ℂ A L.TT * (L.Drb * (L.Di * (L.Di * L.Ahat (Y - 1)))) := by
          rw [← mul_assoc, e1, mul_assoc]; congr 1; simp only [← mul_assoc]; rw [e2]
      _ = algebraMap ℂ A L.TT * (L.Drb * L.Di * L.Ahat Y) * L.Di := by
          rw [← Ahat_Di]; simp only [mul_assoc]
  rw [hc]
  abel

end Formalism.FourierDecayAlt.P.MAx3.H

end S_H_H2

section S_H_H3

set_option linter.unusedVariables false

namespace Formalism.FourierDecayAlt.P.MAx3.H

open Formalism.FourierDecayAlt.R Formalism.FourierDecayAlt.R.LevelData Formalism.FourierDecayAlt.P.RuleGD

variable {A : Type} [Ring A] [Algebra ℂ A] {r : ℕ} (L : LevelData A r)

/- English proof (translation)
Proceed by induction on `i generalizing Y with`. Consider the case `zero => simp`. Consider the case `succ i ih`. Rewrite using `[pow_succ', ← mul_assoc, Ahat_Di, mul_assoc, ih, ← mul_assoc]`. Use `congr 2`.

Use `push_cast`. Expand and normalize the polynomial expressions, which then agree.
-/
theorem Ahat_Dipow (i : ℕ) (Y : ℂ) : L.Ahat Y * L.Di ^ i = L.Di ^ i * L.Ahat (Y - i) := by
  induction i generalizing Y with
  | zero => simp
  | succ i ih =>
    rw [pow_succ', ← mul_assoc, Ahat_Di, mul_assoc, ih, ← mul_assoc]
    congr 2; push_cast; ring

/- English proof (translation)
The claim follows from `((Commute.pow_right (hat_Dbi L Y).1.symm i).symm).eq.symm`.
-/
theorem comm_Dbipow_A (i : ℕ) (Y : ℂ) : L.Ahat Y * L.Dbi ^ i = L.Dbi ^ i * L.Ahat Y :=
  ((Commute.pow_right (hat_Dbi L Y).1.symm i).symm).eq.symm

/- English proof (translation)
The claim follows from `((Commute.pow_right (hat_Dbi L Y).2.symm i).symm).eq.symm`.
-/
theorem comm_Dbipow_R (i : ℕ) (Y : ℂ) : L.R0 Y * L.Dbi ^ i = L.Dbi ^ i * L.R0 Y :=
  ((Commute.pow_right (hat_Dbi L Y).2.symm i).symm).eq.symm

/- English proof (translation)
The claim follows from `Subring.pow_mem _ hx i`.
-/
theorem memPow {x : A} (hx : x ∈ Subring.closure (FS L)) (i : ℕ) : x ^ i ∈ Subring.closure (FS L) :=
  Subring.pow_mem _ hx i

/- English proof (translation)
Proceed by induction on `i generalizing Y with`. Consider the case `zero => exact ⟨[], by simp⟩`. Consider the case `succ i ih`. Take `⟨cs, hcs⟩` from `ih (Y - 1)`. Use `⟨cs ++ [(-L.TT, Y - 1 - i)], ?_⟩` and prove the remaining obligations.

Establish `hDD : L.Drb * L.Di * L.Di ^ i = L.Di ^ i * (L.Drb * L.Di)` using `cl_comm L (Subring.mul_mem _ (memDrb L) (memDi L)) (memPow L (memDi L) i)`. Establish `e : (Y - 1 - (i : ℂ)) = Y - ((i + 1 : ℕ) : ℂ)` using `by push_cast; ring`. Establish `hX : algebraMap ℂ A L.TT * (L.Drb * L.Di * L.Ahat (Y - 1)) * L.Di ^ i = L.Di ^ i * (L.TT • (L.Drb * L.Di * L.Ahat (Y - 1 - i)))`. Rewrite using `[mul_assoc, mul_assoc (L.Drb * L.Di), Ahat_Dipow, ← mul_assoc (L.Drb * L.Di), hDD, Algebra.smul_def, ← mul_assoc, ← mul_assoc, ← mul_assoc, Algebra.commutes L.TT (L.Di ^ i)]`. Simplify using `only [mul_assoc]`.

Combine the equalities or inequalities in the displayed calculation. Rewrite using `[raising_mul_D_inv, mul_assoc, sub_mul]`. Use `_ = L.Di ^ (i + 1) * (L.R0 (Y - ((i + 1 : ℕ) : ℂ)) + ((cs ++ [(-L.TT, Y - 1 - i)]).map fun x => x.1 • (L.Drb * L.Di * L.Ahat x.2)).sum) := by`. Rewrite using `[hcs, hX, ← mul_sub, ← mul_assoc, ← pow_succ', e, List.map_append, List.sum_append, List.map_singleton, List.sum_singleton, neg_smul, ← sub_eq_add_neg, add_sub_assoc, ← e]`.
-/
theorem raising_D_inv_pow (i : ℕ) (Y : ℂ) : ∃ cs : List (ℂ × ℂ), L.R0 Y * L.Di ^ i =
    L.Di ^ i * (L.R0 (Y - i) + (cs.map fun x => x.1 • (L.Drb * L.Di * L.Ahat x.2)).sum) := by
  induction i generalizing Y with
  | zero => exact ⟨[], by simp⟩
  | succ i ih =>
    obtain ⟨cs, hcs⟩ := ih (Y - 1)
    refine ⟨cs ++ [(-L.TT, Y - 1 - i)], ?_⟩
    have hDD : L.Drb * L.Di * L.Di ^ i = L.Di ^ i * (L.Drb * L.Di) :=
      cl_comm L (Subring.mul_mem _ (memDrb L) (memDi L)) (memPow L (memDi L) i)
    have e : (Y - 1 - (i : ℂ)) = Y - ((i + 1 : ℕ) : ℂ) := by push_cast; ring
    have hX : algebraMap ℂ A L.TT * (L.Drb * L.Di * L.Ahat (Y - 1)) * L.Di ^ i =
        L.Di ^ i * (L.TT • (L.Drb * L.Di * L.Ahat (Y - 1 - i))) := by
      rw [mul_assoc, mul_assoc (L.Drb * L.Di), Ahat_Dipow, ← mul_assoc (L.Drb * L.Di), hDD,
        Algebra.smul_def, ← mul_assoc, ← mul_assoc, ← mul_assoc, Algebra.commutes L.TT (L.Di ^ i)]
      simp only [mul_assoc]
    calc L.R0 Y * L.Di ^ (i + 1) = L.R0 Y * L.Di * L.Di ^ i := by rw [pow_succ', mul_assoc]
      _ = L.Di * (L.R0 (Y - 1) * L.Di ^ i - algebraMap ℂ A L.TT * (L.Drb * L.Di * L.Ahat (Y - 1)) * L.Di ^ i) := by
          rw [raising_mul_D_inv, mul_assoc, sub_mul]
      _ = L.Di ^ (i + 1) * (L.R0 (Y - ((i + 1 : ℕ) : ℂ)) +
            ((cs ++ [(-L.TT, Y - 1 - i)]).map fun x => x.1 • (L.Drb * L.Di * L.Ahat x.2)).sum) := by
          rw [hcs, hX, ← mul_sub, ← mul_assoc, ← pow_succ', e, List.map_append, List.sum_append,
            List.map_singleton, List.sum_singleton, neg_smul, ← sub_eq_add_neg, add_sub_assoc, ← e]

def plusHats : Set A := Set.range L.Ahat ∪ Set.range L.R0

def tm (b : A) (i i' : ℕ) (H : List A) : A := b * (L.Di ^ i * L.Dbi ^ i') * H.prod

variable (S : Submonoid A)

def Term (n : ℕ) : Set A :=
  {x | ∃ b ∈ S, ∃ (i i' : ℕ) (H : List A), i + i' = n ∧ H.length = n ∧ (∀ h ∈ H, h ∈ plusHats L) ∧
    x = tm L b i i' H}

def NF (n : ℕ) : Submodule ℂ A := Submodule.span ℂ (Term L S n)

structure Hyp : Prop where
  comm_Di : ∀ b ∈ S, b * L.Di = L.Di * b
  comm_Dbi : ∀ b ∈ S, b * L.Dbi = L.Dbi * b
  ahat : ∀ b ∈ S, ∃ t : ℂ, ∀ Y, L.Ahat Y * b = b * L.Ahat (Y + t)
  r0 : ∀ b ∈ S, ∀ Y, ∃ (t : ℂ) (ts : List (ℂ × A × ℂ)), (∀ x ∈ ts, x.2.1 ∈ S) ∧
    L.R0 Y * b = b * L.R0 (Y + t) + (ts.map fun x => x.1 • (x.2.1 * L.Ahat x.2.2)).sum
  drb : L.Drb * L.Di ∈ S

variable {L S}

/- English proof (translation)
The claim follows from `Submodule.subset_span ⟨b, hb, i, i', H, h1, h2, h3, rfl⟩`.
-/
theorem term_mem {n : ℕ} {b : A} (hb : b ∈ S) {i i' : ℕ} {H : List A} (h1 : i + i' = n) (h2 : H.length = n)
    (h3 : ∀ h ∈ H, h ∈ plusHats L) : tm L b i i' H ∈ NF L S n :=
  Submodule.subset_span ⟨b, hb, i, i', H, h1, h2, h3, rfl⟩

/- English proof (translation)
Proceed by induction on `ts with`. Consider the case `nil => simp`. Consider the case `cons a ts ih`. Rewrite using `[List.map_cons, List.sum_cons]`. Conclude with `Submodule.add_mem _ (h a (by simp)) (ih fun x hx => h x (by simp [hx]))`.
-/
theorem sum_mem_NF {n : ℕ} {ι : Type} (ts : List ι) (f : ι → A) (h : ∀ x ∈ ts, f x ∈ NF L S n) :
    (ts.map f).sum ∈ NF L S n := by
  induction ts with
  | nil => simp
  | cons a ts ih =>
    rw [List.map_cons, List.sum_cons]
    exact Submodule.add_mem _ (h a (by simp)) (ih fun x hx => h x (by simp [hx]))

/- English proof (translation)
Take `⟨b, hb, i, i', H, h1, h2, h3, rfl⟩` from `hx`. Take `⟨t, ht⟩` from `hS.ahat b hb`. Establish `ht' : ∀ z, L.Ahat y * (b * z) = b * (L.Ahat (y + t) * z)` using `fun z => by`. Rewrite using `[← mul_assoc, ht, mul_assoc]`. Establish `hb' : ∀ z, L.Di * (b * z) = b * (L.Di * z)` using `fun z => by`.

Rewrite using `[← mul_assoc, ← hS.comm_Di b hb, mul_assoc]`. Establish `hA1 : ∀ z, L.Ahat (y + t) * (L.Di ^ i * z) = L.Di ^ i * (L.Ahat (y + t - i) * z)` using `fun z => by`. Rewrite using `[← mul_assoc, Ahat_Dipow, mul_assoc]`. Establish `hA2 : ∀ z, L.Ahat (y + t - i) * (L.Dbi ^ i' * z) = L.Dbi ^ i' * (L.Ahat (y + t - i) * z)` using `fun z => by`. Rewrite using `[← mul_assoc, comm_Dbipow_A, mul_assoc]`.

Establish `e : L.Di * L.Ahat y * tm L b i i' H = tm L b (i + 1) i' (L.Ahat (y + t - i) :: H)`. Unfold `tm`. Rewrite using `[List.prod_cons, pow_succ']`. Simplify using `only [mul_assoc]`. Rewrite using `[ht', hb', hA1, hA2]`.

Rewrite using `[e]`. Conclude with `term_mem hb (by omega) (by simp [h2]) (by`. Introduce `h hh`. Break down `List.mem_cons.1 hh with rfl | hh` into its components or cases. Conclude with `Or.inl ⟨_, rfl⟩`.

Conclude with `h3 h hh)`.
-/
theorem a_term (hS : Hyp L S) (y : ℂ) {n : ℕ} {x : A} (hx : x ∈ Term L S n) :
    L.Di * L.Ahat y * x ∈ NF L S (n + 1) := by
  obtain ⟨b, hb, i, i', H, h1, h2, h3, rfl⟩ := hx
  obtain ⟨t, ht⟩ := hS.ahat b hb
  have ht' : ∀ z, L.Ahat y * (b * z) = b * (L.Ahat (y + t) * z) := fun z => by
    rw [← mul_assoc, ht, mul_assoc]
  have hb' : ∀ z, L.Di * (b * z) = b * (L.Di * z) := fun z => by
    rw [← mul_assoc, ← hS.comm_Di b hb, mul_assoc]
  have hA1 : ∀ z, L.Ahat (y + t) * (L.Di ^ i * z) = L.Di ^ i * (L.Ahat (y + t - i) * z) := fun z => by
    rw [← mul_assoc, Ahat_Dipow, mul_assoc]
  have hA2 : ∀ z, L.Ahat (y + t - i) * (L.Dbi ^ i' * z) = L.Dbi ^ i' * (L.Ahat (y + t - i) * z) := fun z => by
    rw [← mul_assoc, comm_Dbipow_A, mul_assoc]
  have e : L.Di * L.Ahat y * tm L b i i' H = tm L b (i + 1) i' (L.Ahat (y + t - i) :: H) := by
    unfold tm
    rw [List.prod_cons, pow_succ']
    simp only [mul_assoc]
    rw [ht', hb', hA1, hA2]
  rw [e]
  exact term_mem hb (by omega) (by simp [h2]) (by
    intro h hh
    rcases List.mem_cons.1 hh with rfl | hh
    · exact Or.inl ⟨_, rfl⟩
    · exact h3 h hh)

end Formalism.FourierDecayAlt.P.MAx3.H

end S_H_H3

section S_H_H4

set_option linter.unusedVariables false

namespace Formalism.FourierDecayAlt.P.MAx3.H

open Formalism.FourierDecayAlt.R Formalism.FourierDecayAlt.R.LevelData Formalism.FourierDecayAlt.P.RuleGD

variable {A : Type} [Ring A] [Algebra ℂ A] {r : ℕ} {L : LevelData A r} {S : Submonoid A}

def Term2 (L : LevelData A r) (S : Submonoid A) (d ℓ : ℕ) : Set A :=
  {x | ∃ b ∈ S, ∃ (i i' : ℕ) (H : List A), i + i' = d ∧ H.length = ℓ ∧ (∀ h ∈ H, h ∈ plusHats L) ∧
    x = tm L b i i' H}

def NormalFormTwo (L : LevelData A r) (S : Submonoid A) (d ℓ : ℕ) : Submodule ℂ A := Submodule.span ℂ (Term2 L S d ℓ)

/- English proof (translation)
The claim follows from `Submodule.subset_span ⟨b, hb, i, i', H, h1, h2, h3, rfl⟩`.
-/
theorem mem2 {d ℓ : ℕ} {b : A} (hb : b ∈ S) {i i' : ℕ} {H : List A} (h1 : i + i' = d) (h2 : H.length = ℓ)
    (h3 : ∀ h ∈ H, h ∈ plusHats L) : tm L b i i' H ∈ NormalFormTwo L S d ℓ :=
  Submodule.subset_span ⟨b, hb, i, i', H, h1, h2, h3, rfl⟩

/- English proof (translation)
Introduce `x hx`. Break down `List.mem_cons.1 hx with rfl | hx` into its components or cases. Use `exacts [hh, h3 x hx]`.
-/
theorem cons_hats {h : A} (hh : h ∈ plusHats L) {H : List A} (h3 : ∀ x ∈ H, x ∈ plusHats L) :
    ∀ x ∈ h :: H, x ∈ plusHats L := by
  intro x hx; rcases List.mem_cons.1 hx with rfl | hx; exacts [hh, h3 x hx]

/- English proof (translation)
Proceed by induction on `hx using Submodule.span_induction with`. Consider the case `mem x hx => exact h x hx`. Consider the case `zero => simp`. Consider the case `add x y _ _ h1 h2 => rw [mul_add]`. Conclude with `M.add_mem h1 h2`.

Consider the case `smul c x _ h1 => rw [mul_smul_comm]`. Conclude with `M.smul_mem c h1`.
-/
theorem span_mul {T : Set A} {M : Submodule ℂ A} (z : A) (h : ∀ x ∈ T, z * x ∈ M) {x : A}
    (hx : x ∈ Submodule.span ℂ T) : z * x ∈ M := by
  induction hx using Submodule.span_induction with
  | mem x hx => exact h x hx
  | zero => simp
  | add x y _ _ h1 h2 => rw [mul_add]; exact M.add_mem h1 h2
  | smul c x _ h1 => rw [mul_smul_comm]; exact M.smul_mem c h1

/- English proof (translation)
Unfold `tm`. Rewrite using `[← mul_assoc, ← mul_assoc, ← hS.comm_Di b hb, pow_succ']`. Simplify using `only [mul_assoc]`.
-/
theorem Di_tm (hS : Hyp L S) {b : A} (hb : b ∈ S) (i i' : ℕ) (H : List A) :
    L.Di * tm L b i i' H = tm L b (i + 1) i' H := by
  unfold tm
  rw [← mul_assoc, ← mul_assoc, ← hS.comm_Di b hb, pow_succ']
  simp only [mul_assoc]

/- English proof (translation)
Unfold `tm`. Establish `hc : L.Dbi * L.Di ^ i = L.Di ^ i * L.Dbi` using `cl_comm L (memDbi L) (memPow L (memDi L) i)`. Rewrite using `[← mul_assoc, ← mul_assoc, ← hS.comm_Dbi b hb, pow_succ']`. Simplify using `only [mul_assoc]`. Rewrite using `[← mul_assoc L.Dbi, hc, mul_assoc]`.
-/
theorem Dbi_tm (hS : Hyp L S) {b : A} (hb : b ∈ S) (i i' : ℕ) (H : List A) :
    L.Dbi * tm L b i i' H = tm L b i (i' + 1) H := by
  unfold tm
  have hc : L.Dbi * L.Di ^ i = L.Di ^ i * L.Dbi :=
    cl_comm L (memDbi L) (memPow L (memDi L) i)
  rw [← mul_assoc, ← mul_assoc, ← hS.comm_Dbi b hb, pow_succ']
  simp only [mul_assoc]
  rw [← mul_assoc L.Dbi, hc, mul_assoc]

/- English proof (translation)
Take `⟨t, ht⟩` from `hS.ahat b hb`. Use `⟨y + t - i, ?_⟩` and prove the remaining obligations. Unfold `tm`. Rewrite using `[List.prod_cons]`. Simplify using `only [mul_assoc]`.

Rewrite using `[← mul_assoc (L.Ahat y), ht, mul_assoc, ← mul_assoc (L.Ahat (y + t)), Ahat_Dipow, mul_assoc, ← mul_assoc (L.Ahat (y + t - i)), comm_Dbipow_A, mul_assoc]`.
-/
theorem Ahat_tm (hS : Hyp L S) (y : ℂ) {b : A} (hb : b ∈ S) (i i' : ℕ) (H : List A) :
    ∃ y', L.Ahat y * tm L b i i' H = tm L b i i' (L.Ahat y' :: H) := by
  obtain ⟨t, ht⟩ := hS.ahat b hb
  refine ⟨y + t - i, ?_⟩
  unfold tm
  rw [List.prod_cons]
  simp only [mul_assoc]
  rw [← mul_assoc (L.Ahat y), ht, mul_assoc, ← mul_assoc (L.Ahat (y + t)), Ahat_Dipow, mul_assoc,
    ← mul_assoc (L.Ahat (y + t - i)), comm_Dbipow_A, mul_assoc]

/- English proof (translation)
Use `span_mul _ (fun x hx => ?_) hx` and prove the remaining obligations. Take `⟨b, hb, i, i', H, h1, h2, h3, rfl⟩` from `hx`. Rewrite using `[Di_tm hS hb]; exact mem2 hb (by omega) h2 h3`.
-/
theorem normal_form_D_inv (hS : Hyp L S) {d ℓ : ℕ} {x : A} (hx : x ∈ NormalFormTwo L S d ℓ) : L.Di * x ∈ NormalFormTwo L S (d + 1) ℓ := by
  refine span_mul _ (fun x hx => ?_) hx
  obtain ⟨b, hb, i, i', H, h1, h2, h3, rfl⟩ := hx
  rw [Di_tm hS hb]; exact mem2 hb (by omega) h2 h3

/- English proof (translation)
Use `span_mul _ (fun x hx => ?_) hx` and prove the remaining obligations. Take `⟨b, hb, i, i', H, h1, h2, h3, rfl⟩` from `hx`. Rewrite using `[Dbi_tm hS hb]; exact mem2 hb (by omega) h2 h3`.
-/
theorem normal_form_two_D_bar_inv (hS : Hyp L S) {d ℓ : ℕ} {x : A} (hx : x ∈ NormalFormTwo L S d ℓ) : L.Dbi * x ∈ NormalFormTwo L S (d + 1) ℓ := by
  refine span_mul _ (fun x hx => ?_) hx
  obtain ⟨b, hb, i, i', H, h1, h2, h3, rfl⟩ := hx
  rw [Dbi_tm hS hb]; exact mem2 hb (by omega) h2 h3

/- English proof (translation)
Use `span_mul _ (fun x hx => ?_) hx` and prove the remaining obligations. Take `⟨b, hb, i, i', H, h1, h2, h3, rfl⟩` from `hx`. Take `⟨y', e⟩` from `Ahat_tm hS y hb i i' H`. Rewrite using `[e]; exact mem2 hb h1 (by simp [h2]) (cons_hats (Or.inl ⟨_, rfl⟩) h3)`.
-/
theorem normal_form_two_hat (hS : Hyp L S) (y : ℂ) {d ℓ : ℕ} {x : A} (hx : x ∈ NormalFormTwo L S d ℓ) :
    L.Ahat y * x ∈ NormalFormTwo L S d (ℓ + 1) := by
  refine span_mul _ (fun x hx => ?_) hx
  obtain ⟨b, hb, i, i', H, h1, h2, h3, rfl⟩ := hx
  obtain ⟨y', e⟩ := Ahat_tm hS y hb i i' H
  rw [e]; exact mem2 hb h1 (by simp [h2]) (cons_hats (Or.inl ⟨_, rfl⟩) h3)

end Formalism.FourierDecayAlt.P.MAx3.H

end S_H_H4

section S_H_H5

set_option linter.unusedVariables false

namespace Formalism.FourierDecayAlt.P.MAx3.H

open Formalism.FourierDecayAlt.R Formalism.FourierDecayAlt.R.LevelData Formalism.FourierDecayAlt.P.RuleGD

variable {A : Type} [Ring A] [Algebra ℂ A] {r : ℕ} {L : LevelData A r} {S : Submonoid A}

/- English proof (translation)
Unfold `tm`. Rewrite using `[List.prod_cons]`. Simplify using `only [mul_assoc]`. Rewrite using `[← mul_assoc (L.Ahat y'), Ahat_Dipow, mul_assoc, ← mul_assoc (L.Ahat (y' - i)), comm_Dbipow_A, mul_assoc]`.
-/
theorem bAPQ (b : A) (y' : ℂ) (i i' : ℕ) (H : List A) :
    b * L.Ahat y' * (L.Di ^ i * L.Dbi ^ i') * H.prod = tm L b i i' (L.Ahat (y' - i) :: H) := by
  unfold tm
  rw [List.prod_cons]
  simp only [mul_assoc]
  rw [← mul_assoc (L.Ahat y'), Ahat_Dipow, mul_assoc, ← mul_assoc (L.Ahat (y' - i)), comm_Dbipow_A, mul_assoc]

/- English proof (translation)
The claim follows from `cl_comm L (Subring.mul_mem _ (memDrb L) (memDi L)) (memPow L (memDi L) i)`.
-/
theorem drb_comm_P (i : ℕ) : L.Drb * L.Di * L.Di ^ i = L.Di ^ i * (L.Drb * L.Di) :=
  cl_comm L (Subring.mul_mem _ (memDrb L) (memDi L)) (memPow L (memDi L) i)
/- English proof (translation)
The claim follows from `cl_comm L (Subring.mul_mem _ (memDrb L) (memDi L)) (memPow L (memDbi L) i)`.
-/
theorem drb_comm_Q (i : ℕ) : L.Drb * L.Di * L.Dbi ^ i = L.Dbi ^ i * (L.Drb * L.Di) :=
  cl_comm L (Subring.mul_mem _ (memDrb L) (memDi L)) (memPow L (memDbi L) i)

/- English proof (translation)
Take `⟨cs, hcs⟩` from `raising_D_inv_pow L i y`. Use `⟨cs, ?_⟩` and prove the remaining obligations. Establish `e1 : b * L.R0 y * (L.Di ^ i * L.Dbi ^ i') * H.prod = b * L.Di ^ i * (L.R0 (y - i) + (cs.map fun x => x.1 • (L.Drb * L.Di * L.Ahat x.2)).sum) * L.Dbi ^ i' * H.prod`. Rewrite using `[mul_assoc b (L.Di ^ i), ← hcs]`. Simplify using `only [mul_assoc]`.

Rewrite using `[e1, mul_add, add_mul, add_mul]`. Use `congr 1`. Unfold `tm`. Rewrite using `[List.prod_cons]`. Simplify using `only [mul_assoc]`.

Rewrite using `[← mul_assoc (L.R0 _), comm_Dbipow_R, mul_assoc]`. Rewrite using `[← List.sum_map_mul_left, ← List.sum_map_mul_right, ← List.sum_map_mul_right]`. Use `congr 1`. Use `List.map_congr_left fun x _ => ?_` and prove the remaining obligations. Rewrite using `[mul_smul_comm, smul_mul_assoc, smul_mul_assoc]`.

Use `congr 1`. Establish `tA : ∀ z, L.Ahat x.2 * (L.Dbi ^ i' * z) = L.Dbi ^ i' * (L.Ahat x.2 * z)` using `fun z => by`. Rewrite using `[← mul_assoc, comm_Dbipow_A, mul_assoc]`. Establish `tP : ∀ z, L.Di ^ i * (L.Drb * (L.Di * z)) = L.Drb * (L.Di * (L.Di ^ i * z))` using `fun z => by`. Rewrite using `[← mul_assoc L.Drb, ← mul_assoc, ← drb_comm_P, mul_assoc, mul_assoc]`.

Unfold `tm`. Rewrite using `[List.prod_cons]`. Simplify using `only [mul_assoc]`. Rewrite using `[tA, tP]`.
-/
theorem bRPQ (b : A) (y : ℂ) (i i' : ℕ) (H : List A) : ∃ cs : List (ℂ × ℂ),
    b * L.R0 y * (L.Di ^ i * L.Dbi ^ i') * H.prod = tm L b i i' (L.R0 (y - i) :: H) +
      (cs.map fun x => x.1 • tm L (b * (L.Drb * L.Di)) i i' (L.Ahat x.2 :: H)).sum := by
  obtain ⟨cs, hcs⟩ := raising_D_inv_pow L i y
  refine ⟨cs, ?_⟩
  have e1 : b * L.R0 y * (L.Di ^ i * L.Dbi ^ i') * H.prod =
      b * L.Di ^ i * (L.R0 (y - i) + (cs.map fun x => x.1 • (L.Drb * L.Di * L.Ahat x.2)).sum) *
        L.Dbi ^ i' * H.prod := by
    rw [mul_assoc b (L.Di ^ i), ← hcs]; simp only [mul_assoc]
  rw [e1, mul_add, add_mul, add_mul]
  congr 1
  · unfold tm; rw [List.prod_cons]; simp only [mul_assoc]; rw [← mul_assoc (L.R0 _), comm_Dbipow_R, mul_assoc]
  · rw [← List.sum_map_mul_left, ← List.sum_map_mul_right, ← List.sum_map_mul_right]
    congr 1
    refine List.map_congr_left fun x _ => ?_
    rw [mul_smul_comm, smul_mul_assoc, smul_mul_assoc]
    congr 1
    have tA : ∀ z, L.Ahat x.2 * (L.Dbi ^ i' * z) = L.Dbi ^ i' * (L.Ahat x.2 * z) := fun z => by
      rw [← mul_assoc, comm_Dbipow_A, mul_assoc]
    have tP : ∀ z, L.Di ^ i * (L.Drb * (L.Di * z)) = L.Drb * (L.Di * (L.Di ^ i * z)) := fun z => by
      rw [← mul_assoc L.Drb, ← mul_assoc, ← drb_comm_P, mul_assoc, mul_assoc]
    unfold tm; rw [List.prod_cons]; simp only [mul_assoc]
    rw [tA, tP]

end Formalism.FourierDecayAlt.P.MAx3.H

end S_H_H5

section S_H_H6

set_option linter.unusedVariables false

namespace Formalism.FourierDecayAlt.P.MAx3.H

open Formalism.FourierDecayAlt.R Formalism.FourierDecayAlt.R.LevelData Formalism.FourierDecayAlt.P.RuleGD

variable {A : Type} [Ring A] [Algebra ℂ A] {r : ℕ} {L : LevelData A r} {S : Submonoid A}

/- English proof (translation)
Use `span_mul _ (fun x hx => ?_) hx` and prove the remaining obligations. Take `⟨b, hb, i, i', H, h1, h2, h3, rfl⟩` from `hx`. Take `⟨t, ts, hts, e⟩` from `hS.r0 b hb y`. Take `⟨cs, hcs⟩` from `bRPQ (L := L) b (y + t) i i' H`. Establish `e2 : L.R0 y * tm L b i i' H = (b * L.R0 (y + t) * (L.Di ^ i * L.Dbi ^ i') * H.prod) + (ts.map fun x => x.1 • (x.2.1 * L.Ahat x.2.2 * (L.Di ^ i * L.Dbi ^ i') * H.prod)).sum`.

Unfold `tm`. Rewrite using `[← mul_assoc, ← mul_assoc, e, add_mul, add_mul, ← List.sum_map_mul_right, ← List.sum_map_mul_right]`. Use `congr 1`. Use `congr 1`. Use `List.map_congr_left fun x _ => ?_` and prove the remaining obligations.

Rewrite using `[smul_mul_assoc, smul_mul_assoc]`. Establish `hlen : (L.R0 (y + t - i) :: H).length = ℓ + 1` using `by simp [h2]`. Rewrite using `[e2, hcs]`. Use `Submodule.add_mem _ (Submodule.add_mem _ (mem2 hb h1 hlen (cons_hats (Or.inr ⟨_, rfl⟩) h3)) (sum_mem_normal_form_two _ _ fun x _ => Submodule.smul_mem _ _ (mem2 (S.mul_mem hb hS.drb) h1 (by simp [h2]) (cons_hats (Or.inl ⟨_, rfl⟩) h3)))) (sum_mem_normal_form_two _ _ fun x hx => ?_ …` and prove the remaining obligations. Rewrite using `[bAPQ]`.

Conclude with `Submodule.smul_mem _ _ (mem2 (hts x hx) h1 (by simp [h2]) (cons_hats (Or.inl ⟨_, rfl⟩) h3))`. Use `where sum_mem_normal_form_two {ι : Type} (ts : List ι) (f : ι → A) (h : ∀ x ∈ ts, f x ∈ NormalFormTwo L S d (ℓ + 1)) : (ts.map f).sum ∈ NormalFormTwo L S d (ℓ + 1) := by`. Proceed by induction on `ts with`. Consider the case `nil => simp`. Consider the case `cons a ts ih`.

Rewrite using `[List.map_cons, List.sum_cons]`. Conclude with `Submodule.add_mem _ (h a (by simp)) (ih fun x hx => h x (by simp [hx]))`.
-/
theorem normal_form_two_raising (hS : Hyp L S) (y : ℂ) {d ℓ : ℕ} {x : A} (hx : x ∈ NormalFormTwo L S d ℓ) :
    L.R0 y * x ∈ NormalFormTwo L S d (ℓ + 1) := by
  refine span_mul _ (fun x hx => ?_) hx
  obtain ⟨b, hb, i, i', H, h1, h2, h3, rfl⟩ := hx
  obtain ⟨t, ts, hts, e⟩ := hS.r0 b hb y
  obtain ⟨cs, hcs⟩ := bRPQ (L := L) b (y + t) i i' H
  have e2 : L.R0 y * tm L b i i' H = (b * L.R0 (y + t) * (L.Di ^ i * L.Dbi ^ i') * H.prod) +
      (ts.map fun x => x.1 • (x.2.1 * L.Ahat x.2.2 * (L.Di ^ i * L.Dbi ^ i') * H.prod)).sum := by
    unfold tm
    rw [← mul_assoc, ← mul_assoc, e, add_mul, add_mul, ← List.sum_map_mul_right, ← List.sum_map_mul_right]
    congr 1
    congr 1
    refine List.map_congr_left fun x _ => ?_
    rw [smul_mul_assoc, smul_mul_assoc]
  have hlen : (L.R0 (y + t - i) :: H).length = ℓ + 1 := by simp [h2]
  rw [e2, hcs]
  refine Submodule.add_mem _ (Submodule.add_mem _ (mem2 hb h1 hlen (cons_hats (Or.inr ⟨_, rfl⟩) h3))
    (sum_mem_normal_form_two _ _ fun x _ => Submodule.smul_mem _ _ (mem2 (S.mul_mem hb hS.drb) h1 (by simp [h2])
      (cons_hats (Or.inl ⟨_, rfl⟩) h3)))) (sum_mem_normal_form_two _ _ fun x hx => ?_)
  rw [bAPQ]
  exact Submodule.smul_mem _ _ (mem2 (hts x hx) h1 (by simp [h2]) (cons_hats (Or.inl ⟨_, rfl⟩) h3))
where
  sum_mem_normal_form_two {ι : Type} (ts : List ι) (f : ι → A) (h : ∀ x ∈ ts, f x ∈ NormalFormTwo L S d (ℓ + 1)) :
      (ts.map f).sum ∈ NormalFormTwo L S d (ℓ + 1) := by
    induction ts with
    | nil => simp
    | cons a ts ih =>
      rw [List.map_cons, List.sum_cons]
      exact Submodule.add_mem _ (h a (by simp)) (ih fun x hx => h x (by simp [hx]))

/- English proof (translation)
Rewrite using `[mul_assoc]`. Conclude with `normal_form_D_inv hS (normal_form_two_hat hS y hx)`.
-/
theorem letterA (hS : Hyp L S) (y : ℂ) {n : ℕ} {x : A} (hx : x ∈ NormalFormTwo L S n n) :
    L.Di * L.Ahat y * x ∈ NormalFormTwo L S (n + 1) (n + 1) := by
  rw [mul_assoc]; exact normal_form_D_inv hS (normal_form_two_hat hS y hx)

/- English proof (translation)
Rewrite using `[mul_assoc]`. Conclude with `normal_form_two_D_bar_inv hS (normal_form_two_raising hS y hx)`.
-/
theorem letterR (hS : Hyp L S) (y : ℂ) {n : ℕ} {x : A} (hx : x ∈ NormalFormTwo L S n n) :
    L.Dbi * L.R0 y * x ∈ NormalFormTwo L S (n + 1) (n + 1) := by
  rw [mul_assoc]; exact normal_form_two_D_bar_inv hS (normal_form_two_raising hS y hx)

/- English proof (translation)
Establish `: tm L 1 0 0 [] = 1` using `by simp [tm]`. Rewrite using `[← this]; exact mem2 S.one_mem rfl rfl (by simp)`.
-/
theorem one_mem_normal_form_two (hS : Hyp L S) : (1 : A) ∈ NormalFormTwo L S 0 0 := by
  have : tm L 1 0 0 [] = 1 := by simp [tm]
  rw [← this]; exact mem2 S.one_mem rfl rfl (by simp)

end Formalism.FourierDecayAlt.P.MAx3.H

