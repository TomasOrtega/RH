/- English proof (translation)
Introduce `H M N _ _ _ _ _ _ _ ρ ρ' Y Z τ I _ φ hZ hY hφ he hinj`. Use `letI := Fintype.ofFinite I`. Set `π : Representation ℂ H Y` to `(⟨Y, fun g v hv => hY g v hv⟩ : Subrepresentation ρ).toRepresentation`. Set `P : Representation ℂ H (I → N)` to `{ toFun := fun g => (ρ' g).compLeft I map_one' := by ext; simp map_mul' := fun a b => by ext; simp }`. Set `j : Y →ₗ[ℂ] (I → N)` to `LinearMap.pi fun i => φ i ∘ₗ Y.subtype`.

Establish `hj : Function.Injective j`. Rewrite using `[injective_iff_map_eq_zero]`. Introduce `y hy`. Conclude with `Subtype.ext (hinj y y.2 fun i => congrFun hy i)`. Establish `hs : ∀ i g x, LinearMap.single ℂ (fun _ : I => N) i (ρ' g x) = P g (LinearMap.single ℂ (fun _ : I => N) i x)`.

Introduce `i g x`. Use function extensionality and compare the values at `k`. Express the relevant statement in the definitionally equal form `(Pi.single i (ρ' g x) : I → N) k = ρ' g ((Pi.single i x : I → N) k)`. Distinguish the cases in `h : k = i`. Substitute `h` using the available equality.

Simplify using the standard rewrite rules. Simplify using `[h]`. Establish `hsing : ∀ i, ∀ z ∈ Z, LinearMap.single ℂ (fun _ : I => N) i z ∈ ⨆ f : {f : τ.V →ₗ[ℂ] (I → N) // ∀ g v, f (τ.ρ g v) = P g (f v)}, LinearMap.range f.1`. Introduce `i z hz`. Use `Submodule.iSup_induction _ (motive := fun z => LinearMap.single ℂ (fun _ : I => N) i z ∈ _) (hZ hz) ?_ ?_ ?_` and prove the remaining obligations.

Introduce and unpack `f _ ⟨s, rfl⟩`. Conclude with `Submodule.mem_iSup_of_mem ⟨LinearMap.single ℂ (fun _ : I => N) i ∘ₗ f.1, fun g v => by`. Rewrite using `[LinearMap.comp_apply, f.2.1, hs]`. Use the proof step `rfl⟩ ⟨s, rfl⟩`. Rewrite using `[map_zero]`.

Conclude with `zero_mem _`. Introduce `a b ha hb`. Rewrite using `[map_add]`. Conclude with `add_mem ha hb`. Establish `key` using `UpperTheory.V.PiLin.iso_sub τ.ρ π P τ.irred j hj (fun g y => funext fun i => he i g y y.2) (fun y => by`.

Rewrite using `[← Finset.univ_sum_single (j y)]`. Conclude with `Submodule.sum_mem _ fun i _ => hsing i _ (hφ i y y.2))`. Introduce `y hy`. Use `Submodule.iSup_induction _ (motive := fun z : Y => (z : M) ∈ _) (key ⟨y, hy⟩) ?_ ?_ ?_` and prove the remaining obligations. Introduce and unpack `f _ ⟨s, rfl⟩`.

Use `Submodule.mem_iSup_of_mem ⟨Y.subtype ∘ₗ f.1, fun g v => ?_, ?_⟩ ⟨s, rfl⟩` and prove the remaining obligations. Conclude with `congrArg Subtype.val (f.2 g v)`. Introduce and unpack `_ ⟨v, rfl⟩`. Conclude with `(f.1 v).2`. Conclude with `zero_mem _`.

Introduce `a b ha hb`. Conclude with `add_mem ha hb`.
-/
theorem UpperTheory.isoSum_of_injective_equivariant_family :
    ∀ (H M N : Type) [Group H] [TopologicalSpace H] [IsTopologicalGroup H] [AddCommGroup M] [Module ℂ M] [AddCommGroup N] [Module ℂ N] (ρ : Representation ℂ H M) (ρ' : Representation ℂ H N) (Y : Submodule ℂ M) (Z : Submodule ℂ N) (τ : SmIrr H) (I : Type) [Finite I] (φ : I → M →ₗ[ℂ] N), IsoSum ρ' Z τ → (∀ g, ∀ y ∈ Y, ρ g y ∈ Y) → (∀ i, ∀ y ∈ Y, φ i y ∈ Z) → (∀ i g, ∀ y ∈ Y, φ i (ρ g y) = ρ' g (φ i y)) → (∀ y ∈ Y, (∀ i, φ i y = 0) → y = 0) → IsoSum ρ Y τ := by
  intro H M N _ _ _ _ _ _ _ ρ ρ' Y Z τ I _ φ hZ hY hφ he hinj
  classical
  letI := Fintype.ofFinite I
  let π : Representation ℂ H Y := (⟨Y, fun g v hv => hY g v hv⟩ : Subrepresentation ρ).toRepresentation
  let P : Representation ℂ H (I → N) :=
    { toFun := fun g => (ρ' g).compLeft I
      map_one' := by ext; simp
      map_mul' := fun a b => by ext; simp }
  let j : Y →ₗ[ℂ] (I → N) := LinearMap.pi fun i => φ i ∘ₗ Y.subtype
  have hj : Function.Injective j := by
    rw [injective_iff_map_eq_zero]
    intro y hy
    exact Subtype.ext (hinj y y.2 fun i => congrFun hy i)
  have hs : ∀ i g x, LinearMap.single ℂ (fun _ : I => N) i (ρ' g x) = P g (LinearMap.single ℂ (fun _ : I => N) i x) := by
    intro i g x
    funext k
    change (Pi.single i (ρ' g x) : I → N) k = ρ' g ((Pi.single i x : I → N) k)
    by_cases h : k = i
    · subst h; simp
    · simp [h]
  have hsing : ∀ i, ∀ z ∈ Z, LinearMap.single ℂ (fun _ : I => N) i z ∈
      ⨆ f : {f : τ.V →ₗ[ℂ] (I → N) // ∀ g v, f (τ.ρ g v) = P g (f v)}, LinearMap.range f.1 := by
    intro i z hz
    refine Submodule.iSup_induction _ (motive := fun z => LinearMap.single ℂ (fun _ : I => N) i z ∈ _) (hZ hz) ?_ ?_ ?_
    · rintro f _ ⟨s, rfl⟩
      exact Submodule.mem_iSup_of_mem ⟨LinearMap.single ℂ (fun _ : I => N) i ∘ₗ f.1, fun g v => by
        rw [LinearMap.comp_apply, f.2.1, hs]; rfl⟩ ⟨s, rfl⟩
    · rw [map_zero]; exact zero_mem _
    · intro a b ha hb
      rw [map_add]; exact add_mem ha hb
  have key := UpperTheory.V.PiLin.iso_sub τ.ρ π P τ.irred j hj (fun g y => funext fun i => he i g y y.2) (fun y => by
    rw [← Finset.univ_sum_single (j y)]
    exact Submodule.sum_mem _ fun i _ => hsing i _ (hφ i y y.2))
  intro y hy
  refine Submodule.iSup_induction _ (motive := fun z : Y => (z : M) ∈ _) (key ⟨y, hy⟩) ?_ ?_ ?_
  · rintro f _ ⟨s, rfl⟩
    refine Submodule.mem_iSup_of_mem ⟨Y.subtype ∘ₗ f.1, fun g v => ?_, ?_⟩ ⟨s, rfl⟩
    · exact congrArg Subtype.val (f.2 g v)
    · rintro _ ⟨v, rfl⟩; exact (f.1 v).2
  · exact zero_mem _
  · intro a b ha hb
    exact add_mem ha hb
