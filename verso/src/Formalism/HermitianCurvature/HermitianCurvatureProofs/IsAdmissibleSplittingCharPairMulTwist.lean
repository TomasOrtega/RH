theorem tele_left (T D : ℝ) (hD : 0 < D) (A B : ℕ → ℝ) : ∀ n : ℕ,
    (∀ j < n, A j ≤ B j) → (∀ j, j + 1 < n → B j ≤ A (j + 1)) → (∀ j < n, D ≤ T - B j) →
