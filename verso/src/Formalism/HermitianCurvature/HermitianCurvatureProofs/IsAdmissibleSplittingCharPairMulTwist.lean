    · calc csR x0R q0R v e ≤ csR x0R q0R v e' * (q0R la.pt.re / (x0R la.pt.re * x0R (la.pt.re + 1))) *
            ((1 + 2 / L) * (1 + 1 / L)) ^ v.length := hflip
