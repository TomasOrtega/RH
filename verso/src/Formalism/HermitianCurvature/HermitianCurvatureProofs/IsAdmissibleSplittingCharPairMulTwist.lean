/- English proof (translation)
Introduce `k hk`. Use `set V : Matrix (Fin (d + 1)) (Fin (d + 1)) ℂ := Matrix.vandermonde (fun n : Fin (d + 1) => ((n : ℕ) : ℂ))`. Establish `hV : IsUnit V.det`. Rewrite using `[isUnit_iff_ne_zero, Matrix.det_vandermonde_ne_zero_iff]`. Introduce `m n h; exact Fin.ext (by simpa using h)`.

Use `set W := V⁻¹`. Establish `hWV : W * V = 1` using `Matrix.nonsing_inv_mul V hV`. Establish `hf : ∀ n : Fin (d + 1), f n = ∑ j : Fin (d + 1), V n j • a j`. Introduce `n`. Rewrite using `[ha, Finset.sum_range (fun j => ((n : ℕ) : ℂ) ^ j • a j)]`.

Use `Finset.sum_congr rfl fun j _ => ?_` and prove the remaining obligations. Simplify using `[V, Matrix.vandermonde_apply]`. Use `set kk : Fin (d + 1) := ⟨k, Finset.mem_range.1 hk⟩ with hkk`. Establish `key : a k = ∑ n : Fin (d + 1), W kk n • f n`. Repeatedly rewrite using `[hf, Finset.smul_sum, smul_smul]`.

Rewrite using `[Finset.sum_comm]`. Repeatedly rewrite using `[← Finset.sum_smul]`. Establish `: ∀ j : Fin (d + 1), (∑ n, W kk n * V n j) = (1 : Matrix (Fin (d + 1)) (Fin (d + 1)) ℂ) kk j`. Introduce `j`. Rewrite using `[← hWV, Matrix.mul_apply]`.

Repeatedly rewrite using `[this, Matrix.one_apply, ite_smul, one_smul, zero_smul, Finset.sum_ite_eq, Finset.mem_univ, if_true]`. Apply the tactic sequence `try rfl`. Rewrite using `[key]`. Conclude with `Submodule.sum_mem _ fun n _ => Submodule.smul_mem _ _ (Submodule.subset_span ⟨n, rfl⟩)`.
-/
theorem polyIn_coeff_span {R : Type} [AddCommGroup R] [Module ℂ R] (f : ℂ → R) (d : ℕ) (a : ℕ → R)
    (ha : ∀ t, f t = ∑ k ∈ Finset.range (d + 1), t ^ k • a k) :
    ∀ k ∈ Finset.range (d + 1), a k ∈ Submodule.span ℂ (Set.range fun n : Fin (d + 1) => f n) := by
  intro k hk
  set V : Matrix (Fin (d + 1)) (Fin (d + 1)) ℂ := Matrix.vandermonde (fun n : Fin (d + 1) => ((n : ℕ) : ℂ))
  have hV : IsUnit V.det := by
    rw [isUnit_iff_ne_zero, Matrix.det_vandermonde_ne_zero_iff]
    intro m n h; exact Fin.ext (by simpa using h)
  set W := V⁻¹
  have hWV : W * V = 1 := Matrix.nonsing_inv_mul V hV
  have hf : ∀ n : Fin (d + 1), f n = ∑ j : Fin (d + 1), V n j • a j := by
    intro n
    rw [ha, Finset.sum_range (fun j => ((n : ℕ) : ℂ) ^ j • a j)]
    refine Finset.sum_congr rfl fun j _ => ?_
    simp [V, Matrix.vandermonde_apply]
  set kk : Fin (d + 1) := ⟨k, Finset.mem_range.1 hk⟩ with hkk
  have key : a k = ∑ n : Fin (d + 1), W kk n • f n := by
    simp_rw [hf, Finset.smul_sum, smul_smul]
    rw [Finset.sum_comm]
    simp_rw [← Finset.sum_smul]
    have : ∀ j : Fin (d + 1), (∑ n, W kk n * V n j) = (1 : Matrix (Fin (d + 1)) (Fin (d + 1)) ℂ) kk j := by
      intro j; rw [← hWV, Matrix.mul_apply]
    simp_rw [this, Matrix.one_apply, ite_smul, one_smul, zero_smul, Finset.sum_ite_eq, Finset.mem_univ, if_true]
    try rfl
  rw [key]
  exact Submodule.sum_mem _ fun n _ => Submodule.smul_mem _ _ (Submodule.subset_span ⟨n, rfl⟩)

