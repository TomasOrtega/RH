  have hE : (frW P l L w).ee (Y : ℂ) ∈ UB L (Fin w.length) := (frame_memB hL hLaw l (wordP w)).1 (Y : ℂ)
  refine ⟨lvec L ((Y : ℂ) + s) ((Y : ℂ) + s) ((frW P l L w).ee (Y : ℂ)) 𝒳,
    lvec_NF hL hLaw _ _ _ hE 𝒳 h1, fun q bi => ?_⟩
