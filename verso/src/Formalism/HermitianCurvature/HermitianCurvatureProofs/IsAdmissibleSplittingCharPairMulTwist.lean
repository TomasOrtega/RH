theorem Dabs_sq (hTT : 0 ≤ P.TT) (q : Qp P.r P.TT) : Dabs q ^ 2 = Gq P q * Wq P q := by
  have h : P.TT < Complex.normSq q.1.2 := q.2.2
  have hne : Complex.normSq q.1.2 - P.TT ≠ 0 := by linarith
  unfold Dabs Gq Wq
  rw [mul_pow, ← Finset.prod_pow]
  simp only [← Complex.normSq_eq_norm_sq]
  field_simp

/- English proof (translation)
Unfold `LE.th`. Establish `hb0 : 0 < x / (x + ε)` using `div_pos hx (by linarith)`. Establish `hb1 : x / (x + ε) ≤ 1` using `(div_le_one (by linarith)).2 (by linarith)`. Combine the equalities or inequalities in the displayed calculation.
