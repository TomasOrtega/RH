noncomputable section

variable {P : M.Par}

def EC (w : (DQ P).Pr) : Submonoid (A P (DQ P)) where
  carrier := {x | ∀ π π', w * x π π' = x π π' * w}
  mul_mem' {x y} hx hy π π' := by
    rw [Matrix.mul_apply, Finset.mul_sum, Finset.sum_mul]
    exact Finset.sum_congr rfl fun k _ => by rw [← mul_assoc, hx, mul_assoc, hy, mul_assoc]
  one_mem' π π' := by simp only [Matrix.one_apply]; split_ifs <;> simp

/- English proof (translation)
Use extensionality with `π π'`. Simplify using `only [sc, Matrix.scalar_apply, Matrix.diagonal_mul, Matrix.mul_diagonal]`. Conclude with `hx π π'`.
-/
theorem sc_comm_EC {w : (DQ P).Pr} {x : A P (DQ P)} (hx : x ∈ EC w) : sc P (DQ P) w * x = x * sc P (DQ P) w := by
  ext π π'
  simp only [sc, Matrix.scalar_apply, Matrix.diagonal_mul, Matrix.mul_diagonal]
  exact hx π π'

/- English proof (translation)
Introduce `π π'` and use `by simp only [sc, Matrix.scalar_apply, Matrix.diagonal_apply]; split_ifs <;> simp [h]`.
-/
theorem sc_mem_EC {w w' : (DQ P).Pr} (h : w * w' = w' * w) : sc P (DQ P) w' ∈ EC w := fun π π' => by
  simp only [sc, Matrix.scalar_apply, Matrix.diagonal_apply]; split_ifs <;> simp [h]

/- English proof (translation)
Introduce `π π'` and use `by rw [hc]; exact (Algebra.commutes _ _).symm`.
-/
theorem alg_mem_EC (w : (DQ P).Pr) (x : A P (DQ P)) (c : M.Ty P → M.Ty P → ℂ)
    (hc : ∀ π π', x π π' = algebraMap ℂ (DQ P).Pr (c π π')) : x ∈ EC w := fun π π' => by
  rw [hc]; exact (Algebra.commutes _ _).symm

variable (hTTp : 0 < P.TT) {L : LevelData (A P (DQ P)) P.r} (hL : IsModelLevel P (DQ P) L) (hLaw : (DQ P).Laws P.TT)
include hTTp hL hLaw

/- English proof (translation)
Establish `hTT` using `hTTp.le`. Break down `hb with (((hb | ⟨f, rfl⟩) | ⟨i, hi, rfl⟩) | ⟨i, hi, rfl⟩)` into its components or cases. Simplify using `only [Set.mem_insert_iff, Set.mem_singleton_iff] at hb`. Break down `hb with rfl | rfl | rfl | rfl` into its components or cases. Conclude with `⟨_, SAB_of_CF (cf_ζi hTT hL) (inv_nonneg.2 (Real.sqrt_nonneg _)) fun q => I4.ζinv_le hTTp q⟩`.

Conclude with `⟨_, SAB_of_CF (cf_ζbi hTT hL) (inv_nonneg.2 (Real.sqrt_nonneg _)) fun q => by`. Rewrite using `[norm_inv, Complex.norm_conj, ← norm_inv]`. Conclude with `I4.ζinv_le hTTp q⟩`. Conclude with `⟨1, SAB_of_CF (CF_mul (cf_D hTT hL) (cf_Dbi hTT hL)) zero_le_one fun q => by`. Rewrite using `[norm_mul, I4.norm_D (hTTp := hTTp) (hL := hL), mul_comm, I4.norm_Dbi (hTTp := hTTp) (hL := hL)]⟩`.

Conclude with `⟨1, SAB_of_CF (CF_mul (cf_Db hTT hL) (cf_Di hTT hL)) zero_le_one fun q => by`. Rewrite using `[norm_mul, I4.norm_Db (hTTp := hTTp) (hL := hL), mul_comm, I4.norm_Di (hTTp := hTTp) (hL := hL)]⟩`. Conclude with `⟨_, SAB_scalars _ (fun π π' => if π = π' then f π else 0) fun π π' => by`. Establish `e : kap P (DQ P) f = Matrix.diagonal fun π => algebraMap ℂ (DQ P).Pr (f π)` using `rfl`. Apply the tactic sequence `rw [e, Matrix.diagonal_apply]; split_ifs <;> simp⟩`.

Apply the tactic sequence `have hS := SAB_scalars (SS P (DQ P) i) (fun π' π => if M.Up P i π π' then ((Real.sqrt (M.Nrm P i π) : ℝ) : ℂ) else 0) (fun π' π => by simp only [SS, Matrix.of_apply]; split_ifs <;> simp)`. Establish `hD` using `SAB_of_CF (CF_mul (cf_Drb hTT hL) (cf_Dri hTT hL)) zero_le_one fun q => by`. Rewrite using `[norm_mul, norm_prod, norm_prod]`. Simplify using `only [Complex.norm_conj, norm_inv]`. Rewrite using `[← Finset.prod_mul_distrib]`.

Conclude with `le_of_eq (Finset.prod_eq_one fun l _ => mul_inv_cancel₀ (norm_ne_zero_iff.2 (I4.c_ne q l)))`. Conclude with `⟨_, SAB_mul hD hS⟩`. Apply the tactic sequence `have hS := SAB_scalars (SS P (DQ P) i) (fun π' π => if M.Up P i π π' then ((Real.sqrt (M.Nrm P i π) : ℝ) : ℂ) else 0) (fun π' π => by simp only [SS, Matrix.of_apply]; split_ifs <;> simp)`. Establish `hD` using `SAB_of_CF (CF_mul (cf_Drb hTT hL) (cf_Dri hTT hL)) zero_le_one fun q => by`. Rewrite using `[norm_mul, norm_prod, norm_prod]`.

Simplify using `only [Complex.norm_conj, norm_inv]`. Rewrite using `[← Finset.prod_mul_distrib]`. Conclude with `le_of_eq (Finset.prod_eq_one fun l _ => mul_inv_cancel₀ (norm_ne_zero_iff.2 (I4.c_ne q l)))`. Conclude with `⟨_, SAB_star (SAB_mul hD hS)⟩`.
-/
theorem SAB_gen {b : A P (DQ P)} (hb : b ∈ bddSet P L) : ∃ C, SAB b C := by
  have hTT := hTTp.le
  rcases hb with (((hb | ⟨f, rfl⟩) | ⟨i, hi, rfl⟩) | ⟨i, hi, rfl⟩)
  · simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hb
    rcases hb with rfl | rfl | rfl | rfl
    · exact ⟨_, SAB_of_CF (cf_ζi hTT hL) (inv_nonneg.2 (Real.sqrt_nonneg _)) fun q => I4.ζinv_le hTTp q⟩
    · exact ⟨_, SAB_of_CF (cf_ζbi hTT hL) (inv_nonneg.2 (Real.sqrt_nonneg _)) fun q => by
        rw [norm_inv, Complex.norm_conj, ← norm_inv]; exact I4.ζinv_le hTTp q⟩
    · exact ⟨1, SAB_of_CF (CF_mul (cf_D hTT hL) (cf_Dbi hTT hL)) zero_le_one fun q => by
        rw [norm_mul, I4.norm_D (hTTp := hTTp) (hL := hL), mul_comm, I4.norm_Dbi (hTTp := hTTp) (hL := hL)]⟩
    · exact ⟨1, SAB_of_CF (CF_mul (cf_Db hTT hL) (cf_Di hTT hL)) zero_le_one fun q => by
        rw [norm_mul, I4.norm_Db (hTTp := hTTp) (hL := hL), mul_comm, I4.norm_Di (hTTp := hTTp) (hL := hL)]⟩
  · classical
    exact ⟨_, SAB_scalars _ (fun π π' => if π = π' then f π else 0) fun π π' => by
      have e : kap P (DQ P) f = Matrix.diagonal fun π => algebraMap ℂ (DQ P).Pr (f π) := rfl
      rw [e, Matrix.diagonal_apply]; split_ifs <;> simp⟩
  · classical
    have hS := SAB_scalars (SS P (DQ P) i)
      (fun π' π => if M.Up P i π π' then ((Real.sqrt (M.Nrm P i π) : ℝ) : ℂ) else 0)
      (fun π' π => by simp only [SS, Matrix.of_apply]; split_ifs <;> simp)
    have hD := SAB_of_CF (CF_mul (cf_Drb hTT hL) (cf_Dri hTT hL)) zero_le_one fun q => by
      rw [norm_mul, norm_prod, norm_prod]
      simp only [Complex.norm_conj, norm_inv]
      rw [← Finset.prod_mul_distrib]
      exact le_of_eq (Finset.prod_eq_one fun l _ => mul_inv_cancel₀ (norm_ne_zero_iff.2 (I4.c_ne q l)))
    exact ⟨_, SAB_mul hD hS⟩
  · classical
    have hS := SAB_scalars (SS P (DQ P) i)
      (fun π' π => if M.Up P i π π' then ((Real.sqrt (M.Nrm P i π) : ℝ) : ℂ) else 0)
      (fun π' π => by simp only [SS, Matrix.of_apply]; split_ifs <;> simp)
    have hD := SAB_of_CF (CF_mul (cf_Drb hTT hL) (cf_Dri hTT hL)) zero_le_one fun q => by
      rw [norm_mul, norm_prod, norm_prod]
      simp only [Complex.norm_conj, norm_inv]
      rw [← Finset.prod_mul_distrib]
      exact le_of_eq (Finset.prod_eq_one fun l _ => mul_inv_cancel₀ (norm_ne_zero_iff.2 (I4.c_ne q l)))
    exact ⟨_, SAB_star (SAB_mul hD hS)⟩

/- English proof (translation)
Proceed by induction on `hb using Submonoid.closure_induction with`. Consider the case `mem x hx => exact SAB_gen hTTp hL hLaw hx`. Consider the case `one => exact ⟨1, SAB_one⟩`. Consider the case `mul x y _ _ h1 h2`. Take `⟨C1, h1⟩` from `h1`.

Take `⟨C2, h2⟩` from `h2`. Conclude with `⟨_, SAB_mul h1 h2⟩`.
-/
theorem SAB_closure {b : A P (DQ P)} (hb : b ∈ Submonoid.closure (bddSet P L)) : ∃ C, SAB b C := by
  induction hb using Submonoid.closure_induction with
  | mem x hx => exact SAB_gen hTTp hL hLaw hx
  | one => exact ⟨1, SAB_one⟩
  | mul x y _ _ h1 h2 =>
    obtain ⟨C1, h1⟩ := h1
    obtain ⟨C2, h2⟩ := h2
    exact ⟨_, SAB_mul h1 h2⟩

end

