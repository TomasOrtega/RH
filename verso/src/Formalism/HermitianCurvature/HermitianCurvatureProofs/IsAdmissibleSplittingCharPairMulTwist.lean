/- English proof (translation)
The claim follows from `| [], _ => by simp [multS] | b :: u, h => by have ih := multS_bound L hL p hp e u fun c hc => h c (List.mem_cons_of_mem _ hc) obtain ⟨hb1, hb2⟩ := h b List.mem_cons_self unfold multS at ih ⊢ rw [List.map_cons, List.prod_cons, norm_mul, List.length_cons, pow_succ'] refine mul_le_m …`.
-/
theorem multS_bound {S : Type} [Fintype S] [DecidableEq S] (L : ℝ) (hL : 0 < L) (p : ℂ) (hp : p.im = 0)
    (e : Ix S) : ∀ (u : List (Letter ℂ S)), (∀ b ∈ u, b.pt.im = 0 ∧ L ≤ b.pt.re - p.re) →
    ‖multS u p e‖ ≤ (1 + 1 / L) ^ u.length
  | [], _ => by simp [multS]
  | b :: u, h => by
