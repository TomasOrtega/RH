    (∀ b ∈ v, 0 < x0R b.pt.re ∧ 0 < x0R (b.pt.re + 1) ∧ 0 < q0R b.pt.re) → 0 < csR x0R q0R v e
  | [], e, _, _ => by simp [csR]
