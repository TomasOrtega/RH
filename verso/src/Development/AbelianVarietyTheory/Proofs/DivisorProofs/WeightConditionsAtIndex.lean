variable {E : Type} [Field E] [NumberField E] [IsCMField E] {H : Geo.Tor.Host E} {Dw : Datum H}

/- English proof (translation)
Use linear arithmetic over natural numbers and integers.
-/
theorem bar_lt (hp : 1 ≤ Dw.p) (hq : 1 ≤ Dw.q) : Dw.p - 1 + 1 < Dw.p + Dw.q := by omega

/- English proof (translation)
Establish `hk` using `bar_lt hp hq`. Establish `h1` using `P.gap_u₁ τ hk`. Establish `hT : 0 < P.T₁` using `by unfold WtPar.T₁; positivity`. Establish `hg : 1 ≤ gap (P.u₁ τ) (Dw.p - 1)`. Rewrite using `[gap, dif_pos hk]`.

Use `hs (show (⟨Dw.p - 1, by omega⟩ : Fin (Dw.p + Dw.q)) < ⟨Dw.p - 1 + 1, hk⟩ from by` as an intermediate fact. Rewrite using `[Fin.mk_lt_mk]`. Use the proof step `omega)`. Use linear arithmetic over natural numbers and integers. Rewrite `hg` using `[h1, Int.le_ediv_iff_mul_le hT, one_mul]`.

Establish `hkap : gap (FlagTan.kap Dw τ) (Dw.p - 1) = 2 * ((Dw.p : ℤ) + Dw.q) - 2`. Simplify using `only [gap, dif_pos hk, FlagTan.kap, Fin.val_mk]`. Use `Nat.cast_sub (R := ℤ) hp` as an intermediate fact. Apply the tactic sequence `split_ifs <;> push_cast at * <;> omega`. Establish `hsub : gap ((P.uMinus - FlagTan.kap Dw) τ) (Dw.p - 1) = gap (P.uMinus τ) (Dw.p - 1) - gap (FlagTan.kap Dw τ) (Dw.p - 1)`.

Simplify using `only [gap, dif_pos hk, Pi.sub_apply]`. Expand and normalize the polynomial expressions, which then agree. Establish `hT1 : 1 ≤ P.T₁` using `hT`. Use linear arithmetic over natural numbers and integers.
-/
theorem one_le_gap_uMinus (P : WtPar Dw) (τ : Psi H) (hp : 1 ≤ Dw.p) (hq : 1 ≤ Dw.q)
    (hs : StrictAnti (P.u₁ τ)) : 1 ≤ gap (P.uMinus τ) (Dw.p - 1) := by
  have hk := bar_lt hp hq
  have h1 := P.gap_u₁ τ hk
  have hT : 0 < P.T₁ := by unfold WtPar.T₁; positivity
  have hg : 1 ≤ gap (P.u₁ τ) (Dw.p - 1) := by
    rw [gap, dif_pos hk]
    have := hs (show (⟨Dw.p - 1, by omega⟩ : Fin (Dw.p + Dw.q)) < ⟨Dw.p - 1 + 1, hk⟩ from by
      rw [Fin.mk_lt_mk]; omega)
    omega
  rw [h1, Int.le_ediv_iff_mul_le hT, one_mul] at hg
  have hkap : gap (FlagTan.kap Dw τ) (Dw.p - 1) = 2 * ((Dw.p : ℤ) + Dw.q) - 2 := by
    simp only [gap, dif_pos hk, FlagTan.kap, Fin.val_mk]
    have := Nat.cast_sub (R := ℤ) hp
    split_ifs <;> push_cast at * <;> omega
  have hsub : gap ((P.uMinus - FlagTan.kap Dw) τ) (Dw.p - 1) =
      gap (P.uMinus τ) (Dw.p - 1) - gap (FlagTan.kap Dw τ) (Dw.p - 1) := by
    simp only [gap, dif_pos hk, Pi.sub_apply]; ring
  have hT1 : 1 ≤ P.T₁ := hT
  omega

/- English proof (translation)
Rewrite using `[← uWt_add_anchor Dw a n kc]`. Simplify using `only [uMinus, add_smul]`. Normalize the expressions using the abelian group laws.
-/
theorem laOf_add_smul (a : (E →+* ℂ) × ℕ → ℕ) (n kc : ℕ) (c0 s : ℤ) :
    laOf Dw a n + s • hodgeWt Dw =
      uMinus Dw a n kc c0 + (s + c0) • hodgeWt Dw + FlatLine.parWt Dw (anchor Dw a n kc) := by
  rw [← uWt_add_anchor Dw a n kc]
  simp only [uMinus, add_smul]
  abel

/- English proof (translation)
Establish `hk` using `bar_lt hp hq`. Simplify using `only [gap, dif_pos hk, Pi.add_apply, Pi.smul_apply, hodgeWt, CompHt.barWt, FlatLine.parWt, Fin.val_mk, smul_eq_mul]`. Apply the tactic sequence `split_ifs <;> first | omega | ring`.
-/
theorem gap_add_smul_hodge (v : AllWt.Weight Dw) (x : ℤ) (w : Psi H → ℤ) (τ : Psi H) (hp : 1 ≤ Dw.p) (hq : 1 ≤ Dw.q) :
    gap ((v + x • hodgeWt Dw + FlatLine.parWt Dw w) τ) (Dw.p - 1) = gap (v τ) (Dw.p - 1) + x := by
  have hk := bar_lt hp hq
  simp only [gap, dif_pos hk, Pi.add_apply, Pi.smul_apply, hodgeWt, CompHt.barWt, FlatLine.parWt, Fin.val_mk, smul_eq_mul]
  split_ifs <;> first | omega | ring

/- English proof (translation)
Introduce `_ _ hab` and use `add_le_add (h hab) le_rfl`.
-/
theorem antitone_add_par (v : AllWt.Weight Dw) (w : Psi H → ℤ) (τ : Psi H) (h : Antitone (v τ)) :
    Antitone ((v + FlatLine.parWt Dw w) τ) :=
  fun _ _ hab => add_le_add (h hab) le_rfl

end Weights

