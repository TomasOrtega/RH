/- English proof (translation)
Take `⟨h1, h2, h3, h4, h5, h6, h7, h8, h9, h10, h11, h12, h13, h14, h15⟩` from `h`. Take `⟨k1, k2, k3, k4, k5, k6, k7, k8, k9, k10, k11, k12, k13, k14, k15⟩` from `h'`. Consider the cases of `L`. Consider the cases of `L'`. Simplify using `only at *`.

Substitute `h1 h2 h3 h4 h5 h6 h7 h8 h9 h10 h11 h12 h13 h14 h15 k1 k2 k3 k4 k5 k6 k7 k8 k9 k10 k11 k12 k13 k14 k15` using the available equality. Both sides reduce to the same expression.
-/
theorem level_unique (P : M.Par) (D : DAlg P.r) (L L' : R.LevelData (A P D) P.r)
    (h : IsModelLevel P D L) (h' : IsModelLevel P D L') : L = L' := by
  obtain ⟨h1, h2, h3, h4, h5, h6, h7, h8, h9, h10, h11, h12, h13, h14, h15⟩ := h
  obtain ⟨k1, k2, k3, k4, k5, k6, k7, k8, k9, k10, k11, k12, k13, k14, k15⟩ := h'
  cases L; cases L'
  dsimp only at *
  subst h1 h2 h3 h4 h5 h6 h7 h8 h9 h10 h11 h12 h13 h14 h15 k1 k2 k3 k4 k5 k6 k7 k8 k9 k10 k11 k12 k13 k14 k15
  rfl

/- English proof (translation)
The claim follows from `| [] => rfl | x :: v => by simp [wordS, wordS_length v]`.
-/
theorem wordS_length : ∀ v : List (Bool × ℝ), (wordS v).length = v.length
  | [] => rfl
  | x :: v => by simp [wordS, wordS_length v]

/- English proof (translation)
Simplify using `[wordP, wordS_length, LE.plus]`.
-/
theorem plusWord_length (w : List ℝ) : (wordP w).length = w.length := by
  simp [wordP, wordS_length, LE.plus]

/- English proof (translation)
The claim follows from `| [], a, h => by simp [wordS] at h | x :: v, a, h => by simp only [wordS, List.mem_cons, List.mem_map] at h rcases h with rfl | ⟨b, hb, rfl⟩ · simp · have := wordS_position_lt v b hb simp only [Fin.coe_castSucc, List.length_cons] omega`.
-/
theorem wordS_position_lt : ∀ (v : List (Bool × ℝ)), ∀ a ∈ (wordS v), (a.intersection_update_fsHerm_neg_one : ℕ) < v.length
  | [], a, h => by simp [wordS] at h
  | x :: v, a, h => by
    simp only [wordS, List.mem_cons, List.mem_map] at h
    rcases h with rfl | ⟨b, hb, rfl⟩
    · simp
    · have := wordS_position_lt v b hb
      simp only [Fin.coe_castSucc, List.length_cons]
      omega

/- English proof (translation)
The claim follows from `| [] => by simp [wordS] | x :: v => by simp only [wordS, List.map_cons, List.map_map, List.nodup_cons] refine ⟨?_, ?_⟩ · intro hm rw [List.mem_map] at hm obtain ⟨b, hb, e⟩ := hm have h1 := wordS_position_lt v b hb have h2 := congrArg Fin.val e simp only [Function.comp_apply, Fin. …`.
-/
theorem wordS_nodup : ∀ v : List (Bool × ℝ), ((wordS v).map Letter.intersection_update_fsHerm_neg_one).Nodup
  | [] => by simp [wordS]
  | x :: v => by
    simp only [wordS, List.map_cons, List.map_map, List.nodup_cons]
    refine ⟨?_, ?_⟩
    · intro hm
      rw [List.mem_map] at hm
      obtain ⟨b, hb, e⟩ := hm
      have h1 := wordS_position_lt v b hb
      have h2 := congrArg Fin.val e
      simp only [Function.comp_apply, Fin.coe_castSucc, Fin.val_last] at h2
      omega
    · have := wordS_nodup v
      convert this.map (Fin.castSucc_injective _) using 1
      · rfl
      · rw [List.map_map]
        rfl

/- English proof (translation)
Unfold `wordP`. Rewrite using `[List.map_map]`. Establish `e : (wordS (LE.plus w)).map (Letter.intersection_update_fsHerm_neg_one ∘ fun lt => (⟨lt.plus, Fin.cast (by simp [LE.plus]) lt.intersection_update_fsHerm_neg_one, lt.pt⟩ : Letter ℂ (Fin w.length))) = ((wordS (LE.plus w)).map Letter.intersection_update_fsHerm_neg_one).map (Fin.cast …`. Simplify using `[List.map_map, Function.comp_def]`. Rewrite using `[e]`.

Conclude with `(wordS_nodup _).map (Fin.cast_injective _)`.
-/
theorem plusWord_slots_nodup (w : List ℝ) : ((wordP w).map Letter.intersection_update_fsHerm_neg_one).Nodup := by
  unfold wordP
  rw [List.map_map]
  have e : (wordS (LE.plus w)).map (Letter.intersection_update_fsHerm_neg_one ∘ fun lt => (⟨lt.plus, Fin.cast (by simp [LE.plus]) lt.intersection_update_fsHerm_neg_one, lt.pt⟩ :
      Letter ℂ (Fin w.length))) = ((wordS (LE.plus w)).map Letter.intersection_update_fsHerm_neg_one).map (Fin.cast (by simp [LE.plus])) := by
    simp [List.map_map, Function.comp_def]
  rw [e]
  exact (wordS_nodup _).map (Fin.cast_injective _)

/- English proof (translation)
The claim follows from `| [], _, a, h => by simp [wordS] at h | x :: v, hv, a, h => by simp only [wordS, List.mem_cons, List.mem_map] at h rcases h with rfl | ⟨b, hb, rfl⟩ · exact hv x (by simp) · exact wordS_plus v (fun y hy => hv y (by simp [hy])) b hb`.
-/
theorem wordS_plus : ∀ v : List (Bool × ℝ), (∀ x ∈ v, x.1 = true) → ∀ a ∈ wordS v, a.plus = true
  | [], _, a, h => by simp [wordS] at h
  | x :: v, hv, a, h => by
    simp only [wordS, List.mem_cons, List.mem_map] at h
    rcases h with rfl | ⟨b, hb, rfl⟩
    · exact hv x (by simp)
    · exact wordS_plus v (fun y hy => hv y (by simp [hy])) b hb

/- English proof (translation)
Introduce `a ha`. Unfold `wordP at ha`. Rewrite `ha` using `[List.mem_map]`. Take `⟨b, hb, rfl⟩` from `ha`. Conclude with `wordS_plus _ (fun x hx => by simp [LE.plus] at hx; obtain ⟨_, _, rfl⟩ := hx; rfl) b hb`.
-/
theorem plusWord_letters_plus (w : List ℝ) : ∀ a ∈ wordP w, a.plus = true := by
  intro a ha
  unfold wordP at ha
  rw [List.mem_map] at ha
  obtain ⟨b, hb, rfl⟩ := ha
  exact wordS_plus _ (fun x hx => by simp [LE.plus] at hx; obtain ⟨_, _, rfl⟩ := hx; rfl) b hb

end Formalism.FourierDecayAlt.P.MAx3.F

