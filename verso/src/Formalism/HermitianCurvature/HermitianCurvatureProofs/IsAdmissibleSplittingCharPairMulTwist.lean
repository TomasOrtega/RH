variable {n N : ℕ} (t : Fin N → Fin (n + 1) → ℝ)

def Vd (a : Fin N) : Matrix (Fin (n + 1)) (Fin (n + 1)) ℂ := Matrix.vandermonde fun i => (t a i : ℂ)

