noncomputable section

variable {P : M.Par}

def Good (ψ : ℝ → ℝ) : Prop := LE.SmoothLog ψ ∧ ∀ p, ∃ C, ∀ x, 0 < x → |LE.ld p ψ x| ≤ C

/- English proof (translation)
Take `⟨hs, ⟨ε, hε, h0⟩, hb⟩` from `hφ`. Take `⟨hs', hb'⟩` from `hψ`. Use `⟨?_, ⟨ε, hε, fun x hx => by simp [h0 x hx]⟩, fun q => ?_⟩` and prove the remaining obligations. Unfold `LE.SmoothLog`. Conclude with `hs.mul hs'`.

Use `choose C hC using hb choose C' hC' using hb'`. Use `⟨∑ i ∈ Finset.range (q + 1), (q.choose i : ℝ) * C i * C' (q - i), fun x hx => ?_⟩` and prove the remaining obligations. Rewrite using `[ld_mul hs hs']`. Use `(Finset.abs_sum_le_sum_abs _ _).trans (Finset.sum_le_sum fun i _ => ?_)` and prove the remaining obligations. Rewrite using `[abs_mul, abs_mul, abs_of_nonneg (Nat.cast_nonneg _)]`.

Establish `h1` using `hC i x hx`. Establish `h2` using `hC' (q - i) x hx`. Establish `hc0 : 0 ≤ C i` using `(abs_nonneg _).trans h1`. Conclude with `mul_le_mul (mul_le_mul_of_nonneg_left h1 (Nat.cast_nonneg _)) h2 (abs_nonneg _) (mul_nonneg (Nat.cast_nonneg _) hc0)`.
-/
theorem admissible_mul_good {φ ψ : ℝ → ℝ} (hφ : admitted φ) (hψ : Good ψ) : admitted (fun x => φ x * ψ x) := by
  obtain ⟨hs, ⟨ε, hε, h0⟩, hb⟩ := hφ
  obtain ⟨hs', hb'⟩ := hψ
  refine ⟨?_, ⟨ε, hε, fun x hx => by simp [h0 x hx]⟩, fun q => ?_⟩
  · unfold LE.SmoothLog; exact hs.mul hs'
  · choose C hC using hb
    choose C' hC' using hb'
    refine ⟨∑ i ∈ Finset.range (q + 1), (q.choose i : ℝ) * C i * C' (q - i), fun x hx => ?_⟩
    rw [ld_mul hs hs']
    refine (Finset.abs_sum_le_sum_abs _ _).trans (Finset.sum_le_sum fun i _ => ?_)
    rw [abs_mul, abs_mul, abs_of_nonneg (Nat.cast_nonneg _)]
    have h1 := hC i x hx
    have h2 := hC' (q - i) x hx
    have hc0 : 0 ≤ C i := (abs_nonneg _).trans h1
    exact mul_le_mul (mul_le_mul_of_nonneg_left h1 (Nat.cast_nonneg _)) h2 (abs_nonneg _)
      (mul_nonneg (Nat.cast_nonneg _) hc0)

/- English proof (translation)
Both sides reduce to the same expression.
-/
theorem Fq_star (φ : ℝ → ℝ) : star (Fq P φ 0) = Fq P φ 0 := rfl

/- English proof (translation)
Introduce `π π'` and use `by rw [Matrix.star_apply] have := congrArg star (hx π' π) rw [star_mul, star_mul, hw] at this exact this.symm`.
-/
theorem EC_star {w : (DQ P).Pr} (hw : star w = w) {x : A P (DQ P)} (hx : x ∈ EC w) : star x ∈ EC w := fun π π' => by
  rw [Matrix.star_apply]
  have := congrArg star (hx π' π)
  rw [star_mul, star_mul, hw] at this
  exact this.symm

variable {L : LevelData (A P (DQ P)) P.r} (hL : IsModelLevel P (DQ P) L) (hLaw : (DQ P).Laws P.TT)
include hL hLaw

/- English proof (translation)
Establish `fc : ∀ F Fb : (DQ P).R, (DQ P).fnP F Fb * Fq P φ 0 = Fq P φ 0 * (DQ P).fnP F Fb` using `fun F Fb => Formalism.FourierDecayAlt.P.MAx1.multiplierPair_comm (DQ P) _ _ _ _`. Establish `scm : ∀ F Fb : (DQ P).R, sc P (DQ P) ((DQ P).fnP F Fb) ∈ EC (Fq P φ 0)` using `fun F Fb => sc_mem_EC (fc F Fb).symm`. Take `⟨hp, hpb, hc, hci, hcb, hcbi, hz, hzi, hzb, hzbi, -⟩` from `hL`. Establish `mc : ∀ l, L.c l ∈ EC (Fq P φ 0)` using `fun l => by rw [hc]; exact scm _ _`. Establish `mci : ∀ l, L.ci l ∈ EC (Fq P φ 0)` using `fun l => by rw [hci]; exact scm _ _`.

Establish `mcb : ∀ l, L.cb l ∈ EC (Fq P φ 0)` using `fun l => by rw [hcb]; exact scm _ _`. Establish `mcbi : ∀ l, L.cbi l ∈ EC (Fq P φ 0)` using `fun l => by rw [hcbi]; exact scm _ _`. Establish `mz : L.ζ ∈ EC (Fq P φ 0)` using `by rw [hz]; exact scm _ _`. Establish `mzi : L.ζi ∈ EC (Fq P φ 0)` using `by rw [hzi]; exact scm _ _`. Establish `mzb : L.ζb ∈ EC (Fq P φ 0)` using `by rw [hzb]; exact scm _ _`.

