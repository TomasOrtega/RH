theorem coef2 (Y s p Lb : ℝ) (hL : 0 < Lb) (hs : |s| ≤ Lb) (h1 : Lb ≤ Y - p) (h2 : Lb ≤ Y + s - p) :
    ‖(((Y : ℂ) - (p : ℂ))⁻¹ - (((Y + s : ℝ) : ℂ) - (p : ℂ))⁻¹)‖ ^ 2 ≤ 1 / Lb ^ 2 := by
  have hne1 : Y - p ≠ 0 := by intro e; linarith
  have hne2 : Y + s - p ≠ 0 := by intro e; linarith
