noncomputable section

variable {P : M.Par}

/- English proof (translation)
Both sides reduce to the same expression.
-/
theorem ipA_eq (f g : M.Ty P → SmQ P.r P.TT) :
    ipA P f g = ∑ π, ∫ q, evQ P (f π) q * conj (evQ P (g π) q) ∂(mu0 P.r P.TT) := rfl

variable {L : LevelData (A P (DQ P)) P.r} {j : M.Ty P → SmQ P.r P.TT}
variable (hTTp : 0 < P.TT) (hL : IsModelLevel P (DQ P) L) (hLaw : (DQ P).Laws P.TT)
include hTTp hL hLaw

/- English proof (translation)
Take `⟨Mβ, hSA, hC0, hMb⟩` from `hβ`. Take `⟨B, hB, hBb⟩` from `zbound hTTp hL hLaw hD hk hsa`. Establish `hS : ∀ q π, evQ P (actA P (star s * a) j π) q = conj (g q) * evQ P (actA P a j π) q` using `fun q π => by`. Rewrite using `[F.actA_mul, (CF_act hs _ q π).2]`. Establish `e1 : ∀ q π, evQ P (actA P (β * s * W.prod) j π) q = ∑ π', Mβ q π π' * (g q * evQ P (actA P W.prod j π') q)` using `fun q π => by`.

Rewrite using `[F.actA_mul, F.actA_mul, hSA.1]`. Conclude with `Finset.sum_congr rfl fun π' _ => by rw [(CF_act hs _ q π').1]`. Establish `e2 : ∀ q π', evQ P (actA P (star (β * s) * a) j π') q = ∑ π, conj (Mβ q π π') * (conj (g q) * evQ P (actA P a j π) q)` using `fun q π' => by`. Rewrite using `[star_mul, F.actA_mul, F.actA_mul, (CF_act hs _ q π').2, hSA.2, Finset.mul_sum]`. Conclude with `Finset.sum_congr rfl fun π _ => by ring`.

Establish `hV : SqB (fun q => ∑ π', ‖evQ P (actA P W.prod j π') q‖)` using `sqB_sum _ _ fun π' _ => sqB_word hD hW hWl π'`. Establish `hCB : SqB (fun q => C * B q)` using `sqB_smul hB hC0`. Establish `hcard : SqB (fun q => (Fintype.card (M.Ty P) : ℝ) * (C * B q))` using `sqB_smul hCB (Nat.cast_nonneg _)`. Establish `cont : ∀ (x : A P (DQ P)) (y : A P (DQ P)) (π π' : M.Ty P), Continuous fun q => evQ P (actA P x j π) q * conj (evQ P (actA P y j π') q)` using `fun x y π π' => (MAx3.evQ_cont P _).mul (Complex.continuous_conj.comp (MAx3.evQ_cont P _))`. Establish `int1 : ∀ π, Integrable (fun q => evQ P (actA P a j π) q * conj (evQ P (actA P (β * s * W.prod) j π) q)) (mu0 P.r P.TT)` using `fun π => by`.

Use `int_of_sqB (cont _ _ π π) hCB hV fun q => ?_` and prove the remaining obligations. Rewrite using `[e1, norm_mul, Complex.norm_conj]`. Combine the equalities or inequalities in the displayed calculation. Rewrite using `[norm_mul, norm_mul]; exact mul_le_mul_of_nonneg_right (hMb q π π') (by positivity))) (norm_nonneg _)`. Use `_ = C * (‖g q‖ * ‖evQ P (actA P a j π) q‖) * ∑ π', ‖evQ P (actA P W.prod j π') q‖ := by`.

Rewrite using `[Finset.mul_sum, Finset.mul_sum]; exact Finset.sum_congr rfl fun _ _ => by ring`. Use `_ ≤ C * B q * ∑ π', ‖evQ P (actA P W.prod j π') q‖ := by`. Use `mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left ?_ hC0) (hV.2.1 q)` and prove the remaining obligations. Use `hBb q π` as an intermediate fact. Rewrite `this` using `[hS, norm_mul, Complex.norm_conj]`.

Conclude with `this`. Establish `int2 : ∀ π', Integrable (fun q => evQ P (actA P (star (β * s) * a) j π') q * conj (evQ P (actA P W.prod j π') q)) (mu0 P.r P.TT)` using `fun π' => by`. Use `int_of_sqB (cont _ _ π' π') hcard (sqB_word hD hW hWl π') fun q => ?_` and prove the remaining obligations. Rewrite using `[e2, norm_mul, Complex.norm_conj]`. Use `mul_le_mul_of_nonneg_right ((norm_sum_le _ _).trans ?_) (norm_nonneg _)` and prove the remaining obligations.

Combine the equalities or inequalities in the displayed calculation. Rewrite using `[norm_mul, Complex.norm_conj, ← hS]`. Conclude with `mul_le_mul (hMb q π π') (hBb q π) (norm_nonneg _) hC0`. Use `_ = _ := by rw [Finset.sum_const, Finset.card_univ, nsmul_eq_mul]`. Use `⟨int1, int2, ?_⟩` and prove the remaining obligations.

Rewrite using `[ipA_eq, ipA_eq, ← integral_finset_sum _ fun π _ => int1 π, ← integral_finset_sum _ fun π _ => int2 π]`. Use `congr 1`. Use function extensionality and compare the values at `q`. Simplify using `only [e1, e2, map_sum, map_mul, Complex.conj_conj, Finset.mul_sum, Finset.sum_mul]`. Rewrite using `[Finset.sum_comm]`.

Conclude with `Finset.sum_congr rfl fun _ _ => Finset.sum_congr rfl fun _ _ => by ring`.
-/
theorem multAdj {m : ℕ} (hD : JDecay P L j m) {a β s : A P (DQ P)} {C : ℝ} (hβ : SAB β C) {g : Qp P.r P.TT → ℂ}
    (hs : CF s g) {W : List (A P (DQ P))} (hW : ∀ x ∈ W, x ∈ hatSet P L) (hWl : W.length ≤ m) {k : ℕ} (hk : k ≤ m)
    (hsa : star s * a ∈ Z P L k) :
    (∀ π, Integrable (fun q => evQ P (actA P a j π) q * conj (evQ P (actA P (β * s * W.prod) j π) q)) (mu0 P.r P.TT)) ∧
    (∀ π, Integrable (fun q => evQ P (actA P (star (β * s) * a) j π) q * conj (evQ P (actA P W.prod j π) q))
      (mu0 P.r P.TT)) ∧
    ipA P (actA P a j) (actA P (β * s * W.prod) j) = ipA P (actA P (star (β * s) * a) j) (actA P W.prod j) := by
  obtain ⟨Mβ, hSA, hC0, hMb⟩ := hβ
  obtain ⟨B, hB, hBb⟩ := zbound hTTp hL hLaw hD hk hsa
  have hS : ∀ q π, evQ P (actA P (star s * a) j π) q = conj (g q) * evQ P (actA P a j π) q := fun q π => by
    rw [F.actA_mul, (CF_act hs _ q π).2]
  have e1 : ∀ q π, evQ P (actA P (β * s * W.prod) j π) q =
      ∑ π', Mβ q π π' * (g q * evQ P (actA P W.prod j π') q) := fun q π => by
    rw [F.actA_mul, F.actA_mul, hSA.1]
    exact Finset.sum_congr rfl fun π' _ => by rw [(CF_act hs _ q π').1]
  have e2 : ∀ q π', evQ P (actA P (star (β * s) * a) j π') q =
      ∑ π, conj (Mβ q π π') * (conj (g q) * evQ P (actA P a j π) q) := fun q π' => by
    rw [star_mul, F.actA_mul, F.actA_mul, (CF_act hs _ q π').2, hSA.2, Finset.mul_sum]
    exact Finset.sum_congr rfl fun π _ => by ring
  have hV : SqB (fun q => ∑ π', ‖evQ P (actA P W.prod j π') q‖) := sqB_sum _ _ fun π' _ => sqB_word hD hW hWl π'
  have hCB : SqB (fun q => C * B q) := sqB_smul hB hC0
  have hcard : SqB (fun q => (Fintype.card (M.Ty P) : ℝ) * (C * B q)) := sqB_smul hCB (Nat.cast_nonneg _)
  have cont : ∀ (x : A P (DQ P)) (y : A P (DQ P)) (π π' : M.Ty P),
      Continuous fun q => evQ P (actA P x j π) q * conj (evQ P (actA P y j π') q) := fun x y π π' =>
    (MAx3.evQ_cont P _).mul (Complex.continuous_conj.comp (MAx3.evQ_cont P _))
  have int1 : ∀ π, Integrable (fun q => evQ P (actA P a j π) q * conj (evQ P (actA P (β * s * W.prod) j π) q))
      (mu0 P.r P.TT) := fun π => by
    refine int_of_sqB (cont _ _ π π) hCB hV fun q => ?_
    rw [e1, norm_mul, Complex.norm_conj]
    calc ‖evQ P (actA P a j π) q‖ * ‖∑ π', Mβ q π π' * (g q * evQ P (actA P W.prod j π') q)‖
        ≤ ‖evQ P (actA P a j π) q‖ * ∑ π', C * (‖g q‖ * ‖evQ P (actA P W.prod j π') q‖) :=
          mul_le_mul_of_nonneg_left ((norm_sum_le _ _).trans (Finset.sum_le_sum fun π' _ => by
            rw [norm_mul, norm_mul]; exact mul_le_mul_of_nonneg_right (hMb q π π') (by positivity))) (norm_nonneg _)
      _ = C * (‖g q‖ * ‖evQ P (actA P a j π) q‖) * ∑ π', ‖evQ P (actA P W.prod j π') q‖ := by
          rw [Finset.mul_sum, Finset.mul_sum]; exact Finset.sum_congr rfl fun _ _ => by ring
      _ ≤ C * B q * ∑ π', ‖evQ P (actA P W.prod j π') q‖ := by
          refine mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left ?_ hC0) (hV.2.1 q)
          have := hBb q π; rw [hS, norm_mul, Complex.norm_conj] at this; exact this
  have int2 : ∀ π', Integrable (fun q => evQ P (actA P (star (β * s) * a) j π') q *
      conj (evQ P (actA P W.prod j π') q)) (mu0 P.r P.TT) := fun π' => by
    refine int_of_sqB (cont _ _ π' π') hcard (sqB_word hD hW hWl π') fun q => ?_
    rw [e2, norm_mul, Complex.norm_conj]
    refine mul_le_mul_of_nonneg_right ((norm_sum_le _ _).trans ?_) (norm_nonneg _)
    calc ∑ π, ‖conj (Mβ q π π') * (conj (g q) * evQ P (actA P a j π) q)‖ ≤ ∑ _π : M.Ty P, C * B q :=
          Finset.sum_le_sum fun π _ => by
            rw [norm_mul, Complex.norm_conj, ← hS]
            exact mul_le_mul (hMb q π π') (hBb q π) (norm_nonneg _) hC0
      _ = _ := by rw [Finset.sum_const, Finset.card_univ, nsmul_eq_mul]
  refine ⟨int1, int2, ?_⟩
  rw [ipA_eq, ipA_eq, ← integral_finset_sum _ fun π _ => int1 π, ← integral_finset_sum _ fun π _ => int2 π]
  congr 1; funext q
  simp only [e1, e2, map_sum, map_mul, Complex.conj_conj, Finset.mul_sum, Finset.sum_mul]
  rw [Finset.sum_comm]
  exact Finset.sum_congr rfl fun _ _ => Finset.sum_congr rfl fun _ _ => by ring

end

