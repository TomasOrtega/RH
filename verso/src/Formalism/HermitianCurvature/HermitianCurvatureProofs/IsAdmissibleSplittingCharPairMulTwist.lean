theorem mono_gp (κ m : Fin N → Fin (n + 1)) : mono κ (gp t m) = ∏ a, Vd t a (m a) (κ a) := by
  simp [mono, gp, Vd, Matrix.vandermonde_apply]

/- English proof (translation)
Simplify using `only [Wt, mono_gp, ← Finset.prod_mul_distrib]`. Rewrite using `[← Fintype.prod_sum (fun a i => (Vd t a)⁻¹ (κ a) i * Vd t a i (κ' a))]`. Establish `: ∀ a, ∑ i, (Vd t a)⁻¹ (κ a) i * Vd t a i (κ' a) = (1 : Matrix (Fin (n + 1)) (Fin (n + 1)) ℂ) (κ a) (κ' a)` using `fun a => by rw [← Vd_inv t ht a, Matrix.mul_apply]`. Simplify using `only [this, Matrix.one_apply]`. Distinguish the cases in `h : κ = κ'`.

