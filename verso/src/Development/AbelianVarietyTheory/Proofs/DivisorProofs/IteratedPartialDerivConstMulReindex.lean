/- English proof (translation)
Introduce `I J _ _ _ _ e u h A z`. Establish `key : ∀ v : List I, iterD v (fun z ↦ A * h (fun j ↦ z (e.symm j))) = fun z ↦ A * iterD (v.map e) h (fun j ↦ z (e.symm j))`. Introduce `v`. Proceed by induction on `v with`. Consider the case `nil => rfl`.

Consider the case `cons i v ih`. Use function extensionality and compare the values at `z`. Use `show partialD i (iterD v _) z = A * partialD (e i) (iterD (v.map e) h) _`. Rewrite using `[ih]`. Simplify using `only [partialD, lineDeriv]`.

Establish `hpath : (fun t : ℂ ↦ A * iterD (v.map e) h (fun j ↦ (z + t • (Pi.single i 1 : I → ℂ)) (e.symm j))) = fun t ↦ A * iterD (v.map e) h ((fun j ↦ z (e.symm j)) + t • (Pi.single (e i) 1 : J → ℂ))`. Use function extensionality and compare the values at `t`. Use `congr 2`. Use function extensionality and compare the values at `j`. Simplify using `[Pi.single_apply, Equiv.symm_apply_eq]`.

Rewrite using `[hpath, deriv_const_mul_field]`. Conclude with `congrFun (key u) z`.
-/
theorem iterD_const_mul_reindex : ∀ (I J : Type) [Fintype I] [DecidableEq I] [Fintype J] [DecidableEq J] (e : I ≃ J) (u : List I) (h : (J → ℂ) → ℂ) (A : ℂ) (z : I → ℂ), iterD u (fun z ↦ A * h (fun j ↦ z (e.symm j))) z = A * iterD (u.map e) h (fun j ↦ z (e.symm j)) := by
  intro I J _ _ _ _ e u h A z
  have key : ∀ v : List I, iterD v (fun z ↦ A * h (fun j ↦ z (e.symm j))) =
      fun z ↦ A * iterD (v.map e) h (fun j ↦ z (e.symm j)) := by
    intro v
    induction v with
    | nil => rfl
    | cons i v ih =>
      funext z
      show partialD i (iterD v _) z = A * partialD (e i) (iterD (v.map e) h) _
      rw [ih]
      simp only [partialD, lineDeriv]
      have hpath : (fun t : ℂ ↦ A * iterD (v.map e) h (fun j ↦ (z + t • (Pi.single i 1 : I → ℂ)) (e.symm j))) =
          fun t ↦ A * iterD (v.map e) h ((fun j ↦ z (e.symm j)) + t • (Pi.single (e i) 1 : J → ℂ)) := by
        funext t
        congr 2
        funext j
        simp [Pi.single_apply, Equiv.symm_apply_eq]
      rw [hpath, deriv_const_mul_field]
  exact congrFun (key u) z

end GlobalTheory.HilbFam
