variable {P : M.Par} {L : LevelData (A P (DQ P)) P.r} (hL : IsModelLevel P (DQ P) L) (hLaw : (DQ P).Laws P.TT)
include hL hLaw

/- English proof (translation)
Establish `: Fact ((DQ P).Laws P.TT)` using `⟨hLaw⟩`. Establish `hs` using `Formalism.FourierDecayAlt.P.MAx1.starGens P (DQ P)`. Take `⟨-, -, -, -, -, -, -, hzi, -, hzbi, -⟩` from `hL`. Use `⟨by rw [hzi, hzbi]; exact hs.2.2.1, by rw [hzi, hzbi, ← hs.2.2.1, star_star]⟩` and prove the remaining obligations.
-/
theorem star_zi : star L.ζi = L.ζbi ∧ star L.ζbi = L.ζi := by
  have : Fact ((DQ P).Laws P.TT) := ⟨hLaw⟩
  have hs := Formalism.FourierDecayAlt.P.MAx1.starGens P (DQ P)
  obtain ⟨-, -, -, -, -, -, -, hzi, -, hzbi, -⟩ := hL
  refine ⟨by rw [hzi, hzbi]; exact hs.2.2.1, by rw [hzi, hzbi, ← hs.2.2.1, star_star]⟩

/- English proof (translation)
Take `⟨-, -, -, -, -, hz, hzb, -, -, -, -⟩` from `Q.star_all hL hLaw`. Take `⟨hzi, hzbi⟩` from `star_zi hL hLaw`. Establish `hDr` using `Q.star_Dr hL hLaw`. Establish `hDri` using `H.star_Dri hL hLaw`. Establish `hDrb : star L.Drb = L.Dr` using `by rw [← hDr, star_star]`.

Establish `hDrbi : star L.Drbi = L.Dri` using `by rw [← hDri, star_star]`. Unfold `LevelData.D LevelData.Db LevelData.Di LevelData.Dbi`. Use `⟨?_, ?_, ?_, ?_⟩` and prove the remaining obligations. Rewrite using `[star_mul, hz, hDr]`. Conclude with `H.cl_comm L (H.memζb L) (H.memDrb L)`.

Rewrite using `[star_mul, hzb, hDrb]`. Conclude with `H.cl_comm L (H.memζ L) (H.memDr L)`. Rewrite using `[star_mul, hzi, hDri]`. Conclude with `H.cl_comm L (H.memDrbi L) (H.memζbi L)`. Rewrite using `[star_mul, hzbi, hDrbi]`.

Conclude with `H.cl_comm L (H.memDri L) (H.memζi L)`.
-/
theorem star_Ds : star L.D = L.Db ∧ star L.Db = L.D ∧ star L.Di = L.Dbi ∧ star L.Dbi = L.Di := by
  obtain ⟨-, -, -, -, -, hz, hzb, -, -, -, -⟩ := Q.star_all hL hLaw
  obtain ⟨hzi, hzbi⟩ := star_zi hL hLaw
  have hDr := Q.star_Dr hL hLaw
  have hDri := H.star_Dri hL hLaw
  have hDrb : star L.Drb = L.Dr := by rw [← hDr, star_star]
  have hDrbi : star L.Drbi = L.Dri := by rw [← hDri, star_star]
  unfold LevelData.D LevelData.Db LevelData.Di LevelData.Dbi
  refine ⟨?_, ?_, ?_, ?_⟩
  · rw [star_mul, hz, hDr]; exact H.cl_comm L (H.memζb L) (H.memDrb L)
  · rw [star_mul, hzb, hDrb]; exact H.cl_comm L (H.memζ L) (H.memDr L)
  · rw [star_mul, hzi, hDri]; exact H.cl_comm L (H.memDrbi L) (H.memζbi L)
  · rw [star_mul, hzbi, hDrbi]; exact H.cl_comm L (H.memDri L) (H.memζi L)

/- English proof (translation)
Establish `e : ∀ g : M.Ty P → ℂ, kap P (DQ P) g = Matrix.diagonal fun π => algebraMap ℂ (DQ P).Pr (g π)` using `fun g => rfl`. Rewrite using `[e, e, Matrix.star_eq_conjTranspose, Matrix.diagonal_conjTranspose]`. Use `congr 1`. Use function extensionality and compare the values at `π`. Conclude with `(algebraMap_star_comm _).symm`.
-/
theorem star_kap (f : M.Ty P → ℂ) : star (kap P (DQ P) f) = kap P (DQ P) (fun π => conj (f π)) := by
  have e : ∀ g : M.Ty P → ℂ, kap P (DQ P) g = Matrix.diagonal fun π => algebraMap ℂ (DQ P).Pr (g π) := fun g => rfl
  rw [e, e, Matrix.star_eq_conjTranspose, Matrix.diagonal_conjTranspose]
  congr 1; funext π
  exact (algebraMap_star_comm _).symm

/- English proof (translation)
Take `⟨hD, hDb, hDi, hDbi⟩` from `star_Ds hL hLaw`. Take `⟨hzi, hzbi⟩` from `star_zi hL hLaw`. Establish `gen : ∀ {x}, x ∈ bddSet P L → x ∈ Submonoid.closure (bddSet P L)` using `fun h => Submonoid.subset_closure h`. Proceed by induction on `hb using Submonoid.closure_induction with`. Consider the case `mem x hx`.

Break down `hx with (((hx | ⟨f, rfl⟩) | ⟨i, hi, rfl⟩) | ⟨i, hi, rfl⟩)` into its components or cases. Simplify using `only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx`. Break down `hx with rfl | rfl | rfl | rfl` into its components or cases. Rewrite using `[hzi]; exact gen (Or.inl (Or.inl (Or.inl (by simp))))`. Rewrite using `[hzbi]; exact gen (Or.inl (Or.inl (Or.inl (by simp))))`.

Rewrite using `[star_mul, hDbi, hD, H.cl_comm L (H.memDi L) (H.memDb L)]`. Conclude with `gen (Or.inl (Or.inl (Or.inl (by simp))))`. Rewrite using `[star_mul, hDi, hDb, H.cl_comm L (H.memDbi L) (H.memD L)]`. Conclude with `gen (Or.inl (Or.inl (Or.inl (by simp))))`. Rewrite using `[star_kap hL hLaw]`.

Conclude with `gen (Or.inl (Or.inl (Or.inr ⟨_, rfl⟩)))`. Conclude with `gen (Or.inr ⟨i, hi, rfl⟩)`. Rewrite using `[star_star]`. Conclude with `gen (Or.inl (Or.inr ⟨i, hi, rfl⟩))`. Consider the case `one => rw [star_one]`.

Conclude with `Submonoid.one_mem _`. Consider the case `mul x y _ _ h1 h2 => rw [star_mul]`. Conclude with `Submonoid.mul_mem _ h2 h1`.
-/
theorem star_closure {b : A P (DQ P)} (hb : b ∈ Submonoid.closure (bddSet P L)) :
    star b ∈ Submonoid.closure (bddSet P L) := by
  obtain ⟨hD, hDb, hDi, hDbi⟩ := star_Ds hL hLaw
  obtain ⟨hzi, hzbi⟩ := star_zi hL hLaw
  have gen : ∀ {x}, x ∈ bddSet P L → x ∈ Submonoid.closure (bddSet P L) := fun h => Submonoid.subset_closure h
  induction hb using Submonoid.closure_induction with
  | mem x hx =>
    rcases hx with (((hx | ⟨f, rfl⟩) | ⟨i, hi, rfl⟩) | ⟨i, hi, rfl⟩)
    · simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
      rcases hx with rfl | rfl | rfl | rfl
      · rw [hzi]; exact gen (Or.inl (Or.inl (Or.inl (by simp))))
      · rw [hzbi]; exact gen (Or.inl (Or.inl (Or.inl (by simp))))
      · rw [star_mul, hDbi, hD, H.cl_comm L (H.memDi L) (H.memDb L)]
        exact gen (Or.inl (Or.inl (Or.inl (by simp))))
      · rw [star_mul, hDi, hDb, H.cl_comm L (H.memDbi L) (H.memD L)]
        exact gen (Or.inl (Or.inl (Or.inl (by simp))))
    · rw [star_kap hL hLaw]; exact gen (Or.inl (Or.inl (Or.inr ⟨_, rfl⟩)))
    · exact gen (Or.inr ⟨i, hi, rfl⟩)
    · rw [star_star]; exact gen (Or.inl (Or.inr ⟨i, hi, rfl⟩))
  | one => rw [star_one]; exact Submonoid.one_mem _
  | mul x y _ _ h1 h2 => rw [star_mul]; exact Submonoid.mul_mem _ h2 h1

end

