  have hL : IsModelLevel P (DQ P) L := hH.1.2.2.2.1
  have hee1 := h.ee_at L hL Y h.hYm (fun p hp => (h.hfar p hp).1)
  have hee2 := h.ee_at L hL (Y + s) h.hYsm (fun p hp => (h.hfar p hp).2)
