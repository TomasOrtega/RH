namespace Formalism.FourierDecayAlt.P.MAx3.Z

open Formalism.FourierDecayAlt Formalism.FourierDecayAlt.MA Formalism.FourierDecayAlt.R MeasureTheory Formalism.FourierDecayAlt.P.MAx3.H Formalism.FourierDecayAlt.P.MAx3.AD Formalism.FourierDecayAlt.P.MAx3.L
open Formalism.FourierDecayAlt.P.RuleGD
open ComplexConjugate

noncomputable section

variable {P : M.Par}

/- English proof (translation)
Rewrite using `[ipA_eq, ipA_eq, ipA_eq, ← Finset.sum_add_distrib]`. Use `Finset.sum_congr rfl fun π _ => ?_` and prove the remaining obligations. Rewrite using `[← integral_add (h1 π) (h2 π)]`. Use `congr 1`. Use function extensionality and compare the values at `q`.

Use `show evQ P (f π) q * conj (evQ P (g1 π) q + evQ P (g2 π) q) = _`. Rewrite using `[map_add, mul_add]`.
-/
theorem ipA_add_right {f g1 g2 : M.Ty P → SmQ P.r P.TT}
    (h1 : ∀ π, Integrable (fun q => evQ P (f π) q * conj (evQ P (g1 π) q)) (mu0 P.r P.TT))
    (h2 : ∀ π, Integrable (fun q => evQ P (f π) q * conj (evQ P (g2 π) q)) (mu0 P.r P.TT)) :
    ipA P f (g1 + g2) = ipA P f g1 + ipA P f g2 := by
  rw [ipA_eq, ipA_eq, ipA_eq, ← Finset.sum_add_distrib]
  refine Finset.sum_congr rfl fun π _ => ?_
  rw [← integral_add (h1 π) (h2 π)]
  congr 1; funext q
  show evQ P (f π) q * conj (evQ P (g1 π) q + evQ P (g2 π) q) = _
  rw [map_add, mul_add]

/- English proof (translation)
Rewrite using `[ipA_eq, ipA_eq, Finset.mul_sum]`. Use `Finset.sum_congr rfl fun π _ => ?_` and prove the remaining obligations. Rewrite using `[← integral_const_mul]`. Use `congr 1`. Use function extensionality and compare the values at `q`.

Use `show evQ P (f π) q * conj (c * evQ P (g π) q) = _`. Rewrite using `[map_mul]`. Expand and normalize the polynomial expressions, which then agree.
-/
theorem ipA_smul_right (c : ℂ) (f g : M.Ty P → SmQ P.r P.TT) :
    ipA P f (fun π => c • g π) = conj c * ipA P f g := by
  rw [ipA_eq, ipA_eq, Finset.mul_sum]
  refine Finset.sum_congr rfl fun π _ => ?_
  rw [← integral_const_mul]
  congr 1; funext q
  show evQ P (f π) q * conj (c * evQ P (g π) q) = _
  rw [map_mul]; ring

/- English proof (translation)
Rewrite using `[ipA_eq]`. Use `Finset.sum_eq_zero fun π _ => ?_` and prove the remaining obligations. Establish `: (fun q => evQ P (f π) q * conj (evQ P ((0 : M.Ty P → SmQ P.r P.TT) π) q)) = fun _ => 0`. Use function extensionality and compare the values at `q`. Use `show _ * conj (0 : ℂ) = 0`.

Simplify using the standard rewrite rules. Rewrite using `[this, integral_zero]`.
-/
theorem ipA_zero_right (f : M.Ty P → SmQ P.r P.TT) : ipA P f 0 = 0 := by
  rw [ipA_eq]
  refine Finset.sum_eq_zero fun π _ => ?_
  have : (fun q => evQ P (f π) q * conj (evQ P ((0 : M.Ty P → SmQ P.r P.TT) π) q)) = fun _ => 0 := by
    funext q; show _ * conj (0 : ℂ) = 0; simp
  rw [this, integral_zero]

variable {L : LevelData (A P (DQ P)) P.r} {j : M.Ty P → SmQ P.r P.TT}

def QA (L : LevelData (A P (DQ P)) P.r) (j : M.Ty P → SmQ P.r P.TT) (a w : A P (DQ P)) : Prop :=
  (∀ π, Integrable (fun q => evQ P (actA P a j π) q * conj (evQ P (actA P w j π) q)) (mu0 P.r P.TT)) ∧
  (∀ π, Integrable (fun q => evQ P (actA P (star w * a) j π) q * conj (evQ P (j π) q)) (mu0 P.r P.TT)) ∧
  ipA P (actA P a j) (actA P w j) = ipA P (actA P (star w * a) j) j

/- English proof (translation)
Use `⟨fun π => ?_, fun π => ?_, ?_⟩` and prove the remaining obligations. Rewrite using `[F.actA_zero]; exact (integrable_zero _ _ _).congr (Filter.Eventually.of_forall fun q => by show (0 : ℂ) = _ * conj (0 : ℂ); simp)`. Rewrite using `[star_zero, zero_mul, F.actA_zero]; exact (integrable_zero _ _ _).congr (Filter.Eventually.of_forall fun q => by show (0 : ℂ) = (0 : ℂ) * _; simp)`. Rewrite using `[F.actA_zero, star_zero, zero_mul, F.actA_zero, ipA_zero_right, ipA_zero_left]`.
-/
theorem QA_zero (a : A P (DQ P)) : QA L j a 0 := by
  refine ⟨fun π => ?_, fun π => ?_, ?_⟩
  · rw [F.actA_zero]; exact (integrable_zero _ _ _).congr (Filter.Eventually.of_forall fun q => by
      show (0 : ℂ) = _ * conj (0 : ℂ); simp)
  · rw [star_zero, zero_mul, F.actA_zero]; exact (integrable_zero _ _ _).congr (Filter.Eventually.of_forall fun q => by
      show (0 : ℂ) = (0 : ℂ) * _; simp)
  · rw [F.actA_zero, star_zero, zero_mul, F.actA_zero, ipA_zero_right, ipA_zero_left]

/- English proof (translation)
Take `⟨i1, k1, e1⟩` from `h1`. Take `⟨i2, k2, e2⟩` from `h2`. Use `⟨fun π => ?_, fun π => ?_, ?_⟩` and prove the remaining obligations. Rewrite using `[F.actA_add]; exact ((i1 π).add (i2 π)).congr (Filter.Eventually.of_forall fun q => by show _ = evQ P (actA P a j π) q * conj (evQ P (actA P w1 j π) q + evQ P (actA P w2 j π) q)`. Rewrite using `[map_add, mul_add]`.

Use the proof step `rfl)`. Rewrite using `[star_add, add_mul, F.actA_add]; exact ((k1 π).add (k2 π)).congr (Filter.Eventually.of_forall fun q => by show _ = (evQ P (actA P (star w1 * a) j π) q + evQ P (actA P (star w2 * a) j π) q) * _`. Rewrite using `[add_mul]`. Use the proof step `rfl)`. Rewrite using `[F.actA_add, ipA_add_right i1 i2, e1, e2, star_add, add_mul, F.actA_add, ipA_add_left k1 k2]`.
-/
theorem QA_add {a w1 w2 : A P (DQ P)} (h1 : QA L j a w1) (h2 : QA L j a w2) : QA L j a (w1 + w2) := by
  obtain ⟨i1, k1, e1⟩ := h1; obtain ⟨i2, k2, e2⟩ := h2
  refine ⟨fun π => ?_, fun π => ?_, ?_⟩
  · rw [F.actA_add]; exact ((i1 π).add (i2 π)).congr (Filter.Eventually.of_forall fun q => by
      show _ = evQ P (actA P a j π) q * conj (evQ P (actA P w1 j π) q + evQ P (actA P w2 j π) q)
      rw [map_add, mul_add]; rfl)
  · rw [star_add, add_mul, F.actA_add]; exact ((k1 π).add (k2 π)).congr (Filter.Eventually.of_forall fun q => by
      show _ = (evQ P (actA P (star w1 * a) j π) q + evQ P (actA P (star w2 * a) j π) q) * _
      rw [add_mul]; rfl)
  · rw [F.actA_add, ipA_add_right i1 i2, e1, e2, star_add, add_mul, F.actA_add, ipA_add_left k1 k2]

/- English proof (translation)
Take `⟨i1, k1, e1⟩` from `h`. Use `⟨fun π => ?_, fun π => ?_, ?_⟩` and prove the remaining obligations. Rewrite using `[F.actA_smul_mat]; exact ((i1 π).const_mul (conj c)).congr (Filter.Eventually.of_forall fun q => by show _ = evQ P (actA P a j π) q * conj (c * evQ P (actA P w j π) q)`. Rewrite using `[map_mul]`. Use the proof step `ring)`.

Rewrite using `[star_smul, smul_mul_assoc, F.actA_smul_mat]`. Conclude with `((k1 π).const_mul (star c)).congr (Filter.Eventually.of_forall fun q => by show _ = (star c * evQ P (actA P (star w * a) j π) q) * _ ring)`. Rewrite using `[F.actA_smul_mat, ipA_smul_right, e1, star_smul, smul_mul_assoc, F.actA_smul_mat, ipA_smul_left]`. Both sides reduce to the same expression.
-/
theorem QA_smul {a w : A P (DQ P)} (c : ℂ) (h : QA L j a w) : QA L j a (c • w) := by
  obtain ⟨i1, k1, e1⟩ := h
  refine ⟨fun π => ?_, fun π => ?_, ?_⟩
  · rw [F.actA_smul_mat]; exact ((i1 π).const_mul (conj c)).congr (Filter.Eventually.of_forall fun q => by
      show _ = evQ P (actA P a j π) q * conj (c * evQ P (actA P w j π) q)
      rw [map_mul]; ring)
  · rw [star_smul, smul_mul_assoc, F.actA_smul_mat]
    exact ((k1 π).const_mul (star c)).congr (Filter.Eventually.of_forall fun q => by
      show _ = (star c * evQ P (actA P (star w * a) j π) q) * _
      ring)
  · rw [F.actA_smul_mat, ipA_smul_right, e1, star_smul, smul_mul_assoc, F.actA_smul_mat, ipA_smul_left]
    rfl

end

