import Mathlib

namespace GlobalTheory.IntegerShiftSingle

universe u_1 u_2 u_3

/- English proof (translation)
Proceed by induction on `k using Int.induction_on with`. Consider the case `zero => intro x`. Simplify using the standard rewrite rules. Consider the case `succ m ih`. Introduce `x`.

Establish `: x + Pi.single i (((m : ℤ) + 1 : ℤ) : R) = (x + Pi.single i ((m : ℤ) : R)) + Pi.single i (1 : R)`. Rewrite using `[Int.cast_add, Int.cast_one, Pi.single_add, add_assoc]`. Rewrite using `[this, h, ih]`. Consider the case `pred m ih`. Introduce `x`.

Establish `: x + Pi.single i ((-(m : ℤ) : ℤ) : R) = (x + Pi.single i ((-(m : ℤ) - 1 : ℤ) : R)) + Pi.single i (1 : R)`. Rewrite using `[add_assoc, ← Pi.single_add]`. Use `congr 2`. Use `push_cast`. Apply the tactic sequence `first | rfl | ring | abel | simp`.

Rewrite using `[← ih x, this, h]`.
-/
theorem shift_single_int {ι : Type u_1} {R : Type u_2} {E : Type u_3} [DecidableEq ι] [Ring R]
    {F : (ι → R) → E} (h : ∀ (i : ι) (x : ι → R), F (x + Pi.single i (1 : R)) = F x)
    (i : ι) (k : ℤ) : ∀ x : ι → R, F (x + Pi.single i ((k : ℤ) : R)) = F x := by
  induction k using Int.induction_on with
  | zero => intro x; simp
  | succ m ih =>
    intro x
    have : x + Pi.single i (((m : ℤ) + 1 : ℤ) : R) = (x + Pi.single i ((m : ℤ) : R)) + Pi.single i (1 : R) := by
      rw [Int.cast_add, Int.cast_one, Pi.single_add, add_assoc]
    rw [this, h, ih]
  | pred m ih =>
    intro x
    have : x + Pi.single i ((-(m : ℤ) : ℤ) : R) = (x + Pi.single i ((-(m : ℤ) - 1 : ℤ) : R)) + Pi.single i (1 : R) := by
      rw [add_assoc, ← Pi.single_add]
      congr 2
      push_cast
      first | rfl | ring | abel | simp
    rw [← ih x, this, h]

/- English proof (translation)
Introduce `h n x`. Establish `key : ∀ s : Finset ι, ∀ y : ι → R, F (y + ∑ i ∈ s, Pi.single i ((n i : ℤ) : R)) = F y`. Introduce `s`. Proceed by induction on `s using Finset.induction_on with`. Consider the case `empty => intro y`.

Simplify using the standard rewrite rules. Consider the case `insert a s ha ih`. Introduce `y`. Rewrite using `[Finset.sum_insert ha, ← add_assoc, ih, shift_single_int h]`. Establish `hsum : (fun i : ι => ((n i : ℤ) : R)) = ∑ i ∈ Finset.univ, Pi.single i ((n i : ℤ) : R)`.

Rewrite using `[Finset.univ_sum_single]`. Rewrite using `[hsum]`. Conclude with `key Finset.univ x`.
-/
theorem main {ι : Type u_1} {R : Type u_2} {E : Type u_3} [Fintype ι] [inst : DecidableEq ι] [inst_1 : Ring R]
    {F : (ι → R) → E} : (∀ (i : ι) (x : ι → R), F (x + Pi.single i (1 : R)) = F x) →
    ∀ (n : ι → ℤ) (x : ι → R), F (x + fun (i : ι) ↦ (↑(n i) : R)) = F x := by
  intro h n x
  have key : ∀ s : Finset ι, ∀ y : ι → R, F (y + ∑ i ∈ s, Pi.single i ((n i : ℤ) : R)) = F y := by
    intro s
    induction s using Finset.induction_on with
    | empty => intro y; simp
    | insert a s ha ih =>
      intro y
      rw [Finset.sum_insert ha, ← add_assoc, ih, shift_single_int h]
  have hsum : (fun i : ι => ((n i : ℤ) : R)) = ∑ i ∈ Finset.univ, Pi.single i ((n i : ℤ) : R) := by
    rw [Finset.univ_sum_single]
  rw [hsum]
  exact key Finset.univ x

end GlobalTheory.IntegerShiftSingle
