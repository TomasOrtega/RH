section S_AD_AD1

set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace Formalism.FourierDecayAlt.P.MAx3.AD

open Formalism.FourierDecayAlt Formalism.FourierDecayAlt.MA Formalism.FourierDecayAlt.P.MAx1.An Formalism.FourierDecayAlt.P.MAx2.Jet Formalism.FourierDecayAlt.P.MAx3.L

noncomputable section

def admitted (φ : ℝ → ℝ) : Prop :=
  LE.SmoothLog φ ∧ (∃ ε > 0, ∀ x, x ≤ ε → φ x = 0) ∧ ∀ p, ∃ C, ∀ x, 0 < x → |LE.ld p φ x| ≤ C

/- English proof (translation)
Establish `hopen : ∀ u, u < a → iteratedDeriv n f u = 0`. Introduce `u hu`. Establish `hev : f =ᶠ[nhds u] fun _ => (0 : ℝ)` using `by filter_upwards [Iio_mem_nhds hu] with v hv using h0 v (le_of_lt hv)`. Establish `hz : ∀ m, iteratedDeriv m (fun _ : ℝ => (0 : ℝ)) = fun _ => 0`. Introduce `m`.

Proceed by induction on `m with`. Consider the case `zero => rfl`. Consider the case `succ m ih => rw [iteratedDeriv_succ, ih]`. Use function extensionality and compare the values at `v`. Conclude with `deriv_const v (0 : ℝ)`.

Rewrite using `[hev.iteratedDeriv_eq n, hz]`. Establish `hcont : Continuous (iteratedDeriv n f)` using `hf.continuous_iteratedDeriv n (by exact_mod_cast (le_top : (n : ℕ∞) ≤ ⊤))`. Establish `hclosed : IsClosed {u | iteratedDeriv n f u = 0}` using `isClosed_eq hcont continuous_const`. Introduce `u hu`. Establish `hsub : Set.Iio a ⊆ {u | iteratedDeriv n f u = 0}` using `fun v hv => hopen v hv`.

Use `hclosed.closure_subset_iff.2 hsub` as an intermediate fact. Rewrite `this` using `[closure_Iio' (Set.nonempty_Iio)]`. Conclude with `this hu`.
-/
theorem vanish_deriv {f : ℝ → ℝ} (hf : ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) f) (a : ℝ) (h0 : ∀ u, u ≤ a → f u = 0)
    (n : ℕ) : ∀ u, u ≤ a → iteratedDeriv n f u = 0 := by
  have hopen : ∀ u, u < a → iteratedDeriv n f u = 0 := by
    intro u hu
    have hev : f =ᶠ[nhds u] fun _ => (0 : ℝ) := by
      filter_upwards [Iio_mem_nhds hu] with v hv using h0 v (le_of_lt hv)
    have hz : ∀ m, iteratedDeriv m (fun _ : ℝ => (0 : ℝ)) = fun _ => 0 := by
      intro m; induction m with
      | zero => rfl
      | succ m ih => rw [iteratedDeriv_succ, ih]; funext v; exact deriv_const v (0 : ℝ)
    rw [hev.iteratedDeriv_eq n, hz]
  have hcont : Continuous (iteratedDeriv n f) := hf.continuous_iteratedDeriv n (by exact_mod_cast (le_top : (n : ℕ∞) ≤ ⊤))
  have hclosed : IsClosed {u | iteratedDeriv n f u = 0} := isClosed_eq hcont continuous_const
  intro u hu
  have hsub : Set.Iio a ⊆ {u | iteratedDeriv n f u = 0} := fun v hv => hopen v hv
  have := hclosed.closure_subset_iff.2 hsub
  rw [closure_Iio' (Set.nonempty_Iio)] at this
  exact this hu

/- English proof (translation)
Simplify using `[LE.ld, Real.exp_log hx]`.
-/
theorem ld_zero {φ : ℝ → ℝ} {x : ℝ} (hx : 0 < x) : LE.ld 0 φ x = φ x := by
  simp [LE.ld, Real.exp_log hx]

/- English proof (translation)
Unfold `LE.ld`. Use `vanish_deriv hφ (Real.log ε) (fun u hu => h0 _ ?_) p _ (Real.log_le_log hx0 hx)` and prove the remaining obligations. Combine the equalities or inequalities in the displayed calculation.
-/
theorem ld_vanish {φ : ℝ → ℝ} (hφ : LE.SmoothLog φ) {ε : ℝ} (hε : 0 < ε) (h0 : ∀ x, x ≤ ε → φ x = 0) (p : ℕ)
    {x : ℝ} (hx0 : 0 < x) (hx : x ≤ ε) : LE.ld p φ x = 0 := by
  unfold LE.ld
  refine vanish_deriv hφ (Real.log ε) (fun u hu => h0 _ ?_) p _ (Real.log_le_log hx0 hx)
  calc Real.exp u ≤ Real.exp (Real.log ε) := Real.exp_le_exp.2 hu
    _ = ε := Real.exp_log hε

/- English proof (translation)
Use function extensionality and compare the values at `u`. Simplify using `[LE.ld, Real.log_exp]`.
-/
theorem ld_comp_exp (φ : ℝ → ℝ) (p : ℕ) : (fun u => LE.ld p φ (Real.exp u)) = iteratedDeriv p (fun u => φ (Real.exp u)) := by
  funext u; simp [LE.ld, Real.log_exp]

/- English proof (translation)
Unfold `LE.ld`. Rewrite using `[show (fun u => iteratedDeriv p (fun u => φ (Real.exp u)) (Real.log (Real.exp u))) = iteratedDeriv p (fun u => φ (Real.exp u)) from funext fun u => by rw [Real.log_exp]]`. Rewrite using `[iteratedDeriv_eq_iterate, iteratedDeriv_eq_iterate, iteratedDeriv_eq_iterate, Function.iterate_add_apply]`.
-/
theorem ld_ld (φ : ℝ → ℝ) (p q : ℕ) (x : ℝ) : LE.ld q (LE.ld p φ) x = LE.ld (q + p) φ x := by
  unfold LE.ld
  rw [show (fun u => iteratedDeriv p (fun u => φ (Real.exp u)) (Real.log (Real.exp u))) =
      iteratedDeriv p (fun u => φ (Real.exp u)) from funext fun u => by rw [Real.log_exp]]
  rw [iteratedDeriv_eq_iterate, iteratedDeriv_eq_iterate, iteratedDeriv_eq_iterate, Function.iterate_add_apply]

def tr (ε : ℝ) (ψ : ℝ → ℝ) (x : ℝ) : ℝ := if x ≤ ε then 0 else ψ x

/- English proof (translation)
Use function extensionality and compare the values at `u`. Unfold `tr`. Use `split_ifs with h`. Conclude with `(ld_vanish hφ hε h0 p (Real.exp_pos u) h).symm`. Both sides reduce to the same expression.
-/
theorem tr_comp_exp {φ : ℝ → ℝ} (hφ : LE.SmoothLog φ) {ε : ℝ} (hε : 0 < ε) (h0 : ∀ x, x ≤ ε → φ x = 0) (p : ℕ) :
    (fun u => tr ε (LE.ld p φ) (Real.exp u)) = fun u => LE.ld p φ (Real.exp u) := by
  funext u
  unfold tr
  split_ifs with h
  · exact (ld_vanish hφ hε h0 p (Real.exp_pos u) h).symm
  · rfl

/- English proof (translation)
Take `⟨hs, ⟨ε, hε, h0⟩, hb⟩` from `hφ`. Use `⟨tr ε (LE.ld p φ), ⟨?_, ⟨ε, hε, fun x hx => by simp [tr, hx]⟩, fun q => ?_⟩, fun x hx => ?_⟩` and prove the remaining obligations. Unfold `LE.SmoothLog`. Rewrite using `[tr_comp_exp hs hε h0 p, ld_comp_exp]`. Rewrite using `[iteratedDeriv_eq_iterate]`.

Conclude with `ContDiff.iterate_deriv p hs`. Take `⟨C, hC⟩` from `hb (q + p)`. Use `⟨C, fun x hx => ?_⟩` and prove the remaining obligations. Establish `e : LE.ld q (tr ε (LE.ld p φ)) x = LE.ld q (LE.ld p φ) x` using `by show iteratedDeriv q (fun u => tr ε (LE.ld p φ) (Real.exp u)) (Real.log x) = iteratedDeriv q (fun u => LE.ld p φ (Real.exp u)) (Real.log x)`. Rewrite using `[tr_comp_exp hs hε h0 p]`.

Rewrite using `[e, ld_ld]`. Conclude with `hC x hx`. Unfold `tr split_ifs with h`. Conclude with `(ld_vanish hs hε h0 p hx h).symm`. Both sides reduce to the same expression.
-/
theorem admissible_log_derivative {φ : ℝ → ℝ} (hφ : admitted φ) (p : ℕ) :
    ∃ ψ, admitted ψ ∧ ∀ x, 0 < x → ψ x = LE.ld p φ x := by
  obtain ⟨hs, ⟨ε, hε, h0⟩, hb⟩ := hφ
  refine ⟨tr ε (LE.ld p φ), ⟨?_, ⟨ε, hε, fun x hx => by simp [tr, hx]⟩, fun q => ?_⟩, fun x hx => ?_⟩
  · unfold LE.SmoothLog
    rw [tr_comp_exp hs hε h0 p, ld_comp_exp]
    rw [iteratedDeriv_eq_iterate]; exact ContDiff.iterate_deriv p hs
  · obtain ⟨C, hC⟩ := hb (q + p)
    refine ⟨C, fun x hx => ?_⟩
    have e : LE.ld q (tr ε (LE.ld p φ)) x = LE.ld q (LE.ld p φ) x := by
      show iteratedDeriv q (fun u => tr ε (LE.ld p φ) (Real.exp u)) (Real.log x) =
        iteratedDeriv q (fun u => LE.ld p φ (Real.exp u)) (Real.log x)
      rw [tr_comp_exp hs hε h0 p]
    rw [e, ld_ld]; exact hC x hx
  · unfold tr
    split_ifs with h
    · exact (ld_vanish hs hε h0 p hx h).symm
    · rfl

end

end Formalism.FourierDecayAlt.P.MAx3.AD

