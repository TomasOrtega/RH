import Mathlib
import Formalism.LocalToGlobal.SiegelLatticeTheory.HaarTransversals.UnitaryHaarProducts.SettingBlocks
import Formalism.PeriodIntegrals.OrbitalBoundsConclusion.ScGapBig
import Formalism.PeriodIntegrals.ScGapBig

open MeasureTheory NumberField Formalism.BasicNotions Formalism.MainNotions.S Formalism.L2.SG.HidaSetting Formalism.L2.SG.SplitPrimeNormLemmas

namespace GlobalTheory.GapAtRealPlaces

/- English proof (translation)
Introduce `hm hG τ`. Establish `hr : PI.ScGapBig.rk48 D.R.k D.R.rS = D.R.r`. Simplify using `only [PI.ScGapBig.rk48, Formalism.BasicNotions.Ranks.r]`. Use linear arithmetic over natural numbers and integers. Establish `hgaps : ∀ (j : Fin (2 * D.R.rS + 2)) (hj : j.val + 1 < 2 * D.R.rS + 2), 16 * (PI.ScGapBig.rk48 D.R.k D.R.rS : ℝ) ^ 19 ≤ ((D.hc τ).b (Fin.cast hm.symm ⟨j.val + 1, hj⟩) : ℝ) - ((D.hc τ).b (Fin.cast hm.symm j) : ℝ)`.

Introduce `j hj`. Establish `hlt : (Fin.cast hm.symm j).val + 1 < D.R.m`. Rewrite using `[Fin.val_cast]`. Use linear arithmetic over natural numbers and integers. Establish `key` using `hG.2 τ (Fin.cast hm.symm j) hlt`.

Establish `hidx : (⟨(Fin.cast hm.symm j).val + 1, hlt⟩ : Fin D.R.m) = Fin.cast hm.symm ⟨j.val + 1, hj⟩` using `Fin.ext rfl`. Rewrite `key` using `[hidx]`. Rewrite using `[hr]`. Conclude with `key` after adjusting the coercions. Take `⟨t, hto, ht5, ht1801, hgap⟩` from `h D.R.k D.R.rS (fun j => ((D.hc τ).b (Fin.cast hm.symm j) : ℝ)) (hr ▸ hG.1) hgaps`.

Conclude with `⟨t, hto, ht5, ht1801, hgap⟩`.
-/
theorem gapBig_of_comparison (h : PI.ScGapBig.ScGapBig) (D : Formalism.BasicNotions.D7) :
    Formalism.L2.SG.SplitPrimeNormLemmas.GapBigOfGapHyp D := by
  intro hm hG τ

  have hr : PI.ScGapBig.rk48 D.R.k D.R.rS = D.R.r := by
    simp only [PI.ScGapBig.rk48, Formalism.BasicNotions.Ranks.r]
    omega

  have hgaps : ∀ (j : Fin (2 * D.R.rS + 2)) (hj : j.val + 1 < 2 * D.R.rS + 2),
      16 * (PI.ScGapBig.rk48 D.R.k D.R.rS : ℝ) ^ 19 ≤
        ((D.hc τ).b (Fin.cast hm.symm ⟨j.val + 1, hj⟩) : ℝ) - ((D.hc τ).b (Fin.cast hm.symm j) : ℝ) := by
    intro j hj
    have hlt : (Fin.cast hm.symm j).val + 1 < D.R.m := by
      rw [Fin.val_cast]
      omega
    have key := hG.2 τ (Fin.cast hm.symm j) hlt
    have hidx : (⟨(Fin.cast hm.symm j).val + 1, hlt⟩ : Fin D.R.m) = Fin.cast hm.symm ⟨j.val + 1, hj⟩ :=
      Fin.ext rfl
    rw [hidx] at key
    rw [hr]
    exact_mod_cast key
  obtain ⟨t, hto, ht5, ht1801, hgap⟩ :=
    h D.R.k D.R.rS (fun j => ((D.hc τ).b (Fin.cast hm.symm j) : ℝ)) (hr ▸ hG.1) hgaps
  exact ⟨t, hto, ht5, ht1801, hgap⟩

/- English proof (translation)
Introduce `D`. Conclude with `gapBig_of_comparison scGapBig D`.
-/
theorem gapBigOfGapHyp : ∀ D : D7, GapBigOfGapHyp D := by
  intro D
  exact gapBig_of_comparison scGapBig D

end GlobalTheory.GapAtRealPlaces
