/- English proof (translation)
Take `⟨hp, hpb, hc, hci, hcb, hcbi, hz, hzi, hzb, hzbi, hg, hgi, hn, hns⟩` from `level_mem_jet_algebra hL`. Establish `hDr : L.Dr ∈ JetMatrixAlgebra P` using `Subalgebra.list_prod_mem _ fun x hx => by`. Take `⟨l, rfl⟩` from `List.mem_ofFn.1 hx`. Conclude with `hc l`. Establish `hDrb : L.Drb ∈ JetMatrixAlgebra P` using `Subalgebra.list_prod_mem _ fun x hx => by`.

Take `⟨l, rfl⟩` from `List.mem_ofFn.1 hx`. Conclude with `hcb l`. Establish `hT : L.Tprod Y ∈ matSub (JetMatrixAlgebra P) (Fin 2)` using `Subalgebra.list_prod_mem _ fun x hx => by`. Take `⟨l, rfl⟩` from `List.mem_ofFn.1 (List.mem_reverse.1 hx)`. Conclude with `matrix_two_mem_sub _ _ _ _ _ (add_mem (Subalgebra.algebraMap_mem _ _) (hp l)) (neg_mem (hc l)) (hci l) (Subalgebra.zero_mem _)`.

Establish `hTv : L.Tvprod Y ∈ matSub (JetMatrixAlgebra P) (Fin 2)` using `Subalgebra.list_prod_mem _ fun x hx => by`. Take `⟨l, rfl⟩` from `List.mem_ofFn.1 (List.mem_reverse.1 hx)`. Conclude with `matrix_two_mem_sub _ _ _ _ _ (sub_mem (Subalgebra.algebraMap_mem _ _) (hpb l)) (neg_mem (hcb l)) (hcbi l) (Subalgebra.zero_mem _)`. Use `⟨mul_mem hDr (hT 0 0), mul_mem (mul_mem hDrb hg) (add_mem (mul_mem (sub_mem (neg_mem hn) (mul_mem (Subalgebra.algebraMap_mem _ _) (mul_mem hzb hgi))) (hT 0 0)) (hT 1 0)), mul_mem hDrb (hTv 0 0), mul_mem (mul_mem hDr hg) (add_mem (mul_mem (sub_mem (neg_mem hns) (mul_mem (Subalgebr …` and prove the remaining obligations.
-/
theorem hats_mem_jet_algebra (Y : ℂ) : L.Ahat Y ∈ JetMatrixAlgebra P ∧ L.R0 Y ∈ JetMatrixAlgebra P ∧ L.Ahatv Y ∈ JetMatrixAlgebra P ∧ L.R0v Y ∈ JetMatrixAlgebra P := by
  obtain ⟨hp, hpb, hc, hci, hcb, hcbi, hz, hzi, hzb, hzbi, hg, hgi, hn, hns⟩ := level_mem_jet_algebra hL
  have hDr : L.Dr ∈ JetMatrixAlgebra P := Subalgebra.list_prod_mem _ fun x hx => by
    obtain ⟨l, rfl⟩ := List.mem_ofFn.1 hx; exact hc l
  have hDrb : L.Drb ∈ JetMatrixAlgebra P := Subalgebra.list_prod_mem _ fun x hx => by
    obtain ⟨l, rfl⟩ := List.mem_ofFn.1 hx; exact hcb l
  have hT : L.Tprod Y ∈ matSub (JetMatrixAlgebra P) (Fin 2) := Subalgebra.list_prod_mem _ fun x hx => by
    obtain ⟨l, rfl⟩ := List.mem_ofFn.1 (List.mem_reverse.1 hx)
    exact matrix_two_mem_sub _ _ _ _ _ (add_mem (Subalgebra.algebraMap_mem _ _) (hp l)) (neg_mem (hc l)) (hci l)
      (Subalgebra.zero_mem _)
  have hTv : L.Tvprod Y ∈ matSub (JetMatrixAlgebra P) (Fin 2) := Subalgebra.list_prod_mem _ fun x hx => by
    obtain ⟨l, rfl⟩ := List.mem_ofFn.1 (List.mem_reverse.1 hx)
    exact matrix_two_mem_sub _ _ _ _ _ (sub_mem (Subalgebra.algebraMap_mem _ _) (hpb l)) (neg_mem (hcb l)) (hcbi l)
      (Subalgebra.zero_mem _)
  refine ⟨mul_mem hDr (hT 0 0), mul_mem (mul_mem hDrb hg) (add_mem (mul_mem (sub_mem (neg_mem hn)
    (mul_mem (Subalgebra.algebraMap_mem _ _) (mul_mem hzb hgi))) (hT 0 0)) (hT 1 0)),
    mul_mem hDrb (hTv 0 0), mul_mem (mul_mem hDr hg) (add_mem (mul_mem (sub_mem (neg_mem hns)
    (mul_mem (Subalgebra.algebraMap_mem _ _) (mul_mem hz hgi))) (hTv 0 0)) (hTv 1 0))⟩

end Lev

