/- English proof (translation)
Proceed by induction on `s using Finset.induction_on with`. Consider the case `empty => simp [F.actA_zero]`. Consider the case `insert a s ha ih => rw [Finset.sum_insert ha, Finset.sum_insert ha, F.actA_add, ih]`.
-/
theorem actA_finsum {P : M.Par} {ι : Type} (s : Finset ι) (x : ι → A P (DQ P)) (j : M.Ty P → SmQ P.r P.TT) :
    actA P (∑ e ∈ s, x e) j = ∑ e ∈ s, actA P (x e) j := by
  classical
  induction s using Finset.induction_on with
  | empty => simp [F.actA_zero]
  | insert a s ha ih => rw [Finset.sum_insert ha, Finset.sum_insert ha, F.actA_add, ih]

/- English proof (translation)
Proceed by induction on `s using Finset.induction_on with`. Consider the case `empty`. Rewrite using `[Finset.sum_empty, Finset.sum_empty]`. Conclude with `ipA_zero_left g`. Consider the case `insert a s ha ih`.

Rewrite using `[Finset.sum_insert ha, Finset.sum_insert ha]`. Establish `hs : ∀ π, Integrable (fun q => evQ P ((∑ e ∈ s, f e) π) q * conj (evQ P (g π) q)) (mu0 P.r P.TT)`. Introduce `π`. Establish `hint` using `integrable_finset_sum s (fun e he => h e (Finset.mem_insert_of_mem he) π)`. Use `hint.congr (Filter.Eventually.of_forall fun q => ?_)` and prove the remaining obligations.

Simplify using `only [Finset.sum_apply]`. Rewrite using `[MAx2.Jet.evQ_sum, Finset.sum_mul]`. Rewrite using `[ipA_add_left (h a (Finset.mem_insert_self a s)) hs, ih fun e he => h e (Finset.mem_insert_of_mem he)]`.
-/
theorem ipA_sum_left {P : M.Par} {ι : Type} (s : Finset ι) (f : ι → M.Ty P → SmQ P.r P.TT) (g : M.Ty P → SmQ P.r P.TT)
    (h : ∀ e ∈ s, ∀ π, Integrable (fun q => evQ P (f e π) q * conj (evQ P (g π) q)) (mu0 P.r P.TT)) :
    ipA P (∑ e ∈ s, f e) g = ∑ e ∈ s, ipA P (f e) g := by
  classical
  induction s using Finset.induction_on with
  | empty =>
    rw [Finset.sum_empty, Finset.sum_empty]
    exact ipA_zero_left g
  | insert a s ha ih =>
    rw [Finset.sum_insert ha, Finset.sum_insert ha]
    have hs : ∀ π, Integrable (fun q => evQ P ((∑ e ∈ s, f e) π) q * conj (evQ P (g π) q)) (mu0 P.r P.TT) := by
      intro π
      have hint := integrable_finset_sum s (fun e he => h e (Finset.mem_insert_of_mem he) π)
      refine hint.congr (Filter.Eventually.of_forall fun q => ?_)
      simp only [Finset.sum_apply]
      rw [MAx2.Jet.evQ_sum, Finset.sum_mul]
    rw [ipA_add_left (h a (Finset.mem_insert_self a s)) hs, ih fun e he => h e (Finset.mem_insert_of_mem he)]

end

