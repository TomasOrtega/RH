variable {P : M.Par}

/- English proof (translation)
Take `⟨a, ha⟩` from `hx`. Use `⟨fun k q i => wordModuleApply P (io (a k)) U q i, fun Y q i => ?_⟩` and prove the remaining obligations. Establish `e1 : x Y = ∑ k ∈ Finset.range (d + 1), Y ^ k • a k`. Use `ha Y` as an intermediate fact. Simplify using `only [zero_add] at this`.

Conclude with `this`. Establish `e2 : (io (x Y) : SlopeTestRemainingChoices (Fin N) (A P (DQ P))) = ∑ k ∈ Finset.range (d + 1), Y ^ k • io (a k)`. Rewrite using `[e1]`. Unfold `io`. Rewrite using `[map_sum]`.

Use `Finset.sum_congr rfl fun k _ => ?_` and prove the remaining obligations. Use `G.io_smul P (S := Fin N) (Y ^ k) (a k)` as an intermediate fact. Unfold `io at this`. Conclude with `this`. Rewrite using `[e2, G.apply_matrix_sum]`.

Simplify using `only [G.apply_matrix_smul]`. Rewrite using `[Finset.sum_range (fun k => Y ^ k * wordModuleApply P (io (a k)) U q i)]`.
-/
theorem part_poly {N : ℕ} (x : ℂ → A P (DQ P)) (d : ℕ) (hx : G.PolyIn (fun s => x (0 + s)) d)
    (U : Qp P.r P.TT → Iota P N → ℂ) : ∃ α : Fin (d + 1) → Qp P.r P.TT → Iota P N → ℂ,
    ∀ Y q i, wordModuleApply P (io (x Y)) U q i = ∑ k : Fin (d + 1), Y ^ (k : ℕ) * α k q i := by
  obtain ⟨a, ha⟩ := hx
  refine ⟨fun k q i => wordModuleApply P (io (a k)) U q i, fun Y q i => ?_⟩
  have e1 : x Y = ∑ k ∈ Finset.range (d + 1), Y ^ k • a k := by
    have := ha Y; simp only [zero_add] at this; exact this
  have e2 : (io (x Y) : SlopeTestRemainingChoices (Fin N) (A P (DQ P))) = ∑ k ∈ Finset.range (d + 1), Y ^ k • io (a k) := by
    rw [e1]
    unfold io
    rw [map_sum]
    refine Finset.sum_congr rfl fun k _ => ?_
    have := G.io_smul P (S := Fin N) (Y ^ k) (a k)
    unfold io at this
    exact this
  rw [e2, G.apply_matrix_sum]
  simp only [G.apply_matrix_smul]
  rw [Finset.sum_range (fun k => Y ^ k * wordModuleApply P (io (a k)) U q i)]

/- English proof (translation)
Establish `hb : ∀ m : Fin (d + 1), ∃ B, ∀ Y ∈ K, ‖(Lagrange.basis Finset.univ (fun m : Fin (d + 1) => ((m : ℕ) : ℂ)) m).eval ((Y : ℝ) : ℂ)‖ ≤ B`. Introduce `m`. Establish `hc : Continuous fun Y : ℝ => (Lagrange.basis Finset.univ (fun m : Fin (d + 1) => ((m : ℕ) : ℂ)) m).eval ((Y : ℝ) : ℂ)` using `(Polynomial.continuous _).comp Complex.continuous_ofReal`. Take `⟨B, hB⟩` from `hK.exists_bound_of_continuousOn hc.continuousOn`. Conclude with `⟨B, hB⟩`.

Use `choose B hB using hb`. Use `⟨∑ m, |B m|, Finset.sum_nonneg fun m _ => abs_nonneg _, fun c Y hY => ?_⟩` and prove the remaining obligations. Rewrite using `[lagrange d c]`. Combine the equalities or inequalities in the displayed calculation. Use `(norm_sum_le _ _).trans (Finset.sum_le_sum fun m _ => ?_)` and prove the remaining obligations.

Rewrite using `[norm_mul]`. Conclude with `mul_le_mul_of_nonneg_left ((hB m Y hY).trans (le_abs_self _)) (norm_nonneg _)`. Use `_ ≤ ∑ m : Fin (d + 1), ‖∑ k : Fin (d + 1), ((m : ℕ) : ℂ) ^ (k : ℕ) * c k‖ * ∑ m', |B m'| := Finset.sum_le_sum fun m _ => mul_le_mul_of_nonneg_left (Finset.single_le_sum (f := fun m' => |B m'|) (fun _ _ => abs_nonneg _) (Finset.mem_univ m)) (norm_nonneg _)`. Use `_ = _ := by rw [← Finset.sum_mul, mul_comm]`.
-/
theorem poly_bound (d : ℕ) (K : Set ℝ) (hK : IsCompact K) : ∃ Λ : ℝ, 0 ≤ Λ ∧ ∀ (c : Fin (d + 1) → ℂ), ∀ Y ∈ K,
    ‖∑ k : Fin (d + 1), ((Y : ℝ) : ℂ) ^ (k : ℕ) * c k‖ ≤
      Λ * ∑ m : Fin (d + 1), ‖∑ k : Fin (d + 1), ((m : ℕ) : ℂ) ^ (k : ℕ) * c k‖ := by
  have hb : ∀ m : Fin (d + 1), ∃ B, ∀ Y ∈ K,
      ‖(Lagrange.basis Finset.univ (fun m : Fin (d + 1) => ((m : ℕ) : ℂ)) m).eval ((Y : ℝ) : ℂ)‖ ≤ B := by
    intro m
    have hc : Continuous fun Y : ℝ =>
        (Lagrange.basis Finset.univ (fun m : Fin (d + 1) => ((m : ℕ) : ℂ)) m).eval ((Y : ℝ) : ℂ) :=
      (Polynomial.continuous _).comp Complex.continuous_ofReal
    obtain ⟨B, hB⟩ := hK.exists_bound_of_continuousOn hc.continuousOn
    exact ⟨B, hB⟩
  choose B hB using hb
  refine ⟨∑ m, |B m|, Finset.sum_nonneg fun m _ => abs_nonneg _, fun c Y hY => ?_⟩
  rw [lagrange d c]
  calc ‖∑ m : Fin (d + 1), (∑ k : Fin (d + 1), ((m : ℕ) : ℂ) ^ (k : ℕ) * c k) *
        (Lagrange.basis Finset.univ (fun m : Fin (d + 1) => ((m : ℕ) : ℂ)) m).eval ((Y : ℝ) : ℂ)‖
      ≤ ∑ m : Fin (d + 1), ‖∑ k : Fin (d + 1), ((m : ℕ) : ℂ) ^ (k : ℕ) * c k‖ * |B m| := by
        refine (norm_sum_le _ _).trans (Finset.sum_le_sum fun m _ => ?_)
        rw [norm_mul]
        exact mul_le_mul_of_nonneg_left ((hB m Y hY).trans (le_abs_self _)) (norm_nonneg _)
    _ ≤ ∑ m : Fin (d + 1), ‖∑ k : Fin (d + 1), ((m : ℕ) : ℂ) ^ (k : ℕ) * c k‖ * ∑ m', |B m'| :=
        Finset.sum_le_sum fun m _ => mul_le_mul_of_nonneg_left
          (Finset.single_le_sum (f := fun m' => |B m'|) (fun _ _ => abs_nonneg _) (Finset.mem_univ m))
          (norm_nonneg _)
    _ = _ := by rw [← Finset.sum_mul, mul_comm]

end

