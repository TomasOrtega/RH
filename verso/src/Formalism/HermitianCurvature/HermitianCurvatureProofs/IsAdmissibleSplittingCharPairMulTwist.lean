      ∀ q, ‖wordModuleApply P (io (if b then L.Dbi * L.R0 ((m : ℕ) : ℂ) else L.Di * L.Ahat ((m : ℕ) : ℂ)))
        (Xw P l L (ju P j) w) q i‖ * Dabs q ^ (w.length + 1) ≤ C * F q :=
    fun m i => piece_square_integrable hH w hl ((m : ℕ) : ℂ) b i
