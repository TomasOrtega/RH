/- English proof (translation)
Establish `hτy : τ (A.pick y) y ≠ 0` using `hy`. Establish `hτ0 : 0 < A.nsq Λ τ y`. Unfold `WeightedAtlas.nsq`. Conclude with `mul_pos (pow_pos (norm_pos_iff.mpr hτy) 2) (Real.exp_pos _)`. Establish `hs0 : 0 < A.sqn L s y`.

Assume the negation of the conclusion as `hle`. Use `push_neg at hle`. Use `hC y` as an intermediate fact. Use the polynomial consequences of the given equalities and inequalities. Establish `hn : (0 : ℝ) ≤ n` using `Nat.cast_nonneg n`.

Use `⟨?_, ?_, ?_⟩` and prove the remaining obligations. Introduce `hz`. Establish `hz' : ∀ k, s k (A.pick y) y = 0` using `hz`. Establish `: A.sqn L s y = 0`. Unfold `WeightedAtlas.sqn WeightedAtlas.nsq`.

Simplify using `[hz']`. Combine the linear equalities and inequalities to obtain the conclusion. Unfold `psi`. Use `Real.log_nonpos hs0.le (hsq y)` as an intermediate fact. Use the polynomial consequences of the given equalities and inequalities.

Unfold `psi`. Establish `h1 : Real.log (A.nsq Λ τ y) ≤ Real.log C + Real.log (A.sqn L s y)`. Rewrite using `[← Real.log_mul hC0.ne' hs0.ne']`. Conclude with `Real.log_le_log hτ0 (hC y)`. Use `mul_le_mul_of_nonneg_left h1 hn` as an intermediate fact.

Use the polynomial consequences of the given equalities and inequalities.
-/
theorem GlobalTheory.OTY.TwEst.nz_facts {n : ℕ} {Y : Type} [TopologicalSpace Y] [T2Space Y] [SecondCountableTopology Y]
    [MeasurableSpace Y] [BorelSpace Y] {ι La : Type} [AddCommGroup La] (A : WeightedAtlas n Y ι La)
    (L Λ : La) (s : Fin n → ι → Y → ℂ) (τ : ι → Y → ℂ) (C : ℝ) (hC0 : 0 < C)
    (hsq : ∀ y, A.sqn L s y ≤ 1) (hC : ∀ y, A.nsq Λ τ y ≤ C * A.sqn L s y) (y : Y) (hy : y ∈ nz A τ) :
    y ∉ A.zeroSet s ∧ psi A L s y ≤ 0 ∧
      -psi A L s y ≤ (n : ℝ) * (-Real.log (A.nsq Λ τ y)) + (n : ℝ) * Real.log C := by
  have hτy : τ (A.pick y) y ≠ 0 := hy
  have hτ0 : 0 < A.nsq Λ τ y := by
    unfold WeightedAtlas.nsq
    exact mul_pos (pow_pos (norm_pos_iff.mpr hτy) 2) (Real.exp_pos _)
  have hs0 : 0 < A.sqn L s y := by
    by_contra hle
    push_neg at hle
    have := hC y
    nlinarith
  have hn : (0 : ℝ) ≤ n := Nat.cast_nonneg n
  refine ⟨?_, ?_, ?_⟩
  · intro hz
    have hz' : ∀ k, s k (A.pick y) y = 0 := hz
    have : A.sqn L s y = 0 := by
      unfold WeightedAtlas.sqn WeightedAtlas.nsq
      simp [hz']
    linarith
  · unfold psi
    have := Real.log_nonpos hs0.le (hsq y)
    nlinarith
  · unfold psi
    have h1 : Real.log (A.nsq Λ τ y) ≤ Real.log C + Real.log (A.sqn L s y) := by
      rw [← Real.log_mul hC0.ne' hs0.ne']
      exact Real.log_le_log hτ0 (hC y)
    have := mul_le_mul_of_nonneg_left h1 hn
    nlinarith
