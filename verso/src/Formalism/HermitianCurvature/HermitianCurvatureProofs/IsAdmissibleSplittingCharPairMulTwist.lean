section S_R_C4
set_option linter.unusedVariables false

namespace Formalism.FourierDecayAlt.P.MAx3.R

open Finset

noncomputable def resA (s t : Finset ℕ) (a b : ℕ → ℝ) (j : ℕ) : ℝ :=
  -(∏ i ∈ s, (b j - a i)) / (∏ m ∈ t.erase j, (b j - b m))

noncomputable def ratF (s t : Finset ℕ) (a b : ℕ → ℝ) (T : ℝ) : ℝ := (∏ i ∈ s, (T - a i)) / ∏ j ∈ t, (T - b j)

/- English proof (translation)
Take `⟨c0, h⟩` from `partialFrac s t a b hcard hinj`. Use `⟨c0, fun T hT => ?_⟩` and prove the remaining obligations. Rewrite using `[ratF, h T hT, sub_eq_add_neg, ← sum_neg_distrib]`. Use `congr 1`. Use `sum_congr rfl fun j _ => ?_` and prove the remaining obligations.

Rewrite using `[resA, div_div, neg_div, neg_neg]`.
-/
theorem ratF_pf (s t : Finset ℕ) (a b : ℕ → ℝ) (hcard : s.card = t.card + 1) (hinj : Set.InjOn b t) :
    ∃ c0 : ℝ, ∀ T : ℝ, (∀ j ∈ t, T ≠ b j) →
      ratF s t a b T = T + c0 - ∑ j ∈ t, resA s t a b j / (T - b j) := by
  obtain ⟨c0, h⟩ := partialFrac s t a b hcard hinj
  refine ⟨c0, fun T hT => ?_⟩
  rw [ratF, h T hT, sub_eq_add_neg, ← sum_neg_distrib]
  congr 1
  refine sum_congr rfl fun j _ => ?_
  rw [resA, div_div, neg_div, neg_neg]

/- English proof (translation)
Take `⟨c0, hpf⟩` from `ratF_pf s t a b hcard hinj`. Establish `h1` using `hasDerivAt_ratioLin s t a b T ha hb`. Establish `hpfd : HasDerivAt (fun T => T + c0 - ∑ j ∈ t, resA s t a b j / (T - b j)) (1 + ∑ j ∈ t, resA s t a b j / (T - b j) ^ 2) T`. Establish `hj' : ∀ j ∈ t, HasDerivAt (fun T => resA s t a b j / (T - b j)) (-(resA s t a b j / (T - b j) ^ 2)) T`. Introduce `j hj`.

Establish `hne : T - b j ≠ 0` using `sub_ne_zero.2 (hb j hj)`. Use `((hasDerivAt_id T).sub_const (b j)).inv hne` as an intermediate fact. Establish `h2` using `this.const_mul (resA s t a b j)`. Use `(h2.congr_deriv ?_).congr_of_eventuallyEq ?_` and prove the remaining obligations. Simplify using `only [id]`.

Clear the denominators using the available nonvanishing facts. Conclude with `Filter.Eventually.of_forall fun x => by simp [div_eq_mul_inv]`. Establish `hs : HasDerivAt (fun T => ∑ j ∈ t, resA s t a b j / (T - b j)) (∑ j ∈ t, -(resA s t a b j / (T - b j) ^ 2)) T`. Establish `hsum` using `HasDerivAt.sum (u := t) hj'`. Establish `e : (∑ j ∈ t, fun T => resA s t a b j / (T - b j)) = fun T => ∑ j ∈ t, resA s t a b j / (T - b j)`.

Use function extensionality and compare the values at `T`. Simplify using `[Finset.sum_apply]`. Rewrite `hsum` using `[e]`. Conclude with `hsum`. Use `((hasDerivAt_id T).add_const c0).sub hs` as an intermediate fact.

Use `this.congr_deriv ?_` and prove the remaining obligations. Simplify using `[sum_neg_distrib]`. Establish `hopen : IsOpen {x : ℝ | ∀ j ∈ t, x ≠ b j}`. Establish `: {x : ℝ | ∀ j ∈ t, x ≠ b j} = ⋂ j ∈ t, {x | x ≠ b j}` using `by ext; simp`. Rewrite using `[this]`.

Conclude with `isOpen_biInter_finset fun j _ => isOpen_ne`. Establish `heq : (fun T => T + c0 - ∑ j ∈ t, resA s t a b j / (T - b j)) =ᶠ[nhds T] (fun T => (∏ i ∈ s, (T - a i)) / ∏ j ∈ t, (T - b j))` using `by filter_upwards [hopen.mem_nhds hb] with x hx`. Rewrite using `[← ratF, hpf x hx]`. Establish `h3` using `hpfd.congr_of_eventuallyEq heq.symm`. Conclude with `(h3.unique h1).trans rfl`.
-/
theorem ratF_deriv_id (s t : Finset ℕ) (a b : ℕ → ℝ) (hcard : s.card = t.card + 1) (hinj : Set.InjOn b t)
    (T : ℝ) (ha : ∀ i ∈ s, T ≠ a i) (hb : ∀ j ∈ t, T ≠ b j) :
    1 + ∑ j ∈ t, resA s t a b j / (T - b j) ^ 2 =
      ratF s t a b T * (∑ i ∈ s, 1 / (T - a i) - ∑ j ∈ t, 1 / (T - b j)) := by
  obtain ⟨c0, hpf⟩ := ratF_pf s t a b hcard hinj
  have h1 := hasDerivAt_ratioLin s t a b T ha hb
  have hpfd : HasDerivAt (fun T => T + c0 - ∑ j ∈ t, resA s t a b j / (T - b j))
      (1 + ∑ j ∈ t, resA s t a b j / (T - b j) ^ 2) T := by
    have hj' : ∀ j ∈ t, HasDerivAt (fun T => resA s t a b j / (T - b j)) (-(resA s t a b j / (T - b j) ^ 2)) T := by
      intro j hj
      have hne : T - b j ≠ 0 := sub_ne_zero.2 (hb j hj)
      have := ((hasDerivAt_id T).sub_const (b j)).inv hne
      have h2 := this.const_mul (resA s t a b j)
      refine (h2.congr_deriv ?_).congr_of_eventuallyEq ?_
      · simp only [id]; field_simp
      · exact Filter.Eventually.of_forall fun x => by simp [div_eq_mul_inv]
    have hs : HasDerivAt (fun T => ∑ j ∈ t, resA s t a b j / (T - b j))
        (∑ j ∈ t, -(resA s t a b j / (T - b j) ^ 2)) T := by
      have hsum := HasDerivAt.sum (u := t) hj'
      have e : (∑ j ∈ t, fun T => resA s t a b j / (T - b j)) = fun T => ∑ j ∈ t, resA s t a b j / (T - b j) := by
        funext T; simp [Finset.sum_apply]
      rw [e] at hsum; exact hsum
    have := ((hasDerivAt_id T).add_const c0).sub hs
    refine this.congr_deriv ?_
    simp [sum_neg_distrib]
  have hopen : IsOpen {x : ℝ | ∀ j ∈ t, x ≠ b j} := by
    have : {x : ℝ | ∀ j ∈ t, x ≠ b j} = ⋂ j ∈ t, {x | x ≠ b j} := by ext; simp
    rw [this]
    exact isOpen_biInter_finset fun j _ => isOpen_ne
  have heq : (fun T => T + c0 - ∑ j ∈ t, resA s t a b j / (T - b j)) =ᶠ[nhds T]
      (fun T => (∏ i ∈ s, (T - a i)) / ∏ j ∈ t, (T - b j)) := by
    filter_upwards [hopen.mem_nhds hb] with x hx
    rw [← ratF, hpf x hx]
  have h3 := hpfd.congr_of_eventuallyEq heq.symm
  exact (h3.unique h1).trans rfl

/- English proof (translation)
Take `⟨c0, hpf⟩` from `ratF_pf s t a b hcard hinj`. Rewrite using `[hpf Z hZ, hpf Y hY, mul_add, mul_one, mul_sum]`. Establish `: ∀ j ∈ t, resA s t a b j / (Y - b j) - resA s t a b j / (Z - b j) = (Z - Y) * (resA s t a b j / ((Z - b j) * (Y - b j)))` using `fun j hj => by`. Establish `h1 : Z - b j ≠ 0` using `sub_ne_zero.2 (hZ j hj)`. Establish `h2 : Y - b j ≠ 0` using `sub_ne_zero.2 (hY j hj)`.

Clear the denominators using the available nonvanishing facts. Expand and normalize the polynomial expressions, which then agree. Rewrite using `[← sum_congr rfl this, sum_sub_distrib]`. Expand and normalize the polynomial expressions, which then agree.
-/
theorem ratF_two (s t : Finset ℕ) (a b : ℕ → ℝ) (hcard : s.card = t.card + 1) (hinj : Set.InjOn b t)
    (Y Z : ℝ) (hY : ∀ j ∈ t, Y ≠ b j) (hZ : ∀ j ∈ t, Z ≠ b j) :
    ratF s t a b Z - ratF s t a b Y = (Z - Y) * (1 + ∑ j ∈ t, resA s t a b j / ((Z - b j) * (Y - b j))) := by
  obtain ⟨c0, hpf⟩ := ratF_pf s t a b hcard hinj
  rw [hpf Z hZ, hpf Y hY, mul_add, mul_one, mul_sum]
  have : ∀ j ∈ t, resA s t a b j / (Y - b j) - resA s t a b j / (Z - b j) =
      (Z - Y) * (resA s t a b j / ((Z - b j) * (Y - b j))) := fun j hj => by
    have h1 : Z - b j ≠ 0 := sub_ne_zero.2 (hZ j hj)
    have h2 : Y - b j ≠ 0 := sub_ne_zero.2 (hY j hj)
    field_simp
    ring
  rw [← sum_congr rfl this, sum_sub_distrib]
  ring

end Formalism.FourierDecayAlt.P.MAx3.R

