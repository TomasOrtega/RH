/- English proof (translation)
Use `show ∑ π', ((Matrix.scalar (M.Ty P) w * Mx : Matrix (M.Ty P) (M.Ty P) (DQ P).Pr) π π').1 (j π') = w.1 (∑ π', (Mx π π').1 (j π'))`. Rewrite using `[map_sum]`. Use `Finset.sum_congr rfl fun π' _ => ?_` and prove the remaining obligations. Rewrite using `[Matrix.scalar_apply, Matrix.diagonal_mul]`. Both sides reduce to the same expression.
-/
theorem act_sc (w : (DQ P).Pr) (Mx : A P (DQ P)) (j : M.Ty P → SmQ P.r P.TT) (π : M.Ty P) :
    actA P (sc P (DQ P) w * Mx) j π = w.1 (actA P Mx j π) := by
  show ∑ π', ((Matrix.scalar (M.Ty P) w * Mx : Matrix (M.Ty P) (M.Ty P) (DQ P).Pr) π π').1 (j π') =
    w.1 (∑ π', (Mx π π').1 (j π'))
  rw [map_sum]
  refine Finset.sum_congr rfl fun π' _ => ?_
  rw [Matrix.scalar_apply, Matrix.diagonal_mul]
  rfl

/- English proof (translation)
Use `show ∑ π', ((Matrix.diagonal (fun π => algebraMap ℂ (DQ P).Pr (c π)) * Mx : Matrix (M.Ty P) (M.Ty P) (DQ P).Pr) π π').1 (j π') = c π • ∑ π', (Mx π π').1 (j π')`. Rewrite using `[Finset.smul_sum]`. Use `Finset.sum_congr rfl fun π' _ => ?_` and prove the remaining obligations. Rewrite using `[Matrix.diagonal_mul]`. Both sides reduce to the same expression.
-/
theorem act_kap (c : M.Ty P → ℂ) (Mx : A P (DQ P)) (j : M.Ty P → SmQ P.r P.TT) (π : M.Ty P) :
    actA P (kap P (DQ P) c * Mx) j π = c π • actA P Mx j π := by
  show ∑ π', ((Matrix.diagonal (fun π => algebraMap ℂ (DQ P).Pr (c π)) * Mx : Matrix (M.Ty P) (M.Ty P) (DQ P).Pr) π π').1 (j π') =
    c π • ∑ π', (Mx π π').1 (j π')
  rw [Finset.smul_sum]
  refine Finset.sum_congr rfl fun π' _ => ?_
  rw [Matrix.diagonal_mul]
  rfl

def zw : (DQ P).Pr := (DQ P).zP * (DQ P).zbP * (DQ P).ggiP P.TT

/- English proof (translation)
Establish `hu : IsUnit ((anQ P.r P.TT).gg P.TT)` using `(Formalism.FourierDecayAlt.P.analytic_units_hold P.r P.TT hTT).2`. Establish `e0 : evQ P ((zw P).1 h) q = ((coordQ M.vz : SmQ P.r P.TT) : Qp P.r P.TT → ℂ) q * (((coordQ M.vzb : SmQ P.r P.TT) : Qp P.r P.TT → ℂ) q * (((Ring.inverse ((anQ P.r P.TT).gg P.TT) : SmQ P.r P.TT) : Qp P.r P.TT → ℂ) q * (h : Qp P.r P.TT → ℂ) q))` using `rfl`. Rewrite using `[e0, MAx2.Jet.ev_inverse P _ hu]`. Establish `hg` using `gg_apply (r := P.r) (TT := P.TT) q`. Establish `hz : ((coordQ M.vz : SmQ P.r P.TT) : Qp P.r P.TT → ℂ) q = q.1.2` using `coordE_vz q.1`.

Establish `hzb : ((coordQ M.vzb : SmQ P.r P.TT) : Qp P.r P.TT → ℂ) q = conj q.1.2` using `coordE_vzb q.1`. Rewrite `hg` using `[coordE_vz, coordE_vzb]`. Establish `hne` using `gg_ne (r := P.r) (TT := P.TT) q`. Rewrite `hne` using `[gg_apply, coordE_vz, coordE_vzb]`. Use `show _ = ((Complex.normSq q.1.2 / (Complex.normSq q.1.2 - P.TT) : ℝ) : ℂ) * _`.

Rewrite using `[hz, hzb]`. Express the relevant statement in the definitionally equal form `q.1.2 * (conj q.1.2 * ((((ggQ P.r P.TT : SmQ P.r P.TT) : Qp P.r P.TT → ℂ) q)⁻¹ * _)) = _`. Rewrite using `[hg]`. Establish `hmc : q.1.2 * conj q.1.2 = ((Complex.normSq q.1.2 : ℝ) : ℂ)` using `Complex.mul_conj _`. Rewrite `hne` using `[Complex.mul_conj]`.

Establish `e1 : q.1.2 * (conj q.1.2 * ((q.1.2 * conj q.1.2 - (P.TT : ℂ))⁻¹ * (h : Qp P.r P.TT → ℂ) q)) = (q.1.2 * conj q.1.2) * (q.1.2 * conj q.1.2 - (P.TT : ℂ))⁻¹ * (h : Qp P.r P.TT → ℂ) q` using `by ring`. Rewrite using `[e1, hmc]`. Use `push_cast`. Rewrite using `[div_eq_mul_inv]`. Both sides reduce to the same expression.
-/
theorem zw_apply (hTT : 0 ≤ P.TT) (h : SmQ P.r P.TT) (q : Qp P.r P.TT) :
    evQ P ((zw P).1 h) q = ((Wq P q : ℝ) : ℂ) * evQ P h q := by
  have hu : IsUnit ((anQ P.r P.TT).gg P.TT) := (Formalism.FourierDecayAlt.P.analytic_units_hold P.r P.TT hTT).2
  have e0 : evQ P ((zw P).1 h) q = ((coordQ M.vz : SmQ P.r P.TT) : Qp P.r P.TT → ℂ) q *
      (((coordQ M.vzb : SmQ P.r P.TT) : Qp P.r P.TT → ℂ) q *
      (((Ring.inverse ((anQ P.r P.TT).gg P.TT) : SmQ P.r P.TT) : Qp P.r P.TT → ℂ) q * (h : Qp P.r P.TT → ℂ) q)) := rfl
  rw [e0, MAx2.Jet.ev_inverse P _ hu]
  have hg := gg_apply (r := P.r) (TT := P.TT) q
  have hz : ((coordQ M.vz : SmQ P.r P.TT) : Qp P.r P.TT → ℂ) q = q.1.2 := coordE_vz q.1
  have hzb : ((coordQ M.vzb : SmQ P.r P.TT) : Qp P.r P.TT → ℂ) q = conj q.1.2 := coordE_vzb q.1
  rw [coordE_vz, coordE_vzb] at hg
  have hne := gg_ne (r := P.r) (TT := P.TT) q
  rw [gg_apply, coordE_vz, coordE_vzb] at hne
  show _ = ((Complex.normSq q.1.2 / (Complex.normSq q.1.2 - P.TT) : ℝ) : ℂ) * _
  rw [hz, hzb]
  change q.1.2 * (conj q.1.2 * ((((ggQ P.r P.TT : SmQ P.r P.TT) : Qp P.r P.TT → ℂ) q)⁻¹ * _)) = _
  rw [hg]
  have hmc : q.1.2 * conj q.1.2 = ((Complex.normSq q.1.2 : ℝ) : ℂ) := Complex.mul_conj _
  rw [Complex.mul_conj] at hne
  have e1 : q.1.2 * (conj q.1.2 * ((q.1.2 * conj q.1.2 - (P.TT : ℂ))⁻¹ * (h : Qp P.r P.TT → ℂ) q)) =
      (q.1.2 * conj q.1.2) * (q.1.2 * conj q.1.2 - (P.TT : ℂ))⁻¹ * (h : Qp P.r P.TT → ℂ) q := by ring
  rw [e1, hmc]
  push_cast
  rw [div_eq_mul_inv]
  rfl

/- English proof (translation)
Proceed by induction on `n generalizing h with`. Consider the case `zero => show evQ P h q = _`. Simplify using the standard rewrite rules. Consider the case `succ n ih => show evQ P (((zw P) ^ n).1 ((zw P).1 h)) q = _`. Use `ih ((zw P).1 h)` as an intermediate fact.

Rewrite `this` using `[zw_apply P hTT]`. Conclude with `this.trans (by rw [pow_succ]; ring)`.
-/
theorem zw_pow_apply (hTT : 0 ≤ P.TT) (n : ℕ) (h : SmQ P.r P.TT) (q : Qp P.r P.TT) :
    evQ P (((zw P) ^ n).1 h) q = ((Wq P q : ℝ) : ℂ) ^ n * evQ P h q := by
  induction n generalizing h with
  | zero => show evQ P h q = _; simp
  | succ n ih =>
    show evQ P (((zw P) ^ n).1 ((zw P).1 h)) q = _
    have := ih ((zw P).1 h)
    rw [zw_apply P hTT] at this
    exact this.trans (by rw [pow_succ]; ring)

end Eval

end

