theorem diag_vec {R ι : Type*} [Ring R] [Fintype ι] [DecidableEq ι] (d : ι → R) (Nx : Matrix ι ι R) (g : ι → R)
    (e : ι) : ∑ e1, (Matrix.diagonal d * Nx) e e1 * g e1 = d e * ∑ e1, Nx e e1 * g e1 := by
  simp only [Matrix.diagonal_mul, Finset.mul_sum, mul_assoc]

section Model

