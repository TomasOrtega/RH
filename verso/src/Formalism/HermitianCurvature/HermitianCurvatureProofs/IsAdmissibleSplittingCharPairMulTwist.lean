/- English proof (translation)
Establish `hB` using `Bm_mem (l := l) hTT.le hL w`. Establish `hBi` using `Bi_mem (l := l) hTT.le hL w`. Establish `hUS : ∀ b : Wd.SlopeTestRemainingChoices (Fin w.length) (A P (DQ P)), b ∈ UB P L (Fin w.length) → b ∈ G.BlockMatrixAlgebra P (Fin w.length)` using `fun b hb e e' => bounded_sub_base_algebra hTT hL (hb e e')`. Simplify using `only [Finset.mul_sum]`. Rewrite using `[Finset.sum_comm]`.

Establish `key : ∀ k : Iota P N, ∑ x : Iota P N, ptMat P (Bi P l L w) ω (cast h i) (cast h x) * (ptMat P (Bm P l L w) ω (cast h x) (cast h k) * v k) = if i = k then v k else 0`. Introduce `k`. Simplify using `only [← mul_assoc, ← Finset.sum_mul]`. Rewrite using `[show (∑ x : Iota P N, ptMat P (Bi P l L w) ω (cast h i) (cast h x) * ptMat P (Bm P l L w) ω (cast h x) (cast h k)) = ∑ x' : Iota P w.length, ptMat P (Bi P l L w) ω (cast h i) x' * ptMat P (Bm P l L w) ω x' (cast h k) from Fintype.sum_equiv (Equiv.cast h) _ _ (fun x => rfl)]`. Rewrite using `[← ptMat_mul P _ _ (hUS _ hBi) (hUS _ hB), Bi_mul, ptMat_one]`.

Distinguish the cases in `hik : i = k`. Substitute `hik` using the available equality. Simplify using the standard rewrite rules. Rewrite using `[if_neg (fun h' => hik ((cast_inj h).1 h')), if_neg hik, zero_mul]`. Simplify using `only [key]`.

Simplify using the standard rewrite rules.
-/
theorem inv_prop (w : List ℝ) (N : ℕ) (h : Iota P N = Iota P w.length) (ω : Qp P.r P.TT) (v : Iota P N → ℂ)
    (i : Iota P N) :
    ∑ x, ptMat P (Bi P l L w) ω (cast h i) (cast h x) * ∑ k, ptMat P (Bm P l L w) ω (cast h x) (cast h k) * v k =
      v i := by
  classical
  have hB := Bm_mem (l := l) hTT.le hL w
  have hBi := Bi_mem (l := l) hTT.le hL w
  have hUS : ∀ b : Wd.SlopeTestRemainingChoices (Fin w.length) (A P (DQ P)), b ∈ UB P L (Fin w.length) → b ∈ G.BlockMatrixAlgebra P (Fin w.length) :=
    fun b hb e e' => bounded_sub_base_algebra hTT hL (hb e e')
  simp only [Finset.mul_sum]
  rw [Finset.sum_comm]
  have key : ∀ k : Iota P N, ∑ x : Iota P N, ptMat P (Bi P l L w) ω (cast h i) (cast h x) *
      (ptMat P (Bm P l L w) ω (cast h x) (cast h k) * v k) = if i = k then v k else 0 := by
    intro k
    simp only [← mul_assoc, ← Finset.sum_mul]
    rw [show (∑ x : Iota P N, ptMat P (Bi P l L w) ω (cast h i) (cast h x) *
        ptMat P (Bm P l L w) ω (cast h x) (cast h k)) = ∑ x' : Iota P w.length,
