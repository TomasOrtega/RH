theorem kap_comm_DG (f : M.Ty P → ℂ) {x : A P (DQ P)} (hx : x ∈ DG P) : kap P (DQ P) f * x = x * kap P (DQ P) f := by
  obtain ⟨d, rfl⟩ := hx
