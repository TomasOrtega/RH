-/
theorem polynomial_shift_identity {l : ℕ} {L : LevelData (A P (DQ P)) P.r} (hTT : 0 ≤ P.TT) (hL : IsModelLevel P (DQ P) L)
    (w : List ℝ) (X : Qp P.r P.TT → Iota P w.length → ℂ) (hX : ∀ i, (fun q => X q i) ∈ smSub P.r P.TT)
