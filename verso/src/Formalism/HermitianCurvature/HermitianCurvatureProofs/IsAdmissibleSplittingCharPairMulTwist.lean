  rw [plusWord_cons] at h2 h3
  refine ⟨plusWord_slots_nodup w, fun a ha => ?_, ?_⟩
  · exact h2 (liftL a) (List.mem_cons_of_mem _ (List.mem_map_of_mem ha))
  · have := (List.pairwise_cons.1 h3).2
    rw [List.pairwise_map] at this
    exact this

end Cut

