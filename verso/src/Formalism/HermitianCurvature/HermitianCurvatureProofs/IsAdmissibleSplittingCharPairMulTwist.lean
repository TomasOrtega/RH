section S_K_K5

set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace Formalism.FourierDecayAlt.P.MAx3.K

open Formalism.FourierDecayAlt Formalism.FourierDecayAlt.MA Formalism.FourierDecayAlt.R Formalism.FourierDecayAlt.R.LevelData Formalism.FourierDecayAlt.P.RuleGD Formalism.FourierDecayAlt.P.MAx3.H

noncomputable section

variable {P : M.Par} {L : LevelData (A P (DQ P)) P.r} (hL : IsModelLevel P (DQ P) L) (hLaw : (DQ P).Laws P.TT)
include hL

/- English proof (translation)
Take `⟨hp, hc, hci, hcb, hcbi, hz, hzi, hzb, hzbi, hg, hgi, hn⟩` from `levDG hL`. Take `⟨-, hpb, -, -, -, -, -, -, -, -, -, -, -, hns, -⟩` from `hL`. Establish `hpb' : ∀ l, L.pb l ∈ DG P` using `fun l => by rw [hpb]; exact sc_memDG P _`. Establish `hns' : L.nabs ∈ DG P` using `by rw [hns]; exact diag_memDG P _`. Establish `hDr : L.Dr ∈ DG P` using `Subalgebra.list_prod_mem _ fun x hx => by`.

Take `⟨l, rfl⟩` from `List.mem_ofFn.1 hx`. Conclude with `hc l`. Establish `hDrb : L.Drb ∈ DG P` using `Subalgebra.list_prod_mem _ fun x hx => by`. Take `⟨l, rfl⟩` from `List.mem_ofFn.1 hx`. Conclude with `hcb l`.

Establish `hT : L.Tvprod Y ∈ Formalism.FourierDecayAlt.P.MAx2.Jet.matSub (DG P) (Fin 2)` using `Subalgebra.list_prod_mem _ fun x hx => by`. Take `⟨l, rfl⟩` from `List.mem_ofFn.1 (List.mem_reverse.1 hx)`. Conclude with `Formalism.FourierDecayAlt.P.MAx2.Jet.matrix_two_mem_sub _ _ _ _ _ (sub_mem (Subalgebra.algebraMap_mem _ _) (hpb' l)) (neg_mem (hcb l)) (hcbi l) (Subalgebra.zero_mem _)`. Use `⟨mul_mem hDrb (hT 0 0), mul_mem (mul_mem hDr hg) (add_mem (mul_mem (sub_mem (neg_mem hns') (mul_mem (Subalgebra.algebraMap_mem _ _) (mul_mem hz hgi))) (hT 0 0)) (hT 1 0))⟩` and prove the remaining obligations.
-/
theorem hatvDG (Y : ℂ) : L.Ahatv Y ∈ DG P ∧ L.R0v Y ∈ DG P := by
  obtain ⟨hp, hc, hci, hcb, hcbi, hz, hzi, hzb, hzbi, hg, hgi, hn⟩ := levDG hL
  obtain ⟨-, hpb, -, -, -, -, -, -, -, -, -, -, -, hns, -⟩ := hL
  have hpb' : ∀ l, L.pb l ∈ DG P := fun l => by rw [hpb]; exact sc_memDG P _
  have hns' : L.nabs ∈ DG P := by rw [hns]; exact diag_memDG P _
  have hDr : L.Dr ∈ DG P := Subalgebra.list_prod_mem _ fun x hx => by
    obtain ⟨l, rfl⟩ := List.mem_ofFn.1 hx; exact hc l
  have hDrb : L.Drb ∈ DG P := Subalgebra.list_prod_mem _ fun x hx => by
    obtain ⟨l, rfl⟩ := List.mem_ofFn.1 hx; exact hcb l
  have hT : L.Tvprod Y ∈ Formalism.FourierDecayAlt.P.MAx2.Jet.matSub (DG P) (Fin 2) := Subalgebra.list_prod_mem _ fun x hx => by
    obtain ⟨l, rfl⟩ := List.mem_ofFn.1 (List.mem_reverse.1 hx)
    exact Formalism.FourierDecayAlt.P.MAx2.Jet.matrix_two_mem_sub _ _ _ _ _ (sub_mem (Subalgebra.algebraMap_mem _ _) (hpb' l))
      (neg_mem (hcb l)) (hcbi l) (Subalgebra.zero_mem _)
  refine ⟨mul_mem hDrb (hT 0 0), mul_mem (mul_mem hDr hg) (add_mem (mul_mem (sub_mem (neg_mem hns')
    (mul_mem (Subalgebra.algebraMap_mem _ _) (mul_mem hz hgi))) (hT 0 0)) (hT 1 0))⟩

include hLaw

/- English proof (translation)
Take `⟨h1, h2⟩` from `SS_rel hL hLaw i hi`. Establish `hf : ∀ x ∈ L.fns, x * SS P (DQ P) i = SS P (DQ P) i * x` using `fun x hx => (SS_comm_SC P i (fnsSC hL x hx)).symm`. Establish `h` using `Formalism.FourierDecayAlt.P.intertwinerConjugation _ P.r L (SS P (DQ P) i) 0 hf (fun l => (SS_comm_SC P i (pSC hL l).1).symm) (fun l => (SS_comm_SC P i (pSC hL l).2).symm) h1 h2 (fun x _ => by simp) (fun l => by simp) (fun l => by simp) (by simp) (by simp) Y`. Conclude with `⟨h.2.2.1, h.2.2.2.1⟩`.
-/
theorem ruleSSv_SS (i : ℕ) (hi : i ∈ Finset.Icc 1 (P.k - 1)) (Y : ℂ) :
    L.Ahatv Y * (L.Drb * L.Dri * SS P (DQ P) i) = (L.Drb * L.Dri * SS P (DQ P) i) * L.Ahatv (Y - 1) ∧
    L.R0v Y * (L.Drb * L.Dri * SS P (DQ P) i) = (L.Drb * L.Dri * SS P (DQ P) i) * L.R0v (Y - 1) := by
  obtain ⟨h1, h2⟩ := SS_rel hL hLaw i hi
  have hf : ∀ x ∈ L.fns, x * SS P (DQ P) i = SS P (DQ P) i * x := fun x hx => (SS_comm_SC P i (fnsSC hL x hx)).symm
  have h := Formalism.FourierDecayAlt.P.intertwinerConjugation _ P.r L (SS P (DQ P) i) 0 hf (fun l => (SS_comm_SC P i (pSC hL l).1).symm)
    (fun l => (SS_comm_SC P i (pSC hL l).2).symm) h1 h2 (fun x _ => by simp) (fun l => by simp) (fun l => by simp)
    (by simp) (by simp) Y
  exact ⟨h.2.2.1, h.2.2.2.1⟩

/- English proof (translation)
Take `⟨h1, h2⟩` from `SSs_rel hL hLaw i hi`. Establish `hf : ∀ x ∈ L.fns, x * star (SS P (DQ P) i) = star (SS P (DQ P) i) * x` using `fun x hx => (SSs_comm_SC i (fnsSC hL x hx)).symm`. Establish `h` using `Formalism.FourierDecayAlt.P.intertwinerConjugation _ P.r L 0 (star (SS P (DQ P) i)) (fun x _ => by simp) (fun l => by simp) (fun l => by simp) (by simp) (by simp) hf (fun l => (SSs_comm_SC i (pSC hL l).1).symm) (fun l => (SSs_comm_SC i (pSC hL l).2).symm) h1 h2 Y`. Rewrite using `[starSSn_eq hL hLaw]`. Conclude with `⟨h.2.2.2.2.2.2.1, h.2.2.2.2.2.2.2⟩`.
-/
theorem ruleSSv_SSs (i : ℕ) (hi : i ∈ Finset.Icc 1 (P.k - 1)) (Y : ℂ) :
    L.Ahatv Y * star (L.Drb * L.Dri * SS P (DQ P) i) = star (L.Drb * L.Dri * SS P (DQ P) i) * L.Ahatv (Y + 1) ∧
    L.R0v Y * star (L.Drb * L.Dri * SS P (DQ P) i) = star (L.Drb * L.Dri * SS P (DQ P) i) * L.R0v (Y + 1) := by
  obtain ⟨h1, h2⟩ := SSs_rel hL hLaw i hi
  have hf : ∀ x ∈ L.fns, x * star (SS P (DQ P) i) = star (SS P (DQ P) i) * x :=
    fun x hx => (SSs_comm_SC i (fnsSC hL x hx)).symm
  have h := Formalism.FourierDecayAlt.P.intertwinerConjugation _ P.r L 0 (star (SS P (DQ P) i)) (fun x _ => by simp) (fun l => by simp)
    (fun l => by simp) (by simp) (by simp) hf (fun l => (SSs_comm_SC i (pSC hL l).1).symm)
    (fun l => (SSs_comm_SC i (pSC hL l).2).symm) h1 h2 Y
  rw [starSSn_eq hL hLaw]
  exact ⟨h.2.2.2.2.2.2.1, h.2.2.2.2.2.2.2⟩

/- English proof (translation)
Establish `gen : ∀ {x}, x ∈ bddSet P L → x ∈ Submonoid.closure (bddSet P L)` using `fun h => Submonoid.subset_closure h`. Establish `mDD : L.D * L.Dbi ∈ bddSet P L` using `Or.inl (Or.inl (Or.inl (by simp)))`. Establish `mDbD : L.Db * L.Di ∈ bddSet P L` using `Or.inl (Or.inl (Or.inl (by simp)))`. Establish `mζi : L.ζi ∈ bddSet P L` using `Or.inl (Or.inl (Or.inl (by simp)))`. Establish `mζbi : L.ζbi ∈ bddSet P L` using `Or.inl (Or.inl (Or.inl (by simp)))`.

Establish `hdrv : L.Dr * L.Dbi ∈ Submonoid.closure (bddSet P L)`. Rewrite using `[drv_eq]`. Conclude with `Submonoid.mul_mem _ (gen mDD) (gen mζi)`. Establish `hInv` using `fun Y => Formalism.FourierDecayAlt.P.inverseCommutators _ P.r L Y`. Use `hypV_closure (bddSet P L) ?_ ?_ hdrv` and prove the remaining obligations.

Introduce and unpack `b ((((hb | ⟨f, rfl⟩) | ⟨i, hi, rfl⟩) | ⟨i, hi, rfl⟩))`. Simplify using `only [Set.mem_insert_iff, Set.mem_singleton_iff] at hb`. Break down `hb with rfl | rfl | rfl | rfl` into its components or cases. Conclude with `⟨0, fun Y => by rw [add_zero]; exact (hInv Y).2.2.2.2.2.1.symm⟩`. Conclude with `⟨0, fun Y => by rw [add_zero]; exact (hInv Y).2.2.1.symm⟩`.

Conclude with `⟨1, vgen_DD_A L⟩`. Conclude with `⟨-1, vgen_DbD_A L⟩`. Conclude with `⟨0, fun Y => by rw [add_zero]; exact (kap_comm_DG P f (hatvDG hL Y).1).symm⟩`. Conclude with `⟨-1, fun Y => by rw [← sub_eq_add_neg]; exact (ruleSSv_SS hL hLaw i (Finset.mem_Icc.2 (Set.mem_Icc.1 hi)) Y).1⟩`. Conclude with `⟨1, fun Y => (ruleSSv_SSs hL hLaw i (Finset.mem_Icc.2 (Set.mem_Icc.1 hi)) Y).1⟩`.

Introduce and unpack `b ((((hb | ⟨f, rfl⟩) | ⟨i, hi, rfl⟩) | ⟨i, hi, rfl⟩)) Y`. Simplify using `only [Set.mem_insert_iff, Set.mem_singleton_iff] at hb`. Break down `hb with rfl | rfl | rfl | rfl` into its components or cases. Conclude with `⟨0, [], by simp, by rw [add_zero]; simpa using (hInv Y).2.2.2.2.2.2.1.symm⟩`. Use `⟨0, _, ?_, vgen_ζbi_R L Y⟩` and prove the remaining obligations.

Introduce `x hx`. Simplify using `only [List.mem_cons, List.not_mem_nil, or_false] at hx`. Break down `hx with rfl | rfl` into its components or cases. Conclude with `gen mDD`. Conclude with `Submonoid.mul_mem _ (Submonoid.mul_mem _ (gen mζi) (gen mζbi)) (gen mDD)`.

Use `⟨1, [(L.TT, L.D * L.Dbi * (L.Dr * L.Dbi), Y + 1)], ?_, ?_⟩` and prove the remaining obligations. Introduce `x hx`. Simplify using `only [List.mem_cons, List.not_mem_nil, or_false] at hx`. Rewrite using `[hx]`. Conclude with `Submonoid.mul_mem _ (gen mDD) hdrv`.

Rewrite using `[vgen_DD_R]`. Simplify using the standard rewrite rules. Use `⟨-1, [(-L.TT, L.Db * L.Di * (L.Dr * L.Dbi), Y + -1)], ?_, ?_⟩` and prove the remaining obligations. Introduce `x hx`. Simplify using `only [List.mem_cons, List.not_mem_nil, or_false] at hx`.

Rewrite using `[hx]`. Conclude with `Submonoid.mul_mem _ (gen mDbD) hdrv`. Rewrite using `[vgen_DbD_R]`. Simplify using the standard rewrite rules. Conclude with `⟨0, [], by simp, by rw [add_zero]; simpa using (kap_comm_DG P f (hatvDG hL Y).2).symm⟩`.

Conclude with `⟨-1, [], by simp, by rw [← sub_eq_add_neg]; simpa using (ruleSSv_SS hL hLaw i (Finset.mem_Icc.2 (Set.mem_Icc.1 hi)) Y).2⟩`. Conclude with `⟨1, [], by simp, by simpa using (ruleSSv_SSs hL hLaw i (Finset.mem_Icc.2 (Set.mem_Icc.1 hi)) Y).2⟩`.
-/
theorem hypV_model : HypV L (Submonoid.closure (bddSet P L)) := by
  have gen : ∀ {x}, x ∈ bddSet P L → x ∈ Submonoid.closure (bddSet P L) := fun h => Submonoid.subset_closure h
  have mDD : L.D * L.Dbi ∈ bddSet P L := Or.inl (Or.inl (Or.inl (by simp)))
  have mDbD : L.Db * L.Di ∈ bddSet P L := Or.inl (Or.inl (Or.inl (by simp)))
  have mζi : L.ζi ∈ bddSet P L := Or.inl (Or.inl (Or.inl (by simp)))
  have mζbi : L.ζbi ∈ bddSet P L := Or.inl (Or.inl (Or.inl (by simp)))
  have hdrv : L.Dr * L.Dbi ∈ Submonoid.closure (bddSet P L) := by
    rw [drv_eq]; exact Submonoid.mul_mem _ (gen mDD) (gen mζi)
  have hInv := fun Y => Formalism.FourierDecayAlt.P.inverseCommutators _ P.r L Y
  refine hypV_closure (bddSet P L) ?_ ?_ hdrv
  · rintro b ((((hb | ⟨f, rfl⟩) | ⟨i, hi, rfl⟩) | ⟨i, hi, rfl⟩))
    · simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hb
      rcases hb with rfl | rfl | rfl | rfl
      · exact ⟨0, fun Y => by rw [add_zero]; exact (hInv Y).2.2.2.2.2.1.symm⟩
      · exact ⟨0, fun Y => by rw [add_zero]; exact (hInv Y).2.2.1.symm⟩
      · exact ⟨1, vgen_DD_A L⟩
      · exact ⟨-1, vgen_DbD_A L⟩
    · exact ⟨0, fun Y => by rw [add_zero]; exact (kap_comm_DG P f (hatvDG hL Y).1).symm⟩
    · exact ⟨-1, fun Y => by rw [← sub_eq_add_neg]; exact (ruleSSv_SS hL hLaw i (Finset.mem_Icc.2 (Set.mem_Icc.1 hi)) Y).1⟩
    · exact ⟨1, fun Y => (ruleSSv_SSs hL hLaw i (Finset.mem_Icc.2 (Set.mem_Icc.1 hi)) Y).1⟩
  · rintro b ((((hb | ⟨f, rfl⟩) | ⟨i, hi, rfl⟩) | ⟨i, hi, rfl⟩)) Y
    · simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hb
      rcases hb with rfl | rfl | rfl | rfl
      · exact ⟨0, [], by simp, by rw [add_zero]; simpa using (hInv Y).2.2.2.2.2.2.1.symm⟩
      · refine ⟨0, _, ?_, vgen_ζbi_R L Y⟩
        intro x hx
        simp only [List.mem_cons, List.not_mem_nil, or_false] at hx
        rcases hx with rfl | rfl
        · exact gen mDD
        · exact Submonoid.mul_mem _ (Submonoid.mul_mem _ (gen mζi) (gen mζbi)) (gen mDD)
      · refine ⟨1, [(L.TT, L.D * L.Dbi * (L.Dr * L.Dbi), Y + 1)], ?_, ?_⟩
        · intro x hx
          simp only [List.mem_cons, List.not_mem_nil, or_false] at hx
          rw [hx]; exact Submonoid.mul_mem _ (gen mDD) hdrv
        · rw [vgen_DD_R]; simp
      · refine ⟨-1, [(-L.TT, L.Db * L.Di * (L.Dr * L.Dbi), Y + -1)], ?_, ?_⟩
        · intro x hx
          simp only [List.mem_cons, List.not_mem_nil, or_false] at hx
          rw [hx]; exact Submonoid.mul_mem _ (gen mDbD) hdrv
        · rw [vgen_DbD_R]; simp
    · exact ⟨0, [], by simp, by rw [add_zero]; simpa using (kap_comm_DG P f (hatvDG hL Y).2).symm⟩
    · exact ⟨-1, [], by simp, by rw [← sub_eq_add_neg]; simpa using
        (ruleSSv_SS hL hLaw i (Finset.mem_Icc.2 (Set.mem_Icc.1 hi)) Y).2⟩
    · exact ⟨1, [], by simp, by simpa using (ruleSSv_SSs hL hLaw i (Finset.mem_Icc.2 (Set.mem_Icc.1 hi)) Y).2⟩

end

