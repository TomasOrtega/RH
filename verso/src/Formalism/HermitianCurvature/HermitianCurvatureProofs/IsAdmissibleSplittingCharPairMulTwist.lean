variable {P : M.Par} {L : LevelData (A P (DQ P)) P.r} {S : Type} [Fintype S] [DecidableEq S]

/- English proof (translation)
Take `⟨ts, h1, e⟩` from `hE`. Conclude with `⟨ts, fun t ht => ⟨(h1 t ht).1, fun Y hY => (h1 t ht).2 Y (h hY)⟩, e⟩`.
-/
theorem rep_mono {G G' : Set ℂ} (h : G' ⊆ G) {E : ℂ → SlopeTestRemainingChoices S (A P (DQ P))} (hE : Rep L G E) : Rep L G' E := by
  obtain ⟨ts, h1, e⟩ := hE
  exact ⟨ts, fun t ht => ⟨(h1 t ht).1, fun Y hY => (h1 t ht).2 Y (h hY)⟩, e⟩

/- English proof (translation)
Proceed by induction on `s using Finset.induction_on with`. Consider the case `empty => exact ⟨[], by simp, fun Y => by simp⟩`. Consider the case `insert a s ha ih`. Establish `e : (fun Y => ∑ i ∈ insert a s, E i Y) = fun Y => E a Y + ∑ i ∈ s, E i Y`. Use function extensionality and compare the values at `fun Y => Finset.sum_insert ha`.

Rewrite using `[e]`. Conclude with `rep_add (h a (Finset.mem_insert_self a s)) (ih fun i hi => h i (Finset.mem_insert_of_mem hi))`.
-/
theorem rep_finsum {ι : Type} (s : Finset ι) {G : Set ℂ} (E : ι → ℂ → SlopeTestRemainingChoices S (A P (DQ P)))
    (h : ∀ i ∈ s, Rep L G (E i)) : Rep L G (fun Y => ∑ i ∈ s, E i Y) := by
  classical
  induction s using Finset.induction_on with
  | empty => exact ⟨[], by simp, fun Y => by simp⟩
  | insert a s ha ih =>
    have e : (fun Y => ∑ i ∈ insert a s, E i Y) = fun Y => E a Y + ∑ i ∈ s, E i Y :=
      funext fun Y => Finset.sum_insert ha
    rw [e]
    exact rep_add (h a (Finset.mem_insert_self a s)) (ih fun i hi => h i (Finset.mem_insert_of_mem hi))

def Gbase (P : M.Par) : Set ℂ := {Y | ∀ j ∈ Finset.Icc 1 (P.k - 1), ∀ π : M.Ty P, Y + (M.rho P π j : ℂ) ≠ 0}

def Gw (P : M.Par) (v : List (Letter ℂ S)) : Set ℂ := {Y | Y ∈ Gbase P ∧ ∀ a ∈ v, Y ≠ a.pt}

variable (hL : IsModelLevel P (DQ P) L) (hLaw : (DQ P).Laws P.TT)
include hL hLaw

/- English proof (translation)
Establish `hDrDG : L.Drb * L.Dri ∈ DG P`. Take `⟨-, d2, d3, -⟩` from `DrSC hL`. Take `⟨w, hw⟩` from `Subring.mul_mem _ d2 d3`. Rewrite using `[← hw]`. Conclude with `sc_memDG P w`.

Establish `hgen : L.Drb * L.Dri * SS P (DQ P) j ∈ bddSet P L` using `Or.inl (Or.inr ⟨j, Set.mem_Icc.2 (Finset.mem_Icc.1 hj), rfl⟩)`. Establish `hDD : L.D * L.Dbi ∈ bddSet P L` using `Or.inl (Or.inl (Or.inl (by simp)))`. Establish `e1 : L.ζ * L.ζbi * (kap P (DQ P) f * SS P (DQ P) j) = L.D * L.Dbi * (kap P (DQ P) f * (L.Drb * L.Dri * SS P (DQ P) j))`. Rewrite using `[ζζbi_eq hL hLaw, mul_assoc (L.D * L.Dbi), ← mul_assoc (L.Drb * L.Dri), ← kap_comm_DG P _ hDrDG]`. Simplify using `only [mul_assoc]`.

Rewrite using `[e1]`. Conclude with `mul_mem (gen_BA hL hLaw hDD) (mul_mem (kap_BA hL hLaw _) (gen_BA hL hLaw hgen))`.
-/
theorem KSS_BA (f : M.Ty P → ℂ) (j : ℕ) (hj : j ∈ Finset.Icc 1 (P.k - 1)) :
    L.ζ * L.ζbi * (kap P (DQ P) f * SS P (DQ P) j) ∈ BA L := by
  have hDrDG : L.Drb * L.Dri ∈ DG P := by
    obtain ⟨-, d2, d3, -⟩ := DrSC hL
    obtain ⟨w, hw⟩ := Subring.mul_mem _ d2 d3
    rw [← hw]; exact sc_memDG P w
  have hgen : L.Drb * L.Dri * SS P (DQ P) j ∈ bddSet P L :=
    Or.inl (Or.inr ⟨j, Set.mem_Icc.2 (Finset.mem_Icc.1 hj), rfl⟩)
  have hDD : L.D * L.Dbi ∈ bddSet P L := Or.inl (Or.inl (Or.inl (by simp)))
  have e1 : L.ζ * L.ζbi * (kap P (DQ P) f * SS P (DQ P) j) =
      L.D * L.Dbi * (kap P (DQ P) f * (L.Drb * L.Dri * SS P (DQ P) j)) := by
    rw [ζζbi_eq hL hLaw, mul_assoc (L.D * L.Dbi), ← mul_assoc (L.Drb * L.Dri), ← kap_comm_DG P _ hDrDG]
    simp only [mul_assoc]
  rw [e1]
  exact mul_mem (gen_BA hL hLaw hDD) (mul_mem (kap_BA hL hLaw _) (gen_BA hL hLaw hgen))

/- English proof (translation)
Take `⟨-, -, -, -, -, -, hz, -, -, hzbi, -⟩` from `id hL`. Establish `e : ∀ Y, eeA P (DQ P) Y = ∑ j ∈ Finset.Icc 1 (P.k - 1), ∑ π : M.Ty P, (Y + (M.rho P π j : ℂ))⁻¹ • (L.ζ * L.ζbi * (kap P (DQ P) (Pi.single π 1) * SS P (DQ P) j))`. Introduce `Y`. Use `show zA P (DQ P) * zbiA P (DQ P) * _ = _`. Rewrite using `[← hz, ← hzbi, Finset.mul_sum]`.

Use `Finset.sum_congr rfl fun j _ => ?_` and prove the remaining obligations. Establish `hk : kap P (DQ P) (fun π => (Y + (M.rho P π j : ℂ))⁻¹) = ∑ π : M.Ty P, (Y + (M.rho P π j : ℂ))⁻¹ • kap P (DQ P) (Pi.single π 1)`. Establish `hf : (fun π => (Y + (M.rho P π j : ℂ))⁻¹) = ∑ π : M.Ty P, (Y + (M.rho P π j : ℂ))⁻¹ • Pi.single π (1 : ℂ)`. Use function extensionality and compare the values at `π'`. Simplify using `[Finset.sum_apply, Pi.single_apply]`.

Rewrite using `[hf, map_sum]`. Conclude with `Finset.sum_congr rfl fun π _ => map_smul _ _ _`. Rewrite using `[hk, Finset.sum_mul, Finset.mul_sum]`. Use `Finset.sum_congr rfl fun π _ => ?_` and prove the remaining obligations. Rewrite using `[smul_mul_assoc, mul_smul_comm]`.

Establish `e2 : (fun Y => (io (eeA P (DQ P) Y) : SlopeTestRemainingChoices S (A P (DQ P)))) = fun Y => ∑ j ∈ Finset.Icc 1 (P.k - 1), ∑ π ∈ (Finset.univ : Finset (M.Ty P)), (Y + (M.rho P π j : ℂ))⁻¹ • (io (L.ζ * L.ζbi * (kap P (DQ P) (Pi.single π 1) * SS P (DQ P) j)) : SlopeTestRemainingChoi …`. Use function extensionality and compare the values at `Y`. Rewrite using `[e]`. Unfold `io`. Rewrite using `[map_sum]`.

Use `Finset.sum_congr rfl fun j _ => ?_` and prove the remaining obligations. Rewrite using `[map_sum]`. Use `Finset.sum_congr rfl fun π _ => ?_` and prove the remaining obligations. Use `G.io_smul P (S := S) (Y + (M.rho P π j : ℂ))⁻¹ (L.ζ * L.ζbi * (kap P (DQ P) (Pi.single π 1) * SS P (DQ P) j))` as an intermediate fact. Unfold `io at this`.

Conclude with `this`. Rewrite using `[e2]`. Use `rep_finsum _ _ fun j hj => rep_finsum _ _ fun π _ => rep_smul _ (fun Y hY => ?_) (rep_const (io_B hL hLaw (KSS_BA hL hLaw _ j hj)))` and prove the remaining obligations. Conclude with `(continuousAt_id.add continuousAt_const).inv₀ (hY j hj π)`.
-/
theorem eeA_rep : Rep L (Gbase P) (fun Y => (io (eeA P (DQ P) Y) : SlopeTestRemainingChoices S (A P (DQ P)))) := by
  obtain ⟨-, -, -, -, -, -, hz, -, -, hzbi, -⟩ := id hL
  have e : ∀ Y, eeA P (DQ P) Y = ∑ j ∈ Finset.Icc 1 (P.k - 1), ∑ π : M.Ty P,
      (Y + (M.rho P π j : ℂ))⁻¹ • (L.ζ * L.ζbi * (kap P (DQ P) (Pi.single π 1) * SS P (DQ P) j)) := by
    intro Y
    show zA P (DQ P) * zbiA P (DQ P) * _ = _
    rw [← hz, ← hzbi, Finset.mul_sum]
    refine Finset.sum_congr rfl fun j _ => ?_
    have hk : kap P (DQ P) (fun π => (Y + (M.rho P π j : ℂ))⁻¹) =
        ∑ π : M.Ty P, (Y + (M.rho P π j : ℂ))⁻¹ • kap P (DQ P) (Pi.single π 1) := by
      have hf : (fun π => (Y + (M.rho P π j : ℂ))⁻¹) = ∑ π : M.Ty P, (Y + (M.rho P π j : ℂ))⁻¹ • Pi.single π (1 : ℂ) := by
        funext π'
        simp [Finset.sum_apply, Pi.single_apply]
      rw [hf, map_sum]
      exact Finset.sum_congr rfl fun π _ => map_smul _ _ _
    rw [hk, Finset.sum_mul, Finset.mul_sum]
    refine Finset.sum_congr rfl fun π _ => ?_
    rw [smul_mul_assoc, mul_smul_comm]
  have e2 : (fun Y => (io (eeA P (DQ P) Y) : SlopeTestRemainingChoices S (A P (DQ P)))) = fun Y => ∑ j ∈ Finset.Icc 1 (P.k - 1),
      ∑ π ∈ (Finset.univ : Finset (M.Ty P)), (Y + (M.rho P π j : ℂ))⁻¹ •
        (io (L.ζ * L.ζbi * (kap P (DQ P) (Pi.single π 1) * SS P (DQ P) j)) : SlopeTestRemainingChoices S (A P (DQ P))) := by
    funext Y
    rw [e]
    unfold io
    rw [map_sum]
    refine Finset.sum_congr rfl fun j _ => ?_
    rw [map_sum]
    refine Finset.sum_congr rfl fun π _ => ?_
    have := G.io_smul P (S := S) (Y + (M.rho P π j : ℂ))⁻¹ (L.ζ * L.ζbi * (kap P (DQ P) (Pi.single π 1) * SS P (DQ P) j))
    unfold io at this
    exact this
  rw [e2]
  refine rep_finsum _ _ fun j hj => rep_finsum _ _ fun π _ => rep_smul _ (fun Y hY => ?_)
    (rep_const (io_B hL hLaw (KSS_BA hL hLaw _ j hj)))
  exact (continuousAt_id.add continuousAt_const).inv₀ (hY j hj π)

end

