section InsLast

variable {A : Type} [Ring A] {N : ℕ}

/- English proof (translation)
Establish `key : (∀ b, b ≠ Fin.last N → Fin.snoc (α` using `fun _ => Fin 2) e c b = Fin.snoc (α := fun _ => Fin 2) e' c' b) ↔ e = e' := by`. Prove the components needed by the constructor for the conclusion. Introduce `h`. Use function extensionality and compare the values at `k`. Use `h k.castSucc (Fin.castSucc_lt_last k).ne` as an intermediate fact.

Simplify using `using this`. Introduce and unpack `rfl b hb`. Proceed by induction on `b using Fin.lastCases with`. Consider the case `last => exact absurd rfl hb`. Consider the case `cast k => simp`.

Simplify using `only [eU, Matrix.of_apply, Fin.snoc_last]`. Distinguish the cases in `h : c = i ∧ c' = j ∧ e = e'`. Rewrite using `[if_pos h, if_pos ⟨h.1, h.2.1, key.2 h.2.2⟩]`. Rewrite using `[if_neg h, if_neg (fun h' => h ⟨h'.1, h'.2.1, key.1 h'.2.2⟩)]`.
-/
theorem eU_last_snoc (i j : Fin 2) (e e' : Ix (Fin N)) (c c' : Fin 2) :
    (eU (Fin.last N) i j : SlopeTestRemainingChoices (Fin (N + 1)) A) (Fin.snoc (α := fun _ => Fin 2) e c) (Fin.snoc (α := fun _ => Fin 2) e' c') =
      if c = i ∧ c' = j ∧ e = e' then 1 else 0 := by
  have key : (∀ b, b ≠ Fin.last N → Fin.snoc (α := fun _ => Fin 2) e c b = Fin.snoc (α := fun _ => Fin 2) e' c' b) ↔ e = e' := by
    constructor
    · intro h
      funext k
      have := h k.castSucc (Fin.castSucc_lt_last k).ne
      simpa using this
    · rintro rfl b hb
      induction b using Fin.lastCases with
      | last => exact absurd rfl hb
      | cast k => simp
  simp only [eU, Matrix.of_apply, Fin.snoc_last]
  by_cases h : c = i ∧ c' = j ∧ e = e'
  · rw [if_pos h, if_pos ⟨h.1, h.2.1, key.2 h.2.2⟩]
  · rw [if_neg h, if_neg (fun h' => h ⟨h'.1, h'.2.1, key.1 h'.2.2⟩)]

/- English proof (translation)
Unfold `ins`. Simplify using `only [Matrix.sum_apply, Matrix.mul_apply, Matrix.map_apply]`. Simplify using `only [sum_snoc, eU_last_snoc, embM_snoc, ite_mul, one_mul, zero_mul]`. Rewrite using `[Finset.sum_eq_single c (fun i _ hi => Finset.sum_eq_zero fun j _ => Finset.sum_eq_zero fun e1 _ => Finset.sum_eq_zero fun b _ => if_neg (fun h => hi h.1.symm)) (by simp)]`. Rewrite using `[Finset.sum_eq_single c' (fun j _ hj => Finset.sum_eq_zero fun e1 _ => Finset.sum_eq_zero fun b _ => by`.

Distinguish the cases in `h1 : c = c ∧ b = j ∧ e = e1`. Rewrite using `[if_pos h1, if_neg (fun h2 => hj (h1.2.1.symm.trans h2))]`. Rewrite using `[if_neg h1]) (by simp)]`. Rewrite using `[Finset.sum_eq_single e (fun e1 _ he => Finset.sum_eq_zero fun b _ => if_neg (fun h => he h.2.2.symm)) (by simp)]`. Rewrite using `[Finset.sum_eq_single c' (fun b _ hb => if_neg (fun h => hb h.2.1)) (by simp)]`.

Simplify using the standard rewrite rules.
-/
theorem ins_last_apply (M : M2 (SlopeTestRemainingChoices (Fin N) A)) (e e' : Ix (Fin N)) (c c' : Fin 2) :
    ins (Fin.last N) (M.map embM) (Fin.snoc (α := fun _ => Fin 2) e c) (Fin.snoc (α := fun _ => Fin 2) e' c') = M c c' e e' := by
  unfold ins
  simp only [Matrix.sum_apply, Matrix.mul_apply, Matrix.map_apply]
  simp only [sum_snoc, eU_last_snoc, embM_snoc, ite_mul, one_mul, zero_mul]
  rw [Finset.sum_eq_single c (fun i _ hi => Finset.sum_eq_zero fun j _ => Finset.sum_eq_zero fun e1 _ =>
    Finset.sum_eq_zero fun b _ => if_neg (fun h => hi h.1.symm)) (by simp)]
  rw [Finset.sum_eq_single c' (fun j _ hj => Finset.sum_eq_zero fun e1 _ => Finset.sum_eq_zero fun b _ => by
      by_cases h1 : c = c ∧ b = j ∧ e = e1
      · rw [if_pos h1, if_neg (fun h2 => hj (h1.2.1.symm.trans h2))]
      · rw [if_neg h1]) (by simp)]
  rw [Finset.sum_eq_single e (fun e1 _ he => Finset.sum_eq_zero fun b _ => if_neg (fun h => he h.2.2.symm)) (by simp)]
  rw [Finset.sum_eq_single c' (fun b _ hb => if_neg (fun h => hb h.2.1)) (by simp)]
  simp

end InsLast

end

