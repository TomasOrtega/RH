theorem polyIn_mono {f : ℂ → R} {d d' : ℕ} (h : PolyIn f d) (hd : d ≤ d') : PolyIn f d' := by
  obtain ⟨a, ha⟩ := h
  refine ⟨fun k => if k ≤ d then a k else 0, fun s => ?_⟩
