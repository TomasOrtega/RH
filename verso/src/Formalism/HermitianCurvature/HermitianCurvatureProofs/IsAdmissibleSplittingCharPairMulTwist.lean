      Matrix.smul_apply, G.GpD, mul_assoc] using h) φ hφ
  simp only [sc, Matrix.scalar_apply, Matrix.mul_diagonal, Matrix.sum_apply, Matrix.diagonal_mul, Matrix.smul_apply]
