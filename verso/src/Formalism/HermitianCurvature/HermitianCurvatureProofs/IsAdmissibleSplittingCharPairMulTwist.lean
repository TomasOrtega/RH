theorem partialFrac (s t : Finset ℕ) (a b : ℕ → ℝ) (hcard : s.card = t.card + 1) (hinj : Set.InjOn b t) :
    ∃ c0 : ℝ, ∀ T : ℝ, (∀ j ∈ t, T ≠ b j) →
      (∏ i ∈ s, (T - a i)) / (∏ j ∈ t, (T - b j)) =
        T + c0 + ∑ j ∈ t, (∏ i ∈ s, (b j - a i)) / ((∏ m ∈ t.erase j, (b j - b m)) * (T - b j)) := by
  classical
  set Pp : ℝ[X] := ∏ i ∈ s, (X - C (a i)) with hPp
