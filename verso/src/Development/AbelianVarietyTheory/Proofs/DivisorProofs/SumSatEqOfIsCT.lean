theorem Eig.card : ∀ (u : List (Letter E)) (f : Vec u) (B : Multiset ℂˣ), Eig v u f B → B.card = wsize u
  | [], _, B, H => by rw [show B = 0 from H]; rfl
  | x :: u, f, _, ⟨C, B', h1, h2, h3⟩ => by
    rw [h3, Multiset.card_add, h1.2.2.1, Eig.card u f.2 B' h2]
    simp [wsize]

