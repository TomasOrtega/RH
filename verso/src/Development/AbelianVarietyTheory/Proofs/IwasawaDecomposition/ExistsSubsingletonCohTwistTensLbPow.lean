/- English proof (translation)
Introduce `k _ Y f hf A N hA hN G _ B`. Use `letI := algebraΓOfHom f`. Use `(isProper_and_exists_isAmpleLB_of_isProjOver hf).1` as an intermediate fact. Establish `H (m : Fin B) : ∃ q : ℕ, ∀ n ≥ q, ∀ p, 0 < p → Subsingleton (coh (twist (twist G (lbPow N m)) (lbPow A n)) p)`. Use `isFiniteQC_twist (F := G) (isLB_lbPow hN m)` as an intermediate fact.

Use the proof step `eventually_atTop.1 (hA.eventually_subsingleton_coh_twist (f := f) (fun _ => rfl) _)`. Use `choose q hq using H`. Take `⟨Q, hQ⟩` from `Finite.exists_le q`. Use `⟨Q, fun j m hj hm p hp => ?_⟩` and prove the remaining obligations. Use `hq ⟨m, hm⟩ j ((hQ _).trans hj) p hp` as an intermediate fact.

Take `⟨e⟩` from `nonempty_twist_twist_iso_of_cls_eq G (isLB_lbPow hN m) (isLB_lbPow hA.isLB j) (isLB_tens (isLB_lbPow hA.isLB j) (isLB_lbPow hN m)) (by`. Rewrite using `[cls_tens (isLB_lbPow hA.isLB j) (isLB_lbPow hN m), add_comm])`. Conclude with `(cohOn.mapIso k ⊤ p e).symm.injective.subsingleton`.
-/
theorem exists_subsingleton_coh_twist_tens_lbPow : ∀ (k : Type) [Field k] {Y : Scheme.{0}} (f : Y ⟶ Sp k), IsProjOver f → ∀ (A N : LB Y), IsAmpleLB A → N.IsLB → ∀ (G : Y.Modules) [IsFiniteQC G] (B : ℕ), ∃ j₁ : ℕ, ∀ j m : ℕ, j₁ ≤ j → m < B → ∀ p, 0 < p → Subsingleton (coh (twist G (tens (lbPow A j) (lbPow N m))) p) := by
  intro k _ Y f hf A N hA hN G _ B
  letI := algebraΓOfHom f
  have := (isProper_and_exists_isAmpleLB_of_isProjOver hf).1
  have H (m : Fin B) : ∃ q : ℕ, ∀ n ≥ q, ∀ p, 0 < p →
      Subsingleton (coh (twist (twist G (lbPow N m)) (lbPow A n)) p) :=
    have := isFiniteQC_twist (F := G) (isLB_lbPow hN m)
    eventually_atTop.1 (hA.eventually_subsingleton_coh_twist (f := f) (fun _ => rfl) _)
  choose q hq using H
  obtain ⟨Q, hQ⟩ := Finite.exists_le q
  refine ⟨Q, fun j m hj hm p hp => ?_⟩
  have := hq ⟨m, hm⟩ j ((hQ _).trans hj) p hp
  obtain ⟨e⟩ := nonempty_twist_twist_iso_of_cls_eq G (isLB_lbPow hN m)
    (isLB_lbPow hA.isLB j) (isLB_tens (isLB_lbPow hA.isLB j) (isLB_lbPow hN m)) (by
      rw [cls_tens (isLB_lbPow hA.isLB j) (isLB_lbPow hN m), add_comm])
  exact (cohOn.mapIso k ⊤ p e).symm.injective.subsingleton

end GlobalTheory
