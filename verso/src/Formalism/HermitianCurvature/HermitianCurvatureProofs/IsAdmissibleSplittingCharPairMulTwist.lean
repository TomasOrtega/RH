theorem euler_one (v : M.Var P.r) : eulerQ (TT := P.TT) v (1 : SmQ P.r P.TT) = 0 := MAx1.ev_one hL v

/- English proof (translation)
Proceed by induction on `s using Finset.induction_on with`. Consider the case `empty => simp [euler_one hL]`. Consider the case `insert a s ha ih`. Rewrite using `[Finset.prod_insert ha, euler_mul, ih, h a, Finset.filter_insert]`. Distinguish the cases in `hc : c a`.

Rewrite using `[if_pos hc, if_pos hc, Finset.card_insert_of_notMem (fun h' => ha (Finset.mem_filter.1 h').1)]`. Use `push_cast`. Rewrite using `[add_smul, one_smul, mul_smul_comm]`. Normalize the expressions using the abelian group laws. Rewrite using `[if_neg hc, if_neg hc, zero_mul, zero_add, mul_smul_comm]`.
-/
theorem ev_prod_gen (v : M.Var P.r) (f : Fin P.r → SmQ P.r P.TT) (c : Fin P.r → Prop) [DecidablePred c]
    (h : ∀ m, eulerQ v (f m) = if c m then f m else 0) (s : Finset (Fin P.r)) :
    eulerQ v (∏ m ∈ s, f m) = (((s.filter c).card : ℕ) : ℂ) • ∏ m ∈ s, f m := by
  classical
  induction s using Finset.induction_on with
  | empty => simp [euler_one hL]
  | insert a s ha ih =>
    rw [Finset.prod_insert ha, euler_mul, ih, h a, Finset.filter_insert]
    by_cases hc : c a
    · rw [if_pos hc, if_pos hc, Finset.card_insert_of_notMem (fun h' => ha (Finset.mem_filter.1 h').1)]
      push_cast
      rw [add_smul, one_smul, mul_smul_comm]
      abel
    · rw [if_neg hc, if_neg hc, zero_mul, zero_add, mul_smul_comm]

/- English proof (translation)
Rewrite using `[cc, euler_mul, euler_coord, euler_coord]`. Distinguish the cases in `h1 : v = M.vc m`. Substitute `h1` using the available equality. Simplify using `only [if_true, MAx1.vc_vcb m m, if_false, true_or]`. Expand and normalize the polynomial expressions, which then agree.

Distinguish the cases in `h2 : v = M.vcb m`. Substitute `h2` using the available equality. Simplify using `only [(MAx1.vc_vcb m m).symm, if_true, if_false, or_true]`. Expand and normalize the polynomial expressions, which then agree. Simplify using `only [h1, h2, if_false, or_self]`.

Expand and normalize the polynomial expressions, which then agree.
-/
theorem ev_cc (v : M.Var P.r) (m : Fin P.r) : eulerQ v (cc P m) =
    if v = M.vc m ∨ v = M.vcb m then cc P m else 0 := by
  rw [cc, euler_mul, euler_coord, euler_coord]
  by_cases h1 : v = M.vc m
  · subst h1
    simp only [if_true, MAx1.vc_vcb m m, if_false, true_or]; ring
  · by_cases h2 : v = M.vcb m
    · subst h2
      simp only [(MAx1.vc_vcb m m).symm, if_true, if_false, or_true]; ring
    · simp only [h1, h2, if_false, or_self]; ring

/- English proof (translation)
Establish `hg : eulerQ (M.vc l) (ggQ P.r P.TT) = 0` using `MAx1.euler_gamma_vanish hL _ (MAx1.vc_vz l) (MAx1.vc_vzb l)`. Establish `hc : (Finset.univ.filter fun m => M.vc l = M.vc m ∨ M.vc l = M.vcb m) = {l}`. Use extensionality with `m`. Simplify using `[MAx1.vc_inj, MAx1.vc_vcb, eq_comm]`. Rewrite using `[GQ_eq, euler_mul, ev_prod_gen hL (M.vc l) (cc P) (fun m => M.vc l = M.vc m ∨ M.vc l = M.vcb m) (ev_cc hL _) Finset.univ, hg, hc, Finset.card_singleton]`.

Simplify using the standard rewrite rules.
-/
theorem ev_GQ_c (l : Fin P.r) : eulerQ (M.vc l) (MAx2.Jet.GQ P) = MAx2.Jet.GQ P := by
  classical
  have hg : eulerQ (M.vc l) (ggQ P.r P.TT) = 0 := MAx1.euler_gamma_vanish hL _ (MAx1.vc_vz l) (MAx1.vc_vzb l)
  have hc : (Finset.univ.filter fun m => M.vc l = M.vc m ∨ M.vc l = M.vcb m) = {l} := by
    ext m; simp [MAx1.vc_inj, MAx1.vc_vcb, eq_comm]
  rw [GQ_eq, euler_mul, ev_prod_gen hL (M.vc l) (cc P) (fun m => M.vc l = M.vc m ∨ M.vc l = M.vcb m)
    (ev_cc hL _) Finset.univ, hg, hc, Finset.card_singleton]
