open Formalism.FourierDecayAlt Formalism.FourierDecayAlt.MA Formalism.FourierDecayAlt.R Formalism.FourierDecayAlt.P.MAx1.An Formalism.FourierDecayAlt.P.MAx3.H Formalism.FourierDecayAlt.P.MAx3.G Formalism.FourierDecayAlt.Wd
  Formalism.FourierDecayAlt.Fr MeasureTheory
open scoped ComplexConjugate

noncomputable section

variable {P : M.Par}

/- English proof (translation)
Rewrite using `[← Fintype.sum_prod_type']`. Conclude with `Fintype.sum_equiv (iotaEquiv P n) _ _ fun i => rfl`.
-/
theorem sum_iota_real {n : ℕ} (F : Ix (Fin n) → M.Ty P → ℝ) :
    ∑ i : Iota P n, F (ixOf P n i).1 (ixOf P n i).2 = ∑ e, ∑ π, F e π := by
  rw [← Fintype.sum_prod_type']
  exact Fintype.sum_equiv (iotaEquiv P n) _ _ fun i => rfl

/- English proof (translation)
The claim follows from `Fintype.sum_equiv (Equiv.cast (iota_len P N Y)) _ _ fun _ => rfl`.
-/
theorem sum_cast {N : ℕ} (Y : Fin N → ℝ) (F : Iota P (List.ofFn Y).length → ℝ) :
    ∑ i : Iota P N, F (cast (iota_len P N Y) i) = ∑ i, F i :=
  Fintype.sum_equiv (Equiv.cast (iota_len P N Y)) _ _ fun _ => rfl

/- English proof (translation)
Use function extensionality and compare the values at `ω a`. Use `show evQ P (chiJ P j c ε a) ω = _`. Rewrite using `[chiJ_eq]`. Use `show evQ P (MAx2.Jet.Phi P (chi c ε) 0 * j a) ω = _`. Rewrite using `[MAx2.Jet.evQ_mul, MAx2.Jet.ev_Phi P (smoothLog_chi c ε), log_derivative_zero _ _ (Gq_pos P ω)]`.

Both sides reduce to the same expression.
-/
theorem ju_chiJ (j : M.Ty P → SmQ P.r P.TT) (c : LE.Cut) (ε : ℝ) :
    ju P (chiJ P j c ε) = LE.mulF (baseQ P) (c.sc ε 1) (ju P j) := by
  funext ω a
  show evQ P (chiJ P j c ε a) ω = _
  rw [chiJ_eq]
  show evQ P (MAx2.Jet.Phi P (chi c ε) 0 * j a) ω = _
  rw [MAx2.Jet.evQ_mul, MAx2.Jet.ev_Phi P (smoothLog_chi c ε), log_derivative_zero _ _ (Gq_pos P ω)]
  rfl

/- English proof (translation)
Unfold `ip0`. Rewrite using `[show ((∫ q, f q ∂mu0 P.r P.TT : ℝ) : ℂ) = ∫ q, ((f q : ℝ) : ℂ) ∂mu0 P.r P.TT from integral_ofReal.symm]`. Conclude with `integral_congr_ae (Filter.Eventually.of_forall fun q => hgh q)`.
-/
theorem inner_real_of_pointwise (f : Qp P.r P.TT → ℝ) (g h : SmQ P.r P.TT) (hgh : ∀ q, evQ P g q * conj (evQ P h q) = (f q : ℂ)) :
    ip0 g h = ((∫ q, f q ∂mu0 P.r P.TT : ℝ) : ℂ) := by
  unfold ip0
  rw [show ((∫ q, f q ∂mu0 P.r P.TT : ℝ) : ℂ) = ∫ q, ((f q : ℝ) : ℂ) ∂mu0 P.r P.TT from integral_ofReal.symm]
  exact integral_congr_ae (Filter.Eventually.of_forall fun q => hgh q)

variable {L : LevelData (A P (DQ P)) P.r} (hTTp : 0 < P.TT) (hL : IsModelLevel P (DQ P) L) (hLaw : (DQ P).Laws P.TT)
include hTTp hL hLaw

/- English proof (translation)
Rewrite using `[d_g_sum hTTp hL hLaw cs0 g e]`. Use `inner_real_of_pointwise _ _ _ fun q => ?_` and prove the remaining obligations. Rewrite using `[act_dg hTTp hL hLaw, mul_assoc, Complex.mul_conj, ← Complex.ofReal_pow]`. Establish `hc : cs0 e π = ((cs0 e π).re : ℂ)` using `Complex.ext (by simp) (by simp [hcs e π])`. Rewrite using `[hc, Complex.normSq_eq_norm_sq]`.

Use `push_cast`. Simplify using `only [Complex.ofReal_re]`.
-/
theorem lhs_term {n : ℕ} (cs0 : Ix (Fin n) → M.Ty P → ℂ) (hcs : ∀ e π, (cs0 e π).im = 0)
    (g : Ix (Fin n) → A P (DQ P)) (f : M.Ty P → SmQ P.r P.TT) (e : Ix (Fin n)) (π : M.Ty P) :
    ip0 (actA P (∑ e', ((wt L : SlopeTestRemainingChoices (Fin n) (A P (DQ P))) ^ n *
        Matrix.diagonal (fun e => kap P (DQ P) (cs0 e))) e e' * g e') f π) (actA P (g e) f π) =
      ((∫ q, Wq P q ^ n * (cs0 e π).re * ‖evQ P (actA P (g e) f π) q‖ ^ 2 ∂mu0 P.r P.TT : ℝ) : ℂ) := by
  rw [d_g_sum hTTp hL hLaw cs0 g e]
  refine inner_real_of_pointwise _ _ _ fun q => ?_
  rw [act_dg hTTp hL hLaw, mul_assoc, Complex.mul_conj, ← Complex.ofReal_pow]
  have hc : cs0 e π = ((cs0 e π).re : ℂ) := Complex.ext (by simp) (by simp [hcs e π])
  rw [hc, Complex.normSq_eq_norm_sq]
  push_cast
  simp only [Complex.ofReal_re]

end

end Formalism.FourierDecayAlt.P.MAx3.PG

end S_PG_PG8

section S_PG_PG9

set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace Formalism.FourierDecayAlt.P

open Formalism.FourierDecayAlt Formalism.FourierDecayAlt.MA Formalism.FourierDecayAlt.R Formalism.FourierDecayAlt.Wd Formalism.FourierDecayAlt.Fr MeasureTheory Formalism.FourierDecayAlt.P.MAx3.PG

/- English proof (translation)
Introduce `P l L j lam α β Lb c Ntot hH N Y hN hB ε hε`. Take `⟨⟨hOK, hl1, hlk, hML, hu, hu', hαβ, hcut⟩, hD, hA, hE, hN1, -⟩` from `id hH`. Establish `hTTp : 0 < P.TT` using `mul_pos hOK.T_pos hOK.T'_pos`. Establish `hLaw` using `analytic_laws P.r P.TT hTTp.le`. Establish `hcw : M.CutWord P l (wordP (List.ofFn Y))` using `MAx3.F.cutWord_of hH c (List.ofFn Y) hB (by simpa using hN)`.

Take `⟨L', hL', -, -, hFC⟩` from `model_frame_analytic P hOK l hl1 hlk`. Establish `hLL` using `MAx3.F.level_unique P (DQ P) L' L hL' hML`. Substitute `hLL` using the available equality. Establish `hFCw` using `hFC (Fin (List.ofFn Y).length) (wordP (List.ofFn Y)) hcw`. Establish `hS` using `sites_admissible P (DQ P) hLaw l`.

Establish `hFr : ∀ w' : List ℝ, M.CutWord P l (wordP w') → IsFrame L' (ofWord L' (startM P (DQ P) l) (wordP w'))` using `fun w' h => (hFC _ _ h).1`. Use `set cs0 : Ix (Fin (List.ofFn Y).length) → M.Ty P → ℂ := fun e π => cs (M.x0 P l π) (M.qC P) (wordP (List.ofFn Y)) e with hcs0`. Establish `hcs : ∀ e π, (cs0 e π).im = 0` using `fun e π => (hFCw.2.2.2 e π).2`. Establish `hXw` using `MAx3.F.Xw_eq hML hS hFr (chiJ P j c ε) (List.ofFn Y) hcw`. Take `⟨𝒳, h𝒳, hX𝒳⟩` from `MAx3.I4.Xw_rep hML hLaw l (chiJ P j c ε) (List.ofFn Y)`.

