noncomputable section

variable {P : M.Par} {L : LevelData (A P (DQ P)) P.r} (hTTp : 0 < P.TT) (hL : IsModelLevel P (DQ P) L)
  (hLaw : (DQ P).Laws P.TT)
include hTTp hL hLaw

/- English proof (translation)
Establish `h` using `WDD hTTp hL hLaw`. Take `⟨hD, hDi, hDb, hDbi, -⟩` from `fnP_D hL`. Establish `hW : IsFnP (L.ζ * L.ζb * L.GGi)` using `isFnP_mul (isFnP_mul (fns_fnP hL (m_ζ L)) (fns_fnP hL (m_ζb L))) (fns_fnP hL (m_GGi L))`. Combine the equalities or inequalities in the displayed calculation. Rewrite using `[Di_D, Dbi_Db, mul_one, mul_one]`.

Use `_ = L.ζ * L.ζb * L.GGi * (L.Di * L.Dbi) * (L.D * L.Db) := by`. Rewrite using `[mul_assoc (L.Di) L.D, ← mul_assoc L.D, isFnP_comm hD hDbi]`. Simplify using `only [mul_assoc]`. Use `_ = L.D * L.Db * G.Gs P (-1) := by rw [h, isFnP_comm (isFnP_Gs (-1)) (isFnP_mul hD hDb)]`.
-/
theorem W_eq : L.ζ * L.ζb * L.GGi = L.D * L.Db * G.Gs P (-1) := by
  have h := WDD hTTp hL hLaw
  obtain ⟨hD, hDi, hDb, hDbi, -⟩ := fnP_D hL
  have hW : IsFnP (L.ζ * L.ζb * L.GGi) :=
    isFnP_mul (isFnP_mul (fns_fnP hL (m_ζ L)) (fns_fnP hL (m_ζb L))) (fns_fnP hL (m_GGi L))
  calc L.ζ * L.ζb * L.GGi = L.ζ * L.ζb * L.GGi * ((L.Di * L.D) * (L.Dbi * L.Db)) := by
        rw [Di_D, Dbi_Db, mul_one, mul_one]
    _ = L.ζ * L.ζb * L.GGi * (L.Di * L.Dbi) * (L.D * L.Db) := by
        rw [mul_assoc (L.Di) L.D, ← mul_assoc L.D, isFnP_comm hD hDbi]; simp only [mul_assoc]
    _ = L.D * L.Db * G.Gs P (-1) := by rw [h, isFnP_comm (isFnP_Gs (-1)) (isFnP_mul hD hDb)]

/- English proof (translation)
Break down `hX with ⟨y, rfl⟩ | ⟨y, rfl⟩` into its components or cases. Use `⟨L.Ahatv (y + 1), Or.inl ⟨_, rfl⟩, ?_⟩` and prove the remaining obligations. Establish `h` using `(Formalism.FourierDecayAlt.P.MAx3.L.conj_hatv hTTp.le hL (-1) y).1`. Rewrite `h` using `[neg_neg]`. Establish `e : y - ((-1 : ℝ) : ℂ) = y + 1` using `by push_cast; ring`.

Rewrite `h` using `[e]`. Rewrite using `[← h, ← mul_assoc, ← mul_assoc, show G.Gs P (-1) * G.Gs P 1 = 1 by simpa using G.Gs_mul_neg P (-1), one_mul]`. Use `⟨L.R0v (y + 1), Or.inr ⟨_, rfl⟩, ?_⟩` and prove the remaining obligations. Establish `h` using `(Formalism.FourierDecayAlt.P.MAx3.L.conj_hatv hTTp.le hL (-1) y).2`. Rewrite `h` using `[neg_neg]`.

Establish `e : y - ((-1 : ℝ) : ℂ) = y + 1` using `by push_cast; ring`. Rewrite `h` using `[e]`. Rewrite using `[← h, ← mul_assoc, ← mul_assoc, show G.Gs P (-1) * G.Gs P 1 = 1 by simpa using G.Gs_mul_neg P (-1), one_mul]`.
-/
theorem hatv_Gs {X : A P (DQ P)} (hX : X ∈ minusHats L) : ∃ X', X' ∈ minusHats L ∧ X * G.Gs P (-1) = G.Gs P (-1) * X' := by
  rcases hX with ⟨y, rfl⟩ | ⟨y, rfl⟩
  · refine ⟨L.Ahatv (y + 1), Or.inl ⟨_, rfl⟩, ?_⟩
    have h := (Formalism.FourierDecayAlt.P.MAx3.L.conj_hatv hTTp.le hL (-1) y).1
    rw [neg_neg] at h
    have e : y - ((-1 : ℝ) : ℂ) = y + 1 := by push_cast; ring
    rw [e] at h
    rw [← h, ← mul_assoc, ← mul_assoc, show G.Gs P (-1) * G.Gs P 1 = 1 by simpa using G.Gs_mul_neg P (-1), one_mul]
  · refine ⟨L.R0v (y + 1), Or.inr ⟨_, rfl⟩, ?_⟩
    have h := (Formalism.FourierDecayAlt.P.MAx3.L.conj_hatv hTTp.le hL (-1) y).2
    rw [neg_neg] at h
    have e : y - ((-1 : ℝ) : ℂ) = y + 1 := by push_cast; ring
    rw [e] at h
    rw [← h, ← mul_assoc, ← mul_assoc, show G.Gs P (-1) * G.Gs P 1 = 1 by simpa using G.Gs_mul_neg P (-1), one_mul]

/- English proof (translation)
Proceed by induction on `m generalizing X with`. Consider the case `zero => exact ⟨X, hX, by simp⟩`. Consider the case `succ m ih`. Take `⟨X1, h1, e1⟩` from `hatv_Gs hTTp hL hLaw hX`. Take `⟨X2, h2, e2⟩` from `ih h1`.

Use `⟨X2, h2, ?_⟩` and prove the remaining obligations. Rewrite using `[pow_succ', ← mul_assoc, e1, mul_assoc, e2, ← mul_assoc]`.
-/
theorem hatv_Gspow {X : A P (DQ P)} (hX : X ∈ minusHats L) (m : ℕ) :
    ∃ X', X' ∈ minusHats L ∧ X * G.Gs P (-1) ^ m = G.Gs P (-1) ^ m * X' := by
  induction m generalizing X with
  | zero => exact ⟨X, hX, by simp⟩
  | succ m ih =>
    obtain ⟨X1, h1, e1⟩ := hatv_Gs hTTp hL hLaw hX
    obtain ⟨X2, h2, e2⟩ := ih h1
    refine ⟨X2, h2, ?_⟩
    rw [pow_succ', ← mul_assoc, e1, mul_assoc, e2, ← mul_assoc]

def MSG (L : LevelData (A P (DQ P)) P.r) (n k m : ℕ) : Submodule ℂ (A P (DQ P)) :=
  Submodule.span ℂ {x | ∃ β X, β ∈ Formalism.FourierDecayAlt.P.MAx3.I4.SB L ∧ X ∈ minusHats L ∧
    x = β * (L.D ^ n * L.Dbi ^ k) * G.Gs P (-1) ^ m * X}

/- English proof (translation)
Establish `h` using `hatv_past (hypV_model hL hLaw) hX hβ n k`. Rewrite using `[← mul_assoc]`. Use `span_mul_right h ?_` and prove the remaining obligations. Introduce `x hx`. Take `⟨β', X', hβ', hX', rfl⟩` from `hx`.

Take `⟨X'', h'', e⟩` from `hatv_Gspow hTTp hL hLaw hX' m`. Rewrite using `[mul_assoc, e, ← mul_assoc]`. Conclude with `Submodule.subset_span ⟨β', X'', hβ', h'', rfl⟩`. Use `where span_mul_right {T : Set (A P (DQ P))} {M : Submodule ℂ (A P (DQ P))} {x : A P (DQ P)} (hx : x ∈ Submodule.span ℂ T) (h : ∀ y ∈ T, y * G.Gs P (-1) ^ m ∈ M) : x * G.Gs P (-1) ^ m ∈ M := by`. Proceed by induction on `hx using Submodule.span_induction with`.

Consider the case `mem y hy => exact h y hy`. Consider the case `zero => simp`. Consider the case `add a b _ _ h1 h2 => rw [add_mul]`. Conclude with `M.add_mem h1 h2`. Consider the case `smul c a _ h1 => rw [smul_mul_assoc]`.

Conclude with `M.smul_mem c h1`.
-/
theorem hatv_past_G {X : A P (DQ P)} (hX : X ∈ minusHats L) {β : A P (DQ P)} (hβ : β ∈ Formalism.FourierDecayAlt.P.MAx3.I4.SB L) (n k m : ℕ) :
    X * (β * (L.D ^ n * L.Dbi ^ k) * G.Gs P (-1) ^ m) ∈ MSG L n k m := by
  have h := hatv_past (hypV_model hL hLaw) hX hβ n k
  rw [← mul_assoc]
  refine span_mul_right h ?_
  · intro x hx
    obtain ⟨β', X', hβ', hX', rfl⟩ := hx
    obtain ⟨X'', h'', e⟩ := hatv_Gspow hTTp hL hLaw hX' m
    rw [mul_assoc, e, ← mul_assoc]
    exact Submodule.subset_span ⟨β', X'', hβ', h'', rfl⟩
where
  span_mul_right {T : Set (A P (DQ P))} {M : Submodule ℂ (A P (DQ P))} {x : A P (DQ P)} (hx : x ∈ Submodule.span ℂ T)
      (h : ∀ y ∈ T, y * G.Gs P (-1) ^ m ∈ M) : x * G.Gs P (-1) ^ m ∈ M := by
    induction hx using Submodule.span_induction with
    | mem y hy => exact h y hy
    | zero => simp
    | add a b _ _ h1 h2 => rw [add_mul]; exact M.add_mem h1 h2
    | smul c a _ h1 => rw [smul_mul_assoc]; exact M.smul_mem c h1

end

end Formalism.FourierDecayAlt.P.MAx3.AB

end S_AB_AB2

section S_AB_AB3

set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace Formalism.FourierDecayAlt.P.MAx3.AB

open Formalism.FourierDecayAlt Formalism.FourierDecayAlt.MA Formalism.FourierDecayAlt.R Formalism.FourierDecayAlt.R.LevelData Formalism.FourierDecayAlt.P.RuleGD Formalism.FourierDecayAlt.P.MAx3.H Formalism.FourierDecayAlt.P.MAx3.K
open Formalism.FourierDecayAlt.P.MAx3.Z Formalism.FourierDecayAlt.P.MAx3.AD

noncomputable section

variable {P : M.Par} {L : LevelData (A P (DQ P)) P.r} (hTTp : 0 < P.TT) (hL : IsModelLevel P (DQ P) L)
  (hLaw : (DQ P).Laws P.TT)
include hTTp hL hLaw

/- English proof (translation)
Break down `hX with hX | hX` into its components or cases. Conclude with `Or.inl (Or.inr hX)`. Conclude with `Or.inr hX`.
-/
theorem minus_sub_hat {X : A P (DQ P)} (hX : X ∈ minusHats L) : X ∈ hatSet P L := by
  rcases hX with hX | hX
  · exact Or.inl (Or.inr hX)
  · exact Or.inr hX

/- English proof (translation)
Take `⟨hD, hDi, hDb, hDbi, -⟩` from `fnP_D hL`. Establish `hDD : IsFnP (L.D ^ n * L.Dbi ^ k)` using `isFnP_mul (isFnP_pow hD n) (isFnP_pow hDbi k)`. Establish `hGm : IsFnP (G.Gs P (-1) ^ m)` using `isFnP_pow (isFnP_Gs (-1)) m`. Establish `hDiN : IsFnP (L.Di ^ N)` using `isFnP_pow hDi N`. Proceed by induction on `hz using Submodule.span_induction with`.

Consider the case `mem x hx`. Take `⟨β, X, hβ, hX, rfl⟩` from `hx`. Establish `e : L.Di ^ N * Ph P ψ * (β * (L.D ^ n * L.Dbi ^ k) * G.Gs P (-1) ^ m * X * H.prod) = G.Gs P (-1) ^ m * (Ph P ψ * (β * (L.Di ^ N * (L.D ^ n * L.Dbi ^ k))) * (X :: H).prod)`. Establish `c1 : L.Di ^ N * Ph P ψ = Ph P ψ * L.Di ^ N` using `isFnP_comm hDiN (isFnP_Ph ψ)`. Establish `c2 : L.Di ^ N * β = β * L.Di ^ N` using `(SB_comm_fnP hL hLaw hβ hDiN).symm`.

Establish `c3 : L.D ^ n * L.Dbi ^ k * G.Gs P (-1) ^ m = G.Gs P (-1) ^ m * (L.D ^ n * L.Dbi ^ k)` using `isFnP_comm hDD hGm`. Establish `c4 : L.Di ^ N * G.Gs P (-1) ^ m = G.Gs P (-1) ^ m * L.Di ^ N` using `isFnP_comm hDiN hGm`. Establish `c5 : β * G.Gs P (-1) ^ m = G.Gs P (-1) ^ m * β` using `SB_comm_fnP hL hLaw hβ hGm`. Establish `c6 : Ph P ψ * G.Gs P (-1) ^ m = G.Gs P (-1) ^ m * Ph P ψ` using `isFnP_comm (isFnP_Ph ψ) hGm`. Rewrite using `[List.prod_cons]`.

Combine the equalities or inequalities in the displayed calculation. Rewrite using `[c1]`. Simplify using `only [mul_assoc]`. Use `_ = Ph P ψ * β * (L.Di ^ N * (G.Gs P (-1) ^ m * (L.D ^ n * L.Dbi ^ k))) * (X * H.prod) := by`. Rewrite using `[c2, c3]`.

Simplify using `only [mul_assoc]`. Use `_ = Ph P ψ * (β * G.Gs P (-1) ^ m) * (L.Di ^ N * (L.D ^ n * L.Dbi ^ k)) * (X * H.prod) := by`. Rewrite using `[← mul_assoc (L.Di ^ N), c4]`. Simplify using `only [mul_assoc]`. Use `_ = (Ph P ψ * G.Gs P (-1) ^ m) * β * (L.Di ^ N * (L.D ^ n * L.Dbi ^ k)) * (X * H.prod) := by`.

Rewrite using `[c5]`. Simplify using `only [mul_assoc]`. Use `_ = _ := by rw [c6]; simp only [mul_assoc]`. Rewrite using `[e]`. Use `Gspow_memZ hTTp hL hLaw m (Submodule.subset_span ⟨ψ, _, X :: H, hψ, Submonoid.mul_mem _ hβ hγ, ?_, by simp, rfl⟩)` and prove the remaining obligations.

Introduce `h hh`. Break down `List.mem_cons.1 hh with rfl | hh` into its components or cases. Conclude with `minus_sub_hat hTTp hL hLaw hX`. Conclude with `hH h hh`. Consider the case `zero => simp`.

Consider the case `add a b _ _ h1 h2 => rw [add_mul, mul_add]`. Conclude with `Submodule.add_mem _ h1 h2`. Consider the case `smul c a _ h1 => rw [smul_mul_assoc, mul_smul_comm]`. Conclude with `Submodule.smul_mem _ c h1`.
-/
theorem MSG_Z {N n k m : ℕ} (hγ : L.Di ^ N * (L.D ^ n * L.Dbi ^ k) ∈ Formalism.FourierDecayAlt.P.MAx3.I4.SB L) {ψ : ℝ → ℝ} (hψ : admitted ψ)
    {H : List (A P (DQ P))} (hH : ∀ h ∈ H, h ∈ hatSet P L) {z : A P (DQ P)} (hz : z ∈ MSG L n k m) :
    L.Di ^ N * Ph P ψ * (z * H.prod) ∈ Z P L (H.length + 1) := by
  obtain ⟨hD, hDi, hDb, hDbi, -⟩ := fnP_D hL
  have hDD : IsFnP (L.D ^ n * L.Dbi ^ k) := isFnP_mul (isFnP_pow hD n) (isFnP_pow hDbi k)
  have hGm : IsFnP (G.Gs P (-1) ^ m) := isFnP_pow (isFnP_Gs (-1)) m
  have hDiN : IsFnP (L.Di ^ N) := isFnP_pow hDi N
  induction hz using Submodule.span_induction with
  | mem x hx =>
    obtain ⟨β, X, hβ, hX, rfl⟩ := hx
    have e : L.Di ^ N * Ph P ψ * (β * (L.D ^ n * L.Dbi ^ k) * G.Gs P (-1) ^ m * X * H.prod) =
        G.Gs P (-1) ^ m * (Ph P ψ * (β * (L.Di ^ N * (L.D ^ n * L.Dbi ^ k))) * (X :: H).prod) := by
      have c1 : L.Di ^ N * Ph P ψ = Ph P ψ * L.Di ^ N := isFnP_comm hDiN (isFnP_Ph ψ)
      have c2 : L.Di ^ N * β = β * L.Di ^ N := (SB_comm_fnP hL hLaw hβ hDiN).symm
      have c3 : L.D ^ n * L.Dbi ^ k * G.Gs P (-1) ^ m = G.Gs P (-1) ^ m * (L.D ^ n * L.Dbi ^ k) := isFnP_comm hDD hGm
      have c4 : L.Di ^ N * G.Gs P (-1) ^ m = G.Gs P (-1) ^ m * L.Di ^ N := isFnP_comm hDiN hGm
      have c5 : β * G.Gs P (-1) ^ m = G.Gs P (-1) ^ m * β := SB_comm_fnP hL hLaw hβ hGm
      have c6 : Ph P ψ * G.Gs P (-1) ^ m = G.Gs P (-1) ^ m * Ph P ψ := isFnP_comm (isFnP_Ph ψ) hGm
      rw [List.prod_cons]
      calc L.Di ^ N * Ph P ψ * (β * (L.D ^ n * L.Dbi ^ k) * G.Gs P (-1) ^ m * X * H.prod)
          = Ph P ψ * (L.Di ^ N * β) * ((L.D ^ n * L.Dbi ^ k) * G.Gs P (-1) ^ m) * (X * H.prod) := by
            rw [c1]; simp only [mul_assoc]
        _ = Ph P ψ * β * (L.Di ^ N * (G.Gs P (-1) ^ m * (L.D ^ n * L.Dbi ^ k))) * (X * H.prod) := by
            rw [c2, c3]; simp only [mul_assoc]
        _ = Ph P ψ * (β * G.Gs P (-1) ^ m) * (L.Di ^ N * (L.D ^ n * L.Dbi ^ k)) * (X * H.prod) := by
            rw [← mul_assoc (L.Di ^ N), c4]; simp only [mul_assoc]
        _ = (Ph P ψ * G.Gs P (-1) ^ m) * β * (L.Di ^ N * (L.D ^ n * L.Dbi ^ k)) * (X * H.prod) := by
            rw [c5]; simp only [mul_assoc]
        _ = _ := by rw [c6]; simp only [mul_assoc]
    rw [e]
    refine Gspow_memZ hTTp hL hLaw m (Submodule.subset_span ⟨ψ, _, X :: H, hψ, Submonoid.mul_mem _ hβ hγ, ?_, by simp, rfl⟩)
    intro h hh
    rcases List.mem_cons.1 hh with rfl | hh
    · exact minus_sub_hat hTTp hL hLaw hX
    · exact hH h hh
  | zero => simp
  | add a b _ _ h1 h2 => rw [add_mul, mul_add]; exact Submodule.add_mem _ h1 h2
  | smul c a _ h1 => rw [smul_mul_assoc, mul_smul_comm]; exact Submodule.smul_mem _ c h1

end

end Formalism.FourierDecayAlt.P.MAx3.AB

end S_AB_AB3

section S_AB_AB4

set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace Formalism.FourierDecayAlt.P.MAx3.AB

open Formalism.FourierDecayAlt Formalism.FourierDecayAlt.MA Formalism.FourierDecayAlt.R Formalism.FourierDecayAlt.R.LevelData Formalism.FourierDecayAlt.P.RuleGD Formalism.FourierDecayAlt.P.MAx3.H Formalism.FourierDecayAlt.P.MAx3.K
open Formalism.FourierDecayAlt.P.MAx3.Z Formalism.FourierDecayAlt.P.MAx3.AD

noncomputable section

variable {P : M.Par}

abbrev FnS (P : M.Par) : Subring (A P (DQ P)) := Subring.closure {x | IsFnP x}

instance : CommRing (FnS P) := Subring.closureCommRingOfComm fun x hx y hy => isFnP_comm hx hy

def f (x : A P (DQ P)) (hx : IsFnP x) : FnS P := ⟨x, Subring.subset_closure hx⟩

variable {L : LevelData (A P (DQ P)) P.r} (hTTp : 0 < P.TT) (hL : IsModelLevel P (DQ P) L)
  (hLaw : (DQ P).Laws P.TT)
include hTTp hL hLaw

/- English proof (translation)
Take `⟨hD, hDi, hDb, hDbi, -⟩` from `fnP_D hL`. Conclude with `⟨hD, hDi, hDb, hDbi, isFnP_Gs (-1), isFnP_mul (isFnP_mul (fns_fnP hL (m_ζ L)) (fns_fnP hL (m_ζb L))) (fns_fnP hL (m_GGi L))⟩`.
-/
theorem fnPs : IsFnP L.D ∧ IsFnP L.Di ∧ IsFnP L.Db ∧ IsFnP L.Dbi ∧ IsFnP (G.Gs P (-1)) ∧
    IsFnP (L.ζ * L.ζb * L.GGi) := by
  obtain ⟨hD, hDi, hDb, hDbi, -⟩ := fnP_D hL
  exact ⟨hD, hDi, hDb, hDbi, isFnP_Gs (-1),
    isFnP_mul (isFnP_mul (fns_fnP hL (m_ζ L)) (fns_fnP hL (m_ζb L))) (fns_fnP hL (m_GGi L))⟩

/- English proof (translation)
Use `⟨Subtype.ext (D_Di L), Subtype.ext (Db_Dbi L), Subtype.ext (W_eq hTTp hL hLaw)⟩` and prove the remaining obligations.
-/
theorem rels : let h := fnPs hTTp hL hLaw
    f L.D h.1 * f L.Di h.2.1 = 1 ∧ f L.Db h.2.2.1 * f L.Dbi h.2.2.2.1 = 1 ∧
    f (L.ζ * L.ζb * L.GGi) h.2.2.2.2.2 = f L.D h.1 * f L.Db h.2.2.1 * f (G.Gs P (-1)) h.2.2.2.2.1 := by
  refine ⟨Subtype.ext (D_Di L), Subtype.ext (Db_Dbi L), Subtype.ext (W_eq hTTp hL hLaw)⟩

/- English proof (translation)
Take `⟨hD, hDi, hDb, hDbi, hG, hW⟩` from `fnPs hTTp hL hLaw`. Take `⟨r1, r2, r3⟩` from `rels hTTp hL hLaw`. Establish `key : f L.Dbi hDbi * ((f _ hW) ^ (N + 1) * (f L.Dbi hDbi) ^ (N + 1)) = (f L.D hD) ^ (N + 1) * f L.Dbi hDbi * (f _ hG) ^ (N + 1)`. Rewrite using `[r3]`. Establish `: (f L.Db hDb * f L.Dbi hDbi) ^ (N + 1) = 1` using `by rw [r2, one_pow]`.

Take the linear combination `(f L.Dbi hDbi * (f L.D hD) ^ (N + 1) * (f _ hG) ^ (N + 1)) * this`. Simplify `congrArg Subtype.val key` using `[f]`.
-/
theorem D_power_identity_one (N : ℕ) : L.Dbi * ((L.ζ * L.ζb * L.GGi) ^ (N + 1) * L.Dbi ^ (N + 1)) =
    L.D ^ (N + 1) * L.Dbi * G.Gs P (-1) ^ (N + 1) := by
  obtain ⟨hD, hDi, hDb, hDbi, hG, hW⟩ := fnPs hTTp hL hLaw
  obtain ⟨r1, r2, r3⟩ := rels hTTp hL hLaw
  have key : f L.Dbi hDbi * ((f _ hW) ^ (N + 1) * (f L.Dbi hDbi) ^ (N + 1)) =
      (f L.D hD) ^ (N + 1) * f L.Dbi hDbi * (f _ hG) ^ (N + 1) := by
    rw [r3]
    have : (f L.Db hDb * f L.Dbi hDbi) ^ (N + 1) = 1 := by rw [r2, one_pow]
    linear_combination (f L.Dbi hDbi * (f L.D hD) ^ (N + 1) * (f _ hG) ^ (N + 1)) * this
  simpa [f] using congrArg Subtype.val key

/- English proof (translation)
Take `⟨hD, hDi, hDb, hDbi, hG, hW⟩` from `fnPs hTTp hL hLaw`. Take `⟨r1, r2, r3⟩` from `rels hTTp hL hLaw`. Establish `key : f L.Di hDi * ((f _ hW) ^ (N + 1) * (f L.Dbi hDbi) ^ (N + 1)) = (f L.D hD) ^ N * (f _ hG) ^ (N + 1)`. Rewrite using `[r3]`. Establish `h2 : (f L.Db hDb * f L.Dbi hDbi) ^ (N + 1) = 1` using `by rw [r2, one_pow]`.

Take the linear combination `(f L.Di hDi * (f L.D hD) ^ (N + 1) * (f _ hG) ^ (N + 1)) * h2 + ((f L.D hD) ^ N * (f _ hG) ^ (N + 1)) * r1`. Simplify `congrArg Subtype.val key` using `[f]`.
-/
theorem D_power_identity_two (N : ℕ) : L.Di * ((L.ζ * L.ζb * L.GGi) ^ (N + 1) * L.Dbi ^ (N + 1)) = L.D ^ N * G.Gs P (-1) ^ (N + 1) := by
  obtain ⟨hD, hDi, hDb, hDbi, hG, hW⟩ := fnPs hTTp hL hLaw
  obtain ⟨r1, r2, r3⟩ := rels hTTp hL hLaw
  have key : f L.Di hDi * ((f _ hW) ^ (N + 1) * (f L.Dbi hDbi) ^ (N + 1)) = (f L.D hD) ^ N * (f _ hG) ^ (N + 1) := by
    rw [r3]
    have h2 : (f L.Db hDb * f L.Dbi hDbi) ^ (N + 1) = 1 := by rw [r2, one_pow]
    linear_combination (f L.Di hDi * (f L.D hD) ^ (N + 1) * (f _ hG) ^ (N + 1)) * h2 +
      ((f L.D hD) ^ N * (f _ hG) ^ (N + 1)) * r1
  simpa [f] using congrArg Subtype.val key

/- English proof (translation)
Take `⟨hD, hDi, hDb, hDbi, hG, hW⟩` from `fnPs hTTp hL hLaw`. Take `⟨r1, r2, r3⟩` from `rels hTTp hL hLaw`. Establish `key : (f _ hW) ^ (N + 1) * (f L.Dbi hDbi) ^ (N + 1) = (f L.D hD) ^ (N + 1) * (f _ hG) ^ (N + 1)`. Rewrite using `[r3]`. Establish `h2 : (f L.Db hDb * f L.Dbi hDbi) ^ (N + 1) = 1` using `by rw [r2, one_pow]`.

Take the linear combination `((f L.D hD) ^ (N + 1) * (f _ hG) ^ (N + 1)) * h2`. Simplify `congrArg Subtype.val key` using `[f]`.
-/
theorem D_power_identity_three (N : ℕ) : (L.ζ * L.ζb * L.GGi) ^ (N + 1) * L.Dbi ^ (N + 1) = L.D ^ (N + 1) * G.Gs P (-1) ^ (N + 1) := by
  obtain ⟨hD, hDi, hDb, hDbi, hG, hW⟩ := fnPs hTTp hL hLaw
  obtain ⟨r1, r2, r3⟩ := rels hTTp hL hLaw
  have key : (f _ hW) ^ (N + 1) * (f L.Dbi hDbi) ^ (N + 1) = (f L.D hD) ^ (N + 1) * (f _ hG) ^ (N + 1) := by
    rw [r3]
    have h2 : (f L.Db hDb * f L.Dbi hDbi) ^ (N + 1) = 1 := by rw [r2, one_pow]
    linear_combination ((f L.D hD) ^ (N + 1) * (f _ hG) ^ (N + 1)) * h2
  simpa [f] using congrArg Subtype.val key

/- English proof (translation)
Take `⟨hD, hDi, hDb, hDbi, hG, hW⟩` from `fnPs hTTp hL hLaw`. Take `⟨r1, r2, r3⟩` from `rels hTTp hL hLaw`. Establish `h2 : (f L.Db hDb * f L.Dbi hDbi) ^ N = 1` using `by rw [r2, one_pow]`. Prove the components needed by the constructor for the conclusion. Establish `key : f L.Di hDi * (f L.Db hDb) ^ (N + 1) * (f L.Dbi hDbi) ^ N = f L.Db hDb * f L.Di hDi`.

Take the linear combination `(f L.Di hDi * f L.Db hDb) * h2`. Simplify `congrArg Subtype.val key` using `[f]`. Establish `key : (f L.Db hDb) ^ N * (f L.Dbi hDbi) ^ N = 1` using `by linear_combination h2`. Simplify `congrArg Subtype.val key` using `[f]`.
-/
theorem D_power_identity_four (N : ℕ) : L.Di * L.Db ^ (N + 1) * L.Dbi ^ N = L.Db * L.Di ∧ L.Db ^ N * L.Dbi ^ N = 1 := by
  obtain ⟨hD, hDi, hDb, hDbi, hG, hW⟩ := fnPs hTTp hL hLaw
  obtain ⟨r1, r2, r3⟩ := rels hTTp hL hLaw
  have h2 : (f L.Db hDb * f L.Dbi hDbi) ^ N = 1 := by rw [r2, one_pow]
  constructor
  · have key : f L.Di hDi * (f L.Db hDb) ^ (N + 1) * (f L.Dbi hDbi) ^ N = f L.Db hDb * f L.Di hDi := by
      linear_combination (f L.Di hDi * f L.Db hDb) * h2
    simpa [f] using congrArg Subtype.val key
  · have key : (f L.Db hDb) ^ N * (f L.Dbi hDbi) ^ N = 1 := by linear_combination h2
    simpa [f] using congrArg Subtype.val key

/- English proof (translation)
Take `⟨hD, hDi, hDb, hDbi, hG, hW⟩` from `fnPs hTTp hL hLaw`. Take `⟨r1, r2, r3⟩` from `rels hTTp hL hLaw`. Establish `h2 : (f L.Db hDb * f L.Dbi hDbi) ^ N = 1` using `by rw [r2, one_pow]`. Prove the components needed by the constructor for the conclusion. Establish `key : (f L.Db hDb) ^ (N + 1) * f L.Di hDi * (f L.Dbi hDbi) ^ N = f L.Db hDb * f L.Di hDi`.

Take the linear combination `(f L.Db hDb * f L.Di hDi) * h2`. Simplify `congrArg Subtype.val key` using `[f]`. Establish `key : (f L.Db hDb) ^ (N + 1) * f L.Dbi hDbi * (f L.Dbi hDbi) ^ N = 1`. Establish `h3 : (f L.Db hDb * f L.Dbi hDbi) ^ (N + 1) = 1` using `by rw [r2, one_pow]`. Take the linear combination `h3`.

Simplify `congrArg Subtype.val key` using `[f]`.
-/
theorem D_power_identity_five (N : ℕ) : L.Db ^ (N + 1) * L.Di * L.Dbi ^ N = L.Db * L.Di ∧ L.Db ^ (N + 1) * L.Dbi * L.Dbi ^ N = 1 := by
  obtain ⟨hD, hDi, hDb, hDbi, hG, hW⟩ := fnPs hTTp hL hLaw
  obtain ⟨r1, r2, r3⟩ := rels hTTp hL hLaw
  have h2 : (f L.Db hDb * f L.Dbi hDbi) ^ N = 1 := by rw [r2, one_pow]
  constructor
  · have key : (f L.Db hDb) ^ (N + 1) * f L.Di hDi * (f L.Dbi hDbi) ^ N = f L.Db hDb * f L.Di hDi := by
      linear_combination (f L.Db hDb * f L.Di hDi) * h2
    simpa [f] using congrArg Subtype.val key
  · have key : (f L.Db hDb) ^ (N + 1) * f L.Dbi hDbi * (f L.Dbi hDbi) ^ N = 1 := by
      have h3 : (f L.Db hDb * f L.Dbi hDbi) ^ (N + 1) = 1 := by rw [r2, one_pow]
      linear_combination h3
    simpa [f] using congrArg Subtype.val key

end

end Formalism.FourierDecayAlt.P.MAx3.AB

end S_AB_AB4

section S_AD_AD16

set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace Formalism.FourierDecayAlt.P.MAx3.AD

open Formalism.FourierDecayAlt Formalism.FourierDecayAlt.MA Formalism.FourierDecayAlt.R Formalism.FourierDecayAlt.R.LevelData Formalism.FourierDecayAlt.P.MAx1.An Formalism.FourierDecayAlt.P.MAx2.Jet Formalism.FourierDecayAlt.P.MAx3.L
open MeasureTheory ComplexConjugate

noncomputable section

variable {P : M.Par}

/- English proof (translation)
Assemble the required witnesses or components as `⟨Phi P φ 0, Phi P φ 0, rfl, fun q => eval_cutoff_operator_zero P hφ q, fun q => by rw [Complex.conj_ofReal]; exact eval_cutoff_operator_zero P hφ q⟩`.
-/
theorem cf_Ph {φ : ℝ → ℝ} (hφ : LE.SmoothLog φ) : CF (Ph P φ) (fun q => ((φ (Gq P q) : ℝ) : ℂ)) :=
  ⟨Phi P φ 0, Phi P φ 0, rfl, fun q => eval_cutoff_operator_zero P hφ q, fun q => by rw [Complex.conj_ofReal]; exact eval_cutoff_operator_zero P hφ q⟩

/- English proof (translation)
The claim follows from `cf_Ph (φ := fun x : ℝ => x ^ t) (G.smoothLog_rpow t)`.
-/
theorem cf_Gs (t : ℝ) : CF (G.Gs P t) (fun q => ((Gq P q ^ t : ℝ) : ℂ)) :=
  cf_Ph (φ := fun x : ℝ => x ^ t) (G.smoothLog_rpow t)

variable {L : LevelData (A P (DQ P)) P.r} {j : M.Ty P → SmQ P.r P.TT}

/- English proof (translation)
The claim follows from `Submodule.subset_span ⟨φ, 1, [], hφ, Submonoid.one_mem _, by simp, by simp, by simp⟩`.
-/
theorem Ph_mem_Z {φ : ℝ → ℝ} (hφ : admitted φ) : Ph P φ ∈ Z P L 0 :=
  Submodule.subset_span ⟨φ, 1, [], hφ, Submonoid.one_mem _, by simp, by simp, by simp⟩

/- English proof (translation)
Establish `h : L.D * L.Dbi ∈ bddSet P L` using `Or.inl (Or.inl (Or.inl (by simp)))`. Conclude with `Submonoid.pow_mem _ (Submonoid.subset_closure h) n`.
-/
theorem DDbi_pow_mem (n : ℕ) : (L.D * L.Dbi) ^ n ∈ Submonoid.closure (bddSet P L) := by
  have h : L.D * L.Dbi ∈ bddSet P L := Or.inl (Or.inl (Or.inl (by simp)))
  exact Submonoid.pow_mem _ (Submonoid.subset_closure h) n

/- English proof (translation)
Establish `h : L.Db * L.Di ∈ bddSet P L` using `Or.inl (Or.inl (Or.inl (by simp)))`. Conclude with `Submonoid.pow_mem _ (Submonoid.subset_closure h) n`.
-/
theorem DbDi_pow_mem (n : ℕ) : (L.Db * L.Di) ^ n ∈ Submonoid.closure (bddSet P L) := by
  have h : L.Db * L.Di ∈ bddSet P L := Or.inl (Or.inl (Or.inl (by simp)))
  exact Submonoid.pow_mem _ (Submonoid.subset_closure h) n

variable (hTTp : 0 < P.TT) (hL : IsModelLevel P (DQ P) L) (hLaw : (DQ P).Laws P.TT)
include hTTp hL hLaw

/- English proof (translation)
The claim follows from `| [], _, k, z, hz => by simpa using hz | X :: W, hW, k, z, hz => by rw [List.prod_cons, mul_assoc] have h1 := word_mul_Z W (fun x hx => hW x (by simp [hx])) hz have h2 := hatPast hTTp.le hL hLaw (hW X (by simp)) h1 simpa [Nat.add_assoc, Nat.add_comm 1] using h2`.
-/
theorem word_mul_Z : ∀ (W : List (A P (DQ P))), (∀ x ∈ W, x ∈ hatSet P L) → ∀ {k : ℕ} {z : A P (DQ P)},
    z ∈ Z P L k → W.prod * z ∈ Z P L (k + W.length)
  | [], _, k, z, hz => by simpa using hz
  | X :: W, hW, k, z, hz => by
    rw [List.prod_cons, mul_assoc]
    have h1 := word_mul_Z W (fun x hx => hW x (by simp [hx])) hz
    have h2 := hatPast hTTp.le hL hLaw (hW X (by simp)) h1
    simpa [Nat.add_assoc, Nat.add_comm 1] using h2

/- English proof (translation)
The claim follows from `(canonical_sum_integrable hTTp hL hLaw hD hA a ts hts).2.2`.
-/
theorem canon {m : ℕ} (hD : JDecay P L j m) (hA : JAdj P L j m) (a : A P (DQ P))
    (ts : List (ℂ × A P (DQ P) × A P (DQ P) × List (A P (DQ P)))) (hts : ∀ t ∈ ts, CanonTerm L m a t) :
    ipA P (actA P a j) (actA P (canonSum ts) j) = ipA P (actA P (star (canonSum ts) * a) j) j :=
  (canonical_sum_integrable hTTp hL hLaw hD hA a ts hts).2.2

end

end Formalism.FourierDecayAlt.P.MAx3.AD

end S_AD_AD16

section S_AB_AB5

set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace Formalism.FourierDecayAlt.P.MAx3.AB

open Formalism.FourierDecayAlt Formalism.FourierDecayAlt.MA Formalism.FourierDecayAlt.R Formalism.FourierDecayAlt.R.LevelData Formalism.FourierDecayAlt.P.RuleGD Formalism.FourierDecayAlt.P.MAx3.H Formalism.FourierDecayAlt.P.MAx3.K
open Formalism.FourierDecayAlt.P.MAx3.Z Formalism.FourierDecayAlt.P.MAx3.AD

noncomputable section

variable {P : M.Par} {L : LevelData (A P (DQ P)) P.r} {j : M.Ty P → SmQ P.r P.TT}
  (hTTp : 0 < P.TT) (hL : IsModelLevel P (DQ P) L) (hLaw : (DQ P).Laws P.TT)
include hTTp hL hLaw

/- English proof (translation)
Take `⟨F, Fb, rfl, -, -⟩` from `hs`. Conclude with `⟨F, Fb, rfl⟩`.
-/
theorem isFnP_of_CF {s : A P (DQ P)} {g : Qp P.r P.TT → ℂ} (hs : CF s g) : IsFnP s := by
  obtain ⟨F, Fb, rfl, -, -⟩ := hs; exact ⟨F, Fb, rfl⟩

/- English proof (translation)
Take `⟨F, Fb, rfl⟩` from `hs`. Rewrite using `[MAx2.R2.star_sc]`. Conclude with `⟨Fb, F, rfl⟩`.
-/
theorem isFnP_star {s : A P (DQ P)} (hs : IsFnP s) : IsFnP (star s) := by
  obtain ⟨F, Fb, rfl⟩ := hs
  rw [MAx2.R2.star_sc]
  exact ⟨Fb, F, rfl⟩

/- English proof (translation)
Take `⟨Cβ, hβC⟩` from `SAB_closure hTTp hL hLaw hβ`. Take `⟨int1, -, eq1⟩` from `multAdj hTTp hL hLaw hD hβC hs hW (by omega) (k := k) (by omega) hsa`. Establish `hsβ : star β ∈ Formalism.FourierDecayAlt.P.MAx3.I4.SB L` using `star_SB hL hLaw hβ`. Establish `hz : star (β * s) * a ∈ Z P L k`. Rewrite using `[star_mul, ← SB_comm_fnP hL hLaw hsβ (isFnP_star hTTp hL hLaw (isFnP_of_CF hTTp hL hLaw hs)), mul_assoc]`.

Conclude with `SB_memZ hTTp hL hLaw hsβ hsa`. Establish `hp` using `adjPure hTTp hL hLaw hD hA W hW k hkm _ hz`. Establish `hz2 : star (β * s * W.prod) * a ∈ Z P L (k + W.length)`. Rewrite using `[star_mul, mul_assoc]`. Conclude with `star_word_mem hTTp.le hL hLaw W hW hz`.

Use `⟨int1, fun π => ?_, ?_⟩` and prove the remaining obligations. Use `int_Z hTTp hL hLaw hD (by omega) hz2 (W := []) (by simp) (by simp) π` as an intermediate fact. Simplify `this` using `[MAx2.R2.act_one]`. Rewrite using `[eq1, hp, star_mul (β * s) W.prod, mul_assoc]`.
-/
theorem QA_term {m : ℕ} (hD : JDecay P L j m) (hA : JAdj P L j m) {a : A P (DQ P)} {β : A P (DQ P)}
    (hβ : β ∈ Formalism.FourierDecayAlt.P.MAx3.I4.SB L) {s : A P (DQ P)} {g : Qp P.r P.TT → ℂ} (hs : CF s g)
    {W : List (A P (DQ P))} (hW : ∀ x ∈ W, x ∈ hatSet P L) {k : ℕ} (hkm : k + W.length ≤ m)
    (hsa : star s * a ∈ Z P L k) : QA L j a (β * s * W.prod) := by
  obtain ⟨Cβ, hβC⟩ := SAB_closure hTTp hL hLaw hβ
  obtain ⟨int1, -, eq1⟩ := multAdj hTTp hL hLaw hD hβC hs hW (by omega) (k := k) (by omega) hsa
  have hsβ : star β ∈ Formalism.FourierDecayAlt.P.MAx3.I4.SB L := star_SB hL hLaw hβ
  have hz : star (β * s) * a ∈ Z P L k := by
    rw [star_mul, ← SB_comm_fnP hL hLaw hsβ (isFnP_star hTTp hL hLaw (isFnP_of_CF hTTp hL hLaw hs)), mul_assoc]
    exact SB_memZ hTTp hL hLaw hsβ hsa
  have hp := adjPure hTTp hL hLaw hD hA W hW k hkm _ hz
  have hz2 : star (β * s * W.prod) * a ∈ Z P L (k + W.length) := by
    rw [star_mul, mul_assoc]; exact star_word_mem hTTp.le hL hLaw W hW hz
  refine ⟨int1, fun π => ?_, ?_⟩
  · have := int_Z hTTp hL hLaw hD (by omega) hz2 (W := []) (by simp) (by simp) π
    simpa [MAx2.R2.act_one] using this
  · rw [eq1, hp, star_mul (β * s) W.prod, mul_assoc]

/- English proof (translation)
Proceed by induction on `hw using Submodule.span_induction with`. Consider the case `mem x hx => exact h x hx`. Consider the case `zero => exact QA_zero a`. Consider the case `add x y _ _ h1 h2 => exact QA_add h1 h2`. Consider the case `smul c x _ h1 => exact QA_smul c h1`.
-/
theorem QA_span {a : A P (DQ P)} {T : Set (A P (DQ P))} (h : ∀ w ∈ T, QA L j a w) {w : A P (DQ P)}
    (hw : w ∈ Submodule.span ℂ T) : QA L j a w := by
  induction hw using Submodule.span_induction with
  | mem x hx => exact h x hx
  | zero => exact QA_zero a
  | add x y _ _ h1 h2 => exact QA_add h1 h2
  | smul c x _ h1 => exact QA_smul c h1

end

end Formalism.FourierDecayAlt.P.MAx3.AB

end S_AB_AB5

section S_AB_AB6

set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace Formalism.FourierDecayAlt.P.MAx3.AB

open Formalism.FourierDecayAlt Formalism.FourierDecayAlt.MA Formalism.FourierDecayAlt.R Formalism.FourierDecayAlt.R.LevelData Formalism.FourierDecayAlt.P.RuleGD Formalism.FourierDecayAlt.P.MAx3.H Formalism.FourierDecayAlt.P.MAx3.K
open Formalism.FourierDecayAlt.P.MAx3.Z Formalism.FourierDecayAlt.P.MAx3.AD

noncomputable section

variable {P : M.Par} {L : LevelData (A P (DQ P)) P.r} {j : M.Ty P → SmQ P.r P.TT}
  (hTTp : 0 < P.TT) (hL : IsModelLevel P (DQ P) L) (hLaw : (DQ P).Laws P.TT)
include hTTp hL hLaw

/- English proof (translation)
Establish `: E ∈ Subalgebra.toSubmodule (Algebra.adjoin ℂ (bddSet P L))` using `hE`. Rewrite `this` using `[Algebra.adjoin_eq_span]`. Then use the resulting hypothesis.
-/
theorem BA_span {E : A P (DQ P)} (hE : E ∈ Formalism.FourierDecayAlt.P.MAx3.I4.BA L) :
    E ∈ Submodule.span ℂ (Formalism.FourierDecayAlt.P.MAx3.I4.SB L : Set (A P (DQ P))) := by
  have : E ∈ Subalgebra.toSubmodule (Algebra.adjoin ℂ (bddSet P L)) := hE
  rwa [Algebra.adjoin_eq_span] at this

/- English proof (translation)
Establish `h` using `BA_span hTTp hL hLaw hE`. Use `clear hE`. Proceed by induction on `h using Submodule.span_induction with`. Consider the case `mem b hb => exact SB_memZ hTTp hL hLaw hb hz`. Consider the case `zero => simp`.

Consider the case `add a b _ _ h1 h2 => rw [add_mul]`. Conclude with `Submodule.add_mem _ h1 h2`. Consider the case `smul c a _ h1 => rw [smul_mul_assoc]`. Conclude with `Submodule.smul_mem _ c h1`.
-/
theorem BA_memZ {E : A P (DQ P)} (hE : E ∈ Formalism.FourierDecayAlt.P.MAx3.I4.BA L) {k : ℕ} {z : A P (DQ P)} (hz : z ∈ Z P L k) :
    E * z ∈ Z P L k := by
  have h := BA_span hTTp hL hLaw hE
  clear hE
  induction h using Submodule.span_induction with
  | mem b hb => exact SB_memZ hTTp hL hLaw hb hz
  | zero => simp
  | add a b _ _ h1 h2 => rw [add_mul]; exact Submodule.add_mem _ h1 h2
  | smul c a _ h1 => rw [smul_mul_assoc]; exact Submodule.smul_mem _ c h1

/- English proof (translation)
Establish `h` using `BA_span hTTp hL hLaw hE`. Use `clear hE`. Proceed by induction on `h using Submodule.span_induction with`. Consider the case `mem b hb => exact SB_comm_fnP hL hLaw hb hs`. Consider the case `zero => simp`.

Consider the case `add a b _ _ h1 h2 => rw [add_mul, mul_add, h1, h2]`. Consider the case `smul c a _ h1 => rw [smul_mul_assoc, mul_smul_comm, h1]`.
-/
theorem BA_comm_fnP {E : A P (DQ P)} (hE : E ∈ Formalism.FourierDecayAlt.P.MAx3.I4.BA L) {s : A P (DQ P)} (hs : IsFnP s) :
    E * s = s * E := by
  have h := BA_span hTTp hL hLaw hE
  clear hE
  induction h using Submodule.span_induction with
  | mem b hb => exact SB_comm_fnP hL hLaw hb hs
  | zero => simp
  | add a b _ _ h1 h2 => rw [add_mul, mul_add, h1, h2]
  | smul c a _ h1 => rw [smul_mul_assoc, mul_smul_comm, h1]

/- English proof (translation)
Establish `: G.Gs P t = Ph P (fun x : ℝ => x ^ t)` using `rfl`. Rewrite using `[this, star_Ph]`.
-/
theorem star_Gs (t : ℝ) : star (G.Gs P t) = G.Gs P t := by
  have : G.Gs P t = Ph P (fun x : ℝ => x ^ t) := rfl
  rw [this, star_Ph]

/- English proof (translation)
Take `⟨-, -, -, h4, h5, -⟩` from `star_more hL hLaw`. Take `⟨hD, hDi, hDb, hDbi, -⟩` from `fnP_D hL`. Establish `hst : star (L.D ^ n * L.Dbi ^ k * G.Gs P (-1) ^ m) = G.Gs P (-1) ^ m * (L.Di ^ k * L.Db ^ n)`. Rewrite using `[star_mul, star_mul, star_pow, star_pow, star_pow, star_Gs hTTp hL hLaw, h4, h5]`. Rewrite using `[hst]`.

Proceed by induction on `hx using Submodule.span_induction with`. Consider the case `mem y hy`. Take `⟨β, H, hβ, hH, hl, rfl⟩` from `hy`. Establish `hG : IsFnP (L.Di ^ k * L.Db ^ n)` using `isFnP_mul (isFnP_pow hDi k) (isFnP_pow hDb n)`. Establish `e : G.Gs P (-1) ^ m * (L.Di ^ k * L.Db ^ n) * (Ph P ψ * (β * L.Dbi ^ N * H.prod)) = G.Gs P (-1) ^ m * (Ph P ψ * (β * (L.Di ^ k * L.Db ^ n * L.Dbi ^ N)) * H.prod)`.

Establish `c1 : L.Di ^ k * L.Db ^ n * Ph P ψ = Ph P ψ * (L.Di ^ k * L.Db ^ n)` using `isFnP_comm hG (isFnP_Ph ψ)`. Establish `c2 : L.Di ^ k * L.Db ^ n * β = β * (L.Di ^ k * L.Db ^ n)` using `(SB_comm_fnP hL hLaw hβ hG).symm`. Combine the equalities or inequalities in the displayed calculation. Rewrite using `[c1]`. Simplify using `only [mul_assoc]`.

Use `_ = _ := by rw [c2]; simp only [mul_assoc]`. Rewrite using `[e]`. Use `Gspow_memZ hTTp hL hLaw m (Submodule.subset_span ⟨ψ, _, H, hψ, Submonoid.mul_mem _ hβ hγ, fun h hh => Or.inl (Or.inl (hH h hh)), hl.le, rfl⟩)` and prove the remaining obligations. Consider the case `zero => simp`. Consider the case `add a b _ _ h1 h2 => rw [mul_add, mul_add]`.

Conclude with `Submodule.add_mem _ h1 h2`. Consider the case `smul c a _ h1 => rw [mul_smul_comm, mul_smul_comm]`. Conclude with `Submodule.smul_mem _ c h1`.
-/
theorem left_cond {N n k m : ℕ} (hγ : L.Di ^ k * L.Db ^ n * L.Dbi ^ N ∈ Formalism.FourierDecayAlt.P.MAx3.I4.SB L) {ψ : ℝ → ℝ}
    (hψ : admitted ψ) {x : A P (DQ P)} (hx : x ∈ NFD L N) :
    star (L.D ^ n * L.Dbi ^ k * G.Gs P (-1) ^ m) * (Ph P ψ * x) ∈ Z P L N := by
  obtain ⟨-, -, -, h4, h5, -⟩ := star_more hL hLaw
  obtain ⟨hD, hDi, hDb, hDbi, -⟩ := fnP_D hL
  have hst : star (L.D ^ n * L.Dbi ^ k * G.Gs P (-1) ^ m) = G.Gs P (-1) ^ m * (L.Di ^ k * L.Db ^ n) := by
    rw [star_mul, star_mul, star_pow, star_pow, star_pow, star_Gs hTTp hL hLaw, h4, h5]
  rw [hst]
  induction hx using Submodule.span_induction with
  | mem y hy =>
    obtain ⟨β, H, hβ, hH, hl, rfl⟩ := hy
    have hG : IsFnP (L.Di ^ k * L.Db ^ n) := isFnP_mul (isFnP_pow hDi k) (isFnP_pow hDb n)
    have e : G.Gs P (-1) ^ m * (L.Di ^ k * L.Db ^ n) * (Ph P ψ * (β * L.Dbi ^ N * H.prod)) =
        G.Gs P (-1) ^ m * (Ph P ψ * (β * (L.Di ^ k * L.Db ^ n * L.Dbi ^ N)) * H.prod) := by
      have c1 : L.Di ^ k * L.Db ^ n * Ph P ψ = Ph P ψ * (L.Di ^ k * L.Db ^ n) := isFnP_comm hG (isFnP_Ph ψ)
      have c2 : L.Di ^ k * L.Db ^ n * β = β * (L.Di ^ k * L.Db ^ n) := (SB_comm_fnP hL hLaw hβ hG).symm
      calc G.Gs P (-1) ^ m * (L.Di ^ k * L.Db ^ n) * (Ph P ψ * (β * L.Dbi ^ N * H.prod))
          = G.Gs P (-1) ^ m * ((L.Di ^ k * L.Db ^ n * Ph P ψ) * β * L.Dbi ^ N * H.prod) := by simp only [mul_assoc]
        _ = G.Gs P (-1) ^ m * (Ph P ψ * ((L.Di ^ k * L.Db ^ n) * β) * L.Dbi ^ N * H.prod) := by
            rw [c1]; simp only [mul_assoc]
        _ = _ := by rw [c2]; simp only [mul_assoc]
    rw [e]
    refine Gspow_memZ hTTp hL hLaw m (Submodule.subset_span ⟨ψ, _, H, hψ, Submonoid.mul_mem _ hβ hγ,
      fun h hh => Or.inl (Or.inl (hH h hh)), hl.le, rfl⟩)
  | zero => simp
  | add a b _ _ h1 h2 => rw [mul_add, mul_add]; exact Submodule.add_mem _ h1 h2
  | smul c a _ h1 => rw [mul_smul_comm, mul_smul_comm]; exact Submodule.smul_mem _ c h1

end

end Formalism.FourierDecayAlt.P.MAx3.AB

end S_AB_AB6

section S_AB_AB7

set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace Formalism.FourierDecayAlt.P.MAx3.AB

open Formalism.FourierDecayAlt Formalism.FourierDecayAlt.MA Formalism.FourierDecayAlt.R Formalism.FourierDecayAlt.R.LevelData Formalism.FourierDecayAlt.P.RuleGD Formalism.FourierDecayAlt.P.MAx3.H Formalism.FourierDecayAlt.P.MAx3.K
open Formalism.FourierDecayAlt.P.MAx3.Z Formalism.FourierDecayAlt.P.MAx3.AD

noncomputable section

variable {P : M.Par} {L : LevelData (A P (DQ P)) P.r} {j : M.Ty P → SmQ P.r P.TT}
  (hTTp : 0 < P.TT) (hL : IsModelLevel P (DQ P) L) (hLaw : (DQ P).Laws P.TT)
include hTTp hL hLaw

/- English proof (translation)
Establish `hz` using `hatv_past_G hTTp hL hLaw hX hβ n k m`. Establish `hs : CF (L.D ^ n * L.Dbi ^ k * G.Gs P (-1) ^ m) _` using `CF_mul (CF_mul (CF_pow' (cf_D hTTp.le hL) n) (CF_pow' (cf_Dbi hTTp.le hL) k)) (CF_pow' (cf_Gs (-1)) m)`. Establish `hsa` using `left_cond hTTp hL hLaw (m := m) hγ hψ hx`. It suffices to establish `key : ∀ z ∈ MSG L n k m, QA L j (Ph P ψ * x) (z * H.prod) from key _ hz`. Introduce `z hz`.

Proceed by induction on `hz using Submodule.span_induction with`. Consider the case `mem z hz`. Take `⟨β', X', hβ', hX', rfl⟩` from `hz`. Establish `e : β' * (L.D ^ n * L.Dbi ^ k) * G.Gs P (-1) ^ m * X' * H.prod = β' * (L.D ^ n * L.Dbi ^ k * G.Gs P (-1) ^ m) * (X' :: H).prod`. Rewrite using `[List.prod_cons]`.

Simplify using `only [mul_assoc]`. Rewrite using `[e]`. Use `QA_term hTTp hL hLaw hD hA hβ' hs (fun h hh => ?_) (k := N) (by simp [hl]; omega) hsa` and prove the remaining obligations. Break down `List.mem_cons.1 hh with rfl | hh` into its components or cases. Conclude with `minus_sub_hat hTTp hL hLaw hX'`.

Conclude with `Or.inl (Or.inl (hH h hh))`. Consider the case `zero => rw [zero_mul]`. Conclude with `QA_zero _`. Consider the case `add a b _ _ h1 h2 => rw [add_mul]`. Conclude with `QA_add h1 h2`.

Consider the case `smul c a _ h1 => rw [smul_mul_assoc]`. Conclude with `QA_smul c h1`.
-/
theorem QA_LX {m0 : ℕ} (hD : JDecay P L j m0) (hA : JAdj P L j m0) {N n k m : ℕ} (hm0 : N + (N + 2) ≤ m0)
    (hγ : L.Di ^ k * L.Db ^ n * L.Dbi ^ N ∈ Formalism.FourierDecayAlt.P.MAx3.I4.SB L) {ψ : ℝ → ℝ} (hψ : admitted ψ) {x : A P (DQ P)}
    (hx : x ∈ NFD L N) {X : A P (DQ P)} (hX : X ∈ minusHats L) {β : A P (DQ P)} (hβ : β ∈ Formalism.FourierDecayAlt.P.MAx3.I4.SB L)
    {H : List (A P (DQ P))} (hH : ∀ h ∈ H, h ∈ plusHats L) (hl : H.length = N + 1) :
    QA L j (Ph P ψ * x) (X * (β * (L.D ^ n * L.Dbi ^ k) * G.Gs P (-1) ^ m) * H.prod) := by
  have hz := hatv_past_G hTTp hL hLaw hX hβ n k m
  have hs : CF (L.D ^ n * L.Dbi ^ k * G.Gs P (-1) ^ m) _ :=
    CF_mul (CF_mul (CF_pow' (cf_D hTTp.le hL) n) (CF_pow' (cf_Dbi hTTp.le hL) k)) (CF_pow' (cf_Gs (-1)) m)
  have hsa := left_cond hTTp hL hLaw (m := m) hγ hψ hx
  suffices key : ∀ z ∈ MSG L n k m, QA L j (Ph P ψ * x) (z * H.prod) from key _ hz
  intro z hz
  induction hz using Submodule.span_induction with
  | mem z hz =>
    obtain ⟨β', X', hβ', hX', rfl⟩ := hz
    have e : β' * (L.D ^ n * L.Dbi ^ k) * G.Gs P (-1) ^ m * X' * H.prod =
        β' * (L.D ^ n * L.Dbi ^ k * G.Gs P (-1) ^ m) * (X' :: H).prod := by
      rw [List.prod_cons]; simp only [mul_assoc]
    rw [e]
    refine QA_term hTTp hL hLaw hD hA hβ' hs (fun h hh => ?_) (k := N) (by simp [hl]; omega) hsa
    rcases List.mem_cons.1 hh with rfl | hh
    · exact minus_sub_hat hTTp hL hLaw hX'
    · exact Or.inl (Or.inl (hH h hh))
  | zero => rw [zero_mul]; exact QA_zero _
  | add a b _ _ h1 h2 => rw [add_mul]; exact QA_add h1 h2
  | smul c a _ h1 => rw [smul_mul_assoc]; exact QA_smul c h1

end

end Formalism.FourierDecayAlt.P.MAx3.AB

end S_AB_AB7

section S_AB_AB8

set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace Formalism.FourierDecayAlt.P.MAx3.AB

open Formalism.FourierDecayAlt Formalism.FourierDecayAlt.MA Formalism.FourierDecayAlt.R Formalism.FourierDecayAlt.R.LevelData Formalism.FourierDecayAlt.P.RuleGD Formalism.FourierDecayAlt.P.MAx3.H Formalism.FourierDecayAlt.P.MAx3.K
open Formalism.FourierDecayAlt.P.MAx3.Z Formalism.FourierDecayAlt.P.MAx3.AD

noncomputable section

variable {P : M.Par} {L : LevelData (A P (DQ P)) P.r} {j : M.Ty P → SmQ P.r P.TT}
  (hTTp : 0 < P.TT) (hL : IsModelLevel P (DQ P) L) (hLaw : (DQ P).Laws P.TT)
include hTTp hL hLaw

/- English proof (translation)
The claim follows from `Submonoid.subset_closure (Or.inl (Or.inl (Or.inr ⟨κ, rfl⟩)))`.
-/
theorem kap_SB (κ : M.Ty P → ℂ) : kap P (DQ P) κ ∈ Formalism.FourierDecayAlt.P.MAx3.I4.SB L :=
  Submonoid.subset_closure (Or.inl (Or.inl (Or.inr ⟨κ, rfl⟩)))

/- English proof (translation)
Take `⟨-, -, h3, -, -, -⟩` from `star_more hL hLaw`. Rewrite using `[star_mul, Q.star_Ahat hL hLaw, h3, Complex.conj_ofReal]`.
-/
theorem star_letA (Y : ℝ) : star (L.Di * L.Ahat (Y : ℂ)) = L.Ahatv ((Y : ℂ) - 1) * L.Dbi := by
  obtain ⟨-, -, h3, -, -, -⟩ := star_more hL hLaw
  rw [star_mul, Q.star_Ahat hL hLaw, h3, Complex.conj_ofReal]

/- English proof (translation)
Take `⟨-, -, -, h4, -, -⟩` from `star_more hL hLaw`. Rewrite using `[star_mul, Q.star_raising hL hLaw, h4, Complex.conj_ofReal]`.
-/
theorem star_letR (Y : ℝ) : star (L.Dbi * L.R0 (Y : ℂ)) = L.R0v (Y : ℂ) * L.Di := by
  obtain ⟨-, -, -, h4, -, -⟩ := star_more hL hLaw
  rw [star_mul, Q.star_raising hL hLaw, h4, Complex.conj_ofReal]

/- English proof (translation)
Take `⟨hD, hDi, hDb, hDbi, hG, hW⟩` from `fnPs hTTp hL hLaw`. Establish `hkβ : kap P (DQ P) κ * β ∈ Formalism.FourierDecayAlt.P.MAx3.I4.SB L` using `Submonoid.mul_mem _ (kap_SB hTTp hL hLaw κ) hβ`. Establish `c1 : (L.ζ * L.ζb * L.GGi) ^ (N + 1) * (kap P (DQ P) κ * β) = (kap P (DQ P) κ * β) * (L.ζ * L.ζb * L.GGi) ^ (N + 1)` using `(SB_comm_fnP hL hLaw hkβ (isFnP_pow hW (N + 1))).symm`. Establish `c2 : F * (kap P (DQ P) κ * β) = (kap P (DQ P) κ * β) * F` using `(SB_comm_fnP hL hLaw hkβ hF).symm`. Combine the equalities or inequalities in the displayed calculation.

Rewrite using `[c1]`. Simplify using `only [mul_assoc]`. Use `_ = _ := by rw [c2]; simp only [mul_assoc]`.
-/
theorem rearr1 (N : ℕ) (κ : M.Ty P → ℂ) {β : A P (DQ P)} (hβ : β ∈ Formalism.FourierDecayAlt.P.MAx3.I4.SB L) (F : A P (DQ P))
    (hF : IsFnP F) (Hp : A P (DQ P)) :
    F * ((L.ζ * L.ζb * L.GGi) ^ (N + 1) * kap P (DQ P) κ * (β * L.Dbi ^ (N + 1) * Hp)) =
      (kap P (DQ P) κ * β) * (F * ((L.ζ * L.ζb * L.GGi) ^ (N + 1) * L.Dbi ^ (N + 1))) * Hp := by
  obtain ⟨hD, hDi, hDb, hDbi, hG, hW⟩ := fnPs hTTp hL hLaw
  have hkβ : kap P (DQ P) κ * β ∈ Formalism.FourierDecayAlt.P.MAx3.I4.SB L := Submonoid.mul_mem _ (kap_SB hTTp hL hLaw κ) hβ
  have c1 : (L.ζ * L.ζb * L.GGi) ^ (N + 1) * (kap P (DQ P) κ * β) = (kap P (DQ P) κ * β) * (L.ζ * L.ζb * L.GGi) ^ (N + 1) :=
    (SB_comm_fnP hL hLaw hkβ (isFnP_pow hW (N + 1))).symm
  have c2 : F * (kap P (DQ P) κ * β) = (kap P (DQ P) κ * β) * F := (SB_comm_fnP hL hLaw hkβ hF).symm
  calc F * ((L.ζ * L.ζb * L.GGi) ^ (N + 1) * kap P (DQ P) κ * (β * L.Dbi ^ (N + 1) * Hp))
      = F * ((L.ζ * L.ζb * L.GGi) ^ (N + 1) * (kap P (DQ P) κ * β)) * L.Dbi ^ (N + 1) * Hp := by simp only [mul_assoc]
    _ = (F * (kap P (DQ P) κ * β)) * (L.ζ * L.ζb * L.GGi) ^ (N + 1) * L.Dbi ^ (N + 1) * Hp := by
        rw [c1]; simp only [mul_assoc]
    _ = _ := by rw [c2]; simp only [mul_assoc]

/- English proof (translation)
Take `⟨hD', hDi, hDb, hDbi, hG, hW⟩` from `fnPs hTTp hL hLaw`. Take `⟨hγ, -⟩` from `D_power_identity_four hTTp hL hLaw N`. Establish `hγ' : L.Di ^ 1 * L.Db ^ (N + 1) * L.Dbi ^ N ∈ Formalism.FourierDecayAlt.P.MAx3.I4.SB L`. Rewrite using `[pow_one, hγ]; exact Submonoid.subset_closure (Or.inl (Or.inl (Or.inl (by simp))))`. Proceed by induction on `hy using Submodule.span_induction with`.

Consider the case `mem y hy`. Take `⟨β, H, hβ, hH, hl, rfl⟩` from `hy`. Establish `e : star (L.Di * L.Ahat (Y : ℂ)) * ((L.ζ * L.ζb * L.GGi) ^ (N + 1) * kap P (DQ P) κ * (β * L.Dbi ^ (N + 1) * H.prod)) = L.Ahatv ((Y : ℂ) - 1) * ((kap P (DQ P) κ * β) * (L.D ^ (N + 1) * L.Dbi ^ 1) * G.Gs P (-1) ^ (N + 1)) * H.prod`. Rewrite using `[star_letA hTTp hL hLaw, mul_assoc, rearr1 hTTp hL hLaw N κ hβ L.Dbi hDbi, D_power_identity_one hTTp hL hLaw, pow_one]`. Simplify using `only [mul_assoc]`.

Rewrite using `[e]`. Conclude with `QA_LX hTTp hL hLaw hD hA hm0 hγ' hψ hx (Or.inl ⟨_, rfl⟩) (Submonoid.mul_mem _ (kap_SB hTTp hL hLaw κ) hβ) hH hl`. Consider the case `zero => rw [mul_zero, mul_zero]`. Conclude with `QA_zero _`. Consider the case `add a b _ _ h1 h2 => rw [mul_add, mul_add]`.

Conclude with `QA_add h1 h2`. Consider the case `smul c a _ h1 => rw [mul_smul_comm, mul_smul_comm]`. Conclude with `QA_smul c h1`.
-/
theorem quadratic_form_lowering {m0 : ℕ} (hD : JDecay P L j m0) (hA : JAdj P L j m0) {N : ℕ} (hm0 : N + (N + 2) ≤ m0) {ψ : ℝ → ℝ}
    (hψ : admitted ψ) {x : A P (DQ P)} (hx : x ∈ NFD L N) (Y : ℝ) (κ : M.Ty P → ℂ) {y : A P (DQ P)}
    (hy : y ∈ NFD L (N + 1)) :
    QA L j (Ph P ψ * x) (star (L.Di * L.Ahat (Y : ℂ)) * ((L.ζ * L.ζb * L.GGi) ^ (N + 1) * kap P (DQ P) κ * y)) := by
  obtain ⟨hD', hDi, hDb, hDbi, hG, hW⟩ := fnPs hTTp hL hLaw
  obtain ⟨hγ, -⟩ := D_power_identity_four hTTp hL hLaw N
  have hγ' : L.Di ^ 1 * L.Db ^ (N + 1) * L.Dbi ^ N ∈ Formalism.FourierDecayAlt.P.MAx3.I4.SB L := by
    rw [pow_one, hγ]; exact Submonoid.subset_closure (Or.inl (Or.inl (Or.inl (by simp))))
  induction hy using Submodule.span_induction with
  | mem y hy =>
    obtain ⟨β, H, hβ, hH, hl, rfl⟩ := hy
    have e : star (L.Di * L.Ahat (Y : ℂ)) * ((L.ζ * L.ζb * L.GGi) ^ (N + 1) * kap P (DQ P) κ *
        (β * L.Dbi ^ (N + 1) * H.prod)) = L.Ahatv ((Y : ℂ) - 1) *
        ((kap P (DQ P) κ * β) * (L.D ^ (N + 1) * L.Dbi ^ 1) * G.Gs P (-1) ^ (N + 1)) * H.prod := by
      rw [star_letA hTTp hL hLaw, mul_assoc, rearr1 hTTp hL hLaw N κ hβ L.Dbi hDbi, D_power_identity_one hTTp hL hLaw, pow_one]
      simp only [mul_assoc]
    rw [e]
    exact QA_LX hTTp hL hLaw hD hA hm0 hγ' hψ hx (Or.inl ⟨_, rfl⟩)
      (Submonoid.mul_mem _ (kap_SB hTTp hL hLaw κ) hβ) hH hl
  | zero => rw [mul_zero, mul_zero]; exact QA_zero _
  | add a b _ _ h1 h2 => rw [mul_add, mul_add]; exact QA_add h1 h2
  | smul c a _ h1 => rw [mul_smul_comm, mul_smul_comm]; exact QA_smul c h1

/- English proof (translation)
Take `⟨hD', hDi, hDb, hDbi, hG, hW⟩` from `fnPs hTTp hL hLaw`. Take `⟨-, hγ⟩` from `D_power_identity_four hTTp hL hLaw N`. Establish `hγ' : L.Di ^ 0 * L.Db ^ N * L.Dbi ^ N ∈ Formalism.FourierDecayAlt.P.MAx3.I4.SB L`. Rewrite using `[pow_zero, one_mul, hγ]`. Conclude with `Submonoid.one_mem _`.

Proceed by induction on `hy using Submodule.span_induction with`. Consider the case `mem y hy`. Take `⟨β, H, hβ, hH, hl, rfl⟩` from `hy`. Establish `e : star (L.Dbi * L.R0 (Y : ℂ)) * ((L.ζ * L.ζb * L.GGi) ^ (N + 1) * kap P (DQ P) κ * (β * L.Dbi ^ (N + 1) * H.prod)) = L.R0v (Y : ℂ) * ((kap P (DQ P) κ * β) * (L.D ^ N * L.Dbi ^ 0) * G.Gs P (-1) ^ (N + 1)) * H.prod`. Rewrite using `[star_letR hTTp hL hLaw, mul_assoc, rearr1 hTTp hL hLaw N κ hβ L.Di hDi, D_power_identity_two hTTp hL hLaw, pow_zero, mul_one]`.

Simplify using `only [mul_assoc]`. Rewrite using `[e]`. Conclude with `QA_LX hTTp hL hLaw hD hA hm0 hγ' hψ hx (Or.inr ⟨_, rfl⟩) (Submonoid.mul_mem _ (kap_SB hTTp hL hLaw κ) hβ) hH hl`. Consider the case `zero => rw [mul_zero, mul_zero]`. Conclude with `QA_zero _`.

Consider the case `add a b _ _ h1 h2 => rw [mul_add, mul_add]`. Conclude with `QA_add h1 h2`. Consider the case `smul c a _ h1 => rw [mul_smul_comm, mul_smul_comm]`. Conclude with `QA_smul c h1`.
-/
theorem quadratic_form_raising {m0 : ℕ} (hD : JDecay P L j m0) (hA : JAdj P L j m0) {N : ℕ} (hm0 : N + (N + 2) ≤ m0) {ψ : ℝ → ℝ}
    (hψ : admitted ψ) {x : A P (DQ P)} (hx : x ∈ NFD L N) (Y : ℝ) (κ : M.Ty P → ℂ) {y : A P (DQ P)}
    (hy : y ∈ NFD L (N + 1)) :
    QA L j (Ph P ψ * x) (star (L.Dbi * L.R0 (Y : ℂ)) * ((L.ζ * L.ζb * L.GGi) ^ (N + 1) * kap P (DQ P) κ * y)) := by
  obtain ⟨hD', hDi, hDb, hDbi, hG, hW⟩ := fnPs hTTp hL hLaw
  obtain ⟨-, hγ⟩ := D_power_identity_four hTTp hL hLaw N
  have hγ' : L.Di ^ 0 * L.Db ^ N * L.Dbi ^ N ∈ Formalism.FourierDecayAlt.P.MAx3.I4.SB L := by
    rw [pow_zero, one_mul, hγ]; exact Submonoid.one_mem _
  induction hy using Submodule.span_induction with
  | mem y hy =>
    obtain ⟨β, H, hβ, hH, hl, rfl⟩ := hy
    have e : star (L.Dbi * L.R0 (Y : ℂ)) * ((L.ζ * L.ζb * L.GGi) ^ (N + 1) * kap P (DQ P) κ *
        (β * L.Dbi ^ (N + 1) * H.prod)) = L.R0v (Y : ℂ) *
        ((kap P (DQ P) κ * β) * (L.D ^ N * L.Dbi ^ 0) * G.Gs P (-1) ^ (N + 1)) * H.prod := by
      rw [star_letR hTTp hL hLaw, mul_assoc, rearr1 hTTp hL hLaw N κ hβ L.Di hDi, D_power_identity_two hTTp hL hLaw, pow_zero, mul_one]
      simp only [mul_assoc]
    rw [e]
    exact QA_LX hTTp hL hLaw hD hA hm0 hγ' hψ hx (Or.inr ⟨_, rfl⟩)
      (Submonoid.mul_mem _ (kap_SB hTTp hL hLaw κ) hβ) hH hl
  | zero => rw [mul_zero, mul_zero]; exact QA_zero _
  | add a b _ _ h1 h2 => rw [mul_add, mul_add]; exact QA_add h1 h2
  | smul c a _ h1 => rw [mul_smul_comm, mul_smul_comm]; exact QA_smul c h1

end

end Formalism.FourierDecayAlt.P.MAx3.AB

end S_AB_AB8

section S_AB_AB9

set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace Formalism.FourierDecayAlt.P.MAx3.AB

open Formalism.FourierDecayAlt Formalism.FourierDecayAlt.MA Formalism.FourierDecayAlt.R Formalism.FourierDecayAlt.R.LevelData Formalism.FourierDecayAlt.P.RuleGD Formalism.FourierDecayAlt.P.MAx3.H Formalism.FourierDecayAlt.P.MAx3.K
open Formalism.FourierDecayAlt.P.MAx3.Z Formalism.FourierDecayAlt.P.MAx3.AD

noncomputable section

variable {P : M.Par} {L : LevelData (A P (DQ P)) P.r} {j : M.Ty P → SmQ P.r P.TT}
  (hTTp : 0 < P.TT) (hL : IsModelLevel P (DQ P) L) (hLaw : (DQ P).Laws P.TT)
include hTTp hL hLaw

/- English proof (translation)
Establish `h` using `BA_span hTTp hL hLaw hE`. Use `clear hE`. Proceed by induction on `h using Submodule.span_induction with`. Consider the case `mem b hb => exact Submodule.subset_span (star_SB hL hLaw hb)`. Consider the case `zero => simp`.

Consider the case `add a b _ _ h1 h2 => rw [star_add]`. Conclude with `Submodule.add_mem _ h1 h2`. Consider the case `smul c a _ h1 => rw [star_smul]`. Conclude with `Submodule.smul_mem _ _ h1`.
-/
theorem star_BA_span {E : A P (DQ P)} (hE : E ∈ Formalism.FourierDecayAlt.P.MAx3.I4.BA L) :
    star E ∈ Submodule.span ℂ (Formalism.FourierDecayAlt.P.MAx3.I4.SB L : Set (A P (DQ P))) := by
  have h := BA_span hTTp hL hLaw hE
  clear hE
  induction h using Submodule.span_induction with
  | mem b hb => exact Submodule.subset_span (star_SB hL hLaw hb)
  | zero => simp
  | add a b _ _ h1 h2 => rw [star_add]; exact Submodule.add_mem _ h1 h2
  | smul c a _ h1 => rw [star_smul]; exact Submodule.smul_mem _ _ h1

/- English proof (translation)
Take `⟨hD', hDi, hDb, hDbi, hG, hW⟩` from `fnPs hTTp hL hLaw`. Take `⟨hγ, -⟩` from `D_power_identity_four hTTp hL hLaw N`. Establish `hγ' : L.Di ^ 1 * L.Db ^ (N + 1) * L.Dbi ^ N ∈ Formalism.FourierDecayAlt.P.MAx3.I4.SB L`. Rewrite using `[pow_one, hγ]; exact Submonoid.subset_closure (Or.inl (Or.inl (Or.inl (by simp))))`. Rewrite using `[star_mul, star_letA hTTp hL hLaw]`.

Establish `hsE` using `star_BA_span hTTp hL hLaw hE`. Generalize the expression as in `star E = e at hsE`. Use `clear hE`. Proceed by induction on `hsE using Submodule.span_induction with`. Consider the case `mem b hb`.

Proceed by induction on `hy using Submodule.span_induction with`. Consider the case `mem y hy`. Take `⟨β, H, hβ, hH, hl, rfl⟩` from `hy`. Establish `e1 : L.Ahatv ((Y : ℂ) - 1) * L.Dbi * b * ((L.ζ * L.ζb * L.GGi) ^ (N + 1) * kap P (DQ P) κ * (β * L.Dbi ^ (N + 1) * H.prod)) = L.Ahatv ((Y : ℂ) - 1) * ((b * (kap P (DQ P) κ * β)) * (L.D ^ (N + 1) * L.Dbi ^ 1) * G.Gs P (-1) ^ (N + 1)) * H.prod`. Establish `cb : L.Dbi * b = b * L.Dbi` using `(SB_comm_fnP hL hLaw hb hDbi).symm`.

Rewrite using `[mul_assoc (L.Ahatv _), cb, mul_assoc, mul_assoc, rearr1 hTTp hL hLaw N κ hβ L.Dbi hDbi, D_power_identity_one hTTp hL hLaw, pow_one]`. Simplify using `only [mul_assoc]`. Rewrite using `[e1]`. Conclude with `QA_LX hTTp hL hLaw hD hA hm0 hγ' hψ hx (Or.inl ⟨_, rfl⟩) (Submonoid.mul_mem _ hb (Submonoid.mul_mem _ (kap_SB hTTp hL hLaw κ) hβ)) hH hl`. Consider the case `zero => rw [mul_zero, mul_zero]`.

Conclude with `QA_zero _`. Consider the case `add a c _ _ h1 h2 => rw [mul_add, mul_add]`. Conclude with `QA_add h1 h2`. Consider the case `smul c a _ h1 => rw [mul_smul_comm, mul_smul_comm]`. Conclude with `QA_smul c h1`.

Consider the case `zero => rw [mul_zero, zero_mul]`. Conclude with `QA_zero _`. Consider the case `add a c _ _ h1 h2 => rw [mul_add, add_mul]`. Conclude with `QA_add h1 h2`. Consider the case `smul c a _ h1 => rw [mul_smul_comm, smul_mul_assoc]`.

Conclude with `QA_smul c h1`.
-/
theorem quadratic_form_lowering_base {m0 : ℕ} (hD : JDecay P L j m0) (hA : JAdj P L j m0) {N : ℕ} (hm0 : N + (N + 2) ≤ m0) {ψ : ℝ → ℝ}
    (hψ : admitted ψ) {x : A P (DQ P)} (hx : x ∈ NFD L N) (Y : ℝ) (κ : M.Ty P → ℂ) {E : A P (DQ P)}
    (hE : E ∈ Formalism.FourierDecayAlt.P.MAx3.I4.BA L) {y : A P (DQ P)} (hy : y ∈ NFD L (N + 1)) :
    QA L j (Ph P ψ * x) (star (E * (L.Di * L.Ahat (Y : ℂ))) * ((L.ζ * L.ζb * L.GGi) ^ (N + 1) * kap P (DQ P) κ * y)) := by
  obtain ⟨hD', hDi, hDb, hDbi, hG, hW⟩ := fnPs hTTp hL hLaw
  obtain ⟨hγ, -⟩ := D_power_identity_four hTTp hL hLaw N
  have hγ' : L.Di ^ 1 * L.Db ^ (N + 1) * L.Dbi ^ N ∈ Formalism.FourierDecayAlt.P.MAx3.I4.SB L := by
    rw [pow_one, hγ]; exact Submonoid.subset_closure (Or.inl (Or.inl (Or.inl (by simp))))
  rw [star_mul, star_letA hTTp hL hLaw]
  have hsE := star_BA_span hTTp hL hLaw hE
  generalize star E = e at hsE
  clear hE
  induction hsE using Submodule.span_induction with
  | mem b hb =>
    induction hy using Submodule.span_induction with
    | mem y hy =>
      obtain ⟨β, H, hβ, hH, hl, rfl⟩ := hy
      have e1 : L.Ahatv ((Y : ℂ) - 1) * L.Dbi * b * ((L.ζ * L.ζb * L.GGi) ^ (N + 1) * kap P (DQ P) κ *
          (β * L.Dbi ^ (N + 1) * H.prod)) = L.Ahatv ((Y : ℂ) - 1) *
          ((b * (kap P (DQ P) κ * β)) * (L.D ^ (N + 1) * L.Dbi ^ 1) * G.Gs P (-1) ^ (N + 1)) * H.prod := by
        have cb : L.Dbi * b = b * L.Dbi := (SB_comm_fnP hL hLaw hb hDbi).symm
        rw [mul_assoc (L.Ahatv _), cb, mul_assoc, mul_assoc, rearr1 hTTp hL hLaw N κ hβ L.Dbi hDbi,
          D_power_identity_one hTTp hL hLaw, pow_one]
        simp only [mul_assoc]
      rw [e1]
      exact QA_LX hTTp hL hLaw hD hA hm0 hγ' hψ hx (Or.inl ⟨_, rfl⟩)
        (Submonoid.mul_mem _ hb (Submonoid.mul_mem _ (kap_SB hTTp hL hLaw κ) hβ)) hH hl
    | zero => rw [mul_zero, mul_zero]; exact QA_zero _
    | add a c _ _ h1 h2 => rw [mul_add, mul_add]; exact QA_add h1 h2
    | smul c a _ h1 => rw [mul_smul_comm, mul_smul_comm]; exact QA_smul c h1
  | zero => rw [mul_zero, zero_mul]; exact QA_zero _
  | add a c _ _ h1 h2 => rw [mul_add, add_mul]; exact QA_add h1 h2
  | smul c a _ h1 => rw [mul_smul_comm, smul_mul_assoc]; exact QA_smul c h1

end

end Formalism.FourierDecayAlt.P.MAx3.AB

end S_AB_AB9

section S_AB_AB10

set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace Formalism.FourierDecayAlt.P.MAx3.AB

open Formalism.FourierDecayAlt Formalism.FourierDecayAlt.MA Formalism.FourierDecayAlt.R Formalism.FourierDecayAlt.R.LevelData Formalism.FourierDecayAlt.P.RuleGD Formalism.FourierDecayAlt.P.MAx3.H Formalism.FourierDecayAlt.P.MAx3.K
open Formalism.FourierDecayAlt.P.MAx3.Z Formalism.FourierDecayAlt.P.MAx3.AD

noncomputable section

variable {P : M.Par} {L : LevelData (A P (DQ P)) P.r} {j : M.Ty P → SmQ P.r P.TT}
  (hTTp : 0 < P.TT) (hL : IsModelLevel P (DQ P) L) (hLaw : (DQ P).Laws P.TT)
include hTTp hL hLaw

/- English proof (translation)
Take `⟨-, -, -, -, h5, -⟩` from `star_more hL hLaw`. Establish `hs : CF (L.D ^ (N + 1) * G.Gs P (-1) ^ (N + 1)) _` using `CF_mul (CF_pow' (cf_D hTTp.le hL) (N + 1)) (CF_pow' (cf_Gs (-1)) (N + 1))`. Establish `hsa : star (L.D ^ (N + 1) * G.Gs P (-1) ^ (N + 1)) * a ∈ Z P L (N + 1)`. Rewrite using `[star_mul, star_pow, star_pow, star_Gs hTTp hL hLaw, h5]`. Conclude with `ha`.

Proceed by induction on `hy using Submodule.span_induction with`. Consider the case `mem y hy`. Take `⟨β, H, hβ, hH, hl, rfl⟩` from `hy`. Establish `e : (L.ζ * L.ζb * L.GGi) ^ (N + 1) * kap P (DQ P) κ * (β * L.Dbi ^ (N + 1) * H.prod) = (kap P (DQ P) κ * β) * (L.D ^ (N + 1) * G.Gs P (-1) ^ (N + 1)) * H.prod`. Take `⟨-, -, -, -, -, hW⟩` from `fnPs hTTp hL hLaw`.

Establish `hkβ : kap P (DQ P) κ * β ∈ Formalism.FourierDecayAlt.P.MAx3.I4.SB L` using `Submonoid.mul_mem _ (kap_SB hTTp hL hLaw κ) hβ`. Establish `c1 : (L.ζ * L.ζb * L.GGi) ^ (N + 1) * (kap P (DQ P) κ * β) = (kap P (DQ P) κ * β) * (L.ζ * L.ζb * L.GGi) ^ (N + 1)` using `(SB_comm_fnP hL hLaw hkβ (isFnP_pow hW (N + 1))).symm`. Combine the equalities or inequalities in the displayed calculation. Simplify using `only [mul_assoc]`. Use `_ = (kap P (DQ P) κ * β) * ((L.ζ * L.ζb * L.GGi) ^ (N + 1) * L.Dbi ^ (N + 1)) * H.prod := by`.

Rewrite using `[c1]`. Simplify using `only [mul_assoc]`. Use `_ = _ := by rw [D_power_identity_three hTTp hL hLaw]`. Rewrite using `[e]`. Conclude with `QA_term hTTp hL hLaw hD hA (Submonoid.mul_mem _ (kap_SB hTTp hL hLaw κ) hβ) hs (fun h hh => Or.inl (Or.inl (hH h hh))) (k := N + 1) (by rw [hl]; omega) hsa`.

Consider the case `zero => rw [mul_zero]`. Conclude with `QA_zero _`. Consider the case `add a' b _ _ h1 h2 => rw [mul_add]`. Conclude with `QA_add h1 h2`. Consider the case `smul c a' _ h1 => rw [mul_smul_comm]`.

Conclude with `QA_smul c h1`.
-/
theorem QA_R {m0 : ℕ} (hD : JDecay P L j m0) (hA : JAdj P L j m0) {N : ℕ} (hm0 : (N + 1) + (N + 1) ≤ m0)
    {a : A P (DQ P)} (ha : G.Gs P (-1) ^ (N + 1) * L.Db ^ (N + 1) * a ∈ Z P L (N + 1)) (κ : M.Ty P → ℂ)
    {y : A P (DQ P)} (hy : y ∈ NFD L (N + 1)) :
    QA L j a ((L.ζ * L.ζb * L.GGi) ^ (N + 1) * kap P (DQ P) κ * y) := by
  obtain ⟨-, -, -, -, h5, -⟩ := star_more hL hLaw
  have hs : CF (L.D ^ (N + 1) * G.Gs P (-1) ^ (N + 1)) _ :=
    CF_mul (CF_pow' (cf_D hTTp.le hL) (N + 1)) (CF_pow' (cf_Gs (-1)) (N + 1))
  have hsa : star (L.D ^ (N + 1) * G.Gs P (-1) ^ (N + 1)) * a ∈ Z P L (N + 1) := by
    rw [star_mul, star_pow, star_pow, star_Gs hTTp hL hLaw, h5]; exact ha
  induction hy using Submodule.span_induction with
  | mem y hy =>
    obtain ⟨β, H, hβ, hH, hl, rfl⟩ := hy
    have e : (L.ζ * L.ζb * L.GGi) ^ (N + 1) * kap P (DQ P) κ * (β * L.Dbi ^ (N + 1) * H.prod) =
        (kap P (DQ P) κ * β) * (L.D ^ (N + 1) * G.Gs P (-1) ^ (N + 1)) * H.prod := by
      obtain ⟨-, -, -, -, -, hW⟩ := fnPs hTTp hL hLaw
      have hkβ : kap P (DQ P) κ * β ∈ Formalism.FourierDecayAlt.P.MAx3.I4.SB L := Submonoid.mul_mem _ (kap_SB hTTp hL hLaw κ) hβ
      have c1 : (L.ζ * L.ζb * L.GGi) ^ (N + 1) * (kap P (DQ P) κ * β) =
          (kap P (DQ P) κ * β) * (L.ζ * L.ζb * L.GGi) ^ (N + 1) :=
        (SB_comm_fnP hL hLaw hkβ (isFnP_pow hW (N + 1))).symm
      calc (L.ζ * L.ζb * L.GGi) ^ (N + 1) * kap P (DQ P) κ * (β * L.Dbi ^ (N + 1) * H.prod)
          = ((L.ζ * L.ζb * L.GGi) ^ (N + 1) * (kap P (DQ P) κ * β)) * L.Dbi ^ (N + 1) * H.prod := by
            simp only [mul_assoc]
        _ = (kap P (DQ P) κ * β) * ((L.ζ * L.ζb * L.GGi) ^ (N + 1) * L.Dbi ^ (N + 1)) * H.prod := by
            rw [c1]; simp only [mul_assoc]
        _ = _ := by rw [D_power_identity_three hTTp hL hLaw]
    rw [e]
    exact QA_term hTTp hL hLaw hD hA (Submonoid.mul_mem _ (kap_SB hTTp hL hLaw κ) hβ) hs
      (fun h hh => Or.inl (Or.inl (hH h hh))) (k := N + 1) (by rw [hl]; omega) hsa
  | zero => rw [mul_zero]; exact QA_zero _
  | add a' b _ _ h1 h2 => rw [mul_add]; exact QA_add h1 h2
  | smul c a' _ h1 => rw [mul_smul_comm]; exact QA_smul c h1

/- English proof (translation)
Take `⟨hD', hDi, hDb, hDbi, hG, hW⟩` from `fnPs hTTp hL hLaw`. Take `⟨hI, -⟩` from `D_power_identity_five hTTp hL hLaw N`. Establish `hDD : L.Db * L.Di ∈ Formalism.FourierDecayAlt.P.MAx3.I4.SB L` using `Submonoid.subset_closure (Or.inl (Or.inl (Or.inl (by simp))))`. Proceed by induction on `hx using Submodule.span_induction with`. Consider the case `mem y hy`.

Take `⟨β, H, hβ, hH, hl, rfl⟩` from `hy`. Establish `e : G.Gs P (-1) ^ (N + 1) * L.Db ^ (N + 1) * (L.Di * L.Ahat Y * (Ph P ψ * (β * L.Dbi ^ N * H.prod))) = G.Gs P (-1) ^ (N + 1) * ((L.Db ^ (N + 1) * L.Di * L.Dbi ^ N) * (L.Ahat Y * (Ph P ψ * β * H.prod)))`. Establish `c1 : Ph P ψ * (β * L.Dbi ^ N) = L.Dbi ^ N * (Ph P ψ * β)`. Rewrite using `[SB_comm_fnP hL hLaw hβ (isFnP_pow hDbi N), ← mul_assoc, isFnP_comm (isFnP_Ph ψ) (isFnP_pow hDbi N), mul_assoc]`. Combine the equalities or inequalities in the displayed calculation.

Simplify using `only [mul_assoc]`. Use `_ = G.Gs P (-1) ^ (N + 1) * (L.Db ^ (N + 1) * L.Di * ((L.Ahat Y * L.Dbi ^ N) * (Ph P ψ * β * H.prod))) := by`. Rewrite using `[c1]`. Simplify using `only [mul_assoc]`. Use `_ = _ := by rw [comm_Dbipow_A]; simp only [mul_assoc]`.

Rewrite using `[e, hI]`. Use `Gspow_memZ hTTp hL hLaw (N + 1) (SB_memZ hTTp hL hLaw hDD ?_)` and prove the remaining obligations. Establish `hz : Ph P ψ * β * H.prod ∈ Z P L N` using `Submodule.subset_span ⟨ψ, β, H, hψ, hβ, fun h hh => Or.inl (Or.inl (hH h hh)), hl.le, rfl⟩`. Conclude with `hatPast hTTp.le hL hLaw (Or.inl (Or.inl (Or.inl ⟨Y, rfl⟩))) hz`. Consider the case `zero => simp`.

Consider the case `add a b _ _ h1 h2 => rw [mul_add, mul_add, mul_add]`. Conclude with `Submodule.add_mem _ h1 h2`. Consider the case `smul c a _ h1 => rw [mul_smul_comm, mul_smul_comm, mul_smul_comm]`. Conclude with `Submodule.smul_mem _ c h1`.
-/
theorem rc1 {N : ℕ} {ψ : ℝ → ℝ} (hψ : admitted ψ) {x : A P (DQ P)} (hx : x ∈ NFD L N) (Y : ℂ) :
    G.Gs P (-1) ^ (N + 1) * L.Db ^ (N + 1) * (L.Di * L.Ahat Y * (Ph P ψ * x)) ∈ Z P L (N + 1) := by
  obtain ⟨hD', hDi, hDb, hDbi, hG, hW⟩ := fnPs hTTp hL hLaw
  obtain ⟨hI, -⟩ := D_power_identity_five hTTp hL hLaw N
  have hDD : L.Db * L.Di ∈ Formalism.FourierDecayAlt.P.MAx3.I4.SB L := Submonoid.subset_closure (Or.inl (Or.inl (Or.inl (by simp))))
  induction hx using Submodule.span_induction with
  | mem y hy =>
    obtain ⟨β, H, hβ, hH, hl, rfl⟩ := hy
    have e : G.Gs P (-1) ^ (N + 1) * L.Db ^ (N + 1) * (L.Di * L.Ahat Y * (Ph P ψ * (β * L.Dbi ^ N * H.prod))) =
        G.Gs P (-1) ^ (N + 1) * ((L.Db ^ (N + 1) * L.Di * L.Dbi ^ N) * (L.Ahat Y * (Ph P ψ * β * H.prod))) := by
      have c1 : Ph P ψ * (β * L.Dbi ^ N) = L.Dbi ^ N * (Ph P ψ * β) := by
        rw [SB_comm_fnP hL hLaw hβ (isFnP_pow hDbi N), ← mul_assoc, isFnP_comm (isFnP_Ph ψ) (isFnP_pow hDbi N),
          mul_assoc]
      calc G.Gs P (-1) ^ (N + 1) * L.Db ^ (N + 1) * (L.Di * L.Ahat Y * (Ph P ψ * (β * L.Dbi ^ N * H.prod)))
          = G.Gs P (-1) ^ (N + 1) * (L.Db ^ (N + 1) * L.Di * (L.Ahat Y * ((Ph P ψ * (β * L.Dbi ^ N)) * H.prod))) := by
            simp only [mul_assoc]
        _ = G.Gs P (-1) ^ (N + 1) * (L.Db ^ (N + 1) * L.Di * ((L.Ahat Y * L.Dbi ^ N) * (Ph P ψ * β * H.prod))) := by
            rw [c1]; simp only [mul_assoc]
        _ = _ := by rw [comm_Dbipow_A]; simp only [mul_assoc]
    rw [e, hI]
    refine Gspow_memZ hTTp hL hLaw (N + 1) (SB_memZ hTTp hL hLaw hDD ?_)
    have hz : Ph P ψ * β * H.prod ∈ Z P L N :=
      Submodule.subset_span ⟨ψ, β, H, hψ, hβ, fun h hh => Or.inl (Or.inl (hH h hh)), hl.le, rfl⟩
    exact hatPast hTTp.le hL hLaw (Or.inl (Or.inl (Or.inl ⟨Y, rfl⟩))) hz
  | zero => simp
  | add a b _ _ h1 h2 => rw [mul_add, mul_add, mul_add]; exact Submodule.add_mem _ h1 h2
  | smul c a _ h1 => rw [mul_smul_comm, mul_smul_comm, mul_smul_comm]; exact Submodule.smul_mem _ c h1

end

end Formalism.FourierDecayAlt.P.MAx3.AB

