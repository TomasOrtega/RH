theorem cyc (f : Fin n → Fin n → Fin n → ℝ) : ∑ a, ∑ b, ∑ c, f b c a = ∑ a, ∑ b, ∑ c, f a b c := by
  rw [sum_comm]
  refine sum_congr rfl fun b _ => ?_
  rw [sum_comm]

