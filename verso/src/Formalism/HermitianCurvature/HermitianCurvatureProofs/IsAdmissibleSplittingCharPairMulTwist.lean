          mul_le_mul_of_nonneg_right (norm_sum_le _ _) (pow_nonneg (Dabs_pos hTTp.le q).le _)
      _ = ∑ π', ‖Mb q π π'‖ * ‖evQ P (actA P H.prod j π') q‖ * (‖v q‖ * Dabs q ^ (i + i')) := by
