open Formalism.FourierDecayAlt Formalism.FourierDecayAlt.MA Formalism.FourierDecayAlt.P.MAx3.NF

/- English proof (translation)
Introduce `P l L j lam α β Lb Ntot hH N hN`. Establish `hOK : P.OK` using `hH.1.1`. Establish `hL : IsModelLevel P (DQ P) L` using `hH.1.2.2.2.1`. Establish `hTT : 0 < P.TT` using `mul_pos hOK.T_pos hOK.T'_pos`. Establish `hu : ∀ π, (fun q => ju P j q π) ∈ smSub P.r P.TT` using `fun π => (j π).2`.

Take `⟨c, hcm, hc⟩` from `monPoly P L (ju P j) hu N`. Use `⟨(fun y q i => monL P L (ju P j) 0 (List.ofFn y) q (cast (iota_len P N y) i), fun Y q i k => ptMat P (Bm P l L (List.ofFn Y)) q (cast (iota_len P N Y) i) (cast (iota_len P N Y) k)), ⟨?_, ?_, ?_⟩, ?_, ?_, ?_⟩` and prove the remaining obligations. Conclude with `MAx3.Wq_meas P`. Introduce `y i`. Conclude with `(cont_of_mem P (monL_mem P L (ju P j) hu 0 (List.ofFn y) _)).measurable`.

Introduce `Y i k`. Conclude with `(ptMat_cont P _ _ _).measurable`. Introduce `Y hY s ω i`. Conclude with `factor_id hTT hL (ju P j) hu N Y s ω i`. Introduce `Y hY`.

Establish `hB` using `Bm_mem (l := l) hTT.le hL (List.ofFn Y)`. Establish `hBi` using `Bi_mem (l := l) hTT.le hL (List.ofFn Y)`. Take `⟨C1, hC1⟩` from `ptMat_bdd P (Bm P l L (List.ofFn Y)) fun e e' => BB_le hTT hL (hB e e')`. Take `⟨C2, hC2⟩` from `ptMat_bdd P (Bi P l L (List.ofFn Y)) fun e e' => BB_le hTT hL (hBi e e')`. Use `⟨max C1 C2, fun ω i k => ptMat P (Bi P l L (List.ofFn Y)) ω (cast (iota_len P N Y) i) (cast (iota_len P N Y) k), fun ω i k => ⟨(hC1 _ _ _).trans (le_max_left _ _), (hC2 _ _ _).trans (le_max_right _ _)⟩, fun i k => (ptMat_cont P _ _ _).measurable, fun ω v i => ?_⟩` and prove the remaining obligations.

Conclude with `inv_prop hTT hL (List.ofFn Y) N (iota_len P N Y) ω v i`. Conclude with `⟨c, fun y ω i => hc y ω i⟩`.
-/
theorem factor_exists : Formalism.FourierDecayAlt.MA.FactorExistsQ := by
  intro P l L j lam α β Lb Ntot hH N hN
  have hOK : P.OK := hH.1.1
  have hL : IsModelLevel P (DQ P) L := hH.1.2.2.2.1
  have hTT : 0 < P.TT := mul_pos hOK.T_pos hOK.T'_pos
  have hu : ∀ π, (fun q => ju P j q π) ∈ smSub P.r P.TT := fun π => (j π).2
  obtain ⟨c, hcm, hc⟩ := monPoly P L (ju P j) hu N
  refine ⟨(fun y q i => monL P L (ju P j) 0 (List.ofFn y) q (cast (iota_len P N y) i),
    fun Y q i k => ptMat P (Bm P l L (List.ofFn Y)) q (cast (iota_len P N Y) i) (cast (iota_len P N Y) k)),
    ⟨?_, ?_, ?_⟩, ?_, ?_, ?_⟩
  · exact MAx3.Wq_meas P
  · intro y i
    exact (cont_of_mem P (monL_mem P L (ju P j) hu 0 (List.ofFn y) _)).measurable
  · intro Y i k
    exact (ptMat_cont P _ _ _).measurable
  · intro Y hY s ω i
    exact factor_id hTT hL (ju P j) hu N Y s ω i
  · intro Y hY
    have hB := Bm_mem (l := l) hTT.le hL (List.ofFn Y)
    have hBi := Bi_mem (l := l) hTT.le hL (List.ofFn Y)
    obtain ⟨C1, hC1⟩ := ptMat_bdd P (Bm P l L (List.ofFn Y)) fun e e' => BB_le hTT hL (hB e e')
    obtain ⟨C2, hC2⟩ := ptMat_bdd P (Bi P l L (List.ofFn Y)) fun e e' => BB_le hTT hL (hBi e e')
    refine ⟨max C1 C2, fun ω i k => ptMat P (Bi P l L (List.ofFn Y)) ω (cast (iota_len P N Y) i) (cast (iota_len P N Y) k),
      fun ω i k => ⟨(hC1 _ _ _).trans (le_max_left _ _), (hC2 _ _ _).trans (le_max_right _ _)⟩,
      fun i k => (ptMat_cont P _ _ _).measurable, fun ω v i => ?_⟩
    exact inv_prop hTT hL (List.ofFn Y) N (iota_len P N Y) ω v i
  · exact ⟨c, fun y ω i => hc y ω i⟩

end Formalism.FourierDecayAlt.P

