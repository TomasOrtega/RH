/- English proof (translation)
The claim follows from `| [], Y, _ => by simp [psR] | a :: v, Y, h => by have ih := psR_bounds L hL v Y (fun b hb => h b (List.mem_cons_of_mem _ hb)) have ha := h a List.mem_cons_self have h1 : 0 < Y - a.pt.re := by linarith have hf : 1 ≤ (Y - a.pt.re + 1) / (Y - a.pt.re) ∧ (Y - a.pt.re + 1) / (Y - a.pt …`.
-/
theorem psR_bounds (L : ℝ) (hL : 2 ≤ L) : ∀ (v : List (Letter ℂ S)) (Y : ℝ),
    (∀ a ∈ v, L ≤ Y - a.pt.re) → 1 ≤ psR v Y ∧ psR v Y ≤ (1 + 1 / L) ^ v.length
