noncomputable section

structure Ctx (P : M.Par) (l : ℕ) (α β Lb : ℝ) (Ntot : ℕ) (w : List ℝ) (Y s : ℝ) : Prop where
  hOK : P.OK
  hl1 : 1 ≤ l
  hlk : l ≤ P.k
  hcut : ∀ Z ∈ Set.Icc α β, I.OnCut P.u P.u' l Z
  hαβ : α < β
  hL2 : 2 < Lb
  hNL : (Ntot : ℝ) ≤ Lb
  hNpos : 1 ≤ Ntot
  hn : ((P.k + 2 * P.r + 1 : ℕ) : ℝ) * Lb ≤ β - α
  h6 : 6 * (Ntot : ℝ) * Lb ≤ β - α
  hlen : w.length < Ntot
  hYm : α + (β - α) / 3 ≤ Y ∧ Y ≤ β - (β - α) / 3
  hYsm : α + (β - α) / 3 ≤ Y + s ∧ Y + s ≤ β - (β - α) / 3
  hsL : |s| ≤ Lb
  hwm : ∀ p ∈ w, α + (β - α) / 3 ≤ p ∧ p ≤ β - (β - α) / 3
  hfar : ∀ p ∈ w, Lb ≤ Y - p ∧ Lb ≤ Y + s - p
  hord : w.Pairwise fun p p' => Lb ≤ p - p'

/- English proof (translation)
Take `⟨⟨hOK, hl1, hlk, _, hu, hu', hαβ, hcut⟩, _, _, _, hrN, hNL, hL2, hn, h6⟩` from `hH`. Establish `hBF` using `Formalism.FourierDecayAlt.P.boxes_fit (sysQ P l L j lam α β Lb c Ntot) hL2 h6`. Establish `hYb : Y ∈ (sysQ P l L j lam α β Lb c Ntot).box w.length` using `hY`. Establish `hYsb : Y + s ∈ (sysQ P l L j lam α β Lb c Ntot).box w.length` using `hYs`. Establish `hY' : α + (β - α) / 3 + 2 * (w.length : ℝ) * Lb ≤ Y ∧ Y ≤ α + (β - α) / 3 + 2 * (w.length : ℝ) * Lb + Lb` using `hY`.

Establish `hYs' : α + (β - α) / 3 + 2 * (w.length : ℝ) * Lb ≤ Y + s ∧ Y + s ≤ α + (β - α) / 3 + 2 * (w.length : ℝ) * Lb + Lb` using `hYs`. Apply the tactic sequence `refine ⟨hOK, hl1, hlk, hcut, hαβ, hL2, hNL, by omega, hn, h6, hl, hBF.1 w.length hl hYb, hBF.1 w.length hl hYsb, by rw [abs_le]; constructor <;> linarith [hY'.1, hY'.2, hYs'.1, hYs'.2], fun p hp => ?_, fun p hp => ?_, onBoxes_pairwise _ hBF.2.1 w hw⟩`. Take `⟨a, ha, hpa⟩` from `onBoxes_mem _ w hw p hp`. Conclude with `hBF.1 a (by show a < Ntot; omega) hpa`. Take `⟨a, ha, hpa⟩` from `onBoxes_mem _ w hw p hp`.

Conclude with `⟨hBF.2.1 a w.length ha p hpa Y hYb, hBF.2.1 a w.length ha p hpa (Y + s) hYsb⟩`.
-/
theorem ctx_of (P : M.Par) (l : ℕ) (L : R.LevelData (A P (DQ P)) P.r) (j : M.Ty P → SmQ P.r P.TT)
    (lam : Fin (P.k + 2 * P.r + 1) → ℝ) (α β Lb : ℝ) (c : LE.Cut) (Ntot : ℕ)
    (hH : Hyps P l L j lam α β Lb Ntot) (w : List ℝ) (hw : (sysQ P l L j lam α β Lb c Ntot).OnBoxes w)
    (hl : w.length < Ntot) (Y s : ℝ) (hY : Y ∈ ((sysQ P l L j lam α β Lb c Ntot).step w).J)
    (hYs : Y + s ∈ ((sysQ P l L j lam α β Lb c Ntot).step w).J) : Ctx P l α β Lb Ntot w Y s := by
  obtain ⟨⟨hOK, hl1, hlk, _, hu, hu', hαβ, hcut⟩, _, _, _, hrN, hNL, hL2, hn, h6⟩ := hH
  have hBF := Formalism.FourierDecayAlt.P.boxes_fit (sysQ P l L j lam α β Lb c Ntot) hL2 h6
  have hYb : Y ∈ (sysQ P l L j lam α β Lb c Ntot).box w.length := hY
  have hYsb : Y + s ∈ (sysQ P l L j lam α β Lb c Ntot).box w.length := hYs
  have hY' : α + (β - α) / 3 + 2 * (w.length : ℝ) * Lb ≤ Y ∧ Y ≤ α + (β - α) / 3 + 2 * (w.length : ℝ) * Lb + Lb := hY
  have hYs' : α + (β - α) / 3 + 2 * (w.length : ℝ) * Lb ≤ Y + s ∧
      Y + s ≤ α + (β - α) / 3 + 2 * (w.length : ℝ) * Lb + Lb := hYs
  refine ⟨hOK, hl1, hlk, hcut, hαβ, hL2, hNL, by omega, hn, h6, hl, hBF.1 w.length hl hYb, hBF.1 w.length hl hYsb,
    by rw [abs_le]; constructor <;> linarith [hY'.1, hY'.2, hYs'.1, hYs'.2], fun p hp => ?_, fun p hp => ?_,
    onBoxes_pairwise _ hBF.2.1 w hw⟩
  · obtain ⟨a, ha, hpa⟩ := onBoxes_mem _ w hw p hp
    exact hBF.1 a (by show a < Ntot; omega) hpa
  · obtain ⟨a, ha, hpa⟩ := onBoxes_mem _ w hw p hp
    exact ⟨hBF.2.1 a w.length ha p hpa Y hYb, hBF.2.1 a w.length ha p hpa (Y + s) hYsb⟩

section
variable {P : M.Par} {l : ℕ} {α β Lb : ℝ} {Ntot : ℕ} {w : List ℝ} {Y s : ℝ}

/- English proof (translation)
Establish `h1 : (1 : ℝ) ≤ Ntot` using `by exact_mod_cast h.hNpos`. Use polynomial arithmetic with `[h.h6, h.hL2]`.
-/
theorem Ctx.twelve_le_window (h : Ctx P l α β Lb Ntot w Y s) : 12 ≤ β - α := by
  have h1 : (1 : ℝ) ≤ Ntot := by exact_mod_cast h.hNpos
  nlinarith [h.h6, h.hL2]

/- English proof (translation)
Establish `hπ` using `Formalism.FourierDecayAlt.P.types_interlace P h.hOK π`. Establish `h0` using `Formalism.FourierDecayAlt.P.interlacing_sign P.k P.u P.u' (M.rho P π) l Z h.hl1 h.hlk hπ (h.hcut Z hZ) 0 (by simp)`. Establish `h1` using `Formalism.FourierDecayAlt.P.interlacing_sign P.k P.u P.u' (M.rho P π) l Z h.hl1 h.hlk hπ (h.hcut Z hZ) 1 (by simp)`. Rewrite `h0` using `[add_zero]`. Conclude with `⟨h0, h1⟩`.
-/
theorem Ctx.sx_pos (h : Ctx P l α β Lb Ntot w Y s) (π : M.Ty P) (Z : ℝ) (hZ : Z ∈ Set.Icc α β) :
    0 < sx P l π Z ∧ 0 < sx P l π (Z + 1) := by
  have hπ := Formalism.FourierDecayAlt.P.types_interlace P h.hOK π
  have h0 := Formalism.FourierDecayAlt.P.interlacing_sign P.k P.u P.u' (M.rho P π) l Z h.hl1 h.hlk hπ (h.hcut Z hZ) 0 (by simp)
  have h1 := Formalism.FourierDecayAlt.P.interlacing_sign P.k P.u P.u' (M.rho P π) l Z h.hl1 h.hlk hπ (h.hcut Z hZ) 1 (by simp)
  rw [add_zero] at h0
  exact ⟨h0, h1⟩

/- English proof (translation)
Establish `hπ` using `Formalism.FourierDecayAlt.P.types_interlace P h.hOK (fun _ => 0)`. Conclude with `Formalism.FourierDecayAlt.P.q_positive_interlacing P.k P.u P.u' _ l Z P.T P.T' h.hl1 h.hlk hπ (h.hcut Z hZ) h.hOK.T_pos h.hOK.T'_pos`.
-/
theorem Ctx.qp_pos (h : Ctx P l α β Lb Ntot w Y s) (Z : ℝ) (hZ : Z ∈ Set.Icc α β) : 0 < qp P Z := by
  have hπ := Formalism.FourierDecayAlt.P.types_interlace P h.hOK (fun _ => 0)
  exact Formalism.FourierDecayAlt.P.q_positive_interlacing P.k P.u P.u' _ l Z P.T P.T' h.hl1 h.hlk hπ (h.hcut Z hZ) h.hOK.T_pos h.hOK.T'_pos

/- English proof (translation)
Assemble the required witnesses or components as `⟨by linarith [hZ.1, h.hαβ], by linarith [hZ.2, h.hαβ]⟩`.
-/
theorem Ctx.mid_I (h : Ctx P l α β Lb Ntot w Y s) (Z : ℝ) (hZ : α + (β - α) / 3 ≤ Z ∧ Z ≤ β - (β - α) / 3) :
    Z ∈ Set.Icc α β := ⟨by linarith [hZ.1, h.hαβ], by linarith [hZ.2, h.hαβ]⟩

/- English proof (translation)
Take `⟨h0, h1⟩` from `h.sx_pos π Z hZ`. Unfold `sx at h0 h1`. Conclude with `⟨fun e => by rw [e, mul_zero] at h0; exact lt_irrefl _ h0, fun e => by rw [e, mul_zero] at h1; exact lt_irrefl _ h1⟩`.
-/
theorem Ctx.xpoly_ne (h : Ctx P l α β Lb Ntot w Y s) (π : M.Ty P) (Z : ℝ) (hZ : Z ∈ Set.Icc α β) :
    I.xpoly P.k (M.rho P π) Z ≠ 0 ∧ I.xpoly P.k (M.rho P π) (Z + 1) ≠ 0 := by
  obtain ⟨h0, h1⟩ := h.sx_pos π Z hZ
  unfold sx at h0 h1
  exact ⟨fun e => by rw [e, mul_zero] at h0; exact lt_irrefl _ h0, fun e => by rw [e, mul_zero] at h1; exact lt_irrefl _ h1⟩

/- English proof (translation)
Establish `hwI : ∀ p ∈ w, p ∈ Set.Icc α β` using `fun p hp => h.mid_I p (h.hwm p hp)`. Establish `hcutW : M.CutWord P l (wordP w)`. Use `⟨plusWord_slots_nodup w, fun a ha => ?_, MAx2.pairwise_wordP ?_⟩` and prove the remaining obligations. Take `⟨p, hp, e⟩` from `MAx2.mem_wordP ha`. Rewrite using `[e]`.

Conclude with `⟨Complex.ofReal_im _, by rw [Complex.ofReal_re]; exact h.hcut p (hwI p hp)⟩`. Conclude with `h.hord.imp fun hh => by rw [abs_of_pos (by linarith [h.hL2])]; linarith [h.hL2]`. Establish `hpts : ∀ a ∈ wordP w, ∀ jj, a.pt ≠ gJ P jj`. Introduce `a ha jj e`. Take `⟨p, hp, ep⟩` from `MAx2.mem_wordP ha`.

Rewrite `e` using `[ep, gJ]`. Establish `e' : p = -M.rho P jj.2 ((jj.1 : ℕ) + 1)` using `by exact_mod_cast e`. Establish `hne` using `(h.xpoly_ne jj.2 p (hwI p hp)).1`. Apply `hne` to reduce the goal to its premises. Apply `Finset.prod_eq_zero (i := (jj.1 : ℕ) + 1) (by have := jj.1.isLt; simp only [mem_Icc]; omega)` to reduce the goal to its premises.

Rewrite using `[e']`. Expand and normalize the polynomial expressions, which then agree. Establish `hZI` using `h.mid_I Z hZm`. Establish `hinv : ∀ Z' : ℝ, Z' ∈ Set.Icc α β ∨ Z' - 1 ∈ Set.Icc α β → (∀ p ∈ w, Lb ≤ Z' - p ∨ Lb + 1 ≤ Z' - p) → (Z' : ℂ) ∈ (ofWord L (startM P (DQ P) l) (wordP w)).inv`. Introduce `Z' hZ' hfar'`.

Apply `ofWord_inv L _ (wordP w) (plusWord_letters_plus w)` to reduce the goal to its premises. Introduce `π`. Rewrite using `[xC_real]`. Break down `hZ' with hZ' | hZ'` into its components or cases. Conclude with `(h.xpoly_ne π Z' hZ').1` after adjusting the coercions.

Use `(h.xpoly_ne π (Z' - 1) hZ').2` as an intermediate fact. Rewrite `this` using `[sub_add_cancel]`. Conclude with `this` after adjusting the coercions. Introduce `a ha`. Take `⟨p, hp, ep⟩` from `MAx2.mem_wordP ha`.

Rewrite using `[ep]`. Apply the tactic sequence `have hd : 2 < Z' - p := by rcases hfar' p hp with hh | hh <;> linarith [h.hL2]`. Prove the components needed by the constructor for the conclusion. Introduce `e; have : Z' - p = 0 := by exact_mod_cast e`. Combine the linear equalities and inequalities to obtain the conclusion.

Introduce `e; have : Z' - p = 1 := by exact_mod_cast e`. Combine the linear equalities and inequalities to obtain the conclusion. Establish `hne : ∀ jj, (Z : ℂ) ≠ gJ P jj`. Introduce `jj e`. Rewrite `e` using `[gJ]`.

Establish `e' : Z = -M.rho P jj.2 ((jj.1 : ℕ) + 1)` using `by exact_mod_cast e`. Establish `hne` using `(h.xpoly_ne jj.2 Z hZI).1`. Apply `hne` to reduce the goal to its premises. Apply `Finset.prod_eq_zero (i := (jj.1 : ℕ) + 1) (by have := jj.1.isLt; simp only [mem_Icc]; omega)` to reduce the goal to its premises. Rewrite using `[e']`.

Expand and normalize the polynomial expressions, which then agree. Establish `h1 : (Z : ℂ) + 1 = ((Z + 1 : ℝ) : ℂ)` using `by push_cast; ring`. Establish `hi0` using `hinv Z (Or.inl hZI) fun p hp => Or.inl (hZfar p hp)`. Establish `hZ1 : Z + 1 - 1 ∈ Set.Icc α β` using `by rw [add_sub_cancel_right]; exact hZI`. Establish `hi1` using `hinv (Z + 1) (Or.inr hZ1) fun p hp => Or.inr (by linarith [hZfar p hp])`.

Rewrite `hi1` using `[← h1]`. Conclude with `ee_form P l L h.hOK h.hl1 h.hlk hL w hcutW hpts (Z : ℂ) hi0 hi1 hne`.
-/
theorem Ctx.ee_at (h : Ctx P l α β Lb Ntot w Y s) (L : R.LevelData (A P (DQ P)) P.r) (hL : IsModelLevel P (DQ P) L)
    (Z : ℝ) (hZm : α + (β - α) / 3 ≤ Z ∧ Z ≤ β - (β - α) / 3) (hZfar : ∀ p ∈ w, Lb ≤ Z - p) :
    (frW P l L w).ee (Z : ℂ) = eeF P w L (Z : ℂ) := by
  have hwI : ∀ p ∈ w, p ∈ Set.Icc α β := fun p hp => h.mid_I p (h.hwm p hp)
  have hcutW : M.CutWord P l (wordP w) := by
    refine ⟨plusWord_slots_nodup w, fun a ha => ?_, MAx2.pairwise_wordP ?_⟩
    · obtain ⟨p, hp, e⟩ := MAx2.mem_wordP ha
      rw [e]
      exact ⟨Complex.ofReal_im _, by rw [Complex.ofReal_re]; exact h.hcut p (hwI p hp)⟩
    · exact h.hord.imp fun hh => by rw [abs_of_pos (by linarith [h.hL2])]; linarith [h.hL2]
  have hpts : ∀ a ∈ wordP w, ∀ jj, a.pt ≠ gJ P jj := by
    intro a ha jj e
    obtain ⟨p, hp, ep⟩ := MAx2.mem_wordP ha
    rw [ep, gJ] at e
    have e' : p = -M.rho P jj.2 ((jj.1 : ℕ) + 1) := by exact_mod_cast e
    have hne := (h.xpoly_ne jj.2 p (hwI p hp)).1
    apply hne
    apply Finset.prod_eq_zero (i := (jj.1 : ℕ) + 1) (by have := jj.1.isLt; simp only [mem_Icc]; omega)
    rw [e']; ring
  have hZI := h.mid_I Z hZm
  have hinv : ∀ Z' : ℝ, Z' ∈ Set.Icc α β ∨ Z' - 1 ∈ Set.Icc α β → (∀ p ∈ w, Lb ≤ Z' - p ∨ Lb + 1 ≤ Z' - p) →
      (Z' : ℂ) ∈ (ofWord L (startM P (DQ P) l) (wordP w)).inv := by
    intro Z' hZ' hfar'
    apply ofWord_inv L _ (wordP w) (plusWord_letters_plus w)
    · intro π
      rw [xC_real]
      rcases hZ' with hZ' | hZ'
      · exact_mod_cast (h.xpoly_ne π Z' hZ').1
      · have := (h.xpoly_ne π (Z' - 1) hZ').2
        rw [sub_add_cancel] at this
        exact_mod_cast this
    · intro a ha
      obtain ⟨p, hp, ep⟩ := MAx2.mem_wordP ha
      rw [ep]
      have hd : 2 < Z' - p := by rcases hfar' p hp with hh | hh <;> linarith [h.hL2]
      constructor
      · intro e; have : Z' - p = 0 := by exact_mod_cast e
        linarith
      · intro e; have : Z' - p = 1 := by exact_mod_cast e
        linarith
  have hne : ∀ jj, (Z : ℂ) ≠ gJ P jj := by
    intro jj e
    rw [gJ] at e
    have e' : Z = -M.rho P jj.2 ((jj.1 : ℕ) + 1) := by exact_mod_cast e
    have hne := (h.xpoly_ne jj.2 Z hZI).1
    apply hne
    apply Finset.prod_eq_zero (i := (jj.1 : ℕ) + 1) (by have := jj.1.isLt; simp only [mem_Icc]; omega)
    rw [e']; ring
  have h1 : (Z : ℂ) + 1 = ((Z + 1 : ℝ) : ℂ) := by push_cast; ring
  have hi0 := hinv Z (Or.inl hZI) fun p hp => Or.inl (hZfar p hp)
  have hZ1 : Z + 1 - 1 ∈ Set.Icc α β := by rw [add_sub_cancel_right]; exact hZI
  have hi1 := hinv (Z + 1) (Or.inr hZ1) fun p hp => Or.inr (by linarith [hZfar p hp])
  rw [← h1] at hi1
  exact ee_form P l L h.hOK h.hl1 h.hlk hL w hcutW hpts (Z : ℂ) hi0 hi1 hne

end

