/- English proof (translation)
Simplify using `[dotProduct, Fintype.sum_sum_type]`.
-/
theorem elim_dot {R : Type} [CommRing R] {κ κ' : Type} [Fintype κ] [Fintype κ'] (u v : κ → R) (x y : κ' → R) :
    Sum.elim u x ⬝ᵥ Sum.elim v y = u ⬝ᵥ v + x ⬝ᵥ y := by
  simp [dotProduct, Fintype.sum_sum_type]

/- English proof (translation)
Use function extensionality and compare the values at `x`. Simplify using `only [schr, Pi.star_apply, star_mul', dotProduct_neg, mul_neg, ← neg_add, AddChar.map_neg_eq_inv]`. Rewrite using `[Complex.inv_eq_conj (hψ _), Complex.star_def, Complex.conj_conj]`.
-/
theorem star_schr' {R : Type} [CommRing R] [Invertible (2 : R)] (ψ : AddChar R ℂ) (hψ : ∀ x, ‖ψ x‖ = 1)
    {κ : Type} [Fintype κ] (w : (κ → R) × (κ → R)) (φ : (κ → R) → ℂ) :
    star (schr ψ (w.1, -w.2) φ) = schr ψ w (star φ) := by
  funext x
  simp only [schr, Pi.star_apply, star_mul', dotProduct_neg, mul_neg, ← neg_add, AddChar.map_neg_eq_inv]
  rw [Complex.inv_eq_conj (hψ _), Complex.star_def, Complex.conj_conj]

variable {F : Type} [Field F] [NumberField F]

/- English proof (translation)
Establish `e1 : (fun x => Φ (Sum.elim x b)) = fun x => Φ (GlobalTheory.ThK.Adapt.glue (Equiv.sumComm κ κ') b x)`. Apply the tactic sequence `funext fun x => congrArg Φ (funext fun k => by cases k <;> rfl)`. Rewrite using `[e1]`. Conclude with `GlobalTheory.ThK.Adapt.slice_mem_schA (Equiv.sumComm κ κ') b hΦ`.
-/
theorem sliceL {κ κ' : Type} [Fintype κ] [Fintype κ'] {Φ : (κ ⊕ κ' → AF F) → ℂ} (hΦ : Φ ∈ schA F (κ ⊕ κ'))
    (b : κ' → AF F) : (fun x => Φ (Sum.elim x b)) ∈ schA F κ := by
  have e1 : (fun x => Φ (Sum.elim x b)) = fun x => Φ (GlobalTheory.ThK.Adapt.glue (Equiv.sumComm κ κ') b x) :=
    funext fun x => congrArg Φ (funext fun k => by cases k <;> rfl)
  rw [e1]
  exact GlobalTheory.ThK.Adapt.slice_mem_schA (Equiv.sumComm κ κ') b hΦ

/- English proof (translation)
The claim follows from `GlobalTheory.ThK.Adapt.slice_mem_schA (Equiv.refl (κ ⊕ κ')) a hΦ`.
-/
theorem sliceR {κ κ' : Type} [Fintype κ] [Fintype κ'] {Φ : (κ ⊕ κ' → AF F) → ℂ} (hΦ : Φ ∈ schA F (κ ⊕ κ'))
    (a : κ → AF F) : (fun x => Φ (Sum.elim a x)) ∈ schA F κ' :=
  GlobalTheory.ThK.Adapt.slice_mem_schA (Equiv.refl (κ ⊕ κ')) a hΦ

/- English proof (translation)
Introduce `F _ _ ψ hψ κ κ₁ _ _ T A₁ B₁ A₂ B₂ a b h1 h2 h3 φ hφ`. Establish `hconj : ∀ g ∈ schA F κ, conjMap T (schr ψ (A₂, -B₂) g) = schr ψ (a, -b) (conjMap T g)`. Introduce `g hg`. Establish `hs : star g ∈ schA F κ` using `GlobalTheory.SchAConj.star_mem_schA F κ g hg`. Rewrite using `[conjMap_apply, conjMap_apply, star_schr' ψ hψ (A₂, B₂) g, h2 _ hs]`.

Use `star_schr' ψ hψ (a, -b) (T (star g))` as an intermediate fact. Simplify `this` using `only [neg_neg]`. Use function extensionality and compare the values at `s`. Establish `hΨ` using `h3 φ hφ`. Establish `hslice` using `sliceL hΨ (s ∘ Sum.inr + a)`.

Establish `hinner : (fun x₁ => conjMap T (fun x₂ => schr ψ (Sum.elim A₁ A₂, Sum.elim B₁ (-B₂)) φ (Sum.elim x₁ x₂)) (s ∘ Sum.inr)) = ψ (-((s ∘ Sum.inr) ⬝ᵥ b) - ⅟(2 : AF F) * (a ⬝ᵥ b)) • schr ψ (A₁, B₁) (fun x₁ => partR (conjMap T) φ (Sum.elim x₁ (s ∘ Sum.inr + a)))`. Use function extensionality and compare the values at `x₁`. Establish `e1 : (fun x₂ => schr ψ (Sum.elim A₁ A₂, Sum.elim B₁ (-B₂)) φ (Sum.elim x₁ x₂)) = ψ (x₁ ⬝ᵥ B₁ + ⅟(2 : AF F) * (A₁ ⬝ᵥ B₁)) • schr ψ (A₂, -B₂) (fun x₂ => φ (Sum.elim (x₁ + A₁) x₂))`. Use function extensionality and compare the values at `x₂`. Simplify using `only [schr, Pi.smul_apply, smul_eq_mul, elim_dot, Sum.elim_add_add]`.

Rewrite using `[← mul_assoc, ← AddChar.map_add_eq_mul]`. Use `congr 2`. Expand and normalize the polynomial expressions, which then agree. Rewrite using `[e1, map_smul, hconj _ (sliceR hφ _)]`. Simplify using `only [Pi.smul_apply, smul_eq_mul, schr, partR_apply, Sum.elim_comp_inl, Sum.elim_comp_inr]`.

Rewrite using `[dotProduct_neg, dotProduct_neg]`. Rewrite using `[show ∀ p q r : ℂ, p * (q * r) = q * (p * r) from fun p q r => by ring]`. Use `congr 2`. Put the polynomial expressions in normal form. Rewrite using `[evDbl_apply, hinner, map_smul, h1 _ hslice]`.

Simplify using `only [schr, Pi.smul_apply, smul_eq_mul, evDbl_apply, elim_dot, partR_apply, Sum.elim_comp_inl, Sum.elim_comp_inr, dotProduct_neg]`. Rewrite using `[← mul_assoc, ← AddChar.map_add_eq_mul]`. Use `congr 2`. Establish `hs : s ⬝ᵥ Sum.elim b (-b) = (s ∘ Sum.inl) ⬝ᵥ b - (s ∘ Sum.inr) ⬝ᵥ b`. Rewrite using `[← Sum.elim_comp_inl_inr s, elim_dot, dotProduct_neg, Sum.elim_comp_inl, Sum.elim_comp_inr, sub_eq_add_neg]`.

Rewrite using `[hs]`. Expand and normalize the polynomial expressions, which then agree.
-/
theorem main : ∀ (F : Type) [Field F] [NumberField F] (ψ : AddChar (AF F) ℂ), (∀ x, ‖ψ x‖ = 1) →
    ∀ (κ κ₁ : Type) [Fintype κ] [Fintype κ₁] (T : ((κ → AF F) → ℂ) →ₗ[ℂ] ((κ₁ → AF F) → ℂ))
      (A₁ B₁ A₂ B₂ : κ → AF F) (a b : κ₁ → AF F),
      (∀ Φ ∈ schA F κ, T (schr ψ (A₁, B₁) Φ) = schr ψ (a, b) (T Φ)) →
      (∀ Φ ∈ schA F κ, T (schr ψ (A₂, B₂) Φ) = schr ψ (a, b) (T Φ)) →
      (∀ φ ∈ schA F (κ ⊕ κ), partR (conjMap T) φ ∈ schA F (κ ⊕ κ₁)) →
      ∀ φ ∈ schA F (κ ⊕ κ), evDbl T (schr ψ (Sum.elim A₁ A₂, Sum.elim B₁ (-B₂)) φ) =
        schr ψ (Sum.elim a a, Sum.elim b (-b)) (evDbl T φ) := by
  intro F _ _ ψ hψ κ κ₁ _ _ T A₁ B₁ A₂ B₂ a b h1 h2 h3 φ hφ
  have hconj : ∀ g ∈ schA F κ, conjMap T (schr ψ (A₂, -B₂) g) = schr ψ (a, -b) (conjMap T g) := by
    intro g hg
    have hs : star g ∈ schA F κ := GlobalTheory.SchAConj.star_mem_schA F κ g hg
    rw [conjMap_apply, conjMap_apply, star_schr' ψ hψ (A₂, B₂) g, h2 _ hs]
    have := star_schr' ψ hψ (a, -b) (T (star g))
    simpa only [neg_neg] using this
  funext s
  have hΨ := h3 φ hφ
  have hslice := sliceL hΨ (s ∘ Sum.inr + a)
  have hinner : (fun x₁ => conjMap T (fun x₂ => schr ψ (Sum.elim A₁ A₂, Sum.elim B₁ (-B₂)) φ (Sum.elim x₁ x₂))
      (s ∘ Sum.inr)) = ψ (-((s ∘ Sum.inr) ⬝ᵥ b) - ⅟(2 : AF F) * (a ⬝ᵥ b)) •
        schr ψ (A₁, B₁) (fun x₁ => partR (conjMap T) φ (Sum.elim x₁ (s ∘ Sum.inr + a))) := by
    funext x₁
    have e1 : (fun x₂ => schr ψ (Sum.elim A₁ A₂, Sum.elim B₁ (-B₂)) φ (Sum.elim x₁ x₂)) =
        ψ (x₁ ⬝ᵥ B₁ + ⅟(2 : AF F) * (A₁ ⬝ᵥ B₁)) • schr ψ (A₂, -B₂) (fun x₂ => φ (Sum.elim (x₁ + A₁) x₂)) := by
      funext x₂
      simp only [schr, Pi.smul_apply, smul_eq_mul, elim_dot, Sum.elim_add_add]
      rw [← mul_assoc, ← AddChar.map_add_eq_mul]
      congr 2
      ring
    rw [e1, map_smul, hconj _ (sliceR hφ _)]
    simp only [Pi.smul_apply, smul_eq_mul, schr, partR_apply, Sum.elim_comp_inl, Sum.elim_comp_inr]
    rw [dotProduct_neg, dotProduct_neg]
    rw [show ∀ p q r : ℂ, p * (q * r) = q * (p * r) from fun p q r => by ring]
    congr 2
    ring_nf
  rw [evDbl_apply, hinner, map_smul, h1 _ hslice]
  simp only [schr, Pi.smul_apply, smul_eq_mul, evDbl_apply, elim_dot, partR_apply, Sum.elim_comp_inl,
    Sum.elim_comp_inr, dotProduct_neg]
  rw [← mul_assoc, ← AddChar.map_add_eq_mul]
  congr 2
  have hs : s ⬝ᵥ Sum.elim b (-b) = (s ∘ Sum.inl) ⬝ᵥ b - (s ∘ Sum.inr) ⬝ᵥ b := by
    rw [← Sum.elim_comp_inl_inr s, elim_dot, dotProduct_neg, Sum.elim_comp_inl, Sum.elim_comp_inr, sub_eq_add_neg]
  rw [hs]
  ring

end GlobalTheory.DoublingEvLaw
