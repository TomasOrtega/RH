/- English proof (translation)
Introduce `s`. Proceed by induction on `s using Finset.induction_on with`. Consider the case `empty => intro _`. Simplify using `using hasDerivAt_const T (1 : ℝ)`. Consider the case `insert x s hx ih`.

Introduce `h`. Establish `hx' : T - a x ≠ 0` using `sub_ne_zero.2 (h x (mem_insert_self x s))`. Establish `h1` using `ih (fun i hi => h i (mem_insert_of_mem hi))`. Establish `h2 : HasDerivAt (fun T => T - a x) 1 T` using `(hasDerivAt_id T).sub_const (a x)`. Establish `h3` using `h2.mul h1`.

Simplify using `only [prod_insert hx, sum_insert hx]`. Use `h3.congr_deriv ?_` and prove the remaining obligations. Establish `e : (T - a x) * (1 / (T - a x)) = 1` using `mul_one_div_cancel hx'`. Take the linear combination `-(∏ i ∈ s, (T - a i)) * e`.
-/
theorem hasDerivAt_prodLin (a : ℕ → ℝ) (T : ℝ) : ∀ (s : Finset ℕ), (∀ i ∈ s, T ≠ a i) →
    HasDerivAt (fun T => ∏ i ∈ s, (T - a i)) ((∏ i ∈ s, (T - a i)) * ∑ i ∈ s, 1 / (T - a i)) T := by
  intro s
  induction s using Finset.induction_on with
  | empty => intro _; simpa using hasDerivAt_const T (1 : ℝ)
  | insert x s hx ih =>
    intro h
    have hx' : T - a x ≠ 0 := sub_ne_zero.2 (h x (mem_insert_self x s))
    have h1 := ih (fun i hi => h i (mem_insert_of_mem hi))
    have h2 : HasDerivAt (fun T => T - a x) 1 T := (hasDerivAt_id T).sub_const (a x)
    have h3 := h2.mul h1
    simp only [prod_insert hx, sum_insert hx]
    refine h3.congr_deriv ?_
    have e : (T - a x) * (1 / (T - a x)) = 1 := mul_one_div_cancel hx'
    linear_combination -(∏ i ∈ s, (T - a i)) * e

/- English proof (translation)
Establish `hD : ∏ j ∈ t, (T - b j) ≠ 0` using `prod_ne_zero_iff.2 fun j hj => sub_ne_zero.2 (hb j hj)`. Establish `h` using `(hasDerivAt_prodLin a T s ha).div (hasDerivAt_prodLin b T t hb) hD`. Use `h.congr_deriv ?_` and prove the remaining obligations. Clear the denominators using the available nonvanishing facts.
