theorem adjoint_bounded : Formalism.FourierDecayAlt.MA.AdjBQ := by
  intro P l L j lam α β Lb c Ntot hH w hw hl Y hY ε ε₂ hε hε₂
  obtain ⟨⟨hOK, hl1, hlk, hML, hu, hu', hαβ, hcut⟩, hD, hA, hE, hN1, -⟩ := id hH
