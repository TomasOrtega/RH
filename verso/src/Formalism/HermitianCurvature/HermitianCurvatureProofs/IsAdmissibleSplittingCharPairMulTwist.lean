noncomputable section

/- English proof (translation)
Rewrite using `[act_Ph hφ]`. Use `show evQ P (toSm P (fun q => ((φ (Gq P q) : ℝ) : ℂ)) * actA P y j π) q = _`. Rewrite using `[MAx2.Jet.evQ_mul, ← Phi0_eq P hφ, eval_cutoff_operator_zero P hφ]`.
-/
theorem ev_Ph {P : M.Par} {j : M.Ty P → SmQ P.r P.TT} {φ : ℝ → ℝ} (hφ : LE.SmoothLog φ) (y : A P (DQ P))
    (π : M.Ty P) (q : Qp P.r P.TT) :
    evQ P (actA P (Ph P φ * y) j π) q = ((φ (Gq P q) : ℝ) : ℂ) * evQ P (actA P y j π) q := by
  rw [act_Ph hφ]
  show evQ P (toSm P (fun q => ((φ (Gq P q) : ℝ) : ℂ)) * actA P y j π) q = _
  rw [MAx2.Jet.evQ_mul, ← Phi0_eq P hφ, eval_cutoff_operator_zero P hφ]

/- English proof (translation)
Rewrite using `[mul_one, PG.chiJ_eq]`. Use function extensionality and compare the values at `π`. Use `show _ = actA P (sc P (DQ P) (Fq P (PG.chi c ε) 0)) j π`. Rewrite using `[MAx2.R2.act_sc]`. Both sides reduce to the same expression.
-/
theorem chiJ_Ph {P : M.Par} (j : M.Ty P → SmQ P.r P.TT) (c : LE.Cut) (ε : ℝ) :
    chiJ P j c ε = actA P (Ph P (PG.chi c ε) * 1) j := by
  rw [mul_one, PG.chiJ_eq]
  funext π
  show _ = actA P (sc P (DQ P) (Fq P (PG.chi c ε) 0)) j π
  rw [MAx2.R2.act_sc]
  rfl

/- English proof (translation)
Introduce `P l L j lam α β Lb c Ntot hH N Y hN hB ε hε π`. Take `⟨⟨hOK, hl1, hlk, hML, -⟩, hD, hA, -⟩` from `id hH`. Establish `hTTp : 0 < P.TT` using `mul_pos hOK.T_pos hOK.T'_pos`. Establish `hLaw` using `analytic_laws P.r P.TT hTTp.le`. Establish `hz` using `T_memZ hH Y hN hB hε`.

Establish `hlen : (List.ofFn Y).length = N` using `List.length_ofFn`. Use `set T := ∑ e, ∑ e', star (gRing P l L Y e) * dRing P l L Y e e' * gRing P l L Y e' with hT`. Establish `hsm` using `PG.smoothLog_chi c ε`. Establish `hint` using `int_Z hTTp hML hLaw hD (k := (List.ofFn Y).length + (List.ofFn Y).length) (by omega) hz (W := []) (by simp) (by simp) π`. Use `hint.congr (Filter.Eventually.of_forall fun q => ?_)` and prove the remaining obligations.

Use `show evQ P (actA P (Ph P (PG.chi c ε) * T * Ph P (PG.chi c ε)) j π) q * conj (evQ P (actA P ([] : List (A P (DQ P))).prod j π) q) = evQ P (actA P T (chiJ P j c ε) π) q * conj (evQ P (chiJ P j c ε π) q)`. Rewrite using `[chiJ_Ph, mul_assoc, ev_Ph hsm, ← F.actA_mul, ev_Ph hsm, List.prod_nil, mul_one, MAx2.R2.act_one, map_mul, Complex.conj_ofReal]`. Expand and normalize the polynomial expressions, which then agree.
-/
theorem intForm : MAx3.I1.IntForm := by
  intro P l L j lam α β Lb c Ntot hH N Y hN hB ε hε π
  obtain ⟨⟨hOK, hl1, hlk, hML, -⟩, hD, hA, -⟩ := id hH
  have hTTp : 0 < P.TT := mul_pos hOK.T_pos hOK.T'_pos
  have hLaw := analytic_laws P.r P.TT hTTp.le
  have hz := T_memZ hH Y hN hB hε
  have hlen : (List.ofFn Y).length = N := List.length_ofFn
  set T := ∑ e, ∑ e', star (gRing P l L Y e) * dRing P l L Y e e' * gRing P l L Y e' with hT
  have hsm := PG.smoothLog_chi c ε
  have hint := int_Z hTTp hML hLaw hD (k := (List.ofFn Y).length + (List.ofFn Y).length) (by omega) hz
    (W := []) (by simp) (by simp) π
  refine hint.congr (Filter.Eventually.of_forall fun q => ?_)
  show evQ P (actA P (Ph P (PG.chi c ε) * T * Ph P (PG.chi c ε)) j π) q * conj (evQ P (actA P ([] : List (A P (DQ P))).prod j π) q) =
    evQ P (actA P T (chiJ P j c ε) π) q * conj (evQ P (chiJ P j c ε π) q)
  rw [chiJ_Ph, mul_assoc, ev_Ph hsm, ← F.actA_mul, ev_Ph hsm, List.prod_nil, mul_one, MAx2.R2.act_one, map_mul,
    Complex.conj_ofReal]
  ring

end

end Formalism.FourierDecayAlt.P.MAx3.Z

namespace Formalism.FourierDecayAlt.P

/- English proof (translation)
The claim follows from `MAx3.I1.first_identity_of_form MAx3.Z.intForm`.
-/
theorem first_identity : Formalism.FourierDecayAlt.MA.EnergyPolynomialInPoints := MAx3.I1.first_identity_of_form MAx3.Z.intForm

