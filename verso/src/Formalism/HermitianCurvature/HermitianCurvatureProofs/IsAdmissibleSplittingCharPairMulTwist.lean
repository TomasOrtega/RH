/- English proof (translation)
Assemble the required witnesses or components as `⟨Phi P φ 0, Phi P φ 0, rfl, fun q => eval_cutoff_operator_zero P hφ q, fun q => by show evQ P (Phi P φ 0) q = _ rw [eval_cutoff_operator_zero P hφ q, Complex.conj_ofReal]⟩`.
-/
theorem cf_Ph {φ : ℝ → ℝ} (hφ : LE.SmoothLog φ) : CF (Ph P φ) (fun q => ((φ (Gq P q) : ℝ) : ℂ)) :=
  ⟨Phi P φ 0, Phi P φ 0, rfl, fun q => eval_cutoff_operator_zero P hφ q, fun q => by
    show evQ P (Phi P φ 0) q = _
    rw [eval_cutoff_operator_zero P hφ q, Complex.conj_ofReal]⟩

/- English proof (translation)
Proceed by induction on `n with`. Consider the case `zero => simpa using (CF_one : CF (1 : A P (DQ P)) (fun _ => 1))`. Consider the case `succ n ih => rw [pow_succ]`. Simplify `CF_mul ih hx` using `[pow_succ]`.
-/
theorem CF_pow' {x : A P (DQ P)} {g : Qp P.r P.TT → ℂ} (hx : CF x g) (n : ℕ) : CF (x ^ n) (fun q => g q ^ n) := by
  induction n with
  | zero => simpa using (CF_one : CF (1 : A P (DQ P)) (fun _ => 1))
  | succ n ih => rw [pow_succ]; simpa [pow_succ] using CF_mul ih hx

/- English proof (translation)
Unfold `Ph sc`. Rewrite using `[Matrix.scalar_apply]`. Use `Matrix.ext fun π π' => ?_` and prove the remaining obligations. Rewrite using `[Matrix.star_apply]`. Distinguish the cases in `h : π = π'`.

Substitute `h` using the available equality. Rewrite using `[Matrix.diagonal_apply_eq]`. Conclude with `Fq_star φ`. Rewrite using `[Matrix.diagonal_apply_ne _ (Ne.symm h), Matrix.diagonal_apply_ne _ h, star_zero]`.
-/
theorem star_Ph (φ : ℝ → ℝ) : star (Ph P φ) = Ph P φ := by
  unfold Ph sc
  rw [Matrix.scalar_apply]
  refine Matrix.ext fun π π' => ?_
  rw [Matrix.star_apply]
  by_cases h : π = π'
  · subst h; rw [Matrix.diagonal_apply_eq]; exact Fq_star φ
  · rw [Matrix.diagonal_apply_ne _ (Ne.symm h), Matrix.diagonal_apply_ne _ h, star_zero]

variable {L : LevelData (A P (DQ P)) P.r} {j : M.Ty P → SmQ P.r P.TT}
variable (hTTp : 0 < P.TT) (hL : IsModelLevel P (DQ P) L) (hLaw : (DQ P).Laws P.TT)
include hTTp hL hLaw

/- English proof (translation)
Take `⟨-, -, -, h4, -, -⟩` from `star_more hL hLaw`. Take `⟨-, hDi, -, hDbi, -⟩` from `fnP_D hL`. Take `⟨Cβ, hβC⟩` from `SAB_closure hTTp hL hLaw hβ`. Establish `hs : CF (L.Dbi ^ N * Ph P φ) _` using `CF_mul (CF_pow' (cf_Dbi hTTp.le hL) N) (cf_Ph hφ.1)`. Establish `hstar : star (L.Dbi ^ N * Ph P φ) = Ph P φ * L.Di ^ N` using `by rw [star_mul, star_Ph, star_pow, h4]`.

Establish `hsa' : star (L.Dbi ^ N * Ph P φ) * a ∈ Z P L N` using `by rw [hstar]; exact hsa φ hφ`. Take `⟨int1, -, eq1⟩` from `multAdj hTTp hL hLaw hD hβC hs hW (hWl.trans (by omega)) (k := N) (by omega) hsa'`. Establish `hsβ : star β ∈ SB L` using `star_SB hL hLaw hβ`. Establish `hz : star (β * (L.Dbi ^ N * Ph P φ)) * a ∈ Z P L N`. Rewrite using `[star_mul, ← SB_comm_fnP hL hLaw hsβ (by rw [hstar]; exact isFnP_mul (isFnP_Ph φ) (isFnP_pow hDi N)), mul_assoc]`.

Conclude with `SB_memZ hTTp hL hLaw hsβ hsa'`. Establish `hp` using `adjPure hTTp hL hLaw hD hA W hW N (by omega) _ hz`. Establish `hz2 : star (β * (L.Dbi ^ N * Ph P φ) * W.prod) * a ∈ Z P L (N + W.length)`. Rewrite using `[star_mul, mul_assoc]`. Conclude with `star_word_mem hTTp.le hL hLaw W hW hz`.

Use `⟨int1, fun π => ?_, ?_⟩` and prove the remaining obligations. Use `int_Z hTTp hL hLaw hD (by omega) hz2 (W := []) (by simp) (by simp) π` as an intermediate fact. Simplify `this` using `[MAx2.R2.act_one]`. Rewrite using `[eq1, hp, star_mul (β * (L.Dbi ^ N * Ph P φ)) W.prod, mul_assoc]`.
-/
theorem QA_gen {m : ℕ} (hD : JDecay P L j m) (hA : JAdj P L j m) {a : A P (DQ P)} {N : ℕ} (hm : N + N ≤ m)
    (hsa : ∀ φ, admitted φ → Ph P φ * L.Di ^ N * a ∈ Z P L N) {β : A P (DQ P)} (hβ : β ∈ SB L) {φ : ℝ → ℝ} (hφ : admitted φ)
    {W : List (A P (DQ P))} (hW : ∀ x ∈ W, x ∈ hatSet P L) (hWl : W.length ≤ N) :
    QA L j a (β * (L.Dbi ^ N * Ph P φ) * W.prod) := by
  obtain ⟨-, -, -, h4, -, -⟩ := star_more hL hLaw
  obtain ⟨-, hDi, -, hDbi, -⟩ := fnP_D hL
  obtain ⟨Cβ, hβC⟩ := SAB_closure hTTp hL hLaw hβ
  have hs : CF (L.Dbi ^ N * Ph P φ) _ := CF_mul (CF_pow' (cf_Dbi hTTp.le hL) N) (cf_Ph hφ.1)
  have hstar : star (L.Dbi ^ N * Ph P φ) = Ph P φ * L.Di ^ N := by rw [star_mul, star_Ph, star_pow, h4]
  have hsa' : star (L.Dbi ^ N * Ph P φ) * a ∈ Z P L N := by rw [hstar]; exact hsa φ hφ
  obtain ⟨int1, -, eq1⟩ := multAdj hTTp hL hLaw hD hβC hs hW (hWl.trans (by omega)) (k := N) (by omega) hsa'
  have hsβ : star β ∈ SB L := star_SB hL hLaw hβ
  have hz : star (β * (L.Dbi ^ N * Ph P φ)) * a ∈ Z P L N := by
    rw [star_mul, ← SB_comm_fnP hL hLaw hsβ (by rw [hstar]; exact isFnP_mul (isFnP_Ph φ) (isFnP_pow hDi N)), mul_assoc]
    exact SB_memZ hTTp hL hLaw hsβ hsa'
  have hp := adjPure hTTp hL hLaw hD hA W hW N (by omega) _ hz
  have hz2 : star (β * (L.Dbi ^ N * Ph P φ) * W.prod) * a ∈ Z P L (N + W.length) := by
    rw [star_mul, mul_assoc]; exact star_word_mem hTTp.le hL hLaw W hW hz
  refine ⟨int1, fun π => ?_, ?_⟩
  · have := int_Z hTTp hL hLaw hD (by omega) hz2 (W := []) (by simp) (by simp) π
    simpa [MAx2.R2.act_one] using this
  · rw [eq1, hp, star_mul (β * (L.Dbi ^ N * Ph P φ)) W.prod, mul_assoc]

/- English proof (translation)
Take `⟨-, -, -, hDbi, -⟩` from `fnP_D hL`. Proceed by induction on `hy using Submodule.span_induction with`. Consider the case `mem x hx`. Take `⟨b, H, hb, hH, hl, rfl⟩` from `hx`. Establish `hz : H.prod * Ph P χ ∈ Z P L (0 + H.length)` using `word_memZ hTTp hL hLaw H (fun h hh => Or.inl (Or.inl (hH h hh))) (Ph_memZ hχ)`.

Rewrite `hz` using `[zero_add, hl]`. Rewrite using `[mul_assoc]`. It suffices to establish `key : ∀ z ∈ Z P L N, QA L j a (b * L.Dbi ^ N * z) from key _ hz`. Introduce `z hz`. Proceed by induction on `hz using Submodule.span_induction with`.

Consider the case `mem z hz`. Take `⟨φ, b', v, hφ, hb', hv, hlen, rfl⟩` from `hz`. Establish `e : b * L.Dbi ^ N * (Ph P φ * b' * v.prod) = (b * b') * (L.Dbi ^ N * Ph P φ) * v.prod`. Establish `c` using `SB_comm_fnP hL hLaw hb' (isFnP_mul (isFnP_pow hDbi N) (isFnP_Ph φ))`. Combine the equalities or inequalities in the displayed calculation.

Simplify using `only [mul_assoc]`. Use `_ = b * (b' * (L.Dbi ^ N * Ph P φ)) * v.prod := by rw [c]`. Use `_ = _ := by simp only [mul_assoc]`. Rewrite using `[e]`. Conclude with `QA_gen hTTp hL hLaw hD hA hm hsa (Submonoid.mul_mem _ hb hb') hφ hv hlen`.

Consider the case `zero => rw [mul_zero]`. Conclude with `QA_zero a`. Consider the case `add u v _ _ hu hv => rw [mul_add]`. Conclude with `QA_add hu hv`. Consider the case `smul c u _ hu => rw [mul_smul_comm]`.

Conclude with `QA_smul c hu`. Consider the case `zero => rw [zero_mul]`. Conclude with `QA_zero a`. Consider the case `add u v _ _ hu hv => rw [add_mul]`. Conclude with `QA_add hu hv`.

Consider the case `smul c u _ hu => rw [smul_mul_assoc]`. Conclude with `QA_smul c hu`.
-/
theorem QA_NF {m : ℕ} (hD : JDecay P L j m) (hA : JAdj P L j m) {a : A P (DQ P)} {N : ℕ} (hm : N + N ≤ m)
    (hsa : ∀ φ, admitted φ → Ph P φ * L.Di ^ N * a ∈ Z P L N) {χ : ℝ → ℝ} (hχ : admitted χ) {y : A P (DQ P)}
    (hy : y ∈ NFD L N) : QA L j a (y * Ph P χ) := by
  obtain ⟨-, -, -, hDbi, -⟩ := fnP_D hL
  induction hy using Submodule.span_induction with
  | mem x hx =>
    obtain ⟨b, H, hb, hH, hl, rfl⟩ := hx
    have hz : H.prod * Ph P χ ∈ Z P L (0 + H.length) :=
      word_memZ hTTp hL hLaw H (fun h hh => Or.inl (Or.inl (hH h hh))) (Ph_memZ hχ)
    rw [zero_add, hl] at hz
    rw [mul_assoc]
    suffices key : ∀ z ∈ Z P L N, QA L j a (b * L.Dbi ^ N * z) from key _ hz
    intro z hz
    induction hz using Submodule.span_induction with
    | mem z hz =>
      obtain ⟨φ, b', v, hφ, hb', hv, hlen, rfl⟩ := hz
      have e : b * L.Dbi ^ N * (Ph P φ * b' * v.prod) = (b * b') * (L.Dbi ^ N * Ph P φ) * v.prod := by
        have c := SB_comm_fnP hL hLaw hb' (isFnP_mul (isFnP_pow hDbi N) (isFnP_Ph φ))
        calc b * L.Dbi ^ N * (Ph P φ * b' * v.prod) = b * ((L.Dbi ^ N * Ph P φ) * b') * v.prod := by
              simp only [mul_assoc]
          _ = b * (b' * (L.Dbi ^ N * Ph P φ)) * v.prod := by rw [c]
          _ = _ := by simp only [mul_assoc]
      rw [e]
      exact QA_gen hTTp hL hLaw hD hA hm hsa (Submonoid.mul_mem _ hb hb') hφ hv hlen
    | zero => rw [mul_zero]; exact QA_zero a
    | add u v _ _ hu hv => rw [mul_add]; exact QA_add hu hv
    | smul c u _ hu => rw [mul_smul_comm]; exact QA_smul c hu
  | zero => rw [zero_mul]; exact QA_zero a
  | add u v _ _ hu hv => rw [add_mul]; exact QA_add hu hv
  | smul c u _ hu => rw [smul_mul_assoc]; exact QA_smul c hu

/- English proof (translation)
Introduce `φ hφ`. Take `⟨hD, hDi, hDb, hDbi, -⟩` from `fnP_D hL`. Establish `hW : IsFnP (L.ζ * L.ζb * L.GGi)` using `isFnP_mul (isFnP_mul (fns_fnP hL (m_ζ L)) (fns_fnP hL (m_ζb L))) (fns_fnP hL (m_GGi L))`. Establish `hk : kap P (DQ P) f ∈ SB L` using `Submonoid.subset_closure (Or.inl (Or.inl (Or.inr ⟨f, rfl⟩)))`. Proceed by induction on `hx using Submodule.span_induction with`.

Consider the case `mem x hx`. Take `⟨b2, H2, hb2, hH2, hl2, rfl⟩` from `hx`. Establish `hβ : kap P (DQ P) f * b2 ∈ SB L` using `Submonoid.mul_mem _ hk hb2`. Establish `hmid` using `mid_id (1 : A P (DQ P)) (kap P (DQ P) f) b2 (L.Di ^ N) ((L.ζ * L.ζb * L.GGi) ^ N) (L.Dbi ^ N) (by simp) (SB_comm_fnP hL hLaw hβ (isFnP_mul (isFnP_pow hDi N) (isFnP_pow hW N))).symm`. Rewrite `hmid` using `[DWD_pow hTTp hL hLaw, one_mul, mul_one]`.

Establish `e : Ph P φ * L.Di ^ N * ((L.ζ * L.ζb * L.GGi) ^ N * kap P (DQ P) f * (b2 * L.Dbi ^ N * H2.prod) * Ph P χ) = Ph P φ * ((kap P (DQ P) f * b2) * (G.Gs P (-1) ^ N * (H2.prod * Ph P χ)))`. Combine the equalities or inequalities in the displayed calculation. Rewrite using `[e]`. Establish `z1 : H2.prod * Ph P χ ∈ Z P L (0 + H2.length)` using `word_memZ hTTp hL hLaw H2 (fun h hh => Or.inl (Or.inl (hH2 h hh))) (Ph_memZ hχ)`. Rewrite `z1` using `[zero_add, hl2]`.

Conclude with `Ph_memZ_mul hTTp hL hLaw hφ (SB_memZ hTTp hL hLaw hβ (Gspow_memZ hTTp hL hLaw N z1))`. Consider the case `zero => simp`. Consider the case `add u v _ _ hu hv => rw [mul_add, add_mul, mul_add]`. Conclude with `Submodule.add_mem _ hu hv`. Consider the case `smul c u _ hu => rw [mul_smul_comm, smul_mul_assoc, mul_smul_comm]`.

Conclude with `Submodule.smul_mem _ c hu`.
-/
theorem hsa_U {N : ℕ} (f : M.Ty P → ℂ) {χ : ℝ → ℝ} (hχ : admitted χ) {x : A P (DQ P)} (hx : x ∈ NFD L N) :
    ∀ φ, admitted φ → Ph P φ * L.Di ^ N * ((L.ζ * L.ζb * L.GGi) ^ N * kap P (DQ P) f * x * Ph P χ) ∈ Z P L N := by
  intro φ hφ
  obtain ⟨hD, hDi, hDb, hDbi, -⟩ := fnP_D hL
  have hW : IsFnP (L.ζ * L.ζb * L.GGi) :=
    isFnP_mul (isFnP_mul (fns_fnP hL (m_ζ L)) (fns_fnP hL (m_ζb L))) (fns_fnP hL (m_GGi L))
  have hk : kap P (DQ P) f ∈ SB L := Submonoid.subset_closure (Or.inl (Or.inl (Or.inr ⟨f, rfl⟩)))
  induction hx using Submodule.span_induction with
  | mem x hx =>
    obtain ⟨b2, H2, hb2, hH2, hl2, rfl⟩ := hx
    have hβ : kap P (DQ P) f * b2 ∈ SB L := Submonoid.mul_mem _ hk hb2
    have hmid := mid_id (1 : A P (DQ P)) (kap P (DQ P) f) b2 (L.Di ^ N) ((L.ζ * L.ζb * L.GGi) ^ N) (L.Dbi ^ N)
      (by simp) (SB_comm_fnP hL hLaw hβ (isFnP_mul (isFnP_pow hDi N) (isFnP_pow hW N))).symm
    rw [DWD_pow hTTp hL hLaw, one_mul, mul_one] at hmid
    have e : Ph P φ * L.Di ^ N * ((L.ζ * L.ζb * L.GGi) ^ N * kap P (DQ P) f * (b2 * L.Dbi ^ N * H2.prod) * Ph P χ) =
        Ph P φ * ((kap P (DQ P) f * b2) * (G.Gs P (-1) ^ N * (H2.prod * Ph P χ))) := by
      calc Ph P φ * L.Di ^ N * ((L.ζ * L.ζb * L.GGi) ^ N * kap P (DQ P) f * (b2 * L.Dbi ^ N * H2.prod) * Ph P χ)
          = Ph P φ * (L.Di ^ N * ((L.ζ * L.ζb * L.GGi) ^ N * kap P (DQ P) f * (b2 * L.Dbi ^ N))) *
            (H2.prod * Ph P χ) := by simp only [mul_assoc]
        _ = _ := by rw [hmid]; simp only [mul_assoc]
    rw [e]
    have z1 : H2.prod * Ph P χ ∈ Z P L (0 + H2.length) :=
      word_memZ hTTp hL hLaw H2 (fun h hh => Or.inl (Or.inl (hH2 h hh))) (Ph_memZ hχ)
    rw [zero_add, hl2] at z1
    exact Ph_memZ_mul hTTp hL hLaw hφ (SB_memZ hTTp hL hLaw hβ (Gspow_memZ hTTp hL hLaw N z1))
  | zero => simp
  | add u v _ _ hu hv => rw [mul_add, add_mul, mul_add]; exact Submodule.add_mem _ hu hv
  | smul c u _ hu => rw [mul_smul_comm, smul_mul_assoc, mul_smul_comm]; exact Submodule.smul_mem _ c hu

end

