section Gen
variable {R : Type} [Ring R] [Algebra ℂ R]

def PR (f : ℝ → R) (d : ℕ) : Prop := ∃ a : ℕ → R, ∀ s : ℝ, f s = ∑ k ∈ range (d + 1), ((s : ℂ) ^ k) • a k

/- English proof (translation)
Assemble the required witnesses or components as `⟨fun _ => x, fun s => by simp⟩`.
-/
theorem PR_const (x : R) : PR (fun _ => x) 0 := ⟨fun _ => x, fun s => by simp⟩

/- English proof (translation)
Take `⟨a, ha⟩` from `h`. Use `⟨fun k => if k ≤ d then a k else 0, fun s => ?_⟩` and prove the remaining obligations. Simplify using `only`. Rewrite using `[ha, ← Finset.sum_range_add_sum_Ico _ (Nat.succ_le_succ hd)]`. Rewrite using `[Finset.sum_eq_zero (s := Finset.Ico (d + 1) (d' + 1)) (fun k hk => by`.

Rewrite using `[if_neg (by simp [Finset.mem_Ico] at hk; omega), smul_zero]), add_zero]`. Conclude with `Finset.sum_congr rfl fun k hk => by rw [if_pos (by simp at hk; omega)]`.
-/
theorem PR_mono {f : ℝ → R} {d d' : ℕ} (h : PR f d) (hd : d ≤ d') : PR f d' := by
  obtain ⟨a, ha⟩ := h
  refine ⟨fun k => if k ≤ d then a k else 0, fun s => ?_⟩
  dsimp only
  rw [ha, ← Finset.sum_range_add_sum_Ico _ (Nat.succ_le_succ hd)]
  rw [Finset.sum_eq_zero (s := Finset.Ico (d + 1) (d' + 1)) (fun k hk => by
    rw [if_neg (by simp [Finset.mem_Ico] at hk; omega), smul_zero]), add_zero]
  exact Finset.sum_congr rfl fun k hk => by rw [if_pos (by simp at hk; omega)]

/- English proof (translation)
Take `⟨a, ha⟩` from `hf`. Take `⟨b, hb⟩` from `hg`. Conclude with `⟨fun k => a k + b k, fun s => by dsimp only; rw [ha, hb, ← Finset.sum_add_distrib]; simp only [smul_add]⟩`.
-/
theorem PR_add {f g : ℝ → R} {d : ℕ} (hf : PR f d) (hg : PR g d) : PR (fun s => f s + g s) d := by
  obtain ⟨a, ha⟩ := hf; obtain ⟨b, hb⟩ := hg
  exact ⟨fun k => a k + b k, fun s => by dsimp only; rw [ha, hb, ← Finset.sum_add_distrib]; simp only [smul_add]⟩

/- English proof (translation)
The claim follows from `PR_add (PR_mono hf (le_max_left _ _)) (PR_mono hg (le_max_right _ _))`.
-/
theorem PR_add' {f g : ℝ → R} {d1 d2 : ℕ} (hf : PR f d1) (hg : PR g d2) : PR (fun s => f s + g s) (max d1 d2) :=
  PR_add (PR_mono hf (le_max_left _ _)) (PR_mono hg (le_max_right _ _))

/- English proof (translation)
Take `⟨a, ha⟩` from `hf`. Conclude with `⟨fun k => -a k, fun s => by dsimp only; rw [ha, ← Finset.sum_neg_distrib]; simp only [smul_neg]⟩`.
-/
theorem PR_neg {f : ℝ → R} {d : ℕ} (hf : PR f d) : PR (fun s => -f s) d := by
  obtain ⟨a, ha⟩ := hf
  exact ⟨fun k => -a k, fun s => by dsimp only; rw [ha, ← Finset.sum_neg_distrib]; simp only [smul_neg]⟩

/- English proof (translation)
Use `PR_add hf (PR_neg hg)` as an intermediate fact. Simplify `this` using `[sub_eq_add_neg]`.
-/
theorem PR_sub {f g : ℝ → R} {d : ℕ} (hf : PR f d) (hg : PR g d) : PR (fun s => f s - g s) d := by
  have := PR_add hf (PR_neg hg)
  simpa [sub_eq_add_neg] using this

/- English proof (translation)
Take `⟨a, ha⟩` from `hf`. Conclude with `⟨fun k => z • a k, fun s => by dsimp only; rw [ha, Finset.smul_sum]; simp only [smul_comm z]⟩`.
-/
theorem PR_smul (z : ℂ) {f : ℝ → R} {d : ℕ} (hf : PR f d) : PR (fun s => z • f s) d := by
  obtain ⟨a, ha⟩ := hf
  exact ⟨fun k => z • a k, fun s => by dsimp only; rw [ha, Finset.smul_sum]; simp only [smul_comm z]⟩

/- English proof (translation)
Take `⟨a, ha⟩` from `hf`. Take `⟨b, hb⟩` from `hg`. Use `⟨fun k => ∑ i ∈ range (d1 + 1), ∑ j ∈ range (d2 + 1), if i + j = k then a i * b j else 0, fun s => ?_⟩` and prove the remaining obligations. Simplify using `only`. Rewrite using `[ha, hb, Finset.sum_mul_sum]`.

Use `symm`. Simplify using `only [Finset.smul_sum]`. Rewrite using `[Finset.sum_comm]`. Use `Finset.sum_congr rfl fun i hi => ?_` and prove the remaining obligations. Rewrite using `[Finset.sum_comm]`.

