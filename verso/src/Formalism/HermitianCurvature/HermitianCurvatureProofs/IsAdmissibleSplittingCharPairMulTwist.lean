section Gen
variable {R : Type} [Ring R] [Algebra ℂ R]

def Kp (n : ℕ) (K : ℕ → R) {N : ℕ} (κ : Fin N → Fin (n + 1)) : R :=
  ((List.ofFn fun a => K (κ a)).reverse).prod

def mono {N n : ℕ} (κ : Fin N → Fin (n + 1)) (Y : Fin N → ℝ) : ℂ := ∏ a, ((Y a : ℂ) ^ (κ a : ℕ))

/- English proof (translation)
