    have ha := h a (List.mem_cons_self)
    have ih := xs_real x0 v (fun b hb => h b (List.mem_cons_of_mem _ hb)) e Y
    simp only [xs, ih, phR, List.map_cons, List.prod_cons]
    by_cases he : e a.intersection_update_fsHerm_neg_one = 0
    · simp only [he, if_true, phiL, ha.1, if_true]
      have hp := pt_eq ha.2
      set p := a.pt.re
      rw [hp]
      push_cast
      ring
    · simp only [he, if_false]
      push_cast
      ring

/- English proof (translation)
The claim follows from `| [], _, Y => by simp [qw, psR] | a :: v, h, Y => by have ha := h a (List.mem_cons_self) have ih := qw_real q0 v (fun b hb => h b (List.mem_cons_of_mem _ hb)) Y simp only [qw, ih, psR, List.map_cons, List.prod_cons, ha.1, if_true] have hp := pt_eq ha.2 set p := a.pt.re rw [hp] pu …`.
