section S_H_H7

set_option linter.unusedVariables false

namespace Formalism.FourierDecayAlt.P.MAx3.H

open Formalism.FourierDecayAlt.R Formalism.FourierDecayAlt.R.LevelData Formalism.FourierDecayAlt.P.RuleGD

variable {A : Type} [Ring A] [Algebra ℂ A] {r : ℕ} {L : LevelData A r}

def RaisingCommutesModulo (L : LevelData A r) (M : Set A) (b : A) : Prop :=
  ∀ Y, ∃ (t : ℂ) (ts : List (ℂ × A × ℂ)), (∀ x ∈ ts, x.2.1 ∈ M) ∧
    L.R0 Y * b = b * L.R0 (Y + t) + (ts.map fun x => x.1 • (x.2.1 * L.Ahat x.2.2)).sum

/- English proof (translation)
Establish `P1 : ∀ b ∈ Submonoid.closure T, (b * L.Di = L.Di * b) ∧ (b * L.Dbi = L.Dbi * b) ∧ (∃ t : ℂ, ∀ Y, L.Ahat Y * b = b * L.Ahat (Y + t)) ∧ RaisingCommutesModulo L (Submonoid.closure T) b`. Introduce `b hb`. Proceed by induction on `hb using Submonoid.closure_induction with`. Consider the case `mem x hx => exact ⟨hDi x hx, hDbi x hx, hA x hx, hR x hx⟩`. Consider the case `one => exact ⟨by simp, by simp, ⟨0, fun Y => by simp⟩, fun Y => ⟨0, [], by simp, by simp⟩⟩`.

Consider the case `mul x y hx hy ihx ihy`. Take `⟨x1, x2, ⟨tx, htx⟩, rx⟩` from `ihx`. Take `⟨y1, y2, ⟨ty, hty⟩, ry⟩` from `ihy`. Use `⟨by rw [mul_assoc, y1, ← mul_assoc, x1, mul_assoc], by rw [mul_assoc, y2, ← mul_assoc, x2, mul_assoc], ⟨tx + ty, fun Y => by rw [← mul_assoc, htx, mul_assoc, hty, mul_assoc, add_assoc]⟩, fun Y => ?_⟩` and prove the remaining obligations. Take `⟨t1, ts1, hts1, e1⟩` from `rx Y`.

Take `⟨t2, ts2, hts2, e2⟩` from `ry (Y + t1)`. Use `⟨t1 + t2, (ts1.map fun z => (z.1, z.2.1 * y, z.2.2 + ty)) ++ (ts2.map fun z => (z.1, x * z.2.1, z.2.2)), ?_, ?_⟩` and prove the remaining obligations. Introduce `z hz`. Break down `List.mem_append.1 hz with hz | hz` into its components or cases. Take `⟨z', hz', rfl⟩` from `List.mem_map.1 hz`.

Conclude with `Submonoid.mul_mem _ (hts1 z' hz') hy`. Take `⟨z', hz', rfl⟩` from `List.mem_map.1 hz`. Conclude with `Submonoid.mul_mem _ hx (hts2 z' hz')`. Establish `s1 : (ts1.map fun z => z.1 • (z.2.1 * L.Ahat z.2.2)).sum * y = ((ts1.map fun z => (z.1, z.2.1 * y, z.2.2 + ty)).map fun z => z.1 • (z.2.1 * L.Ahat z.2.2)).sum`. Rewrite using `[← List.sum_map_mul_right, List.map_map]`.

Use `congr 1`. Use `List.map_congr_left fun z _ => ?_` and prove the remaining obligations. Simplify using `only [Function.comp_apply, smul_mul_assoc, mul_assoc, hty]`. Establish `s2 : x * (ts2.map fun z => z.1 • (z.2.1 * L.Ahat z.2.2)).sum = ((ts2.map fun z => (z.1, x * z.2.1, z.2.2)).map fun z => z.1 • (z.2.1 * L.Ahat z.2.2)).sum`. Rewrite using `[← List.sum_map_mul_left, List.map_map]`.

Use `congr 1`. Use `List.map_congr_left fun z _ => ?_` and prove the remaining obligations. Simplify using `only [Function.comp_apply, mul_smul_comm, mul_assoc]`. Combine the equalities or inequalities in the displayed calculation. Rewrite using `[e1, add_mul, mul_assoc]`.

Use `_ = _ := by`. Rewrite using `[e2, s1, mul_add, s2, List.map_append, List.sum_append, ← mul_assoc, add_assoc Y]`. Normalize the expressions using the abelian group laws. Conclude with `⟨fun b hb => (P1 b hb).1, fun b hb => (P1 b hb).2.1, fun b hb => (P1 b hb).2.2.1, fun b hb Y => (P1 b hb).2.2.2 Y, hdrb⟩`.
-/
theorem hyp_closure (T : Set A)
    (hDi : ∀ b ∈ T, b * L.Di = L.Di * b) (hDbi : ∀ b ∈ T, b * L.Dbi = L.Dbi * b)
    (hA : ∀ b ∈ T, ∃ t : ℂ, ∀ Y, L.Ahat Y * b = b * L.Ahat (Y + t))
    (hR : ∀ b ∈ T, RaisingCommutesModulo L (Submonoid.closure T) b)
    (hdrb : L.Drb * L.Di ∈ Submonoid.closure T) : Hyp L (Submonoid.closure T) := by

  have P1 : ∀ b ∈ Submonoid.closure T, (b * L.Di = L.Di * b) ∧ (b * L.Dbi = L.Dbi * b) ∧
      (∃ t : ℂ, ∀ Y, L.Ahat Y * b = b * L.Ahat (Y + t)) ∧ RaisingCommutesModulo L (Submonoid.closure T) b := by
    intro b hb
    induction hb using Submonoid.closure_induction with
    | mem x hx => exact ⟨hDi x hx, hDbi x hx, hA x hx, hR x hx⟩
    | one => exact ⟨by simp, by simp, ⟨0, fun Y => by simp⟩, fun Y => ⟨0, [], by simp, by simp⟩⟩
    | mul x y hx hy ihx ihy =>
      obtain ⟨x1, x2, ⟨tx, htx⟩, rx⟩ := ihx
      obtain ⟨y1, y2, ⟨ty, hty⟩, ry⟩ := ihy
      refine ⟨by rw [mul_assoc, y1, ← mul_assoc, x1, mul_assoc], by rw [mul_assoc, y2, ← mul_assoc, x2, mul_assoc],
        ⟨tx + ty, fun Y => by rw [← mul_assoc, htx, mul_assoc, hty, mul_assoc, add_assoc]⟩, fun Y => ?_⟩
      obtain ⟨t1, ts1, hts1, e1⟩ := rx Y
      obtain ⟨t2, ts2, hts2, e2⟩ := ry (Y + t1)
      refine ⟨t1 + t2, (ts1.map fun z => (z.1, z.2.1 * y, z.2.2 + ty)) ++ (ts2.map fun z => (z.1, x * z.2.1, z.2.2)),
        ?_, ?_⟩
      · intro z hz
        rcases List.mem_append.1 hz with hz | hz
        · obtain ⟨z', hz', rfl⟩ := List.mem_map.1 hz
          exact Submonoid.mul_mem _ (hts1 z' hz') hy
        · obtain ⟨z', hz', rfl⟩ := List.mem_map.1 hz
          exact Submonoid.mul_mem _ hx (hts2 z' hz')
      · have s1 : (ts1.map fun z => z.1 • (z.2.1 * L.Ahat z.2.2)).sum * y =
            ((ts1.map fun z => (z.1, z.2.1 * y, z.2.2 + ty)).map fun z => z.1 • (z.2.1 * L.Ahat z.2.2)).sum := by
          rw [← List.sum_map_mul_right, List.map_map]
          congr 1
          refine List.map_congr_left fun z _ => ?_
          simp only [Function.comp_apply, smul_mul_assoc, mul_assoc, hty]
        have s2 : x * (ts2.map fun z => z.1 • (z.2.1 * L.Ahat z.2.2)).sum =
            ((ts2.map fun z => (z.1, x * z.2.1, z.2.2)).map fun z => z.1 • (z.2.1 * L.Ahat z.2.2)).sum := by
          rw [← List.sum_map_mul_left, List.map_map]
          congr 1
          refine List.map_congr_left fun z _ => ?_
          simp only [Function.comp_apply, mul_smul_comm, mul_assoc]
        calc L.R0 Y * (x * y) = (L.R0 Y * x) * y := by rw [mul_assoc]
          _ = x * (L.R0 (Y + t1) * y) + (ts1.map fun z => z.1 • (z.2.1 * L.Ahat z.2.2)).sum * y := by
              rw [e1, add_mul, mul_assoc]
          _ = _ := by
              rw [e2, s1, mul_add, s2, List.map_append, List.sum_append, ← mul_assoc, add_assoc Y]
              abel
  exact ⟨fun b hb => (P1 b hb).1, fun b hb => (P1 b hb).2.1, fun b hb => (P1 b hb).2.2.1,
    fun b hb Y => (P1 b hb).2.2.2 Y, hdrb⟩

end Formalism.FourierDecayAlt.P.MAx3.H

