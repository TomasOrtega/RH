-/
theorem apply_matrix_pointwise {N : ℕ} (b : SlopeTestRemainingChoices (Fin N) (A P (DQ P))) (hb : b ∈ BlockMatrixAlgebra P (Fin N))
    (U : Qp P.r P.TT → Iota P N → ℂ) (hU : ∀ i, (fun q => U q i) ∈ smSub P.r P.TT) (q : Qp P.r P.TT)
