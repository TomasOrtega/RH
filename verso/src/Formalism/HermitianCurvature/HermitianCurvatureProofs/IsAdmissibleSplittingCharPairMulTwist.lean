theorem rep_add {G : Set ℂ} {E F : ℂ → SlopeTestRemainingChoices S (A P (DQ P))} (hE : Rep L G E) (hF : Rep L G F) :
    Rep L G (fun Y => E Y + F Y) := by
  obtain ⟨t1, h1, e1⟩ := hE
