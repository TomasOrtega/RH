        ∏ m ∈ ((Icc 1 (k - 1)).erase j).filter (fun m => ¬ m < j), (b m - b j)) := by
    have hσ : ((-1 : ℝ) ^ (k - 1 - j)) ≠ 0 := pow_ne_zero _ (by norm_num)
