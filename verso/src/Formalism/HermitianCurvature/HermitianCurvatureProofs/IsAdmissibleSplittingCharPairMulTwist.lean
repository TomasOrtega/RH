section Star

variable {A : Type} [Ring A] [StarRing A] {S : Type} [Fintype S] [DecidableEq S]

/- English proof (translation)
Use extensionality with `E E'`. Unfold `io`. Simplify using `only [Matrix.star_apply, Matrix.scalar_apply, Matrix.diagonal_apply]`. Distinguish the cases in `h : E = E'`. Substitute `h` using the available equality.

Simplify using the standard rewrite rules. Rewrite using `[if_neg (Ne.symm h), if_neg h, star_zero]`.
-/
theorem star_io (x : A) : star (io x : SlopeTestRemainingChoices S A) = io (star x) := by
  ext E E'
  unfold io
  simp only [Matrix.star_apply, Matrix.scalar_apply, Matrix.diagonal_apply]
  by_cases h : E = E'
  · subst h; simp
  · rw [if_neg (Ne.symm h), if_neg h, star_zero]

end Star

section StarModel

variable (P : M.Par) (D : DAlg P.r)

/- English proof (translation)
Use extensionality with `i j`. Unfold `sc`. Simplify using `only [Matrix.star_apply, Matrix.scalar_apply, Matrix.diagonal_apply]`. Distinguish the cases in `h : i = j`. Substitute `h` using the available equality.

Simplify using the standard rewrite rules. Rewrite using `[if_neg (Ne.symm h), if_neg h, star_zero]`.
-/
theorem star_sc (w : D.Pr) : star (sc P D w) = sc P D (star w) := by
  ext i j
  unfold sc
  simp only [Matrix.star_apply, Matrix.scalar_apply, Matrix.diagonal_apply]
  by_cases h : i = j
  · subst h; simp
  · rw [if_neg (Ne.symm h), if_neg h, star_zero]

/- English proof (translation)
Use `show ((D.pP l).2.unop, MulOpposite.op (D.pP l).1) = -(D.pbP l)`. Use `Prod.ext rfl ?_` and prove the remaining obligations. Use `show MulOpposite.op (D.ev (M.vc l)) = -(MulOpposite.op (-(D.ev (M.vc l))))`. Rewrite using `[MulOpposite.op_neg, neg_neg]`.
-/
theorem star_pP (l : Fin P.r) : star (D.pP l) = -(D.pbP l) := by
  show ((D.pP l).2.unop, MulOpposite.op (D.pP l).1) = -(D.pbP l)
  refine Prod.ext rfl ?_
  show MulOpposite.op (D.ev (M.vc l)) = -(MulOpposite.op (-(D.ev (M.vc l))))
  rw [MulOpposite.op_neg, neg_neg]

/- English proof (translation)
Use `show ((D.pbP l).2.unop, MulOpposite.op (D.pbP l).1) = -(D.pP l)`. Use `Prod.ext rfl ?_` and prove the remaining obligations. Use `show MulOpposite.op (D.ev (M.vcb l)) = -(MulOpposite.op (-(D.ev (M.vcb l))))`. Rewrite using `[MulOpposite.op_neg, neg_neg]`.
-/
theorem star_pbP (l : Fin P.r) : star (D.pbP l) = -(D.pP l) := by
  show ((D.pbP l).2.unop, MulOpposite.op (D.pbP l).1) = -(D.pP l)
  refine Prod.ext rfl ?_
  show MulOpposite.op (D.ev (M.vcb l)) = -(MulOpposite.op (-(D.ev (M.vcb l))))
  rw [MulOpposite.op_neg, neg_neg]

variable {P D}

/- English proof (translation)
Take `⟨hp, hpb, hc, hci, hcb, hcbi, -⟩` from `hL`. Establish `hs : ∀ y ∈ sgen P D L, y ∈ Algebra.adjoin ℂ (sgen P D L)` using `fun y hy => Algebra.subset_adjoin hy`. Introduce and unpack `y (((((⟨l, rfl⟩ | ⟨l, rfl⟩) | ⟨l, rfl⟩) | ⟨l, rfl⟩) | ⟨l, rfl⟩) | ⟨l, rfl⟩)`. Establish `: star (L.p l) = -(L.pb l)`. Rewrite using `[hp, hpb]`.

Use `show star (sc P D (D.pP l)) = -sc P D (D.pbP l)`. Rewrite using `[star_sc, star_pP]`. Unfold `sc`. Simplify using the standard rewrite rules. Rewrite using `[this]; exact neg_mem (hs _ (by simp [sgen]))`.

Establish `: star (L.c l) = L.cb l`. Rewrite using `[hc, hcb]`. Use `show star (sc P D (D.cP l)) = sc P D (D.cbP l)`. Rewrite using `[star_sc]`. Both sides reduce to the same expression.

Rewrite using `[this]; exact hs _ (by simp [sgen])`. Establish `: star (L.ci l) = L.cbi l`. Rewrite using `[hci, hcbi]`. Use `show star (sc P D (D.ciP l)) = sc P D (D.cbiP l)`. Rewrite using `[star_sc]`.

Both sides reduce to the same expression. Rewrite using `[this]; exact hs _ (by simp [sgen])`. Establish `: star (L.pb l) = -(L.p l)`. Rewrite using `[hp, hpb]`. Use `show star (sc P D (D.pbP l)) = -sc P D (D.pP l)`.

Rewrite using `[star_sc, star_pbP]`. Unfold `sc`. Simplify using the standard rewrite rules. Rewrite using `[this]; exact neg_mem (hs _ (by simp [sgen]))`. Establish `: star (L.cb l) = L.c l`.

Rewrite using `[hc, hcb]`. Use `show star (sc P D (D.cbP l)) = sc P D (D.cP l)`. Rewrite using `[star_sc]`. Both sides reduce to the same expression. Rewrite using `[this]; exact hs _ (by simp [sgen])`.

Establish `: star (L.cbi l) = L.ci l`. Rewrite using `[hci, hcbi]`. Use `show star (sc P D (D.cbiP l)) = sc P D (D.ciP l)`. Rewrite using `[star_sc]`. Both sides reduce to the same expression.

Rewrite using `[this]; exact hs _ (by simp [sgen])`.
-/
theorem star_sgen_mem {L : LevelData (A P D) P.r} (hL : IsModelLevel P D L) :
    ∀ y ∈ sgen P D L, star y ∈ Algebra.adjoin ℂ (sgen P D L) := by
  obtain ⟨hp, hpb, hc, hci, hcb, hcbi, -⟩ := hL
  have hs : ∀ y ∈ sgen P D L, y ∈ Algebra.adjoin ℂ (sgen P D L) := fun y hy => Algebra.subset_adjoin hy
  rintro y (((((⟨l, rfl⟩ | ⟨l, rfl⟩) | ⟨l, rfl⟩) | ⟨l, rfl⟩) | ⟨l, rfl⟩) | ⟨l, rfl⟩)
  · have : star (L.p l) = -(L.pb l) := by
      rw [hp, hpb]; show star (sc P D (D.pP l)) = -sc P D (D.pbP l)
      rw [star_sc, star_pP]; unfold sc; simp
    rw [this]; exact neg_mem (hs _ (by simp [sgen]))
  · have : star (L.c l) = L.cb l := by
      rw [hc, hcb]; show star (sc P D (D.cP l)) = sc P D (D.cbP l); rw [star_sc]; rfl
    rw [this]; exact hs _ (by simp [sgen])
  · have : star (L.ci l) = L.cbi l := by
      rw [hci, hcbi]; show star (sc P D (D.ciP l)) = sc P D (D.cbiP l); rw [star_sc]; rfl
    rw [this]; exact hs _ (by simp [sgen])
  · have : star (L.pb l) = -(L.p l) := by
      rw [hp, hpb]; show star (sc P D (D.pbP l)) = -sc P D (D.pP l)
      rw [star_sc, star_pbP]; unfold sc; simp
    rw [this]; exact neg_mem (hs _ (by simp [sgen]))
  · have : star (L.cb l) = L.c l := by
      rw [hc, hcb]; show star (sc P D (D.cbP l)) = sc P D (D.cP l); rw [star_sc]; rfl
    rw [this]; exact hs _ (by simp [sgen])
  · have : star (L.cbi l) = L.ci l := by
      rw [hci, hcbi]; show star (sc P D (D.cbiP l)) = sc P D (D.ciP l); rw [star_sc]; rfl
    rw [this]; exact hs _ (by simp [sgen])

/- English proof (translation)
Proceed by induction on `hx using Algebra.adjoin_induction with`. Consider the case `mem y hy => exact star_sgen_mem hL y hy`. Consider the case `algebraMap z => rw [← algebraMap_star_comm]`. Conclude with `Subalgebra.algebraMap_mem _ _`. Consider the case `add x y _ _ hx hy => rw [star_add]`.

Conclude with `add_mem hx hy`. Consider the case `mul x y _ _ hx hy => rw [star_mul]`. Conclude with `mul_mem hy hx`.
-/
theorem star_adjoin {L : LevelData (A P D) P.r} (hL : IsModelLevel P D L) {x : A P D}
    (hx : x ∈ Algebra.adjoin ℂ (sgen P D L)) : star x ∈ Algebra.adjoin ℂ (sgen P D L) := by
  induction hx using Algebra.adjoin_induction with
  | mem y hy => exact star_sgen_mem hL y hy
  | algebraMap z => rw [← algebraMap_star_comm]; exact Subalgebra.algebraMap_mem _ _
  | add x y _ _ hx hy => rw [star_add]; exact add_mem hx hy
  | mul x y _ _ hx hy => rw [star_mul]; exact mul_mem hy hx

end StarModel

