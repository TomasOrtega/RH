-/
theorem iter_exp (s : ℝ) : ∀ n : ℕ, iteratedDeriv n (fun u : ℝ => Real.exp (u * s)) = fun u => s ^ n * Real.exp (u * s)
  | 0 => by simp
  | n + 1 => by
    rw [iteratedDeriv_succ, iter_exp s n]
    funext u
    have hd := (((hasDerivAt_id' u).mul_const s).exp).const_mul (s ^ n)
    rw [hd.deriv]; ring

