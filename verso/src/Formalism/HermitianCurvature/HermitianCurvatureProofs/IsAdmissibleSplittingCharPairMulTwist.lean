      · have h1 : (e = e' ∧ M.Up P ((m : ℕ) + 1) π' π) := ⟨he, hu⟩
        rw [if_pos h1]
        simp only [hu, if_true, mul_one]
      · have h1 : ¬ (e = e' ∧ M.Up P ((m : ℕ) + 1) π' π) := fun h => hu h.2
        rw [if_neg h1]
        simp only [hu, if_false, mul_zero]
    · intro b _ hb; rw [if_neg (Ne.symm hb)]; simp
    · simp
  · rw [if_neg he]
    exact (sum_eq_zero fun m _ => if_neg fun h => he h.1).symm

/- English proof (translation)
Unfold `dL`. Rewrite using `[lsS_sum, lsS_sum, ← sum_sub_distrib]`. Distinguish the cases in `hp : π = π'`. Rewrite using `[if_pos hp]`. Use `sum_congr rfl fun n _ => ?_` and prove the remaining obligations.

Unfold `eUS`. Distinguish the cases in `hc : e ((wordP w).get n).intersection_update_fsHerm_neg_one = 0 ∧ e' ((wordP w).get n).intersection_update_fsHerm_neg_one = 1 ∧ ∀ b, b ≠ ((wordP w).get n).intersection_update_fsHerm_neg_one → e b = e' b`. Rewrite using `[if_pos hc, if_pos ⟨hp, hc⟩]`. Simplify using the standard rewrite rules. Expand and normalize the polynomial expressions, which then agree.

