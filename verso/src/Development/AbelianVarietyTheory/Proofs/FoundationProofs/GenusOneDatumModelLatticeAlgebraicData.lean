/- English proof (translation)
Use function extensionality and compare the values at `z`. Simplify using `[U1]`.
-/
theorem weierstrass_translate_zero_eq_self (Λ : AddSubgroup ℂ) (F : ℂ → ℂ) : U1 Λ 0 F = F := by
  funext z; simp [U1]

/- English proof (translation)
Take `⟨w₁, w₂, hli, rfl⟩` from `hlat`. Use `⟨w₁ / 2, ?_, ⟨2, by norm_num, ?_⟩⟩` and prove the remaining obligations. Introduce `h`. Rewrite `h` using `[AddSubgroup.mem_closure_pair]`. Take `⟨m, n, hmn⟩` from `h`.

Establish `key` using `(LinearIndependent.pair_iff.1 hli) ((m : ℝ) - 1 / 2) (n : ℝ) (by`. Establish `e : (m : ℂ) * w₁ + (n : ℂ) * w₂ = w₁ / 2` using `by simpa [zsmul_eq_mul] using hmn`. Simplify using `only [Complex.real_smul]`. Use `push_cast`. Take the linear combination `e)`.

Establish `h1 : (m : ℝ) = 1 / 2` using `by linarith [key.1]`. Establish `h2 : (2 * m : ℝ) = 1` using `by linarith`. Establish `h3 : (2 * m : ℤ) = 1` using `by exact_mod_cast h2`. Use linear arithmetic over natural numbers and integers. Establish `: (2 : ℂ) * (w₁ / 2) = w₁` using `by ring`.

Use `push_cast`. Rewrite using `[this]`. Conclude with `AddSubgroup.subset_closure (by simp)`.
-/
theorem half_gen {Λ : AddSubgroup ℂ} (hlat : IsLat Λ) : ∃ v : ℂ, v ∉ Λ ∧ InRationalLattice Λ v := by
  obtain ⟨w₁, w₂, hli, rfl⟩ := hlat
  refine ⟨w₁ / 2, ?_, ⟨2, by norm_num, ?_⟩⟩
  · intro h
    rw [AddSubgroup.mem_closure_pair] at h
    obtain ⟨m, n, hmn⟩ := h
    have key := (LinearIndependent.pair_iff.1 hli) ((m : ℝ) - 1 / 2) (n : ℝ) (by
      have e : (m : ℂ) * w₁ + (n : ℂ) * w₂ = w₁ / 2 := by simpa [zsmul_eq_mul] using hmn
      simp only [Complex.real_smul]
      push_cast
      linear_combination e)
    have h1 : (m : ℝ) = 1 / 2 := by linarith [key.1]
    have h2 : (2 * m : ℝ) = 1 := by linarith
    have h3 : (2 * m : ℤ) = 1 := by exact_mod_cast h2
    omega
  · have : (2 : ℂ) * (w₁ / 2) = w₁ := by ring
    push_cast
    rw [this]
    exact AddSubgroup.subset_closure (by simp)

/- English proof (translation)
Introduce `D p _ cc δ g hg`. Take `⟨hcc, -, hδ, hΛ, hok⟩` from `hg`. Establish `hcrv : Crv D cc δ` using `⟨hcc, hδ⟩`. Establish `hG` using `(GlobalTheory.InducedType.induced_type D).1`. Take `⟨hlat, -⟩` from `GlobalTheory.CurveLattice.lattice_of_curve D hG cc δ hcrv`.

Take `⟨⟨-, h2, h3⟩, hwp⟩` from `(GlobalTheory.CurveAlgebraic.integral_j_and_algebraic_data D hG).2 cc δ hcrv`. Establish `huse` using `(GlobalTheory.ThetaConj.cmTheta_taylorCoeff_algebraic_and_conjugate D cc δ hcrv).1`. Simplify using `only [tor0] at h2 h3`. Rewrite `hlat`, `h2`, `h3`, `hwp`, `huse` using `[← hΛ]`. Establish `hlat' : IsLat g.abelian₂` using `hlat`.

Take `⟨v, hv, hvq⟩` from `half_gen hlat'`. Use `⟨hok.2.1, hlat', h2, h3, ⟨hlat'.differentiable, fun n => ?_⟩, v, hv, (hwp v hvq hv).1⟩` and prove the remaining obligations. Use `huse 0 ⟨1, one_pos, by simp⟩ n` as an intermediate fact. Rewrite `this` using `[weierstrass_translate_zero_eq_self]`. Then use the resulting hypothesis.
-/
theorem atData : ∀ (D : D7) (p : ℕ) [Fact p.Prime] (cc : Ideal (𝓞 D.host.K)) (δ : ℂ) (g : GL3Theta.G1 p), GL3Theta.At D cc δ g → IsWq g.W g.wq ∧ IsLat g.abelian₂ ∧ g2 g.abelian₂ ∈ Qbar ∧ g3 g.abelian₂ ∈ Qbar ∧ AlgEnt (sgStar g.abelian₂) ∧ ∃ v : ℂ, v ∉ g.abelian₂ ∧ wpF g.abelian₂ v ∈ Qbar := by
  intro D p _ cc δ g hg
  obtain ⟨hcc, -, hδ, hΛ, hok⟩ := hg
  have hcrv : Crv D cc δ := ⟨hcc, hδ⟩
  have hG := (GlobalTheory.InducedType.induced_type D).1
  obtain ⟨hlat, -⟩ := GlobalTheory.CurveLattice.lattice_of_curve D hG cc δ hcrv
  obtain ⟨⟨-, h2, h3⟩, hwp⟩ := (GlobalTheory.CurveAlgebraic.integral_j_and_algebraic_data D hG).2 cc δ hcrv
  have huse := (GlobalTheory.ThetaConj.cmTheta_taylorCoeff_algebraic_and_conjugate D cc δ hcrv).1
  simp only [tor0] at h2 h3
  rw [← hΛ] at hlat h2 h3 hwp huse
  have hlat' : IsLat g.abelian₂ := hlat
  obtain ⟨v, hv, hvq⟩ := half_gen hlat'
  refine ⟨hok.2.1, hlat', h2, h3, ⟨hlat'.differentiable, fun n => ?_⟩, v, hv, (hwp v hvq hv).1⟩
  have := huse 0 ⟨1, one_pos, by simp⟩ n
  rwa [weierstrass_translate_zero_eq_self] at this

end GlobalTheory.FrobStick.AtData
