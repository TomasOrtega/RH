        ∑ b : Bool, ∑ i : Iota P w.length, (fun ω i => (dwW P l (Y :: w) ω (b, i) : ℂ) *
          gL P l L' w Y (Xw P l L' (ju P j) w) ω (b, i)) ω i *
          conj ((fun ω i => gL P l L' w Y (LE.mulF (baseQ P) ψ (Xw P l L' (ju P j) w)) ω (b, i)) ω i) := by
