/- English proof (translation)
Take `⟨w, hw⟩` from `(GlobalTheory.LKCentAf.cent_iff_mem P _).1 (quot_commute P Q hγ hc)`. Establish `hb : ((P.β * Q.β⁻¹ : G.Cˣ) : G.C) ∈ Algebra.adjoin G.F ({(P.γ : G.C)} : Set G.C)`. Rewrite using `[← hw]`. Conclude with `w.2`. Conclude with `Algebra.commute_of_mem_adjoin_of_forall_mem_commute hb fun z hz => by`.

Rewrite `hz` using `[Set.mem_singleton_iff]`. Substitute `hz` using the available equality. Conclude with `hy`.
-/
theorem commute_quot (P : Pair G) (Q : DPair G) (hγ : P.γ = Q.γ) (hc : P.c = Q.c) (y : G.C)
    (hy : y * (P.γ : G.C) = (P.γ : G.C) * y) :
    y * ((P.β * Q.β⁻¹ : G.Cˣ) : G.C) = ((P.β * Q.β⁻¹ : G.Cˣ) : G.C) * y := by
  obtain ⟨w, hw⟩ := (GlobalTheory.LKCentAf.cent_iff_mem P _).1 (quot_commute P Q hγ hc)
  have hb : ((P.β * Q.β⁻¹ : G.Cˣ) : G.C) ∈ Algebra.adjoin G.F ({(P.γ : G.C)} : Set G.C) := by
    rw [← hw]; exact w.2
  exact Algebra.commute_of_mem_adjoin_of_forall_mem_commute hb fun z hz => by
    rw [Set.mem_singleton_iff] at hz
    subst hz
    exact hy

/- English proof (translation)
Use extensionality with `⟨y, s⟩`. Express the relevant statement in the definitionally equal form `(y * P.γ = P.γ * y ∧ (y : G.C) * P.β * sh G y = algebraMap ℚ G.C s * P.β) ↔ (y * Q.γ = Q.γ * y ∧ (y : G.C) * Q.β * sh G y = algebraMap ℚ G.C s * Q.β)`. Rewrite using `[← hγ]`. Use `and_congr_right fun h1 => ?_` and prove the remaining obligations. Establish `hy : (y : G.C) * (P.γ : G.C) = (P.γ : G.C) * y` using `by rw [← Units.val_mul, h1, Units.val_mul]`.

Establish `hcomm` using `commute_quot P Q hγ hc y hy`. Use `set b : G.Cˣ := P.β * Q.β⁻¹`. Establish `hβ : (P.β : G.C) = (b : G.C) * Q.β` using `by simp [b, mul_assoc]`. Rewrite using `[hβ]`. Establish `e1 : (y : G.C) * (b * Q.β) * sh G y = b * ((y : G.C) * Q.β * sh G y)`.

Rewrite using `[← mul_assoc (y : G.C), hcomm]`. Simplify using `only [mul_assoc]`. Establish `e2 : algebraMap ℚ G.C s * ((b : G.C) * Q.β) = b * (algebraMap ℚ G.C s * Q.β)`. Rewrite using `[← mul_assoc, Algebra.commutes, mul_assoc]`. Rewrite using `[e1, e2]`.

Prove the components needed by the constructor for the conclusion. Introduce `h`. Use `congrArg (((b⁻¹ : G.Cˣ) : G.C) * ·) h` as an intermediate fact. Simplify `this` using `only [← mul_assoc, Units.inv_mul, one_mul]`. Introduce `h`.

Rewrite using `[h]`.
-/
theorem cent_eq (P : Pair G) (Q : DPair G) (hγ : P.γ = Q.γ) (hc : P.c = Q.c) : P.cent = Q.cent := by
  ext ⟨y, s⟩
  change (y * P.γ = P.γ * y ∧ (y : G.C) * P.β * sh G y = algebraMap ℚ G.C s * P.β) ↔
    (y * Q.γ = Q.γ * y ∧ (y : G.C) * Q.β * sh G y = algebraMap ℚ G.C s * Q.β)
  rw [← hγ]
  refine and_congr_right fun h1 => ?_
  have hy : (y : G.C) * (P.γ : G.C) = (P.γ : G.C) * y := by rw [← Units.val_mul, h1, Units.val_mul]
  have hcomm := commute_quot P Q hγ hc y hy
  set b : G.Cˣ := P.β * Q.β⁻¹
  have hβ : (P.β : G.C) = (b : G.C) * Q.β := by simp [b, mul_assoc]
  rw [hβ]
  have e1 : (y : G.C) * (b * Q.β) * sh G y = b * ((y : G.C) * Q.β * sh G y) := by
    rw [← mul_assoc (y : G.C), hcomm]; simp only [mul_assoc]
  have e2 : algebraMap ℚ G.C s * ((b : G.C) * Q.β) = b * (algebraMap ℚ G.C s * Q.β) := by
    rw [← mul_assoc, Algebra.commutes, mul_assoc]
  rw [e1, e2]
  constructor
  · intro h
    have := congrArg (((b⁻¹ : G.Cˣ) : G.C) * ·) h
    simpa only [← mul_assoc, Units.inv_mul, one_mul] using this
  · intro h; rw [h]

end GlobalTheory.LKDefTerm

