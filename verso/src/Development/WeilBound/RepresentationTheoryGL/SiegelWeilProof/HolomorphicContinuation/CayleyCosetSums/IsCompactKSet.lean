private theorem mul_JJ_mul_conjTranspose_of_inG {x : M2 n} (hx : InG x) : x * JJ n * xᴴ = JJ n := by
  have hJ := (JJ_mul_JJ' (n := n))
  have hx' : xᴴ * JJ n * x = JJ n := hx
