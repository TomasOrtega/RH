namespace Formalism.FourierDecayAlt.P.MAx3

open Formalism.FourierDecayAlt Formalism.FourierDecayAlt.MA MeasureTheory Formalism.FourierDecayAlt.Fr

/- English proof (translation)
Take `⟨⟨hOK, hl1, hlk, _, hu, hu', hαβ, hcut⟩, _, _, _, _, _, hL2, _, h6⟩` from `hH`. Establish `hBF` using `Formalism.FourierDecayAlt.P.boxes_fit (sysQ P l L j lam α β Lb c Ntot) hL2 h6`. Establish `hAdm` using `hBF.2.2 w hw hlen`. Establish `hYI : ∀ Y ∈ w, Y ∈ Set.Icc α β` using `fun Y hY => hAdm.1 (true, Y) (List.mem_map.2 ⟨Y, hY, rfl⟩)`. Establish `hpw : w.Pairwise fun Y Y' => 2 < |Y - Y'|`.

Establish `h2` using `hAdm.2`. Unfold `LE.plus at h2`. Rewrite `h2` using `[List.pairwise_map]`. Conclude with `h2`. Establish `hcutw : ∀ a ∈ wordP w, a.pt.im = 0 ∧ I.OnCut P.u P.u' l a.pt.re`.

Introduce `a ha`. Take `⟨Y', hY', e⟩` from `MAx2.mem_wordP ha`. Rewrite using `[e]`. Conclude with `⟨Complex.ofReal_im _, by rw [Complex.ofReal_re]; exact hcut _ (hYI _ hY')⟩`. Establish `hπ` using `Formalism.FourierDecayAlt.P.types_interlace P hOK (ixOf P w.length i).2`.

Establish `hpos` using `Formalism.FourierDecayAlt.P.c_pos_truncated Formalism.FourierDecayAlt.P.interlacing_sign Formalism.FourierDecayAlt.P.q_positive_interlacing Formalism.FourierDecayAlt.P.q_positive_shift Formalism.FourierDecayAlt.P.cPos_true (Fin w.length) P.k P.u P.u' (M.rho P (ixOf P w.length i). …`. Conclude with `hpos.1`.
-/
theorem cwPos (P : M.Par) (l : ℕ) (L : R.LevelData (A P (DQ P)) P.r) (j : M.Ty P → SmQ P.r P.TT)
    (lam : Fin (P.k + 2 * P.r + 1) → ℝ) (α β Lb : ℝ) (c : LE.Cut) (Ntot : ℕ)
    (hH : Hyps P l L j lam α β Lb Ntot) (w : List ℝ) (hw : (sysQ P l L j lam α β Lb c Ntot).OnBoxes w)
    (hlen : w.length ≤ Ntot) (i : Iota P w.length) :
    0 < (cs (M.x0 P l (ixOf P w.length i).2) (M.qC P) (wordP w) (ixOf P w.length i).1).re := by
  obtain ⟨⟨hOK, hl1, hlk, _, hu, hu', hαβ, hcut⟩, _, _, _, _, _, hL2, _, h6⟩ := hH
  have hBF := Formalism.FourierDecayAlt.P.boxes_fit (sysQ P l L j lam α β Lb c Ntot) hL2 h6
  have hAdm := hBF.2.2 w hw hlen
  have hYI : ∀ Y ∈ w, Y ∈ Set.Icc α β := fun Y hY => hAdm.1 (true, Y) (List.mem_map.2 ⟨Y, hY, rfl⟩)
  have hpw : w.Pairwise fun Y Y' => 2 < |Y - Y'| := by
    have h2 := hAdm.2
    unfold LE.plus at h2
    rw [List.pairwise_map] at h2
    exact h2
  have hcutw : ∀ a ∈ wordP w, a.pt.im = 0 ∧ I.OnCut P.u P.u' l a.pt.re := by
    intro a ha
    obtain ⟨Y', hY', e⟩ := MAx2.mem_wordP ha
    rw [e]
