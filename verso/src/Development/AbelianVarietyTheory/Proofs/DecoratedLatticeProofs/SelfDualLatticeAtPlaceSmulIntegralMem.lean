variable {D : D7}

/- English proof (translation)
Unfold `hermAt`. Rewrite using `[Finset.mul_sum]`. Use `Finset.sum_congr rfl fun i _ => ?_` and prove the remaining obligations. Rewrite using `[Finset.mul_sum]`. Use `Finset.sum_congr rfl fun j _ => ?_` and prove the remaining obligations.

Simplify using `only [Pi.smul_apply, smul_eq_mul]`. Expand and normalize the polynomial expressions, which then agree.
-/
theorem hermAt_smul_left (S : HSp D) (a : AE D) (y x : Fin S.rank → AE D) :
    hermAt S (a • y) x = a * hermAt S y x := by
  unfold hermAt
  rw [Finset.mul_sum]
  refine Finset.sum_congr rfl fun i _ => ?_
  rw [Finset.mul_sum]
  refine Finset.sum_congr rfl fun j _ => ?_
  simp only [Pi.smul_apply, smul_eq_mul]
  ring

/- English proof (translation)
Assemble the required witnesses or components as `⟨Ideal.mul_mem_left _ _ hb.1, by rw [RingHom.map_mul]; exact FrameLat.mul_mem_intAE ha.2 hb.2⟩`.
-/
theorem mul_mem_intAt {v : Pl D} {a b : AE D} (ha : a ∈ intAt D (· = v)) (hb : b ∈ intAt D (· = v)) :
    a * b ∈ intAt D (· = v) :=
  ⟨Ideal.mul_mem_left _ _ hb.1, by rw [RingHom.map_mul]; exact FrameLat.mul_mem_intAE ha.2 hb.2⟩

/- English proof (translation)
Introduce `D S v Λ hΛ a ha y hy`. Establish `hsupp : ∀ i, (a • y) i ∈ idAt D (· = v)` using `fun i => by`. Simplify using `only [Pi.smul_apply, smul_eq_mul]`. Conclude with `Ideal.mul_mem_left _ _ (hΛ.1 y hy i)`. Use `(hΛ.2.2 (a • y) hsupp).2 fun x hx => ?_` and prove the remaining obligations.

Rewrite using `[hermAt_smul_left]`. Conclude with `mul_mem_intAt ha ((hΛ.2.2 y (hΛ.1 y hy)).1 hy x hx)`.
-/
theorem smul_mem : ∀ (D : D7) (S : HSp D) (v : Pl D) (Λ : AddSubgroup (Fin S.rank → AE D)), IsSDAt S v Λ →
    ∀ a ∈ intAt D (· = v), ∀ y ∈ Λ, a • y ∈ Λ := by
  intro D S v Λ hΛ a ha y hy
  have hsupp : ∀ i, (a • y) i ∈ idAt D (· = v) := fun i => by
    simp only [Pi.smul_apply, smul_eq_mul]
    exact Ideal.mul_mem_left _ _ (hΛ.1 y hy i)
  refine (hΛ.2.2 (a • y) hsupp).2 fun x hx => ?_
  rw [hermAt_smul_left]
  exact mul_mem_intAt ha ((hΛ.2.2 y (hΛ.1 y hy)).1 hy x hx)

end GlobalTheory.IwaPlace.SDStable

