/- English proof (translation)
Use function extensionality and compare the values at `π`. Use `show ∑ π', ((1 : Matrix (M.Ty P) (M.Ty P) (DQ P).Pr) π π').1 (j π') = j π`. Rewrite using `[Finset.sum_eq_single π]`. Rewrite using `[Matrix.one_apply_eq]`. Both sides reduce to the same expression.

Introduce `b _ hb`. Rewrite using `[Matrix.one_apply_ne (Ne.symm hb)]`. Both sides reduce to the same expression. Simplify using the standard rewrite rules.
-/
theorem one_act (P : M.Par) (j : M.Ty P → SmQ P.r P.TT) : actA P (1 : A P (DQ P)) j = j := by
  funext π
  classical
  show ∑ π', ((1 : Matrix (M.Ty P) (M.Ty P) (DQ P).Pr) π π').1 (j π') = j π
  rw [Finset.sum_eq_single π]
  · rw [Matrix.one_apply_eq]; rfl
  · intro b _ hb
    rw [Matrix.one_apply_ne (Ne.symm hb)]; rfl
  · simp

/- English proof (translation)
Simplify using `only [LE.Sys.dens, LE.sq]`. Use `Finset.sum_congr rfl fun a _ => ?_` and prove the remaining obligations. Use `show (Wq P ω ^ 0 * ((1 : ℂ)).re) * ‖(j a : Qp P.r P.TT → ℂ) ω‖ ^ 2 = _`. Simplify using the standard rewrite rules.
-/
theorem dens_nil (P : M.Par) (l : ℕ) (L : R.LevelData (A P (DQ P)) P.r) (j : M.Ty P → SmQ P.r P.TT)
    (lam : Fin (P.k + 2 * P.r + 1) → ℝ) (α β Lb : ℝ) (c : LE.Cut) (Ntot : ℕ) (ω : Qp P.r P.TT) :
    (sysQ P l L j lam α β Lb c Ntot).dens [] ω = ∑ π, ‖(j π : Qp P.r P.TT → ℂ) ω‖ ^ 2 := by
  simp only [LE.Sys.dens, LE.sq]
  refine Finset.sum_congr rfl fun a _ => ?_
  show (Wq P ω ^ 0 * ((1 : ℂ)).re) * ‖(j a : Qp P.r P.TT → ℂ) ω‖ ^ 2 = _
  simp

end Formalism.FourierDecayAlt.P.MAx3

