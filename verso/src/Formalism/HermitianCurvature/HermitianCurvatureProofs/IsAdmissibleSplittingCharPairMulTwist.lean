section S_I4_I5

set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace Formalism.FourierDecayAlt.P.MAx3.I4

open Formalism.FourierDecayAlt Formalism.FourierDecayAlt.MA Formalism.FourierDecayAlt.R Formalism.FourierDecayAlt.Wd Formalism.FourierDecayAlt.Fr Formalism.FourierDecayAlt.P.MAx3.H Formalism.FourierDecayAlt.P.MAx1.An
open scoped ComplexConjugate

noncomputable section

variable {P : M.Par}

def PW (x : A P (DQ P)) (C : ℝ) : Prop :=
  0 ≤ C ∧ ∃ Mx : Qp P.r P.TT → Matrix (M.Ty P) (M.Ty P) ℂ, (∀ q π π', ‖Mx q π π'‖ ≤ C) ∧
    ∀ (f : M.Ty P → SmQ P.r P.TT) q π, evQ P (actA P x f π) q = ∑ π', Mx q π π' * evQ P (f π') q

/- English proof (translation)
Take `⟨h1, M1, b1, e1⟩` from `hx`. Take `⟨h2, M2, b2, e2⟩` from `hy`. Use `⟨by positivity, fun q π π'' => ∑ π', M1 q π π' * M2 q π' π'', fun q π π'' => ?_, fun f q π => ?_⟩` and prove the remaining obligations. Combine the equalities or inequalities in the displayed calculation. Rewrite using `[norm_mul]`.

Conclude with `mul_le_mul (b1 q π π') (b2 q π' π'') (norm_nonneg _) h1`. Use `_ = _ := by simp [mul_assoc]`. Rewrite using `[MAx2.R2.act_mul, e1]`. Simplify using `only [e2, Finset.mul_sum]`. Rewrite using `[Finset.sum_comm]`.

Use `Finset.sum_congr rfl fun π'' _ => ?_` and prove the remaining obligations. Rewrite using `[Finset.sum_mul]`. Conclude with `Finset.sum_congr rfl fun π' _ => by ring`.
-/
theorem PW_mul {x y : A P (DQ P)} {C₁ C₂ : ℝ} (hx : PW x C₁) (hy : PW y C₂) :
    PW (x * y) (Fintype.card (M.Ty P) * C₁ * C₂) := by
  obtain ⟨h1, M1, b1, e1⟩ := hx
  obtain ⟨h2, M2, b2, e2⟩ := hy
  refine ⟨by positivity, fun q π π'' => ∑ π', M1 q π π' * M2 q π' π'', fun q π π'' => ?_, fun f q π => ?_⟩
  · calc ‖∑ π', M1 q π π' * M2 q π' π''‖ ≤ ∑ π' : M.Ty P, ‖M1 q π π' * M2 q π' π''‖ := norm_sum_le _ _
      _ ≤ ∑ π' : M.Ty P, C₁ * C₂ := Finset.sum_le_sum fun π' _ => by
          rw [norm_mul]; exact mul_le_mul (b1 q π π') (b2 q π' π'') (norm_nonneg _) h1
      _ = _ := by simp [mul_assoc]
  · rw [MAx2.R2.act_mul, e1]
    simp only [e2, Finset.mul_sum]
    rw [Finset.sum_comm]
    refine Finset.sum_congr rfl fun π'' _ => ?_
    rw [Finset.sum_mul]
    exact Finset.sum_congr rfl fun π' _ => by ring

/- English proof (translation)
Take `⟨h0, Mx, b, e⟩` from `h`. Conclude with `⟨h0.trans hC, Mx, fun q π π' => (b q π π').trans hC, e⟩`.
-/
theorem PW_mono {x : A P (DQ P)} {C C' : ℝ} (h : PW x C) (hC : C ≤ C') : PW x C' := by
  obtain ⟨h0, Mx, b, e⟩ := h
  exact ⟨h0.trans hC, Mx, fun q π π' => (b q π π').trans hC, e⟩

/- English proof (translation)
Take `⟨F, Fb, rfl, hF⟩` from `hx`. Use `⟨hC, fun q π π' => if π = π' then g q else 0, fun q π π' => ?_, fun f q π => ?_⟩` and prove the remaining obligations. Simplify using `only split_ifs`. Conclude with `hg q`. Simplify using `using hC`.

Rewrite using `[MAx2.R2.act_sc, Finset.sum_eq_single π (fun b _ hb => by dsimp only; rw [if_neg (Ne.symm hb), zero_mul]) (by simp)] dsimp only`. Rewrite using `[if_pos rfl, ← hF q]`. Use `show evQ P (F * f π) q = _`. Rewrite using `[MAx2.Jet.evQ_mul]`.
-/
theorem PW_fn {x : A P (DQ P)} {g : Qp P.r P.TT → ℂ} (hx : IsFn x g) {C : ℝ} (hC : 0 ≤ C) (hg : ∀ q, ‖g q‖ ≤ C) :
    PW x C := by
  obtain ⟨F, Fb, rfl, hF⟩ := hx
  classical
  refine ⟨hC, fun q π π' => if π = π' then g q else 0, fun q π π' => ?_, fun f q π => ?_⟩
  · dsimp only
    split_ifs
    · exact hg q
    · simpa using hC
  · rw [MAx2.R2.act_sc, Finset.sum_eq_single π (fun b _ hb => by dsimp only; rw [if_neg (Ne.symm hb), zero_mul])
      (by simp)]
    dsimp only
    rw [if_pos rfl, ← hF q]
    show evQ P (F * f π) q = _
    rw [MAx2.Jet.evQ_mul]

/- English proof (translation)
Use `⟨by positivity, fun _ π π' => if π = π' then g π else 0, fun q π π' => ?_, fun f q π => ?_⟩` and prove the remaining obligations. Simplify using `only split_ifs`. Conclude with `Finset.single_le_sum (f := fun π => ‖g π‖) (fun _ _ => norm_nonneg _) (Finset.mem_univ π)`. Simplify using `using Finset.sum_nonneg (fun π _ => norm_nonneg (g π))`. Rewrite using `[MAx2.R2.act_kap, Finset.sum_eq_single π (fun b _ hb => by dsimp only; rw [if_neg (Ne.symm hb), zero_mul]) (by simp)] dsimp only`.

Rewrite using `[if_pos rfl]`. Both sides reduce to the same expression.
-/
theorem PW_kap (g : M.Ty P → ℂ) : PW (kap P (DQ P) g) (∑ π, ‖g π‖) := by
  classical
  refine ⟨by positivity, fun _ π π' => if π = π' then g π else 0, fun q π π' => ?_, fun f q π => ?_⟩
  · dsimp only
    split_ifs
    · exact Finset.single_le_sum (f := fun π => ‖g π‖) (fun _ _ => norm_nonneg _) (Finset.mem_univ π)
    · simpa using Finset.sum_nonneg (fun π _ => norm_nonneg (g π))
  · rw [MAx2.R2.act_kap, Finset.sum_eq_single π (fun b _ hb => by dsimp only; rw [if_neg (Ne.symm hb), zero_mul])
      (by simp)]
    dsimp only
    rw [if_pos rfl]
    rfl

/- English proof (translation)
Use `⟨by positivity, fun _ => c, fun q π π' => ?_, fun f q π => ?_⟩` and prove the remaining obligations. Conclude with `(Finset.single_le_sum (f := fun π' => ‖c π π'‖) (fun _ _ => norm_nonneg _) (Finset.mem_univ π')).trans (Finset.single_le_sum (f := fun π => ∑ π', ‖c π π'‖) (fun _ _ => Finset.sum_nonneg fun _ _ => norm_nonneg _) (Finset.mem_univ π))`. Rewrite using `[MAx2.R2.actA_eq, MAx2.Jet.evQ_sum]`. Use `Finset.sum_congr rfl fun π' _ => ?_` and prove the remaining obligations. Rewrite using `[hc]`.

Both sides reduce to the same expression.
-/
theorem PW_scalars (x : A P (DQ P)) (c : M.Ty P → M.Ty P → ℂ) (hc : ∀ π π', x π π' = algebraMap ℂ (DQ P).Pr (c π π')) :
    PW x (∑ π, ∑ π', ‖c π π'‖) := by
  refine ⟨by positivity, fun _ => c, fun q π π' => ?_, fun f q π => ?_⟩
  · exact (Finset.single_le_sum (f := fun π' => ‖c π π'‖) (fun _ _ => norm_nonneg _) (Finset.mem_univ π')).trans
      (Finset.single_le_sum (f := fun π => ∑ π', ‖c π π'‖) (fun _ _ => Finset.sum_nonneg fun _ _ => norm_nonneg _)
        (Finset.mem_univ π))
  · rw [MAx2.R2.actA_eq, MAx2.Jet.evQ_sum]
    refine Finset.sum_congr rfl fun π' _ => ?_
    rw [hc]
    rfl

/- English proof (translation)
Apply the tactic sequence `exact ⟨_, PW_scalars _ (fun π' π => if M.Up P i π π' then ((Real.sqrt (M.Nrm P i π) : ℝ) : ℂ) else 0) (fun π' π => by simp only [SS, Matrix.of_apply]; split_ifs <;> simp)⟩`.
-/
theorem PW_SS (i : ℕ) : ∃ C, PW (SS P (DQ P) i) C := by
  classical
  exact ⟨_, PW_scalars _ (fun π' π => if M.Up P i π π' then ((Real.sqrt (M.Nrm P i π) : ℝ) : ℂ) else 0)
    (fun π' π => by simp only [SS, Matrix.of_apply]; split_ifs <;> simp)⟩

/- English proof (translation)
Conclude with `⟨_, PW_scalars _ (fun π π' => if M.Up P i π π' then ((Real.sqrt (M.Nrm P i π) : ℝ) : ℂ) else 0) (fun π π' => by`. Rewrite using `[Matrix.star_apply]`. Simplify using `only [SS, Matrix.of_apply]`. Use `split_ifs`. Rewrite using `[← algebraMap_star_comm]`.

Simplify using the standard rewrite rules. Use the proof step `simp)⟩`.
-/
theorem PW_starSS (i : ℕ) : ∃ C, PW (star (SS P (DQ P) i)) C := by
  classical
  exact ⟨_, PW_scalars _ (fun π π' => if M.Up P i π π' then ((Real.sqrt (M.Nrm P i π) : ℝ) : ℂ) else 0)
    (fun π π' => by
      rw [Matrix.star_apply]
      simp only [SS, Matrix.of_apply]
      split_ifs
      · rw [← algebraMap_star_comm]; simp
      · simp)⟩

end

