    funext Y
    rw [G.gX_split P hL w Y X q i]
    have h1 := hα (Y : ℂ) q i
    simp only [if_true] at h1
    rw [h1]
    congr 1
    exact Finset.sum_congr rfl fun i' _ => by rw [hpt]
  rw [e]
  refine ContinuousOn.add ?_ (continuousOn_finset_sum _ fun i' _ => (hEc i i').mul (cont_gA w X K q i'))
