include hLaw

/- English proof (translation)
Break down `hb with (((hb | ⟨f, rfl⟩) | ⟨i, hi, rfl⟩) | ⟨i, hi, rfl⟩)` into its components or cases. Simplify using `only [Set.mem_insert_iff, Set.mem_singleton_iff] at hb`. Break down `hb with rfl | rfl | rfl | rfl` into its components or cases. Conclude with `⟨_, PW_ζi hTTp hL⟩`. Conclude with `⟨_, PW_ζbi hTTp hL⟩`.

Conclude with `⟨_, PW_DDbi hTTp hL⟩`. Conclude with `⟨_, PW_DbDi hTTp hL⟩`. Conclude with `⟨_, PW_kap f⟩`. Take `⟨C, hC⟩` from `PW_SS (P := P) i`. Conclude with `⟨_, PW_mul (PW_DrbDri hTTp hL) hC⟩`.

Take `⟨C, hC⟩` from `PW_starSS (P := P) i show ∃ C, PW (star (L.Drb * L.Dri * SS P (DQ P) i)) C`. Rewrite using `[starSSn_eq hL hLaw]`. Conclude with `⟨_, PW_mul hC (PW_DrDrbi hTTp hL)⟩`.
-/
theorem PW_gen {b : A P (DQ P)} (hb : b ∈ bddSet P L) : ∃ C, PW b C := by
  rcases hb with (((hb | ⟨f, rfl⟩) | ⟨i, hi, rfl⟩) | ⟨i, hi, rfl⟩)
  · simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hb
    rcases hb with rfl | rfl | rfl | rfl
    · exact ⟨_, PW_ζi hTTp hL⟩
    · exact ⟨_, PW_ζbi hTTp hL⟩
    · exact ⟨_, PW_DDbi hTTp hL⟩
    · exact ⟨_, PW_DbDi hTTp hL⟩
  · exact ⟨_, PW_kap f⟩
  · obtain ⟨C, hC⟩ := PW_SS (P := P) i
    exact ⟨_, PW_mul (PW_DrbDri hTTp hL) hC⟩
  · obtain ⟨C, hC⟩ := PW_starSS (P := P) i
    show ∃ C, PW (star (L.Drb * L.Dri * SS P (DQ P) i)) C
    rw [starSSn_eq hL hLaw]
    exact ⟨_, PW_mul hC (PW_DrDrbi hTTp hL)⟩

/- English proof (translation)
Proceed by induction on `hb using Submonoid.closure_induction with`. Consider the case `mem x hx => exact PW_gen hTTp hL hLaw hx`. Consider the case `one => exact ⟨1, PW_one⟩`. Consider the case `mul x y _ _ h1 h2`. Take `⟨C1, hC1⟩` from `h1`.

Take `⟨C2, hC2⟩` from `h2`. Conclude with `⟨_, PW_mul hC1 hC2⟩`.
-/
theorem PW_SB {b : A P (DQ P)} (hb : b ∈ SB L) : ∃ C, PW b C := by
  induction hb using Submonoid.closure_induction with
  | mem x hx => exact PW_gen hTTp hL hLaw hx
  | one => exact ⟨1, PW_one⟩
  | mul x y _ _ h1 h2 =>
    obtain ⟨C1, hC1⟩ := h1
    obtain ⟨C2, hC2⟩ := h2
    exact ⟨_, PW_mul hC1 hC2⟩

end

