      Fintype.sum_equiv (Equiv.cast h) _ _ (fun x => rfl)]
    rw [← ptMat_mul P _ _ (hUS _ hBi) (hUS _ hB), Bi_mul, ptMat_one]
    by_cases hik : i = k
    · subst hik; simp
    · rw [if_neg (fun h' => hik ((cast_inj h).1 h')), if_neg hik, zero_mul]
  simp only [key]
  simp

end Fac

