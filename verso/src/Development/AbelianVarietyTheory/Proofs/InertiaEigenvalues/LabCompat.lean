namespace GlobalTheory.LabelCompat

/- English proof (translation)
Introduce `D i σ Sig hσ`. Establish `key : ∀ k, D.nd.lab k σ = fun v => D.naut.items₂ k (D.naut.plGw k v) (isoLoc D.nd D.naut Sig (D.naut.plGw k v))`. Introduce `k`. Use function extensionality and compare the values at `v`. Rewrite using `[D.naut.lab_loc i k σ v, hσ.2.2 _ (GlobalTheory.FixedPlaceSplit.isSplitPl_plGw D k v)]`.

Unfold `NData.goodRow goodSig`. Use `forall_congr' fun k => ?_` and prove the remaining obligations. Rewrite using `[key k]`.
-/
theorem labCompat : ∀ (D : D7) (i : D.nd.Loc), LabCompat D.nd D.naut i := by
  intro D i σ Sig hσ
  have key : ∀ k, D.nd.lab k σ = fun v =>
      D.naut.items₂ k (D.naut.plGw k v) (isoLoc D.nd D.naut Sig (D.naut.plGw k v)) := by
    intro k
    funext v
    rw [D.naut.lab_loc i k σ v, hσ.2.2 _ (GlobalTheory.FixedPlaceSplit.isSplitPl_plGw D k v)]
  unfold NData.goodRow goodSig
  refine forall_congr' fun k => ?_
  rw [key k]

end GlobalTheory.LabelCompat
