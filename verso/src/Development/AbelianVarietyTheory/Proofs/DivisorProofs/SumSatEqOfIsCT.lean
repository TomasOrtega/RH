noncomputable def Eig : (u : List (Letter E)) → Vec u → Multiset ℂˣ → Prop
  | [], _, B => B = 0
  | x :: u, f, B => ∃ C B', IsSatVecGL v (locR x.1 v) f.1.1 C ∧ Eig u f.2 B' ∧ B = C + B'

