/- English proof (translation)
Introduce `P l L j lam α β Lb c Ntot hH N Y hN hB ε hε`. Take `⟨⟨hOK, hl1, hlk, hML, hu, hu', hαβ, hcut⟩, _⟩` from `id hH`. Establish `hTT : 0 ≤ P.TT` using `(mul_pos hOK.T_pos hOK.T'_pos).le`. Establish `hcw` using `MAx3.F.cutWord_of hH c (List.ofFn Y) hB (by simpa using hN)`. Take `⟨L', hL', -, -, hFC⟩` from `model_frame_analytic P hOK l hl1 hlk`.

Establish `hLL` using `MAx3.F.level_unique P (DQ P) L' L hL' hML`. Substitute `hLL` using the available equality. Establish `hFr` using `(hFC (Fin (List.ofFn Y).length) (wordP (List.ofFn Y)) hcw).2.1`. Establish `hMW` using `(model_words P hOK (DQ P) (analytic_laws P.r P.TT hTT) l (Fin (List.ofFn Y).length) (wordP (List.ofFn Y)) (MAx3.F.good_of_cut _ hcw)).1`. Rewrite `hMW` using `[MAx3.F.prod_eq]`.

Rewrite `hMW` using `[hFr, MAx3.F.plusWord_length]`. Unfold `cutoffEnergyForm formFdF`. Rewrite using `[← hMW, MAx3.F.sandwich]`. Both sides reduce to the same expression.
-/
theorem theorem_P_form : Formalism.FourierDecayAlt.MA.ThmPForm := by
  intro P l L j lam α β Lb c Ntot hH N Y hN hB ε hε
  obtain ⟨⟨hOK, hl1, hlk, hML, hu, hu', hαβ, hcut⟩, _⟩ := id hH
  have hTT : 0 ≤ P.TT := (mul_pos hOK.T_pos hOK.T'_pos).le
  have hcw := MAx3.F.cutWord_of hH c (List.ofFn Y) hB (by simpa using hN)
  obtain ⟨L', hL', -, -, hFC⟩ := model_frame_analytic P hOK l hl1 hlk
  have hLL := MAx3.F.level_unique P (DQ P) L' L hL' hML
  subst hLL
  have hFr := (hFC (Fin (List.ofFn Y).length) (wordP (List.ofFn Y)) hcw).2.1
  have hMW := (model_words P hOK (DQ P) (analytic_laws P.r P.TT hTT) l (Fin (List.ofFn Y).length)
    (wordP (List.ofFn Y)) (MAx3.F.good_of_cut _ hcw)).1
  rw [MAx3.F.prod_eq] at hMW
  rw [hFr, MAx3.F.plusWord_length] at hMW
  unfold cutoffEnergyForm formFdF
  rw [← hMW, MAx3.F.sandwich]
  rfl

end Formalism.FourierDecayAlt.P

