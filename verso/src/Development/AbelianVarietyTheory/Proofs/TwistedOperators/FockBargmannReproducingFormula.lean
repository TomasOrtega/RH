/- English proof (translation)
Establish `h` using `GlobalTheory.T.hasSum_finsupp_prod_pow_div_factorial_exp_sum κ (fun k => (x k : ℂ))`. Rewrite `h` using `[← Complex.ofReal_sum, ← Complex.ofReal_exp]`. Use `Complex.hasSum_ofReal.mp ?_` and prove the remaining obligations. Use `h using 1` and compare the differences between its conclusion and the goal. Use function extensionality and compare the values at `m`.

Simplify using `only [Finsupp.prod, Complex.ofReal_prod, Complex.ofReal_div, Complex.ofReal_pow, Complex.ofReal_natCast]`.
-/
theorem expand_real (κ : Type) [Fintype κ] (x : κ → ℝ) :
    HasSum (fun m : κ →₀ ℕ => m.prod fun k n => x k ^ n / (n.factorial : ℝ)) (Real.exp (∑ k, x k)) := by
  have h := GlobalTheory.T.hasSum_finsupp_prod_pow_div_factorial_exp_sum κ (fun k => (x k : ℂ))
  rw [← Complex.ofReal_sum, ← Complex.ofReal_exp] at h
  refine Complex.hasSum_ofReal.mp ?_
  convert h using 1
  funext m
  simp only [Finsupp.prod, Complex.ofReal_prod, Complex.ofReal_div, Complex.ofReal_pow, Complex.ofReal_natCast]

/- English proof (translation)
Unfold `conjMono Finsupp.prod`. Use `fun_prop`.
