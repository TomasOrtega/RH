    ∀ (v : List (Letter ℂ S)), (∀ a ∈ v, a.plus = true ∧ a.pt.im = 0) →
      ∀ e : Ix S, cs x0 q0 v e = ((csR x0R q0R v e : ℝ) : ℂ)
